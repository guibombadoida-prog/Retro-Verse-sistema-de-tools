					<Item class="Script" referent="RBX95503610ECCC4EB987E6577376A7DE64">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local tweenservice = game:GetService("TweenService")


script.Parent.OnServerEvent:Connect(function(player)
	local Char = player.Character


	local Shrine = game.ReplicatedStorage.Domain.Shrine:Clone()
	Shrine.Parent = Char
	Shrine:SetPrimaryPartCFrame(Char.HumanoidRootPart.CFrame * CFrame.new(50,-50,0))
	game.Debris:AddItem(Shrine,30)

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://270070244"
	sound.Parent = Char.HumanoidRootPart
	sound:Play()
	sound.Volume = 2
	game.Debris:AddItem(sound,3)



	spawn(function()
		for i=1,48 do
			Char.Shrine:SetPrimaryPartCFrame(Char.Shrine.PrimaryPart.CFrame* CFrame.new(0,1,0))
			print("work")
			wait()
		end

	end)

	wait(2)

	local blackball = game.ReplicatedStorage.Domain:WaitForChild("Blacball"):Clone()
	blackball.CFrame = Char.HumanoidRootPart.CFrame
	blackball.Parent = workspace
	game.Debris:AddItem(blackball,24)

	local cage = game.ReplicatedStorage.Domain:WaitForChild("Cage"):Clone()
	cage.CFrame = Char.HumanoidRootPart.CFrame * CFrame.new(0,26.5,0)
	cage.Parent = workspace
	game.Debris:AddItem(cage,24)


	local info2 = TweenInfo.new(1,Enum.EasingStyle.Linear,Enum.EasingDirection.Out,0,false,0)
	local goal2 = {}
	goal2.Size = blackball.Size * 50
	local tween2 = tweenservice:Create(blackball,info2,goal2)
	tween2:Play()

	local sound2 = Instance.new("Sound")
	sound2.SoundId = "rbxassetid://357558938"
	sound2.Parent = Char.HumanoidRootPart
	sound2:Play()
	game.Debris:AddItem(sound2,5)

	wait(4)



	for i,v in pairs(game.Workspace:GetChildren()) do
		if v and v:FindFirstChild("HumanoidRootPart") and v ~= Char  then
			if (Char.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude < 50 then

				print("there someone  near u")
				local enemy = v


				enemy.HumanoidRootPart.Anchored = true

				spawn(function()

					repeat
						local sound3 = Instance.new("Sound")
						sound3.SoundId = "rbxassetid://1086616651"
						sound3.Parent = enemy.HumanoidRootPart
						sound3:Play()
						sound3.Volume = 2
						game.Debris:AddItem(sound3,0.5)

						local slash = game.ReplicatedStorage.Domain:WaitForChild("Slash"):Clone()
						slash.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.Angles(0,0,math.rad(45))
						slash.Parent = workspace
						game.Debris:AddItem(slash,0.5)

						enemy.Humanoid.Health = enemy.Humanoid.Health - 4

						wait(0.65)
					until enemy.Humanoid.Health == 0

				end)

				spawn(function()

					repeat 
						local slash2 = game.ReplicatedStorage.Domain:WaitForChild("Slash"):Clone()
						slash2.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.Angles(0,0,math.rad(-45))
						slash2.Parent = workspace
						game.Debris:AddItem(slash2,0.5)

						local sound4 = Instance.new("Sound")
						sound4.SoundId = "rbxassetid://1086616651"
						sound4.Parent = enemy.HumanoidRootPart
						sound4:Play()
						sound4.Volume = 2
						game.Debris:AddItem(sound4,0.6)

						wait(0.7)
					until enemy.Humanoid.Health == 0	

					local sound5 = Instance.new("Sound")
					sound5.SoundId = "rbxassetid://270070244"
					sound5.Parent = Char.HumanoidRootPart
					sound5:Play()
					sound5.Volume = 2
					game.Debris:AddItem(sound5,3)

					for i=1,48 do
						Char.Shrine:SetPrimaryPartCFrame(Char.Shrine.PrimaryPart.CFrame* CFrame.new(0,-1,0))
						print("work")
						wait()
					end

				end)



			end
		end
	end

end)

]]></ProtectedString>
