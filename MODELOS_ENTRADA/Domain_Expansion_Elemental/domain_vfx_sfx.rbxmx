				<Item class="LocalScript" referent="RBXA45A6E93D2D54783AC10CF5D361D50F2">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local debounce = false
Player = game.Players.LocalPlayer --gets local player
repeat wait() until Player.Character
Character = Player.Character
local tweenservice = game:GetService("TweenService")
local camera = game.Workspace.Camera
local lighting = game:GetService("Lighting")


script.Parent.Activated:Connect(function()
	if not debounce then
		debounce = true

		camera.CameraType = Enum.CameraType.Scriptable
		local runs = game:GetService("RunService")


		local cam = game.ReplicatedStorage.Domain:WaitForChild("Cam"):Clone()
		cam.CFrame = Character.Torso.CFrame * CFrame.new(0,-1,-16) * CFrame.Angles(0,math.rad(180),0)
		cam.Parent = workspace
		game.Debris:AddItem(cam,5)


		local track = Instance.new("Animation")
		track.AnimationId = "rbxassetid://9744147373" --Track1 id
		local anim = Character.Humanoid:LoadAnimation(track)
		anim:Play()

		local track2 = Instance.new("Animation")
		track2.AnimationId = "rbxassetid://9744151747" --Track2 id
		local anim2 = Character.Humanoid:LoadAnimation(track2)
		anim2:Play()

		local info = TweenInfo.new(1,Enum.EasingStyle.Linear,Enum.EasingDirection.Out,0,false,0)
		local goal = {}
		goal.CFrame = cam.CFrame
		local tween = tweenservice:Create(camera,info,goal)
		tween:Play()
		print("played")


		Character.HumanoidRootPart.Anchored = true


		script.RemoteEvent:FireServer()
		print("fired")




		spawn(function()
			wait(8)
			camera.CameraType = Enum.CameraType.Custom

		end)



		wait(15)
		Character.HumanoidRootPart.Anchored = false
		anim2:Stop()




		wait(3)
		debounce = false
	end
end)]]></ProtectedString>
