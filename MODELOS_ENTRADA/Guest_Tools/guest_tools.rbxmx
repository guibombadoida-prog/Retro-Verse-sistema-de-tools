					<Properties>
						<ProtectedString name="Source"><![CDATA[game.TweenService:Create(script.Parent.Frame,TweenInfo.new(.25),{BackgroundTransparency = 0}):Play()
game.TweenService:Create(script.Parent.Frame.Frame,TweenInfo.new(.25),{BackgroundTransparency = 0}):Play()
game.TweenService:Create(script.Parent.ImageLabel,TweenInfo.new(.25),{ImageTransparency = 0}):Play()
game.TweenService:Create(script.Parent,TweenInfo.new(.25),{Size = UDim2.new(2.8,0,2.8,0),StudsOffset = script.Parent.StudsOffset + Vector3.new(0,1.5,0)}):Play()
spawn(function()
	while true do
		wait(.05)
		script.Parent.ImageLabel.Position = UDim2.new(0,0,-0.01,0)
		wait(.05)
		script.Parent.ImageLabel.Position = UDim2.new(-1,0,-0.01,0)
