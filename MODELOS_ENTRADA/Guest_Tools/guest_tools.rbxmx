		<Item class="Script" referent="RBX0F3BB3CE7EED44ED9D586C4BA332DA46">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Abacate (roubado) do mexico - Server Script (Coloque dentro da Tool)

local Tool = script.Parent
local enabled = true
local COOLDOWN = 5 -- Aumentado de 3 para 5 segundos
local MAX_USES_PER_MINUTE = 8 -- Máximo de 8 usos por minuto
local HEAL_AMOUNT = 3 -- Reduzido de 5 para 3 HP
local useTimes = {}

-- Função para limpar usos antigos
local function cleanOldUses()
	local currentTime = tick()
	local newUseTimes = {}

	for _, useTime in ipairs(useTimes) do
		if currentTime - useTime < 60 then
			table.insert(newUseTimes, useTime)
		end
	end

	useTimes = newUseTimes
end

function onActivated()
	-- Verificar se está habilitado
	if not enabled then
		warn("Aguarde o cooldown!")
		return
	end

	-- Limpar usos antigos
	cleanOldUses()

	-- Verificar limite de usos por minuto
	if #useTimes >= MAX_USES_PER_MINUTE then
		warn("Limite de usos atingido! Aguarde um momento.")
		return
	end

	-- Verificar se o personagem existe
	local character = Tool.Parent
	if not character or not character:FindFirstChild("Humanoid") then
		return
	end

	enabled = false

	-- Registrar uso atual
	table.insert(useTimes, tick())

	-- Animação de beber
	Tool.GripForward = Vector3.new(0, -.759, -.651)
	Tool.GripPos = Vector3.new(1.5, -.5, .3)
	Tool.GripRight = Vector3.new(1, 0, 0)
	Tool.GripUp = Vector3.new(0, .651, -.759)

	Tool.Handle.DrinkSound:Play()

	wait(3)

	-- Sistema de cura nerfado
	local h = Tool.Parent:FindFirstChild("Humanoid")
	if h ~= nil and h.Health > 0 then -- Verifica se ainda está vivo
		local newHealth = math.min(h.Health + HEAL_AMOUNT, h.MaxHealth)
		h.Health = newHealth
	end

	-- Volta à posição normal
	Tool.GripForward = Vector3.new(-.976, 0, -0.217)
	Tool.GripPos = Vector3.new(0.03, 0, 0)
	Tool.GripRight = Vector3.new(.217, 0, -.976)
	Tool.GripUp = Vector3.new(0, 1, 0)

	-- Cooldown aumentado
	wait(COOLDOWN - 3) -- Já esperou 3 segundos na animação
	enabled = true
end

function onEquipped()
	Tool.Handle.OpenSound:Play()
	-- Reseta contador ao equipar
	useTimes = {}
	enabled = true
end

-- Limpa contador ao desequipar
Tool.Unequipped:Connect(function()
	useTimes = {}
	enabled = true
end)

Tool.Activated:Connect(onActivated)
Tool.Equipped:Connect(onEquipped)]]></ProtectedString>
