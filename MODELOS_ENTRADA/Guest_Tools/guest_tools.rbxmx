end)
wait(1.25)
game.TweenService:Create(script.Parent.Frame,TweenInfo.new(.19),{BackgroundTransparency = 1}):Play()
game.TweenService:Create(script.Parent.Frame.Frame,TweenInfo.new(.19),{BackgroundTransparency = 1}):Play()
