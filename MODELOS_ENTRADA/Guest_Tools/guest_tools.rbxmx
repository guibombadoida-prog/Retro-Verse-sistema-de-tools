			<Properties>
				<ProtectedString name="Source"><![CDATA[-- LocalScript_TacoDeBaseball_V1.1.lua
-- Coloque DENTRO da Tool "Taco de Baseball"
-- Adiciona botão mobile para ativar/segurar o ataque

--[[
═══════════════════════════════════════════════════════════════
        TACO DE BASEBALL - LOCAL SCRIPT V1.1
═══════════════════════════════════════════════════════════════
FUNCIONALIDADES:
- ✅ Botão mobile para ativar/segurar ataque
- ✅ Segure o botão para carregar (50 frames = critical, 90 frames = vibe check)
- ✅ Compatível com PC e Mobile
═══════════════════════════════════════════════════════════════
--]]

-- ═══════════════════════════════════════════════════════════
-- SERVIÇOS
-- ═══════════════════════════════════════════════════════════
local ContextActionService = game:GetService("ContextActionService")

-- ═══════════════════════════════════════════════════════════
-- VARIÁVEIS
-- ═══════════════════════════════════════════════════════════
local Tool = script.Parent

-- ═══════════════════════════════════════════════════════════
-- FUNÇÃO DE ATIVAÇÃO DO BOTÃO
-- ═══════════════════════════════════════════════════════════
local function OnAttack(actionName, inputState, inputObj)
	if inputState == Enum.UserInputState.Begin then
		-- Ativa o ataque (pressionar/segurar)
		Tool:Activate()
	elseif inputState == Enum.UserInputState.End then
		-- Desativa o ataque (soltar)
		Tool:Deactivate()
	end
end

-- ═══════════════════════════════════════════════════════════
-- EQUIPAR - CRIAR BOTÃO MOBILE
-- ═══════════════════════════════════════════════════════════
Tool.Equipped:Connect(function()
	-- Criar botão de ataque para mobile
	-- Aparece automaticamente em dispositivos touch
	ContextActionService:BindAction(
		"BatAttack",           -- Nome da ação
		OnAttack,              -- Função callback
		true,                  -- Criar botão mobile (true = sim)
		Enum.KeyCode.ButtonR2  -- Tecla padrão (R2 no gamepad)
	)

	-- Configurar título do botão
	ContextActionService:SetTitle("BatAttack", "⚾ Ataque")

	-- Configurar posição do botão (canto superior direito)
	ContextActionService:SetPosition("BatAttack", UDim2.new(0.85, -60, 0.15, -60))
end)

-- ═══════════════════════════════════════════════════════════
-- DESEQUIPAR - REMOVER BOTÃO MOBILE
-- ═══════════════════════════════════════════════════════════
Tool.Unequipped:Connect(function()
	-- Remove o botão quando a ferramenta é desequipada
	ContextActionService:UnbindAction("BatAttack")
end)

--[[
═══════════════════════════════════════════════════════════════
INSTRUÇÕES DE USO:
1. MOBILE: Pressione e SEGURE o botão "⚾ Ataque" para carregar
   - Segure 50 frames (~0.8s) = Ataque Critical (branco)
   - Segure 90 frames (~1.5s) = Vibe Check (vermelho)
   - Solte para executar o ataque

2. PC: Clique e SEGURE o mouse
   - Mesmo sistema de carga

3. GAMEPAD: Pressione e segure R2
   - Mesmo sistema de carga
═══════════════════════════════════════════════════════════════
--]]]]></ProtectedString>
