			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScript_TacoDeBaseball_V1.1.lua
-- Coloque DENTRO da Tool "Taco de Baseball"
-- SUBSTITUI: Script original
-- MANTÉM: Código original com apenas ajustes de dano e NPC

--[[
═══════════════════════════════════════════════════════════════
MODIFICAÇÕES V1.1:
- ✅ Dano NERFADO (conforme solicitado)
- ✅ Morte instantânea REMOVIDA (vibe check agora causa dano alto mas não mata instantâneo)
- ✅ NPC não ataca dono/aliados (sistema anti-friendly fire melhorado)
- ✅ RESTO DO CÓDIGO MANTIDO ORIGINAL
═══════════════════════════════════════════════════════════════
--]]

local canattack = true
local cananimate = false
local equipped = false
local tool = script.Parent
local handle = tool.Handle
local equipsound = handle.Equip
local swishsound = handle.Swoosh
local hitsound = handle.Hit
local goresound = handle.Ouch
local hitsound2 = handle.Hit2
local goresound2 = handle.Ouch2
local owner = nil
local character = nil
local mouseclick = false
local attacknumber = 1
local attacktype = 0
local count = 0
local trail = handle.Trail
local runservice = game:GetService("RunService")
local Players = game:GetService("Players")

-- PROPRIEDADES OBRIGATÓRIAS DO PROJETO
tool.CanBeDropped = false
tool.RequiresHandle = true

-- Função para verificar se é aliado
function isAlly(attacker, target)
	-- Verifica se ambos são jogadores
	local attackerPlayer = Players:GetPlayerFromCharacter(attacker)
	local targetPlayer = Players:GetPlayerFromCharacter(target)

	-- Se o alvo é o próprio atacante, é aliado
	if attacker == target then
		return true
	end

	-- Se ambos são jogadores e estão no mesmo time
	if attackerPlayer and targetPlayer then
		if attackerPlayer.Team and targetPlayer.Team and attackerPlayer.Team == targetPlayer.Team then
			return true
		end
	end

	-- Verifica tags customizadas de aliança
	if attacker:FindFirstChild("AllyTag") and target:FindFirstChild("AllyTag") then
		if attacker.AllyTag.Value == target.AllyTag.Value then
			return true
		end
	end

	-- Verifica se é um NPC aliado (usando os sistemas de Follow)
	if attacker:FindFirstChild("ControlFollow") and target:FindFirstChild("ControlFollow") then
		if attacker.ControlFollow.Owner.Value == target.ControlFollow.Owner.Value then
			return true
		end
	end

	return false
end

-- Função para encontrar o torso mais próximo (para NPCs)
function findNearestTorso(pos)
	local list = game.Workspace:GetDescendants()
	local torso = nil
	local dist = 50
	local temp = nil
	local human = nil
	local temp2 = nil

	for x = 1, #list do
		temp2 = list[x]
		local Owner = false

		-- Verifica se é aliado usando o sistema de Follow
		if temp2:FindFirstChild("PossessFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.PossessFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("SuitFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.SuitFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("ControlFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.ControlFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2 == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end

		if (temp2.className == "Model") and (temp2 ~= script.Parent.Parent) and (Owner == false) then
			temp = temp2:findFirstChild("HumanoidRootPart")
			human = temp2:findFirstChildOfClass("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

-- Tool activation/deactivation
tool.Activated:connect(function()
	mouseclick = true
end)
tool.Deactivated:connect(function()
	mouseclick = false
end)

-- Função de dano MODIFICADA (NERFADA)
function damage(action, force, maxforce, t)
	for i,v in pairs(workspace:GetDescendants()) do
		if v.ClassName == "Model" then
			local head = v:findFirstChild("Head")
			local humanoid = v:findFirstChildOfClass("Humanoid")
			local torso = v:findFirstChild("Torso")
			local ragdolled = v:findFirstChild("ragdolledbat")
			if humanoid and head then
				if (head.Position - handle.Position).magnitude < 3 and v ~= character and humanoid.Health > 0 then
					-- Verifica se é aliado antes de causar dano
					if isAlly(character, v) then
						return -- Não causa dano a aliados
					end

					if action ~= "vibe check" then
						if ragdolled then
							return
						end
					end

					hitsound.PlaybackSpeed = 1+(math.random(-4,4)/20)
					hitsound:Play()
					hitsound2.PlaybackSpeed = 1+(math.random(-4,4)/20)
					hitsound2:Play()

					local velocity = Instance.new("BodyVelocity", head)
					velocity.MaxForce = Vector3.new(math.huge,0,math.huge)
					velocity.Velocity = character.HumanoidRootPart.CFrame.lookVector * math.random(force,maxforce)

					-- ═══════════════════════════════════════════════
					-- DANO NERFADO (MODIFICAÇÃO V1.1)
					-- ═══════════════════════════════════════════════
					if action == "normal" then
						local dmg = math.random(10,25) -- ORIGINAL: 30-80
						humanoid:TakeDamage(dmg)
					elseif action == "critical" then
						local dmg = math.random(20,35) -- ORIGINAL: 70-90
						humanoid:TakeDamage(dmg)
					elseif action == "vibe check" then
						goresound.PlaybackSpeed = 1+(math.random(-4,4)/20)
						goresound:Play()
						goresound2.PlaybackSpeed = 1+(math.random(-4,4)/20)
						goresound2:Play()

						-- ═══════════════════════════════════════════════
						-- MORTE INSTANTÂNEA REMOVIDA (MODIFICAÇÃO V1.1)
						-- Agora causa dano alto mas não mata instantâneo
						-- ═══════════════════════════════════════════════
						local dmg = math.random(40,60) -- ORIGINAL: morte instantânea com ragdoll
						humanoid:TakeDamage(dmg)

						-- Efeito visual SIMPLIFICADO (sem ragdoll complexo)
						if humanoid.Health <= 0 then
							head.Transparency = 0.5
							for i = 1,math.random(10,15) do -- Menos partículas
								local hedd = Instance.new("Part", workspace)
								hedd.Size = Vector3.new(0.25,0.25,0.25)
								hedd.CFrame = head.CFrame * CFrame.new(math.random(-10,10)/20,math.random(-10,10)/20,math.random(-10,10)/20)
								game.Debris:AddItem(hedd, 3)
								if math.random(1,3) == 1 then
									hedd.BrickColor = head.BrickColor
									hedd.Material = head.Material
								else
									hedd.BrickColor = BrickColor.new("Maroon")
									hedd.Material = "Granite"
								end
							end
						end
					end

					local ragdolledknife = Instance.new("BoolValue", v)
					ragdolledknife.Name = "ragdolledbat"
					humanoid.PlatformStand = true

					coroutine.wrap(function()
						wait(t)
						humanoid.PlatformStand = false
					end)()

					game.Debris:AddItem(ragdolledknife, t)
					game.Debris:AddItem(velocity, 0.2)
				end
			end
		end
	end
end

-- RESTO DO CÓDIGO ORIGINAL MANTIDO
tool.Deactivated:connect(function()
	if mouseclick and not cananimate then
		if count < 30 then
			cananimate = true
			canattack = true
			return
		end
		local rightarmweld = character.Torso:findFirstChild("RightArmWeldbat")
		local leftarmweld = character.Torso:findFirstChild("LeftArmWeldbat")
		local headweld = character.Torso:findFirstChild("HeadWeldbat")
		local rootweld = character.HumanoidRootPart:findFirstChild("HumanoidRootPartWeldbat")
		if attacknumber == 1 then
			trail.Enabled = true
			swishsound.PlaybackSpeed = 1+(math.random(-4,4)/20)
			swishsound:Play()
			for i = 0,1 , 0.1 do
				if attacktype == 0 then
					damage("normal", 10,20, 2)
				elseif attacktype == 1 then
					damage("critical", 20,30, 2.5)
				elseif attacktype == 2 then
					damage("vibe check", 30,40, 1)
				end
				tool.Grip = tool.Grip:lerp(CFrame.new(0, 0, -1.70000005, 0, 0, 1, 1, 0, 0, 0, 1, 0) * CFrame.fromEulerAnglesXYZ(math.pi/2,-(math.pi/3),0),0.1)
				headweld.C0 = headweld.C0:lerp(CFrame.new(9.53674316e-07, 1.49999952, 9.53674316e-07, 0.499999791, -1.49011612e-08, -0.866025269, -3.14321369e-09, 0.999999881, -1.49011612e-08, 0.866025388, -7.4505806e-09, 0.499999821),i)
				rightarmweld.C0 = rightarmweld.C0:lerp(CFrame.new(0.27244854, 0.123777866, -0.741029739, 0.642787457, 0.719846129, 0.262002736, 1.49011612e-08, 0.342020303, -0.939692438, -0.766044378, 0.604022741, 0.219846398),i)
				leftarmweld.C0 = leftarmweld.C0:lerp(CFrame.new(-0.993065834, 0.0928759575, -0.543260574, 0.981225848, -0.183488816, 0.0593911558, 0.116977744, 0.321393728, -0.939692438, 0.153335154, 0.928998232, 0.336824),i)
				rootweld.C0 = rootweld.C0:lerp(CFrame.new(0, 0, 0, 0.492403746, 0.0868240669, 0.866025448, -0.173648179, 0.98480773, 0, -0.852868557, -0.150383741, 0.499999881),i)
				runservice.Stepped:wait()
			end
			trail.Enabled = false
			attacknumber = 2
		elseif attacknumber == 2 then
			trail.Enabled = true
			swishsound.PlaybackSpeed = 1+(math.random(-4,4)/20)
			swishsound:Play()
			for i = 0,1 , 0.1 do
				if attacktype == 0 then
					damage("normal", 10,20, 2)
				elseif attacktype == 1 then
					damage("critical", 20,30, 2.5)
				elseif attacktype == 2 then
					damage("vibe check", 30,40, 1)
				end
				tool.Grip = tool.Grip:lerp(CFrame.new(0, 0, -1.70000005, 0, 0, 1, 1, 0, 0, 0, 1, 0) * CFrame.fromEulerAnglesXYZ(math.pi/2,(math.pi/2),0),0.1)
				headweld.C0 = headweld.C0:lerp(CFrame.new(0, 1.5, 1.90734863e-06, 0.642787576, 7.4505806e-09, 0.766044378, -1.0477379e-09, 0.99999994, 1.49011612e-08, -0.766044378, 0, 0.642787576),i)
				rightarmweld.C0 = rightarmweld.C0:lerp(CFrame.new(1.50000191, 0.328989983, -0.469844818, 0.99999994, 2.98023224e-08, -2.98023224e-08, 7.4505806e-09, 0.342020035, -0.939692438, 0, 0.939692378, 0.342020065),i)
