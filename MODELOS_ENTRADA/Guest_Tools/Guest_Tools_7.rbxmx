		<Item class="Script" referent="RBX6C597EA1E864451384685E7826D724F3">
			<Properties>
				<ProtectedString name="Source">-- Energetico Server Script - VERSÃO NERFADA

local Tool = script.Parent
local enabled = true
local originalSpeed = 16 -- Velocidade padrão do Roblox

function onActivated()
	if not enabled then
		return
	end

	enabled = false

	-- Animação de beber
	Tool.GripForward = Vector3.new(0, -.759, -.651)
	Tool.GripPos = Vector3.new(1.5, -.5, .3)
	Tool.GripRight = Vector3.new(1, 0, 0)
	Tool.GripUp = Vector3.new(0, .651, -.759)
	Tool.Handle.DrinkSound:Play()

	wait(3.5) -- Aumentado de 2.5 para 3.5 segundos

	-- Cura reduzida de 5 para 2 HP
	local h = Tool.Parent:FindFirstChild("Humanoid")
	if h ~= nil then
		if h.MaxHealth &gt; h.Health + 2 then
			h.Health = h.Health + 2
		else	
			h.Health = h.MaxHealth
		end

		-- Velocidade reduzida para 22 e TEMPORÁRIA (dura 5 segundos)
		local player = game.Players:GetPlayerFromCharacter(Tool.Parent)
		if player then
			h.WalkSpeed = 22

			-- Volta ao normal após 5 segundos
			delay(5, function()
				if h then
					h.WalkSpeed = originalSpeed
				end
			end)
		end
	end

	-- Volta à posição normal
	Tool.GripForward = Vector3.new(-.976, 0, -0.217)
	Tool.GripPos = Vector3.new(0.03, 0, 0)
	Tool.GripRight = Vector3.new(.217, 0, -.976)
	Tool.GripUp = Vector3.new(0, 1, 0)

	enabled = true
end

function onEquipped()
	Tool.Handle.OpenSound:Play()
end

Tool.Activated:Connect(onActivated)
Tool.Equipped:Connect(onEquipped)

-- Sistema de partículas
local particleEmitter = Tool.Splash.ParticleEmitter

Tool.Activated:Connect(function()
	particleEmitter.Transparency = NumberSequence.new(0.95)
end)

Tool.Unequipped:Connect(function()
	particleEmitter.Transparency = NumberSequence.new(1)
end)</ProtectedString>
