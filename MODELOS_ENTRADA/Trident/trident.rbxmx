-- welding

function weld(proptable)
	local weld = ins("Weld",proptable[1])
	weld.Part0 = proptable[2]
	weld.Part1 = proptable[3]
	weld.C0 = proptable[4]
	weld.Name = proptable[5]
	return weld
end

