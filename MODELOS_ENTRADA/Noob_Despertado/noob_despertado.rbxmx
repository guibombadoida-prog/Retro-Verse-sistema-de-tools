function KeyDown(Key)
  KEYHOLD = true
---atackks

if Key == "z" and ATTACK == false then
	if mode == "banish" then
		Shot()
	end
	if mode == "master" then
		TimeStop()
	end
	if mode == "dark" then
		Neckless()
	end
	if mode == "dominus" then
		Lunar_Blast()
	end
end

if Key == "x" and ATTACK == false then
	if mode == "banish" then
		Lava()
	end
	if mode == "master" then
		BlackRole()
	end
	if mode == "dominus" then
		SuperDominus()
	end
end

if Key == "c" and ATTACK == false then
	if mode == "master" then
		ClockDestroyer()
	end
	if mode == "banish" then
		BlastShoot()
	end
end

---modes

if Key == "e" and ATTACK == false then
	MasterForm()
end
if Key == "q" and ATTACK == false then
	BanishForm()
end
if Key == "r" and ATTACK == false then
	DarkForm()
end
if Key == "t" and ATTACK == false then
	DominusForm()
end
if Key == "f" and ATTACK == false then
	RobotForm()
end
if Key == "e" and ATTACK == false then
	LightForm()
end




end
 
 
 function KeyUp(Key)
    KEYHOLD = false
end
 
    Mouse.Button1Down:connect(function(NEWKEY)
        MouseDown(NEWKEY)
    end)
    Mouse.Button1Up:connect(function(NEWKEY)
        MouseUp(NEWKEY)
    end)
    Mouse.KeyDown:connect(function(NEWKEY)
        KeyDown(NEWKEY)
    end)
    Mouse.KeyUp:connect(function(NEWKEY)
        KeyUp(NEWKEY)
    end)   
 






