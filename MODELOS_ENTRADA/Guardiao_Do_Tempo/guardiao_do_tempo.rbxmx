			PRT1.CFrame = CLOCK.CFrame * ANGLES(RAD(0), RAD(-LOOP * 5 / 2), RAD(0)) * CF(0, 0, PRT1.Size.Z / 2)
			if LOOP <= -145 then
				LOOP = 0
				if ACTIVE == false then
					ClockEffect(CLOCK.CFrame, 45, 35)
					WACKYEFFECT({
