		PRT1.Transparency = NEWCLOCK.Transparency
		PRT2.Transparency = NEWCLOCK.Transparency
		TICKTOCK.Volume = TICKTOCK.Volume + 0.4
	end
	wait(0.5)
	for i = 1, 120 do
