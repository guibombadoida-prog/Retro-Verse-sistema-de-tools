	coroutine.resume(coroutine.create(function()
		local AFFECTEDPEOPLE = {}
		local CHROMES = {}
		local HITFLOOR, HITPOS = Raycast(CLOCK.PrimaryPart.Position, CF(RootPart.Position, RootPart.Position + VT(0, -1, 0)).lookVector, 1500, Character)
		if HITFLOOR then
			do
