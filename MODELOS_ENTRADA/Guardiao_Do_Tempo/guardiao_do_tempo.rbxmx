	<Item class="LocalScript" referent="RBXA0A6227E886346AA931AA6FE5246D2C0">
		<Properties>
			<ProtectedString name="Source"><![CDATA[repeat
	wait()
until script:FindFirstChild("Undo")
local BOOL = script.Undo
do
	local TIMER = 15
	local CAM = workspace.CurrentCamera
	local FX = Instance.new("ColorCorrectionEffect", CAM)
	FX.Brightness = 1
	FX.Saturation = -1
	local TIME1 = math.ceil(TIMER / 7)
	for i = 1, TIME1 do
		wait()
		FX.Brightness = FX.Brightness - 1 / TIME1
	end
	BOOL.Changed:Connect(function()
		if BOOL.Value == true then
			for i = 1, TIMER do
				wait()
				FX.Saturation = FX.Saturation + 1 / TIMER
			end
			FX:Remove()
			script:Remove()
		end
	end)
end]]></ProtectedString>
