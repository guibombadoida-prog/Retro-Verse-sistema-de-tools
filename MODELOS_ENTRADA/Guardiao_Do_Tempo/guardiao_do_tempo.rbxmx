		LeftHip.C0 = Clerp(LeftHip.C0, CF(-1.03, -0.97 - 0.05 * COS(SINE / 12), 0) * ANGLES(RAD(0), RAD(-100), RAD(0)) * ANGLES(RAD(-8), RAD(0), RAD(0)), 1 / Animation_Speed)
	end
	local BUILDUP = true
