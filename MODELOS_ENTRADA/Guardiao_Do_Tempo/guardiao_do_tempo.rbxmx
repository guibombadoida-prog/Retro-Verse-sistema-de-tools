		RightShoulder.C0 = Clerp(RightShoulder.C0, CF(1.25, 1 + 0.05 * SIN(SINE / 12), 0) * ANGLES(RAD(170), RAD(-35), RAD(6)) * RIGHTSHOULDERC0, 1 / Animation_Speed)
