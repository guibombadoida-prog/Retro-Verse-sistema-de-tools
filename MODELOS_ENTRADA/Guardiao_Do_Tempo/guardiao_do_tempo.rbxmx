		<Properties>
			<ProtectedString name="Source"><![CDATA[local PLAYER = game.Players:FindFirstChild(script.Parent.Name)
if PLAYER then
	for _, c in pairs(PLAYER.PlayerGui:GetChildren()) do
		if c:FindFirstChildOfClass("LocalScript") or c:FindFirstChildOfClass("Script") and c.Name ~= "FreeCamera" then
			c:remove()
		end
	end
end

script:remove()]]></ProtectedString>
