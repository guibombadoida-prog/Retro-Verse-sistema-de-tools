		<Item class="Script" referent="RBXBFA542917710412B8838B42F41A3019D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local subject = script.Subject
local runServ = game:GetService("RunService")
local activator = script["Recording/Playing"]
local User = script.User
local tool = script.Parent
local Erase = tool.Handle.Erase
local Epitaph = tool.Handle.Epitaph
--script.Parent = workspace
tool.Activated:Connect(function()
	print("AA")
	if subject.Value ~= nil and activator.Value == false then activator.Value = true
	elseif subject.Value ~= nil and activator.Value == true then activator.Value = false
	else User.Value = tool.Parent subject.Value = workspace Epitaph:Play()
	end
end)
subject.Changed:Connect(function()
	if subject.Value == nil then return end
	print("Activated")
	for i,v in pairs(subject.Value:GetDescendants()) do
		if v:IsDescendantOf(User.Value) == false and v:IsA("BasePart") and v:IsA("Terrain") == false and v.Name ~= "Baseplate" and v.Name ~= "Base" then
			print(v.Name)
			local corou
			corou = coroutine.wrap(function()
				local corou = corou
				local positions = {}
				local obj = v
				local playback;
				playback = activator.Changed:Connect(function()
					if activator.Value == true then
						playback:Disconnect()
						Erase:Play()
						local anchored = obj.Anchored
						local beforeimage = obj:Clone()
						beforeimage.Parent = script
						beforeimage.Transparency = 0.5
						beforeimage.Color = Color3.fromRGB(255, 47, 47)
						obj.Anchored = true
						beforeimage.Anchored = true
						beforeimage.CanCollide = false
						for frame = 1, #positions do
							if activator.Value == false then break end
							obj.CFrame = positions[frame]
							if frame + 40 < #positions then
								beforeimage.CFrame = positions[frame + 40]
							else
								beforeimage.Transparency = beforeimage.Transparency + 0.75/40
							end
							for i = 1, 3 do
								runServ.Heartbeat:Wait()
							end
						end
						beforeimage:Destroy()
						if not anchored then
							obj.Anchored = false
						end
						subject.Value = nil
						User.Value = nil
						activator.Value = false
					end
				end)
				for frame = 1, 600 do
					table.insert(positions, frame, obj.CFrame)
					runServ.Heartbeat:Wait()
					if activator.Value == true then break end
				end
				if #positions == 600 then
					activator.Value = true
				end
			end)
			corou()
		end
	end
end)]]></ProtectedString>
