			<Item class="Script" referent="RBXDCF62EF32BD64DECA38012979126D4A0">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Character = script.Character.Value
local Tool = script.Tool.Value
local Player = game:GetService("Players"):GetPlayerFromCharacter(Character)
local Slash = script.Parent
local Debris = game:GetService("Debris")

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	Debris:AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end


Slash.Touched:Connect(function(Hit)
	local Humanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
	local ERoot = Hit.Parent:FindFirstChild("HumanoidRootPart") or Hit.Parent:FindFirstChild("Torso")
	if Humanoid and ERoot and not Hit.Parent:FindFirstChild("MoonSlashDetection") then
		local Detection = Instance.new("Vector3Value",Hit.Parent)
		Detection.Name = "MoonSlashDetection"
		if IsTeamMate(Player,game:GetService("Players"):GetPlayerFromCharacter(ERoot.Parent)) then return end
		UntagHumanoid(Humanoid)
		TagHumanoid(Humanoid,Player)
		Humanoid.Sit = true
		Humanoid:TakeDamage(34)
	end
end)

wait(2)

local ExplosionModel = game:GetService("InsertService"):LoadAsset(6213495989)
local Explosion = ExplosionModel:GetChildren()[1]:Clone()
Explosion.Parent = workspace
Explosion.Position = Slash.Position
local ActualExplosion = Instance.new("Explosion",workspace)
ActualExplosion.DestroyJointRadiusPercent = 0
ActualExplosion.BlastPressure = 100000
ActualExplosion.BlastRadius = 100
ActualExplosion.Visible = false
ActualExplosion.Position = Slash.Position
local BoomScript = script.BoomScript:Clone()
BoomScript.Parent = ActualExplosion
BoomScript.Character.Value = Character
BoomScript.Player.Value = Player
BoomScript.Disabled = false
Slash:Destroy()]]></ProtectedString>
