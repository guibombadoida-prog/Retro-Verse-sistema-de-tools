			<Item class="Script" referent="RBXE5490C1E99484107BE82F21057E5D2A3">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Character = script.Character.Value
local Tool = script.Tool.Value
local Player = game:GetService("Players"):GetPlayerFromCharacter(Character)
local Photon = script.Parent

script.Character.Changed:Connect(function()
	Character = script.Character.Value
	Player = game:GetService("Players"):GetPlayerFromCharacter(Character)
end)

Photon:SetNetworkOwner(nil)
local HasBeenHit = false
Photon.Touched:Connect(function(Hit)
	if Hit.Name ~= "Explosion" and HasBeenHit == false and Hit.Name ~= "Shell" and Hit ~= Character and Hit.Name ~= "Photon" and Hit.Name ~= "Core" then
		HasBeenHit = true
		local ExplosionModel = game:GetService("InsertService"):LoadAsset(6213157849)
		local Explosion = ExplosionModel:GetChildren()[1]:Clone()
		Explosion.Position = Photon.Position
		Explosion.Shell.Position = Explosion.Position
		Explosion.Parent = workspace
		Explosion.ExplosionSound:Play()
		local ActualExplosion = Instance.new("Explosion",workspace)
		ActualExplosion.DestroyJointRadiusPercent = 0
		ActualExplosion.BlastPressure = 10000
		ActualExplosion.BlastRadius = 5
		ActualExplosion.Visible = false
		ActualExplosion.Position = Photon.Position
		local BoomScript = script.BoomScript:Clone()
		BoomScript.Parent = ActualExplosion
		BoomScript.Character.Value = Character
		BoomScript.Player.Value = Player
		BoomScript.Disabled = false
		Photon:Destroy()
	end
end)

]]></ProtectedString>
