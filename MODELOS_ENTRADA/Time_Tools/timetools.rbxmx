					<Item class="Script" referent="RBXD76FF6DD20AE4FF7ADFB6C551F21A661">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local part = script.Parent

local TweeenService = game:GetService("TweenService")

local Info = TweenInfo.new(
	2.1, -- Time
	Enum.EasingStyle.Quad, -- EasingStyle
	Enum.EasingDirection.Out, -- EasingDirection
	0, -- RepeatCount (when less than zero the tween will loop indefinitely)
	false, -- Reverses (tween will reverse once reaching it's goal)
	1 -- DelayTime
)
part.Orientation = Vector3.new(0,1250,0)
part.Aura:Play()
wait()
local Properties = {
	Transparency = 1
}

local tween = TweeenService:Create(part,Info,Properties)
tween:Play()]]></ProtectedString>
