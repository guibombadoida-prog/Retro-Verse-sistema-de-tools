			<Item class="LocalScript" referent="RBX928097641C6243C6B93682DDE4785166">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local player = game.Players.LocalPlayer

local value = script:WaitForChild("Time").Value

local blur = script:WaitForChild("Blur")
local grayscale = script:WaitForChild("ColorCorrection")

local debris = game:GetService("Debris")
local tweenService = game:GetService("TweenService")

function effects()

	blur.Parent = game.Lighting
	grayscale.Parent = game.Lighting
	debris:AddItem(blur,value+1)
	debris:AddItem(grayscale,value+1)
	--inward blur tween
	local B_TI1 = TweenInfo.new(0.5,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,0,false)
	local B_TV1 = {
		Size = 6,
	}
	local B_T1 = tweenService:Create(blur,B_TI1,B_TV1)
	--outward blur tween
	local B_TI2 = TweenInfo.new(0.5,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,0,false)
	local B_TV2 = {
		Size = 0,
	}
	local B_T2 = tweenService:Create(blur,B_TI2,B_TV2)
	--inward grayscale tween
	local GS_TI1 = TweenInfo.new(0.5,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,0,false)
	local GS_TV1 = {
		Saturation = -1,
	}
	local GS_T1 = tweenService:Create(grayscale,GS_TI1,GS_TV1)
	--outward grayscale tween
	local GS_TI2 = TweenInfo.new(0.5,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,0,false)
	local GS_TV2 = {
		Saturation = 0,
	}
	local GS_T2 = tweenService:Create(grayscale,GS_TI2,GS_TV2)

	B_T1:Play()
	GS_T1:Play()
	wait(value)
	B_T2:Play()
	GS_T2:Play()
	wait(1)
	script:Destroy()
end
effects()]]></ProtectedString>
