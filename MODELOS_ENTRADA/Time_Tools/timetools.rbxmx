				<Properties>
					<ProtectedString name="Source"><![CDATA[local tool = script.Tool.Value
local timestop = tool.Timestop

function freezeNewParts(part) --freeze new parts created during timestop
	if part:IsA("Part") or part:IsA("MeshPart") or part:IsA("WedgePart") or part:IsA("CornerWedgePart") then
		wait()
		part.Anchored = true
		script.Destroying:Connect(function()
			part.Anchored = false
		end)
	end
end

workspace.ChildAdded:Connect(freezeNewParts)]]></ProtectedString>
