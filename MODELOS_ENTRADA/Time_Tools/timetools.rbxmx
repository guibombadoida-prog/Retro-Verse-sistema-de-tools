		<Item class="LocalScript" referent="RBX506C5EE1ACB5419B951601C75A803ACE">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local character

local debounce = false
local cooldown = 10

local stopEvent = tool.Stop

local equipped = false

tool.Equipped:Connect(function()
	character = tool.Parent
	equipped = true
end)

tool.Unequipped:Connect(function()
	character = nil
	equipped = false
end)

tool.Activated:Connect(function()
	if debounce then return end
	debounce = true
	stopEvent:FireServer()
	wait(cooldown)
	debounce = false
end)]]></ProtectedString>
