		<Item class="Script" referent="RBXA1454DE188A74195AF4C02839D27185A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent

local Effects = tool:WaitForChild("Effects")
local Sounds = tool:WaitForChild("Sounds")

local debris = game:GetService("Debris")
local tweenService = game:GetService("TweenService")

local stopEvent = tool.Stop

local character
local plr

local timestop = tool.Timestop

tool.Equipped:Connect(function()
	character = tool.Parent
	plr = game.Players:GetPlayerFromCharacter(character)
end)

tool.Unequipped:Connect(function()
	character = nil
	plr = nil
end)

function stopFX()
	local sphere = Instance.new("Part")
	sphere.Parent = workspace
	sphere.Name = "Timestop Effect"
	sphere.Shape = Enum.PartType.Ball
	sphere.Material = Enum.Material.ForceField
	sphere.Size = Vector3.new(0.001, 0.001, 0.001)
	sphere.Color = Color3.fromRGB(167, 184, 255)
	sphere.Position = character.HumanoidRootPart.Position
	sphere.Transparency = 0
	sphere.Anchored = true
	sphere.CanCollide = false
	sphere.CanQuery = false
	sphere.CastShadow = false
	sphere.Massless = true
	local M = Instance.new("SpecialMesh")
	M.Parent = sphere
	M.MeshId = "rbxassetid://3732570516"
	M.TextureId = "rbxassetid://5850567969"
	M.Scale = Vector3.new(0.001, 0.001, 0.001)
	debris:AddItem(sphere,script.Stop.Time.Value+2)
	local M_TI1 = TweenInfo.new(0.75,Enum.EasingStyle.Exponential,Enum.EasingDirection.InOut,0,false)
	local M_TV1 = {
		Scale = Vector3.new(10,10,10),
	}
	local M_T1 = tweenService:Create(M, M_TI1, M_TV1)
	local M_TI2 = TweenInfo.new(0.75,Enum.EasingStyle.Exponential,Enum.EasingDirection.InOut,0,false)
	local M_TV2 = {
		Scale = Vector3.new(0.001,0.001,0.001),
	}
	local M_T2 = tweenService:Create(M, M_TI2, M_TV2)
	M_T1:Play() --tween
	wait(script.Stop.Time.Value)
	M_T2:Play() --reverse tween
end

stopEvent.OnServerEvent:Connect(function()
	timestop.Value = true
	local stopSound = Sounds.Timestop:Clone()
	stopSound.Parent = character.HumanoidRootPart
	stopSound:Play()
	coroutine.resume(coroutine.create(stopFX))
	debris:AddItem(stopSound,stopSound.TimeLength+1)
	local freezeParts = script.Parts:Clone()
	freezeParts.Enabled = true
	freezeParts.Parent = workspace
	debris:AddItem(freezeParts,freezeParts.Time.Value)
	for i, v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") and v ~= character.Humanoid then --anchor players
			local char = v.Parent
			local stopScript = script.Stop:Clone()
			stopScript.Parent = char
			stopScript.Enabled = true
			local visualScript = script.GrayScale:Clone()
			visualScript.Parent = char
			visualScript.Enabled = true
		elseif v == character.Humanoid then
			local visualScript = script.GrayScale:Clone()
			visualScript.Parent = character
			visualScript.Enabled = true
		elseif v:IsA("Part") and v.Anchored == false and not v:IsDescendantOf(character) then
			coroutine.resume(coroutine.create(function() --anchor parts
				v.Anchored = true
				wait(script.Stop.Time.Value)
				v.Anchored = false
			end))
		elseif v:IsA("Sparkles") or v:IsA("Smoke") or v:IsA("ParticleEmitter") or v:IsA("Fire") then
			coroutine.resume(coroutine.create(function() --stop particles
				v.TimeScale = 0
				wait(script.Stop.Time.Value)
				v.TimeScale = 1
			end))
		elseif v:IsA("Sound") and v.IsPlaying and v.SoundId ~= "rbxassetid://5326246476" then
			coroutine.resume(coroutine.create(function() --stop sounds
				local originalSpeed = v.PlaybackSpeed
				local V_TI1 = TweenInfo.new(3,Enum.EasingStyle.Quint,Enum.EasingDirection.InOut,0,false)
				local V_TV1 = {
					PlaybackSpeed = 0,
				}
				local V_T1 = tweenService:Create(v, V_TI1, V_TV1)
				V_T1:Play()
				wait(script.Stop.Time.Value-1)
				local V_TI2 = TweenInfo.new(3,Enum.EasingStyle.Quint,Enum.EasingDirection.InOut,0,false)
				local V_TV2 = {
					--Volume = originalVolume,
					PlaybackSpeed = originalSpeed,
				}
				local V_T2 = tweenService:Create(v, V_TI2, V_TV2)
				V_T2:Play()
			end))
		end
	end
	wait(script.Stop.Time.Value-0.5)
	local resumeSound = Sounds.Resume:Clone()
	resumeSound.Parent = workspace
	resumeSound:Play()
	debris:AddItem(resumeSound,resumeSound.TimeLength+1)
	wait(0.5)
	timestop.Value = false
end)]]></ProtectedString>
