				<Properties>
					<ProtectedString name="Source"><![CDATA[local parent = script.Parent
local value = script.Time.Value

for i, v in pairs(parent:GetChildren()) do
	if v:IsA("Part") then
		v.Anchored = true
	end
end
wait(value)
for i, v in pairs(parent:GetChildren()) do
	if v:IsA("Part") then
		v.Anchored = false
	end
end
script:Destroy()]]></ProtectedString>
