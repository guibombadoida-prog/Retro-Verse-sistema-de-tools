		<Item class="Script" referent="RBX2FFACAFBCADD4662BD3F87A726AF26E1">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Handle = Tool:WaitForChild("Handle")
local RunService = game:GetService("RunService")
local Heartbeat = RunService.Heartbeat
local Players = (game:FindService("Players") or game:GetService("Players"))
local Character,Root,Player
local Debris = game:GetService("Debris")
local TweeenService = game:GetService("TweenService")
------------------------------
local UnwingRange = 150
local UnwingCooldown = 35
local CelestialProjectileCD = 1
------------------------------

Essentials = game.ServerStorage:FindFirstChild("CelestialStaffIntances") 
if script:FindFirstChild("CelestialStaffIntances") then
Folder = script:WaitForChild("CelestialStaffIntances",10)
Essentials = game.ServerStorage:FindFirstChild("CelestialStaffIntances") 
if not Essentials then
	Essentials = Folder:Clone()
	Essentials.Parent = game.ServerStorage
end
Folder.Parent = nil
end

local function SunIsVisible(Character)
	local dir = game:GetService("Lighting"):GetSunDirection()
	if Vector3.new(0,1,0):Dot(dir) > 0 then
		-- BUG: particles block raycast
		local hit = workspace:FindPartOnRay(Ray.new(Handle.Position,dir*999),Character)
		if not hit or (hit and not hit.CanCollide)then
			return true
		end
	end
	return false
end

local function MoonIsVisible(Character)
	local dir = game:GetService("Lighting"):GetMoonDirection()
	if Vector3.new(0,1,0):Dot(dir) > 0 then
		-- BUG: particles block raycast
		local hit = workspace:FindPartOnRay(Ray.new(Handle.Position,dir*999),Character)
		if not hit or (hit and not hit.CanCollide)then
			return true
		end
	end
	return false
end

------------------------------

local RigType

function SmoothWait(Number)
	Number = Number or 0
	repeat
		Number = Number - Heartbeat:Wait()
	until Number <= 0
end



function IsCharacterFlying(char) -- Chaos Wing Slasher Theif i am!
	local FlightClasses = {"BodyPosition","BodyThrust","BodyVelocity"}
	if char then
		for i,v in pairs(FlightClasses) do
			if char:FindFirstChildWhichIsA(v,true) then
				return true
			end
		end
	end
	return false
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	Debris:AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end


local Unwing = true
local Spotlight = true

local Boom = Essentials.Explosion


local BoomRing = Essentials.Ring


local SpotLightP = Essentials.SpotLight


local PhotonBoomModel = Essentials.ExplosionP


local PhotonModel = Essentials.Photon


local CeleCutterModel = Essentials.CeleCutter


local MoonBoomModel = Essentials.ExplosionM


local Holding = false

Tool.Equipped:Connect(function()
	Character = Tool.Parent
	Root = Character:WaitForChild("HumanoidRootPart",10)
	Player = game:GetService("Players"):GetPlayerFromCharacter(Character)
	if Character.Humanoid.RigType == Enum.HumanoidRigType.R6 then
		RigType = "R6"
	else
		RigType = "R15"
	end
	Holding = false
	Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Wave):Stop()
end)

Tool.Activated:Connect(function()
	if Tool.Enabled == true then
		Tool.Enabled = false
		Handle.Cast:Play()
		if SunIsVisible(Character) then
			print("Held")
			Holding = true
			local Times = {
				.1,
				.15,
				.2,
				.25,
				.3,
				.35,
				.4,
				.45,
				.5
			}
			local CooldownTime = Times[math.random(1,#Times)]
			
			
			while Holding == true do
				wait(CooldownTime)
				local Photon = PhotonModel:Clone()
				Photon.Parent = workspace
				local MousePos = Tool.DirectionInvoker:InvokeClient(Player).Position + Vector3.new(math.random(-25,25),50,math.random(-25,25))
				PhotonModel.CFrame = (CFrame.new(MousePos, (Tool.DirectionInvoker:InvokeClient(Player).Position))) * CFrame.Angles(math.rad(90),math.rad(0),math.rad(0))
				local BodyVelocity = Instance.new("BodyVelocity")
				BodyVelocity.Parent = Photon
				BodyVelocity.MaxForce = Vector3.new(1,1,1)*math.huge
				BodyVelocity.P = 1000000
				BodyVelocity.Velocity = (Photon.Position - Tool.DirectionInvoker:InvokeClient(Player).Position).Unit * -65
				local PhotonScript = script.Photon:Clone()
				PhotonScript.Parent = Photon
				PhotonScript.Character.Value = Character
				PhotonScript.Tool.Value = Tool
				PhotonScript.Disabled = false
				Debris:AddItem(Photon,10)
			end
			Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Wave):Stop()
		elseif MoonIsVisible(Character) then
			Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].RightSlash):Play()
			SmoothWait(.5)
			local CeleCutter = CeleCutterModel:Clone()
			CeleCutter.Parent = workspace
			CeleCutter.Position = (Root.Position + ((Root.CFrame.lookVector) * 5))
			CeleCutter.Orientation = Root.Orientation +  Vector3.new(0,135,0)
			local Info = TweenInfo.new(
				2.1, -- Time
				Enum.EasingStyle.Quad, -- EasingStyle
				Enum.EasingDirection.Out, -- EasingDirection
				0, -- RepeatCount (when less than zero the tween will loop indefinitely)
				false, -- Reverses (tween will reverse once reaching it's goal)
				0 -- DelayTime
			)
			local Properties = {
				Position = (Root.Position + (Root.CFrame.lookVector * (200)))
			}

			local tween = TweeenService:Create(CeleCutter,Info,Properties)
			tween:Play()
			local SlashScript = script.CelestialCutter:Clone()
			SlashScript.Parent = CeleCutter
			SlashScript.Character.Value = Character
			SlashScript.Tool.Value = Tool
			SlashScript.Disabled = false
		end
	end
end)
local Deactivated = true
Tool.Deactivated:Connect(function()
	if Deactivated == true then
		if SunIsVisible(Character) then
			Handle.UnCast:Play()
		end
		Deactivated = false
		Holding = false
		Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Wave):Stop()
		wait(3.5)
		Tool.Enabled = true
		Deactivated = true
	end
end)

Tool.Unequipped:Connect(function()
	Holding = false
	Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Wave):Stop()
end)

Tool.Event.OnServerEvent:Connect(function(Client,KeyCode) --Registers ability
	if not KeyCode then return end
	if KeyCode == Enum.KeyCode.Q and Spotlight == true and Tool.Enabled == true  then
		Spotlight = false
		Tool.Enabled = false
		delay(3,function()
			Tool.Enabled = true
			SmoothWait(12)
			Spotlight = true
		end)
		Handle.Cast:Play()
		Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Summon):Play()
		Character.Humanoid.WalkSpeed = 0
		Root.Anchored = true
		local CelestialLight = SpotLightP:Clone()
		CelestialLight.Parent = workspace
		CelestialLight.Position = Root.Position + Vector3.new(0,25,0)
		CelestialLight.Light.Disabled = false
		Handle.ChargeReady:Play()
		Handle.TimeSound:Play()
		local Info = TweenInfo.new(
			5, -- Time
			Enum.EasingStyle.Exponential, -- EasingStyle
			Enum.EasingDirection.InOut, -- EasingDirection
			0, -- RepeatCount (when less than zero the tween will loop indefinitely)
			false, -- Reverses (tween will reverse once reaching it's goal)
			0 -- DelayTime
		)
		local Properties
		if SunIsVisible(Character) then
			Properties = {
				ClockTime = 19,
			}
		elseif MoonIsVisible(Character) then
			Properties = {
				ClockTime = 7,
			}
		end
		local tween = TweeenService:Create(game.Lighting,Info,Properties)
		tween:Play()
		SmoothWait(5)
		Character.Humanoid.WalkSpeed = 16
		Root.Anchored = false

	elseif KeyCode == Enum.KeyCode.E and Unwing == true and Tool.Enabled == true then
		Unwing = false
		Tool.Enabled = false
		delay(5,function()
			Tool.Enabled = true
			SmoothWait(35)
			Unwing = true
		end)
		Handle.Cast:Play()
		Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Summon):Play()
		Character.Humanoid.Animator:LoadAnimation(script.Instances.Animations[(tostring(RigType)).."Animations"].Summon):AdjustSpeed(.4)
		wait(.1)
		local Pulse = Boom:Clone()
		Pulse.Parent = workspace
		Pulse.Position = Root.Position - Vector3.new(0,2.5,0)
		local BlastRing = BoomRing:Clone()
		BlastRing.Parent = workspace
		BlastRing.Position = Root.Position - Vector3.new(0,2.5,0)
		Pulse.ExplsoionTween.Disabled = false
		BlastRing.RingTween.Disabled = false
		wait(.25)
		for i,v in pairs(game.workspace:GetDescendants()) do
			if v and v:FindFirstChildOfClass("Humanoid") and v ~= Character then
				local ECharacter = v
				local ERoot = (ECharacter:FindFirstChild("HumanoidRootPart"))
				local EnemyHumanoid = ECharacter:FindFirstChildOfClass("Humanoid")
				if ERoot and (ERoot.CFrame.p-Root.CFrame.p).magnitude<=UnwingRange then
					if IsCharacterFlying(ECharacter) and not ECharacter:FindFirstChildOfClass("ForceField") then
						if IsTeamMate(Player,game:GetService("Players"):GetPlayerFromCharacter(EnemyHumanoid.Parent)) then return end
						local BoomCore = Essentials.Particles.Core:Clone()
						BoomCore.Parent = ERoot
						BoomCore:Emit(1)
						Debris:AddItem(BoomCore,4)
						local DebrisP = Essentials.Particles.Debris:Clone()
						DebrisP.Parent = ERoot
						DebrisP:Emit(75)
						Debris:AddItem(DebrisP,5)
						for i,v in pairs(ECharacter:GetDescendants()) do
							if v:IsA("BodyMover") then
								v:Destroy()
							end
						end
						local BodyVelocity = Instance.new("BodyVelocity")
						BodyVelocity.Parent = ERoot
						BodyVelocity.MaxForce = Vector3.new(1,1,1)*math.huge
						BodyVelocity.Velocity = Vector3.new(math.random(-30,30),math.random(0,30),math.random(-30,30))
						Debris:AddItem(BodyVelocity,.5)
						EnemyHumanoid.PlatformStand = false
						EnemyHumanoid.Sit = true
						local Gear = ECharacter:FindFirstChildOfClass("Tool")
						if Gear then --Knock the gear straight out of their hand!
							local Handle = Gear:FindFirstChild("Handle")
							if Handle then
								local Direction = Vector3.new(math.random(-1,1),math.random(0,1),math.random(-1,1))
								local Speed = math.random(30,50)
								Gear.Parent = workspace
								Handle.CFrame = CFrame.new(Handle.Position + Direction * 3) * (Handle.CFrame-Handle.CFrame.Position)
								Handle.Velocity = Direction * Speed
							end
						end
						local BoomS = Essentials.Effect:Clone()
						BoomS.Parent = ERoot
						BoomS:Play()
						BoomS.TimePosition = .75
						Debris:AddItem(BoomS,3)
					elseif ECharacter:FindFirstChildOfClass("ForceField") and not IsCharacterFlying(ECharacter) then
						local FF = ECharacter:FindFirstChildOfClass("ForceField")
						FF:Destroy()
						local Shatter = Essentials.Particles.Shatter:Clone()
						Shatter.Parent = ERoot
						Shatter:Emit(75)
						Debris:AddItem(Shatter,5)
						local ShatterSound = Essentials.Break:Clone()
						ShatterSound.Parent = ERoot
						ShatterSound:Play()
						Debris:AddItem(ShatterSound,5)
					elseif IsCharacterFlying(ECharacter) and ECharacter:FindFirstChildOfClass("ForceField") then
						local FF = ECharacter:FindFirstChildOfClass("ForceField")
						FF:Destroy()
						local Shatter = Essentials.Particles.Shatter:Clone()
						Shatter.Parent = ERoot
						Shatter:Emit(75)
						Debris:AddItem(Shatter,5)
						local ShatterSound = Essentials.Break:Clone()
						ShatterSound.Parent = ERoot
						ShatterSound:Play()
						Debris:AddItem(ShatterSound,5)
					end
				end
			end
		end
	end
end)]]></ProtectedString>
