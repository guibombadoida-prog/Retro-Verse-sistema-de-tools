					<Item class="Script" referent="RBX4DEA08B8362C40769884A6DFB84835E0">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local Photon1 = script.Parent.Photon
Photon1.Parent = nil



for i = 1,5 do
	local Photon = Photon1:Clone()
	Photon.Parent = workspace
	Photon:SetNetworkOwner(nil)
	Photon.CFrame = script.Parent.CFrame
	local FloatForce = Instance.new("BodyForce")
	FloatForce.Force = Vector3.new(0,workspace.Gravity*Photon:GetMass(),0)
	FloatForce.Parent = Photon
	Photon.Velocity = Vector3.new(math.random(-75,75),math.random(-75,75),math.random(-75,75))
	game:GetService("Debris"):AddItem(Photon,5)
end]]></ProtectedString>
