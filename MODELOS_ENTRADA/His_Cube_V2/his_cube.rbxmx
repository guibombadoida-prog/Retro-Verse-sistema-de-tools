	ShootDamage      = 25,
	ShootBeamRadius  = 6,
	ShootCooldown    = 3,
	-- Nuke (Q)
	NukeMaxDamage    = 60,
	NukeRadius       = 35,
	NukeKnockback    = 65,
	NukeCooldown     = 25,
	NukeChargeTime   = 4,
	-- Sala do Abismo (E) - NOVO V4
	AbyssBoxSize     = 50,
	AbyssDuration    = 8,
	AbyssDPS         = 5,
	AbyssCooldown    = 30,
	-- Animação
	AnimLerpSpeed    = 0.2,
	-- NPC
	NPCDetectRange   = 60,
	NPCShootInterval = 4,
	NPCNukeInterval  = 30,
}

