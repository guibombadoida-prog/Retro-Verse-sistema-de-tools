			<Item class="ModuleScript" referent="RBX48071EA8E3D4455AAF500A35FA3142CC">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")


local Seed = Random.new(os.clock()*10^6)

return function(Position, Amount, Size, Lasting, UpperVelocity, SideVelocity, Particles, CanCollide, Gravity)
	
	Position = Position or Vector3.new(0,10,0);
	Amount = Amount or 3;
	Size = Size or 3;
	Lasting = Lasting or 3
	UpperVelocity = UpperVelocity or 50;
	SideVelocity = SideVelocity or 35;
	Particles = Particles or {}
	
	CanCollide = CanCollide or false
	Gravity = Gravity or 0
	
	if #Particles <= 0 then
		warn("Particles do not exist, or are located in serverstorage or serverscriptservice (required to be accessed by the client)")
		return
	end
	
	
	local Ignore = {}
	for i,v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") then
			table.insert(Ignore,v.Parent)
		elseif v:IsA("BasePart") and (v.CanCollide == false or v.Transparency ~= 0) then
			table.insert(Ignore,v)
		end
	end
	
	local Params = RaycastParams.new();Params.FilterDescendantsInstances = Ignore;Params.IgnoreWater = true


	local RayC = workspace:Raycast(Position + Vector3.new(0,1,0),Vector3.new(0,-16,0),Params)
	
	if RayC then
		for i = 1,Amount do
			
			local ClonedParticles = {}

			for i,v in pairs(Particles) do
				if v then
					ClonedParticles[#ClonedParticles + 1] = v:Clone()
				end
			end
			
			local NewC = (CFrame.new(Position + Vector3.new(0,Size * 1.2,0)) * CFrame.Angles(0,i*math.rad(360/Amount),math.rad(90))) * CFrame.new(0,Size * 1.2,0)
			
			
			
			local CraterSegment = Instance.new("Part")
			CraterSegment.Shape = Enum.PartType.Ball;
			CraterSegment.Color = RayC.Instance.Color
			CraterSegment.Material = RayC.Instance.Material
			CraterSegment.Anchored = false
			CraterSegment.CanCollide = CanCollide;
			CraterSegment.CanTouch = false;
			CraterSegment.CanQuery = false;
			CraterSegment.Transparency = 0
			CraterSegment.TopSurface = Enum.SurfaceType.Smooth
			CraterSegment.BottomSurface = Enum.SurfaceType.Smooth
			CraterSegment.Size = Vector3.new(1,1,1) * Seed:NextNumber(Size * 0.8,Size * 1.2)
			CraterSegment.CFrame = NewC
			
			
			for i,v in pairs(ClonedParticles) do
				if v then
					v.Parent = CraterSegment
					v.Enabled = true;
				end
			end
			
			if Gravity and Gravity > 0 then
				
				Instance.new("BodyForce",CraterSegment).Force = Vector3.new(0,(workspace.Gravity * CraterSegment:GetMass()) * Gravity,0)
				
			end
			
			CraterSegment.Parent = workspace
			CraterSegment.AssemblyLinearVelocity = Vector3.new(Seed:NextNumber(-SideVelocity,SideVelocity),Seed:NextNumber(UpperVelocity * 0.8,UpperVelocity * 1.2),Seed:NextNumber(-SideVelocity,SideVelocity))
			CraterSegment.AssemblyAngularVelocity =  Vector3.new(Seed:NextNumber(-SideVelocity,SideVelocity),Seed:NextNumber(UpperVelocity * 0.8,UpperVelocity * 1.2),Seed:NextNumber(-SideVelocity,SideVelocity))
			
			Debris:AddItem(CraterSegment,Lasting + 5)
			
			task.delay(Lasting,function()
				for i,v in pairs(ClonedParticles) do
					if v then
						v.Enabled = false;
					end
				end
				CraterSegment.Anchored = true;
				
			end)
			
			
			
		end
		
	end
	
	
end]]></ProtectedString>
					<string name="ScriptGuid">{69DB6B31-737F-40FA-AA7B-2D5E24BB786F}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
					<bool name="DefinesCapabilities">true</bool>
					<string name="Name">Particle_Debris</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXCB6E2B80FCEE40D7B3FF9DE3D56520D6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")


return function(CF, Size, Lasting, Color)
	
	CF = CF or CFrame.new()
	Size = Size or 10;
	Lasting = Lasting or 4;
	Color = Color or Color3.fromRGB(255, 255, 255)
	
	
	local Terrain = workspace:FindFirstChild("Terrain")
	local Attachment = Instance.new("Attachment")
	Attachment.WorldCFrame = CF;
	
	local Crack = script.Crack:Clone()
	Crack.Color = ColorSequence.new(Color)
	Crack.Size = NumberSequence.new(Size);
	Crack.Lifetime = NumberRange.new(Lasting);
	
	Crack.Parent = Attachment;
	Attachment.Parent = Terrain;
	Crack:Emit(1)
	
	Debris:AddItem(Attachment,Lasting + 5);
	
	
	
end]]></ProtectedString>
