	<Item class="ModuleScript" referent="RBXAFB467B916DD4808919E680181CE71F3">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")

return function(Object,TweenTable,Params)
	
	if not Object then
		return
	end
	
	TweenTable = TweenTable or {}
	Params = Params or {}
	
	TweenTable[1] = TweenTable[1] or 0;
	TweenTable[2] = TweenTable[2] or Enum.EasingStyle.Linear;
	TweenTable[3] = TweenTable[3] or Enum.EasingDirection.Out;
	TweenTable[4] = TweenTable[4] or 0;
	TweenTable[5] = TweenTable[5] or false;
	TweenTable[6] = TweenTable[6] or 0;
	
	local Info = TweenInfo.new(
		TweenTable[1],
		TweenTable[2],
		TweenTable[3],
		TweenTable[4],
		TweenTable[5],
		TweenTable[6]
	)
	
	TweenService:Create(Object,Info,Params):Play()
	
end]]></ProtectedString>
			<string name="ScriptGuid">{FB99842A-88C1-4AD2-BAF3-D52E69EF5837}</string>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
			<bool name="DefinesCapabilities">true</bool>
			<string name="Name">Tween</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
	</Item>
	<Item class="ModuleScript" referent="RBX66F9CF5B99B44D9C9C252AD2BF9A894B">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[local RunService = (game:FindService("RunService") or game:GetService("RunService"));
local Debris = (game:FindService("Debris") or game:GetService("Debris"));

local Seed = Random.new(os.clock()*10^6)

local Slash_Model = Instance.new("Model");

do

	local Center = Instance.new("Part");
	Center.CastShadow = false;
	Center.Anchored = true;
	Center.CanCollide = false;
	Center.Size = Vector3.new(0, 0, 0);
	Center.Name = "1";
	Center.Material = Enum.Material.Neon;
	Center.Transparency = 1;
	Center.Massless = true;
	Center.Locked = true;
	Center.Parent = Slash_Model

	local Trail_Mesh = Instance.new("SpecialMesh");
	Trail_Mesh.MeshType = Enum.MeshType.FileMesh;
	Trail_Mesh.MeshId = "rbxassetid://3188638000";
	Trail_Mesh.Offset = Vector3.new(0, 0, 0);
	Trail_Mesh.TextureId = "";
	Trail_Mesh.Name = "Trail_Mesh";
	Trail_Mesh.Parent = Center;

	local Slash_Decal = Instance.new("Decal");
	Slash_Decal.Name = "Slash_Decal";
	Slash_Decal.Texture = "rbxassetid://3145429800"
	Slash_Decal.Color3 = Color3.new(1, 1, 1);
	Slash_Decal.Face = Enum.NormalId.Front;
	Slash_Decal.Transparency = 0;
	Slash_Decal.Parent = Center;

	Center = Center:Clone();
	Center.Name = "2";
	Center.Parent = Slash_Model;

	Slash_Model.Name = "Slash_Model";
	--Slash_Model.PrimaryPart = Center;
end

return function(Part: Instance, Start_Width: number, End_Width: number, Height: number, Duration: number, Rotation_Speed: number, Accent_Color)

	local Slash = Slash_Model:Clone();
	--Debris:AddItem(Slash, Duration + 1);

	task.delay(Duration + 1, function()
		Slash:Destroy();
	end)

	Slash:PivotTo(CFrame.lookAt(Part.Position, Part.Position + Part.AssemblyLinearVelocity) * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, Seed:NextNumber(0, math.pi), 0));

	local Slash_1 = Slash["1"];
	local Slash_2 = Slash["2"];

	do
		local Mesh = Slash_1.Trail_Mesh;
		local Decal = Slash_1.Slash_Decal;

		local Color = Accent_Color:Lerp(Color3.new(1, 1, 1), .25);
		Color = Color3.new(Color.R * 10, Color.G * 10, Color.B * 10);

		Decal.Color3 = Color;
		Mesh.Scale = Vector3.new(Start_Width, Height, Start_Width);

		Mesh = Slash_2.Trail_Mesh;
		Decal = Slash_2.Slash_Decal;

		Decal.Color3 = Color;
		Mesh.Scale = Vector3.new(Start_Width, Height, Start_Width);
	end

	Slash.Parent = (RunService:IsClient() and workspace.CurrentCamera) or workspace;

	local current_duration = 0;

	--print("SLASH TRAIL");

	while current_duration < Duration and Part do

		local Delta = task.wait(0);

		local Alpha = math.clamp(current_duration / Duration, 0, 1);

		--local Angle = Vector2.new(Pitch_Start, Pitch_Start):Lerp(Vector2.new(Pitch_End, Pitch_End), Alpha).X

		local Width_Alpha = Vector2.new(Start_Width, Start_Width):Lerp(Vector2.new(End_Width, End_Width), Alpha).X;

		Slash:PivotTo(Slash:GetPivot() * CFrame.Angles(0, Rotation_Speed * Delta, 0));
		Slash_1.Slash_Decal.Transparency = Alpha;
		Slash_2.Slash_Decal.Transparency = Alpha;

		local Mesh = Slash_1.Trail_Mesh;
		Mesh.Scale = Vector3.new(Width_Alpha, Height, Width_Alpha);

		Mesh = Slash_2.Trail_Mesh;
		Mesh.Scale = Vector3.new(Width_Alpha, Height, Width_Alpha);

		current_duration += Delta;
	end

	Slash_1.Slash_Decal.Transparency = 1;
	Slash_2.Slash_Decal.Transparency = 1;
end
]]></ProtectedString>
			<string name="ScriptGuid">{3F67F79C-BF68-4F8B-8C53-6FB852D64D93}</string>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
			<bool name="DefinesCapabilities">true</bool>
			<string name="Name">Wind_Effect</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
	</Item>
	<Item class="ModuleScript" referent="RBXFCB6479700AE49C99859F617E73DA519">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[local Run = game:GetService("RunService")
local Debris = game:GetService("Debris")

return function(Reference, Color_A, Color_B, Size_A, Size_B, Duration, Spin)
	
	
	Reference = Reference or CFrame.new();
	Color_A = Color_A or Color3.new(1,1,1);
	Color_B = Color_B or Color_A;
	Size_A = Size_A or Vector3.new();
	Size_B = Size_B or Vector3.new(0.4,0.2,0.4) * 30;
	


	local windEffect = Instance.new("Part")
	windEffect.CastShadow = false
	windEffect.Massless = true;
	windEffect.CanCollide = false
	windEffect.Color = Color_A
	windEffect.Size = Vector3.new(0,0,0)
	windEffect.Parent = workspace.CurrentCamera

	Debris:AddItem(windEffect,1)
	
	local windWeld;
	local windMesh = Instance.new("SpecialMesh")
	windMesh.MeshId = "http://www.roblox.com/asset/?id=1051557"
	windMesh.Scale = Vector3.new(7,4,7)
	windMesh.Parent = windEffect
	
	if typeof(Reference) == "Instance" and Reference:IsA("Part") then
		windWeld = Instance.new("Weld")
		windWeld.Part0 = Reference
		windWeld.Part1 = windEffect
		windWeld.C0 = CFrame.new(Vector3.new(0,0,0)) * CFrame.Angles(0,math.random(-300,300),0)
		windWeld.Parent = windEffect
	else
		windEffect.Anchored = true
		windEffect.CFrame = Reference
	end

	local T = 0
	
	local function Lerp(a,b,t)
		return (a + ((b-a) * t))
	end
	
	repeat

		local Delta_1 = Run.Heartbeat:Wait()
		local Delta =  Delta_1/Duration
		
		T += Delta
		
		windMesh.Scale = Size_A:Lerp(Size_B,T * Duration)
		
		if windWeld then
			windWeld.C0 = windWeld.C0 * CFrame.Angles(0,math.rad(Spin * Delta_1),0)
		else
			windEffect.CFrame *= CFrame.Angles(0,math.rad(Spin * Delta_1),0)
		end
		
		windEffect.Transparency = Lerp(0,1,T* Duration)
		
		windEffect.Color = Color_A:Lerp(Color_B,T * Duration)
		
	until not windEffect or not windEffect.Parent or windEffect.Transparency >= 1
	
	windEffect:Destroy()
	script:Destroy()

	
end]]></ProtectedString>
