					<Item class="LocalScript" referent="RBXB9F540E735684746B5760EFBC40126F0">
						<Properties>
							<ProtectedString name="Source">local s1 = "My heart resonates..."
local s2 = "Heat enough to burn..."
local s3 = "Sunlight Yellow Overdrive!"
local s4 = "My blood's beat is razor sharp!"
spawn(function()
	spawn(function()
		for i = 1,string.len(s1) do
			script.Parent.TextLabel.Text = string.sub(s1,1,i)
			task.wait(.01)
		end
	end)
	for i = 1,string.len(s1) do
		task.wait(.05)
	end
	task.wait(0.55)
	script.Parent.TextLabel.Text = ""
	task.wait(0.35)
	spawn(function()
		for i = 1,string.len(s2) do
			script.Parent.TextLabel.Text = string.sub(s2,1,i)
			task.wait(.01)
		end
	end)
	for i = 1,string.len(s2) do
		task.wait(.05)
	end
	task.wait(0.55)
	script.Parent.TextLabel.Text = ""
	task.wait(.5)
	spawn(function()
		for i = 1,string.len(s4) do
			script.Parent.TextLabel.Text = string.sub(s4,1,i)
			task.wait(.01)
		end
	end)
	for i = 1,string.len(s4) do
		task.wait(.05)
	end
	task.wait(0.55)
	script.Parent.TextLabel.Text = ""
end)
task.wait(3.591+2.5+1.5)
spawn(function()
	for i = 1,string.len(s3) do
		script.Parent.TextLabel.Text = string.sub(s3,1,i)
		task.wait(.01)
	end
end)
for i = 1,string.len(s3) do
	task.wait(.05)
end
task.wait(4)
script.Parent.TextLabel.Text = ""
script.RemoteEvent2:FireServer()</ProtectedString>
