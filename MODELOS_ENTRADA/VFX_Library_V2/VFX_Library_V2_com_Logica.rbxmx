						<Properties>
							<ProtectedString name="Source">local cam = workspace.CurrentCamera
---
local col = Instance.new("ColorCorrectionEffect",cam)
col.Brightness = 25
game:GetService("Debris"):AddItem(col,0.1)
task.wait(0.05)
col.Brightness = -25
task.wait(0.05)
script:WaitForChild('RemoteEvent',15):FireServer()</ProtectedString>
