								<Properties>
									<ProtectedString name="Source">--Ty roblox
wait()
repeat wait() until script.Parent == game.Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
script.Parent = game.Players.LocalPlayer.PlayerScripts
--
local KeyframeAnimation = script.Animation.Value
local rig = script.Target.Value
local origin = script.Origin.Value
local speed = origin.Speed.Value

local keyframeList = KeyframeAnimation:GetChildren()

local KFNumber = 1
local maxKFNumber = #keyframeList

local basePositions = {}
local lastPositions = {}
local desiredPositions = {}

--FUNCTIONS

local function getJointBetween(part0, part1)
	for _, obj in pairs(part1:GetChildren()) do
		if obj:IsA("Motor6D") and obj.Part0 == part0 then
			return obj
		end
	end
	for _, obj in pairs(part0:GetChildren()) do
		if obj:IsA("Motor6D") and obj.Part1 == part1 then
			return obj
		end
	end
end

local function UpdatePositions()

	local targetKF = keyframeList[KFNumber]

	local function RecursivelyUpdatePositions(parentPose, poseObject)
		if parentPose then
			if rig:FindFirstChild(parentPose.Name) and rig:FindFirstChild(poseObject.Name) then
				local joint = getJointBetween(rig[parentPose.Name], rig[poseObject.Name])
				if joint then

					--A keyframe Joint was found, proceed with schedulation
					lastPositions[joint] = joint.Transform
					desiredPositions[joint] = poseObject.CFrame
					--

				end
			end
		end

		pcall(function()
			for _, subPose in pairs(poseObject:GetSubPoses()) do
				RecursivelyUpdatePositions(poseObject, subPose)
			end
		end)

	end

	timeNeeded = 0.7

	pcall(function()
		for _, poseObj in pairs(targetKF:GetPoses()) do
			RecursivelyUpdatePositions(nil, poseObj)
		end
	end)

end

local function ResetJoints()
	for i, v in pairs(basePositions) do
		i.Transform = CFrame.new()
	end
end
--

local StopEvent = script:WaitForChild('Remote',10).Value
--CODE RUN
t = 0
timeNeeded = 0

local ended = false

UpdatePositions()

spawn(function()
	local TARGET_FRAMERATE = 65
	while true do
		if ended == false then
			game:GetService("RunService").RenderStepped:Wait()
			local t0 = tick()
			game:GetService("RunService").Heartbeat:Wait()
			repeat until t0 + 1/TARGET_FRAMERATE &lt; tick() or ended == true
		else
			break
		end
	end
end)

local AnimatingBind = game["Run Service"].Stepped:Connect(function(totalTime, step)

	t = t + (step * speed)
	local alpha
	if timeNeeded == 0 then
		alpha = 1
	else
		alpha = math.min(1, t / math.max(1,1))
	end


	for limb, position in pairs(desiredPositions) do
		limb.Transform = lastPositions[limb]:lerp(desiredPositions[limb], alpha)
		if alpha == 1 then
			lastPositions[limb] = desiredPositions[limb]
		end
	end

	if alpha == 1 then
		KFNumber = KFNumber + 1
		if KFNumber &gt; maxKFNumber then
			if KeyframeAnimation.Loop then
				--ResetJoints()
				KFNumber = 1
			else
				ResetJoints()
				script:Destroy()
				ended = true
			end
		end

		UpdatePositions()
		t = 0
	end

end)
--

if StopEvent then
	StopEvent.OnClientEvent:Connect(function()
		ResetJoints()
		ResetJoints()
		ResetJoints()
		ended = true
		for index, descendant in pairs(script.Target.Value:GetDescendants()) do
		end
		wait(.01)
		script:Destroy()
	end)
end</ProtectedString>
