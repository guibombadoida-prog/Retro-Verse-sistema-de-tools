				<Item class="LocalScript" referent="RBX64E9F2B9263B4F1B8E14CA138A3D49C4">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local players = game:GetService("Players")
local plr = players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local remote = tool:WaitForChild('RemoteFunction',15)
local UIS = game:GetService('UserInputService')
local humanoid = char:WaitForChild('Humanoid',15) or char:FindFirstChildOfClass("Humanoid")
--
remote.OnClientInvoke = function(type)
	if type == "mouse" then
		return plr:GetMouse().Hit.Position
	elseif type == "state" then
		if humanoid:GetState() == Enum.HumanoidStateType.FallingDown or humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
			return true
		else
			return false
		end
	end
end</ProtectedString>
