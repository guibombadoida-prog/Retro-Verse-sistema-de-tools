	end)
	task.wait(0.8-.45)
	claw.Trail.Enabled = false
	claw.Trail2.Enabled = false
	claw.Trail3.Enabled = false
	game.TweenService:Create(claw.LeftClaw:FindFirstChildOfClass("SpecialMesh"),TweenInfo.new(0.2),{Scale = Vector3.new(0, 1.431, 0)}):Play()
	task.wait(.2)
	claw:Destroy()
	char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
	char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
