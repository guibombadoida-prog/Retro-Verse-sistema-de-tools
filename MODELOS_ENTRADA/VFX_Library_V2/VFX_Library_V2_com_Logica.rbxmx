			local ran2 = math.random(-2,2)
			local ran3 = math.random(-2,2)
			local a0 = Instance.new("Attachment",char['HumanoidRootPart'])
			local a1 = Instance.new("Attachment",char['HumanoidRootPart'])
			a1.Position = Vector3.new(ran1,ran2,ran3)
			pcall(function()
				require(script.Lightning).Lightning(a0.WorldPosition,a1.WorldPosition,true,3,1,Color3.fromRGB(128, 187, 219),1,0.15)
			end)
			game.Debris:AddItem(a1,0.05)
			game.Debris:AddItem(a0,0.05)
			task.wait(.05)
		end
		for i,v in pairs(aura)do
			v:Destroy()
		end
	end)
	task.wait(1.41)
	local sound = Instance.new("Sound",char.HumanoidRootPart)
