								<Properties>
									<ProtectedString name="Source">local thing = script.Parent
local modules = thing:WaitForChild('Modules')
local rockmodule = require(modules:WaitForChild('RockModule2'))
local debrismodule = require(modules:WaitForChild('DebrisModule'))
local char = thing:WaitForChild('Value').Value
spawn(function()
	debrismodule.Rocks(thing:WaitForChild('dang').Position,1,Vector3.new(0,-15,0),true,false,-180,180,20,30,.5,1,4.5,false)
	task.wait(0.02)
	debrismodule.Rocks(thing:WaitForChild('dang2').Position,1,Vector3.new(0,-15,0),true,false,-180,180,20,30,.5,1,4.5,false)
	task.wait(0.02)
	debrismodule.Rocks(thing:WaitForChild('dang3').Position,1,Vector3.new(0,-15,0),true,false,-180,180,20,30,.5,1,4.5,false)
end)
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Blacklist
params.FilterDescendantsInstances = {thing,char}
spawn(function()
	for i = 0,18 do
		if thing:WaitForChild('rockparts'):FindFirstChild(i) then
			local v = thing:WaitForChild('rockparts'):FindFirstChild(i)
			rockmodule.Ground(v.Position,5,v.Size,false,5,params)
		end
		if thing:WaitForChild('rockparts2'):FindFirstChild(i) then
			local v = thing:WaitForChild('rockparts2'):FindFirstChild(i)
			rockmodule.Ground(v.Position,5,v.Size,false,5,params)
		end
		task.wait()
	end
end)
game:GetService("Debris"):AddItem(thing,5)</ProtectedString>
