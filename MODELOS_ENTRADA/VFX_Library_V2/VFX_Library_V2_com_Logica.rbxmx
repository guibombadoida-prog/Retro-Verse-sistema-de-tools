					<Item class="Script" referent="RBX3B3F60234030477D9DECFBA353564633">
						<Properties>
							<ProtectedString name="Source">local thing = script.Parent
local modules = thing:WaitForChild('Modules')
local rockmodule = require(modules:WaitForChild('RocksModule'))
local debrismodule = require(modules:WaitForChild('DebrisModule'))
for i,v in pairs(thing:WaitForChild('idk4'):GetDescendants())do
	if v:IsA("ParticleEmitter") then
		v:Emit(v:GetAttribute('EmitCount'))
	end
end
local currentpos = Vector3.new(0,0,0)
for i,v in pairs(thing:WaitForChild('Root').WindBack:GetDescendants())do
	if v:IsA("ParticleEmitter") then
		v:Emit(v:GetAttribute('EmitCount'))
	end
end
for i = 1,11 do
	spawn(function()
		local cf = thing:FindFirstChild('r'..i).CFrame
		local size = 1
		for i = 1,255 do
			rockmodule.Ground(cf.Position,20,Vector3.new(size,size,size),false,14)
			if i &lt; 25 then
				size = size + 0.5
			else
				size = size + 8.5
			end
			cf = cf*CFrame.new(0,0,-size/Random.new():NextNumber(1.5,2))
		end
	end)
end
spawn(function()
	task.wait(0.2)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {thing}
	for i = 0,math.abs(2048/21) do
		if thing:FindFirstChild('Root') then
			currentpos = currentpos - Vector3.new(0,0,21)
			local attach = Instance.new("Attachment",thing:FindFirstChild('Root'))
			attach.Position = currentpos
			game:GetService("Debris"):AddItem(attach,1.65)
			local ray = workspace:Raycast(attach.WorldPosition,Vector3.new(0,-15,0),params)
			if ray then
				local emitter = script:WaitForChild('Push'):Clone()
				emitter.Parent = attach
				emitter:Emit(35)
				if i &lt; 35 and i &gt; 5 then
					for z = 1,5 do
						debrismodule.Rocks((attach.WorldCFrame*CFrame.new(math.random(-220,220),0,0)).Position,1,Vector3.new(0,-15,0),true,false,-180,180,250,400,10,20,10)
					end
				end
				if i &lt;= 5 then
					for z = 1,8 do
						debrismodule.Rocks((attach.WorldCFrame*CFrame.new(math.random(-25,25),0,0)).Position,1,Vector3.new(0,-15,0),true,false,-180,180,100,150,2,3,10)
					end
				end
			end
		end
	end
end)
game:GetService("Debris"):AddItem(thing,15)</ProtectedString>
