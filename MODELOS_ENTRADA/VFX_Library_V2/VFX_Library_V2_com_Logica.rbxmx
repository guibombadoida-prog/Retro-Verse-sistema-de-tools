					</Properties>
				</Item>
				</Item>
<Item class="Folder" referent="RBX1D1694A53DAC4430856E764DF44226DD">
				<Properties>
					<string name="Name">Ignition Burst</string>
					</Properties>
				<Item class="Script" referent="RBXAFDB449487C94651ADA63C09C6A4E8FC">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local char = nil
local cd = false
local debris = game:GetService("Debris")
local owner = tool:WaitForChild('owner')
local players = game:GetService("Players")
local animation = require(script:WaitForChild('Animation'))
local assets = script:WaitForChild('Assets'):Clone()
script:WaitForChild('Assets'):Destroy()
local effectsfolder = workspace:FindFirstChildOfClass("Terrain") or workspace
local ragdollmodule = require(script:WaitForChild('Ragdoll'))
local rockmodule2 = require(script:WaitForChild('RockModule2'))
local debrismodule = require(script:WaitForChild('DebrisModule'))
local rockmodule = require(script:WaitForChild('RockModule'))
local StopRemote = script:WaitForChild('StopRemote')
local Remote = tool:WaitForChild('RemoteFunction')
local usable = false
local gyro = nil
local velo2 = nil
local oldws = 16
local oldjp = 50
local deb = nil
local iframe = nil
local ended = false
local ended2 = false
local at1 = nil
local at2 = nil
---functions---
getnearobjects = function(pos,range,ignore)
	range = range or 12
	ignore = ignore or char
	local objects = {}
	for i,v in pairs(workspace:GetDescendants())do
		if v:IsA("Model") and v ~= char and v ~= ignore then
			if v:FindFirstChildOfClass("Humanoid") then
				if v.PrimaryPart then
					if (v.PrimaryPart.Position-pos).Magnitude &lt; range then
						table.insert(objects,v)
					end
				end
			end
		end
	end
	---
	return objects
end
smoke = function(pos,lifetime,size,speedmin,speedmax,emit)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {effectsfolder,char} or {effectsfolder}
	local result = workspace:Raycast(pos+Vector3.new(0,1.5,0),Vector3.new(0,-15,0),params)
	if result then
		local attach = Instance.new("Attachment",effectsfolder)
		attach.WorldPosition = result.Position+Vector3.new(0,0.5,0)
		local downsmoke = assets:WaitForChild('Smoke'):Clone()
		downsmoke.Parent = attach
		downsmoke.Size = NumberSequence.new(size)
		downsmoke.Speed = NumberRange.new(speedmin,speedmax)
		downsmoke.Lifetime = NumberRange.new(lifetime)
		downsmoke.Color = ColorSequence.new(result.Instance.Color)
		downsmoke:Emit(emit)
		local upsmoke = assets:WaitForChild('UpSmoke'):Clone()
		upsmoke.Parent = attach
		upsmoke.Size = NumberSequence.new(size)
		upsmoke.Lifetime = NumberRange.new(lifetime)
		upsmoke.Color = ColorSequence.new(result.Instance.Color)
		upsmoke:Emit(emit)
		debris:AddItem(attach,lifetime+0.5)
	end
end
shake = function(lifetime,range,magnitude,roughness,fadein,fadeout,preset)
	preset = preset or nil
	fadein = fadein or 0.3
	fadeout = fadeout or 0.3
	roughness = roughness or 5
	magnitude = magnitude or 5
	range = range or 50
	lifetime = lifetime or 1
	for _,v in pairs(players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Shaker = assets:WaitForChild('Shaker'):Clone()
					Shaker.Roughness.Value = roughness
					Shaker.Magnitude.Value = Magnitude
					Shaker.FadeIn.Value = fadein
					Shaker.FadeOut.Value = fadeout
					if preset ~= nil then
						Shaker.Preset.Value = preset
					end
					Shaker.Parent = v.Backpack
					Shaker.Disabled = false
					debris:AddItem(Shaker,lifetime)
				end
			end
		end
	end
end
newhitbox = function(lifetime,model)
	lifetime = lifetime or 0.5
	local hitboxz = model:Clone()
	hitboxz.Parent = effectsfolder
	debris:AddItem(hitboxz,0.5)
	return hitboxz
end
sfx = function(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
---tool_functions--
ignition = function()
	if usable == true then
		usable = false
		if at1 then
			at1:Destroy()
			at1 = nil
		end
		if at2 then
			at2:Destroy()
			at2 = nil
		end
		ended2 = true
		ended = true
		local hrp = char:WaitForChild('HumanoidRootPart')
		local head = char:WaitForChild('Head')
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if velo2 then
			velo2.Velocity = Vector3.new(0,0,0)
		end
		StopRemote:FireAllClients()
		--
		local paramshitbox = OverlapParams.new()
		paramshitbox.FilterType = Enum.RaycastFilterType.Blacklist
		paramshitbox.FilterDescendantsInstances = {char}
		--
		animation(char,'ignition')
		task.wait(0.167)
		sfx(7325671724,0.65)
		task.wait(0.35-0.167)
		sfx(9116668939,3.5)
		task.wait(0.7-0.35)
		sfx(305695604,6.5)	local rocks = assets:WaitForChild('rocks'):Clone()
		rocks.Parent = effectsfolder
		rocks:SetPrimaryPartCFrame(hrp.CFrame)
		rocks.mainscript.Disabled = false
		local done = false
		spawn(function()
			local hitfunc = function(hit)
				local target = hit.Parent
				if target and target:FindFirstChildOfClass("Humanoid") and not target:FindFirstChild('HitByIB') then
					if not target:FindFirstChild("IFrame") and not char:FindFirstChild("Stunned") then
						local val = Instance.new("BoolValue",target)
						val.Name = "HitByIB"
						debris:AddItem(val,3)
						--
						local targetroot = target:FindFirstChild('HumanoidRootPart') or target:FindFirstChild("Torso") or nil
						local targethumanoid = target:FindFirstChildOfClass("Humanoid")
						--
						local stun = Instance.new("BoolValue",target)
						stun.Name = "Stunned"
						game:GetService("Debris"):AddItem(stun,3)
						targethumanoid.Health -= targethumanoid.MaxHealth/3.5
						if target:FindFirstChild("Ragdolled") then
							target:FindFirstChild("Ragdolled"):Destroy()
							local thing = Instance.new("BoolValue",target)
							thing.Name = "Ragdolled"
							debris:AddItem(thing,0.05)
							local velo = Instance.new("BodyVelocity",hit)
							velo.MaxForce = Vector3.new(1,1,1) * 50000000
							velo.Velocity = hrp.CFrame.LookVector * 50+Vector3.new(0,20,0)
							debris:AddItem(velo,0.3)
							ragdollmodule:Ragdoll(target,0.05)
						else
							local thing = Instance.new("BoolValue",target)
							thing.Name = "Ragdolled"
							debris:AddItem(thing,3)
							local velo = Instance.new("BodyVelocity",hit)
							velo.MaxForce = Vector3.new(1,1,1) * 50000000
							velo.Velocity = hrp.CFrame.LookVector * 50+Vector3.new(0,20,0)
							debris:AddItem(velo,0.3)
							ragdollmodule:Ragdoll(target,3,false)
						end
					end
				end
			end
			--
			local hitbox = newhitbox(0.2,assets:WaitForChild('Hitbox'))
			spawn(function()
				while task.wait() do
					if hitbox and hitbox:FindFirstChild('Hitbox') and done == false then
						hitbox:SetPrimaryPartCFrame(hrp.CFrame)
						local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
						for _,v in pairs(parts)do
							hitfunc(v)
						end
					else
						break
					end
				end
			end)
		end)
		shake(3,40,15,22,0,0.5)
		task.wait(1.050-0.7)
		done = true
		if velo2 then
			velo2:Destroy()
			velo2 = nil
		end
		if gyro then
			gyro:Destroy()
			gyro = nil
		end
		humanoid.AutoRotate = true
		humanoid.WalkSpeed = oldws
		humanoid.JumpPower = oldjp
		if deb then
			deb:Destroy()
		end
		if iframe then
			iframe:Destroy()
		end
		task.wait(5)
		cd = false
	end
end
burst = function()
	if char ~= owner.Value then return end
	if cd then return end
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then return end
	deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	--
	local hrp = char:WaitForChild('HumanoidRootPart')
	local head = char:WaitForChild('Head')
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	oldws = humanoid.WalkSpeed
	oldjp = humanoid.JumpPower
	--
	animation(char,'barrage')
	local val = Instance.new("BoolValue",char)
	val.Name = "ArmFiring"
	local val2 = Instance.new("BoolValue",char)
	val2.Name = "ArmOut"
	debris:AddItem(val,2)
	debris:AddItem(val2,2)
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	local effs = {}
	ended = false
	sfx(7325671724,0.65)
	velo2 = Instance.new("BodyVelocity",hrp)
	velo2.MaxForce = Vector3.new(1,1,1) * 5000000
	velo2.Velocity = Vector3.new(0,0,0)
	local thing = Remote:InvokeClient(players:GetPlayerFromCharacter(char),'state')
	if thing == true then
		humanoid.AutoRotate = false
		gyro = Instance.new("BodyGyro",hrp)
		gyro.MaxTorque = Vector3.new(1,1,1) * math.huge
		gyro.P = 100000
		gyro.D = 0
		gyro.CFrame = CFrame.lookAt(hrp.Position,Remote:InvokeClient(players:GetPlayerFromCharacter(char),'mouse'))
	end
	task.wait(0.4)
	shake(2.5,35,8,10,0,0.35)
	sfx(1796772196,5)
	local attach = Instance.new("Attachment",hrp)
	for _,v in pairs(assets:WaitForChild('jet'):GetChildren())do
		local efz = v:Clone()
		efz.Parent = attach
		efz:Emit(v:GetAttribute("EmitCount"))
	end
	spawn(function()
		task.wait(0.08)
		usable = true
	end)
	debris:AddItem(attach,4.05)
	if char:FindFirstChild("Right Arm") then
		at2 = Instance.new("Attachment",char:FindFirstChild("Right Arm"))
		at2.Position = Vector3.new(0,-1,0)
		at2.Orientation = Vector3.new(90,0,0)
		for _,v in pairs(assets:WaitForChild('yes'):GetChildren())do
			local efz = v:Clone()
			efz.Parent = at2
			efz.Enabled = true
		end
	end
	if char:FindFirstChild("Left Arm") then
		at1 = Instance.new("Attachment",char:FindFirstChild("Left Arm"))
		at1.Position = Vector3.new(0,-1,0)
		at1.Orientation = Vector3.new(90,0,0)
		for _,v in pairs(assets:WaitForChild('yes'):GetChildren())do
			local efz = v:Clone()
			efz.Parent = at1
			efz.Enabled = true
		end
	end
	if velo2 then
		spawn(function()
			while task.wait() do
				if velo2 then
					if ended == false then
						velo2.Velocity = hrp.CFrame.LookVector * 165
					else
						break
					end
				else
					break
				end
			end
		end)
	end
	spawn(function()
		task.wait(0.983-0.4)
		if usable == true then
			usable = false
			ended2 = false
			if at1 then
				at1:Destroy()
				at1 = nil
			end
			if at2 then
				at2:Destroy()
				at2 = nil
			end
			if velo2 then
				spawn(function()
					while task.wait() do
						if velo2 then
							if ended2 == false then
								velo2.Velocity = hrp.CFrame.LookVector * 12.5
							else
								break
							end
						else
							break
						end
					end
				end)
			end
			humanoid.AutoRotate = true
			ended = true
			sfx(7325671724,0.65)
			task.wait(1.667-0.983)
			ended2 = true
			if velo2 then
				velo2:Destroy()
				velo2 = nil
			end
			local donehit2 = false
			usable = false
			if velo2 then
				velo2:Destroy()
			end
			if gyro then
				gyro:Destroy()
			end
			task.wait(1.783-1.667)
			donehit2 = true
			deb:Destroy()
			iframe:Destroy()
			StopRemote:FireAllClients()
			humanoid.WalkSpeed = oldws
			humanoid.JumpPower = oldjp
			task.wait(5)
			cd = false
		end
	end)
end
activate = function()
	if usable == false then
		burst()
	elseif usable == true then
		ignition()
	end
end
equip = function()
	char = tool.Parent
end
---connect---
tool.Equipped:Connect(equip)
tool.Activated:Connect(activate)</ProtectedString>
