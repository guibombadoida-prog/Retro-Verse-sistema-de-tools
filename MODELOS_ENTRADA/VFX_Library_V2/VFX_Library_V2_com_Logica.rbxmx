			<string name="Name">06_JoJo</string>
		</Properties>
<Item class="Folder" referent="RBXF44850CEE5E5488782AF4459BB531897">
			<Properties>
				<string name="Name">7 Page Muda</string>
				</Properties>
			<Item class="Script" referent="RBX34AC18175A7F40FC9842CAE8510C5EAD">
				<Properties>
					<ProtectedString name="Source">local char = nil
local wave = script.Wave:Clone()
script.Wave:Destroy()
local HB = script.Hitbox:Clone()
script.Hitbox:Destroy()
local GE = script.Stand:Clone()
script.Stand:Destroy()
local CP = script.CamPos:Clone()
script.CamPos:Destroy()
local cd = false
script.Parent.Equipped:Connect(function()
	char = script.Parent.Parent
end)
script.Parent.Activated:Connect(function()
	if char then
		if char:FindFirstChild("Debounce") or cd == true or char:FindFirstChild("Stunned") then return end
		local Deb = Instance.new("BoolValue",char)
		Deb.Name = "Debounce"
		local val = Instance.new("BoolValue",char)
		val.Name = "IFrame"
		local oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
		local oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
		local sound3 = Instance.new("Sound",char.HumanoidRootPart)
		sound3.Volume = 1
		sound3.SoundId = "rbxassetid://4748348137"
		sound3.PlayOnRemove = true
		sound3:Destroy()
		char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		char:FindFirstChildOfClass("Humanoid").JumpPower = 0
		local done = false
		for i = 1,1.4/0.1 do
			local ring = wave:Clone()
			ring.Parent = workspace
			ring:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
			ring.script.Disabled = false
			task.wait(.1)
		end
		local stand = GE:Clone()
		stand.HumanoidRootPart.Anchored = false
		local weld = Instance.new("Weld",stand)
		weld.Part0 = char.HumanoidRootPart
		weld.Part1 = stand.HumanoidRootPart
		stand.Parent = char
		local hitbox = HB:Clone()
		local start = require(script.Animator):LoadAnimation(stand,require(10449982955)('BDSTART'))
		local Barrag1 = require(script.Animator):LoadAnimation(stand,require(10449982955)('BD1'))
		local Barrag2 = require(script.Animator):LoadAnimation(stand,require(10449982955)('BD2'))
		local Finisher = require(script.Animator):LoadAnimation(stand,require(10449982955)('BD3'))
		start:Play(0,1)
		local sound3 = Instance.new("Sound",char.HumanoidRootPart)
		sound3.Volume = 1
		sound3.SoundId = "rbxassetid://6767836089"
		sound3.PlayOnRemove = true
		sound3:Destroy()
		hitbox.Parent = workspace
		hitbox.HumanoidRootPart.Anchored = false
		local weld2 = Instance.new("Weld",hitbox)
		weld2.Part0 = char.HumanoidRootPart
		weld2.Part1 = hitbox.HumanoidRootPart
		game.Debris:AddItem(hitbox,0.45)
		hitbox.Hitbox.Touched:Connect(function(hit)
			if hit.Parent:FindFirstChildOfClass("Humanoid") then
				if hit.Parent ~= char then
					if hit.Parent:FindFirstChild("Blocking") or hit.Parent:FindFirstChild("IFrame") then return end
					if done == false then
						done = true
						local stun = Instance.new("BoolValue",hit.Parent)
						stun.Name = "Stunned"
						start:Stop()
						Barrag1:Play(0,1)
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 1
						sound3.SoundId = "rbxassetid://5426323271"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						char:FindFirstChildOfClass("Humanoid").AutoRotate = false
						char.HumanoidRootPart.Anchored = true
						local campos = CP:Clone()
						campos.Parent = char
						campos:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
						char.HumanoidRootPart.CFrame = campos.Root.CFrame
						hit.CFrame = campos.Enemy1.CFrame
						hit.Anchored = true
						local tabl = {}
						spawn(function()
							local text = campos.Camera:Clone()
							text.Parent = game.Players:GetPlayerFromCharacter(char):FindFirstChildOfClass("PlayerGui")
							text.Disabled = false
							table.insert(tabl,text)
							if hit then
								if hit.Parent then
									if game.Players:GetPlayerFromCharacter(hit.Parent) then
										local text2 = campos.Camera:Clone()
										text2.Parent = game.Players:GetPlayerFromCharacter(hit.Parent):FindFirstChildOfClass("PlayerGui")
										text2.Disabled = false
										table.insert(tabl,text2)
									end
								end
							end
						end)
						local ended = false
						spawn(function()
							for i = 1,5/0.035 do
								if ended == false then
									local done2 = false
									if hit then
										if hit.Parent then
											for i,v in pairs(hit.Parent:GetChildren())do
												if v:IsA("BasePart") then
													if done2 == false then
														done2 = true
														for i,c in pairs(script.HitEff:GetChildren())do
															local r = c:Clone()
															r.Parent = v
															r:Emit(c:GetAttribute("EmitCount"))
															game.Debris:AddItem(r,0.5)
														end
													end
												end
											end
										end
									end
									task.wait(0.035)
								end
							end
						end)
						task.wait(5.5)
						ended = true
						Barrag1:Stop()
						Barrag2:Play(0.1,1)
						if hit then
							game.TweenService:Create(hit,TweenInfo.new(0.15),{CFrame = campos.Enemy2.CFrame}):Play()
						end
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 1.75
						sound3.SoundId = "rbxassetid://6244675350"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						local ended2 = false
						spawn(function()
							for i = 1,4.6/0.035 do
								if ended2 == false then
									local done2 = false
									if hit then
										if hit.Parent then
											for i,v in pairs(hit.Parent:GetChildren())do
												if v:IsA("BasePart") then
													if done2 == false then
														done2 = true
														for i,c in pairs(script.HitEff:GetChildren())do
															local r = c:Clone()
															r.Parent = v
															r:Emit(c:GetAttribute("EmitCount"))
															game.Debris:AddItem(r,0.5)
														end
													end
												end
											end
										end
									end
									task.wait(0.035)
								end
							end
						end)
						task.wait(4.644)
						ended2 = true
						Barrag2:Stop()
						Finisher:Play(0,1)
						if hit then
							game.TweenService:Create(hit,TweenInfo.new(0.15),{CFrame = campos.Enemy1.CFrame}):Play()
						end
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 1.5
						sound3.SoundId = "rbxassetid://4903365729"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						task.wait(0.4)
						if hit then
							for i,v in pairs(script.HeavyEff:GetChildren())do
								local r = v:Clone()
								r.Parent = hit
								r:Emit(v:GetAttribute("EmitCount"))
								game.Debris:AddItem(r,1)
							end
						end
						if hit then
							hit.Anchored = false
						end
						spawn(function()
							while task.wait() do
								if hit then
									if hit.Parent then
										hit.Parent:BreakJoints()
									end
								end
							end
						end)
						if hit then
							if hit.Parent then
								for i,v in pairs(hit.Parent:GetDescendants())do
									if v:IsA("BasePart") then
										local velo = Instance.new("BodyVelocity",v)
										velo.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
										velo.Velocity = Vector3.new(0,100,0) + char.HumanoidRootPart.CFrame.LookVector * 120
										game.Debris:AddItem(velo,0.25)
									end
								end
							end
						end	
						if not game.MaterialService:FindFirstChild("CameraShaker") then
							script.CameraShaker:Clone().Parent = game.MaterialService
						end
						for i,v in pairs(game.Players:GetPlayers())do
							if v.Character then
								if v.Character.PrimaryPart then
									local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
									if Magnitude &lt; 50 then
										local Cutscene = script.Shake2:Clone()
										Cutscene.Parent = v.Backpack
										Cutscene.Disabled = false
									end
								end
							end
						end
						task.wait(.25)
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 1
						sound3.SoundId = "rbxassetid://6681508647"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						campos:Destroy()
						stand:Destroy()
						char.HumanoidRootPart.Anchored = false
						char:FindFirstChildOfClass("Humanoid").AutoRotate = true
						for i,v in pairs(tabl)do
							v:Destroy()
						end
						cd = true
						val:Destroy()
						Deb:Destroy()
						char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
						char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
						task.wait(1.5)
						cd = false
					end
				end
			end
		end)
		task.wait(.45)
		if done == false then
			done = true
			val:Destroy()
			stand:Destroy()
			task.wait(2)
			Deb:Destroy()
			cd = true
			char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
			char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
			task.wait(1.5)
			cd = false
		end
	end
end)</ProtectedString>
