				<Item class="LocalScript" referent="RBX642FFBEF8F61416E82ABB94513BF37AE">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local players = game:GetService("Players")
local plr = players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local remote = tool:WaitForChild('RemoteFunction',15)
local UIS = game:GetService('UserInputService')
--
local jumped = false
local holding = false
local humanoid = char:WaitForChild('Humanoid',15) or char:FindFirstChildOfClass("Humanoid")
--
UIS.JumpRequest:Connect(function()
	if jumped == false then
		jumped = true
		task.wait(0.5)
		jumped = false
	end
end)
UIS.InputBegan:Connect(function(input,process)
	if process then return end
	if input.KeyCode == Enum.KeyCode.Space then
		holding = true
	end
end)
UIS.InputEnded:Connect(function(input,process)
	if input.KeyCode == Enum.KeyCode.Space then
		holding = false
	end
end)
--
remote.OnClientInvoke = function()
	if humanoid:GetState() == Enum.HumanoidStateType.FallingDown or humanoid:GetState() == Enum.HumanoidStateType.Freefall then
		return 'fell'
	else
		if jumped == true or holding == true then
			return 'jumped'
		end
	end
end</ProtectedString>
