						<Item class="ModuleScript" referent="RBX581024555FC34C43869CC214032882F2">
							<Properties>
								<Content name="LinkedSource"><null/></Content>
								<ProtectedString name="Source">local module = {}

module.Rocks = function(Origin,rockNumber,Direction,CanCollide,Trail,Min,Max,MinVel,MaxVel,MinSize,MaxSize,LifeTime,Smoke)
	Smoke = Smoke or false
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {workspace.Terrain} or {}
	local raycastResult = workspace:Raycast(Origin,Direction,params)
	local random = Random.new()
	for i = 1, rockNumber do 
		if raycastResult then
			local Part = Instance.new("Part")
			Part.Anchored = false
			Part.Name = "Part"
			Part.Shape = "Block"
			if MinSize == true then
				Part.Size = MaxSize
			else
				Part.Size = Vector3.new(random:NextInteger(MinSize,MaxSize),random:NextInteger(MinSize,MaxSize),random:NextInteger(MinSize,MaxSize))
			end
			if Smoke == true then
				local eff = script:WaitForChild('smoke'):Clone()
				eff.Parent = Part
				eff.Enabled = true
			end
			Part.Material = raycastResult.Instance.Material
			Part.CanCollide = CanCollide
			Part.CFrame = CFrame.new(raycastResult.Position+Vector3.new(0,1,0))
			Part.Transparency = raycastResult.Instance.Transparency
			Part.Color = raycastResult.Instance.Color
			Part.Velocity = Vector3.new(0,math.random(Min, MaxVel),0)
			Part.CFrame = Part.CFrame * CFrame.Angles(math.rad(math.random(Min, Max)), math.rad(math.random(Min, Max)), math.rad(math.random(Min, Max)))
			if Trail == true then
				local a1 = Instance.new("Attachment",Part)
				a1.Name = "a1"
				a1.Position = Vector3.new(.025,0,0)

				local a2 = Instance.new("Attachment",Part)
				a2.Name = "a2"
				a2.Position = Vector3.new(-.025,0,0)

				local Trail = script.Trail:Clone()
				Trail.Parent = Part
				Trail.Attachment0 = a1
				Trail.Attachment1 = a2
			end
			Part.Parent = workspace.Terrain or workspace
			Part.CanCollide = false
			game.Debris:AddItem(Part,LifeTime)
		end
	end
end

return module
