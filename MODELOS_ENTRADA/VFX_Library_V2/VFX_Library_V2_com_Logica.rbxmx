							</Properties>
							<Item class="NumberValue" referent="RBX9DF34770E75A495C8ABEEAB4D2CF1C35">
								<Properties>
									<double name="Value">100</double>
									<BinaryString name="AttributesSerialize"/>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<string name="Name">ResumeSpeed</string>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								</Properties>
							</Item>
							<Item class="NumberValue" referent="RBXF9049C0075634FDDB2A1A8D5006768C5">
								<Properties>
									<double name="Value">50000</double>
									<BinaryString name="AttributesSerialize"/>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<string name="Name">Speed</string>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								</Properties>
							</Item>
							<Item class="ObjectValue" referent="RBX91CAE4B49E3A4790885AE63332F63E0D">
								<Properties>
									<Ref name="Value">null</Ref>
									<BinaryString name="AttributesSerialize"/>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<string name="Name">Target</string>
									<int64 name="SourceAssetId">-1</int64>
