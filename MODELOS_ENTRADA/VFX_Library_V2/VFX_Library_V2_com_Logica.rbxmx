						ragdollmodule:Ragdoll(target,4.5,false)
						targethumanoid.Health -= targethumanoid.MaxHealth/2.5
					else
						local val6 = Instance.new("BoolValue",hit.Parent)
						val6.Name = "Stunned"
						game:GetService("Debris"):AddItem(val6,1.345)
						local val7 = Instance.new("BoolValue",hit.Parent)
						val7.Name = "cantbehitbym1"
						game:GetService("Debris"):AddItem(val7,1.45)
						spawn(function()
							task.wait(1.35)
							if target then
								if not target:FindFirstChild("Stunned") then
									local val6 = Instance.new("BoolValue",hit.Parent)
									val6.Name = "Stunned"
									game:GetService("Debris"):AddItem(val6,2.5)
									local ragdollvalue = Instance.new("BoolValue",target)
									ragdollvalue.Name = "Ragdolled"
									debris:AddItem(ragdollvalue,2.5)
									ragdollmodule:Ragdoll(target,2.5,false)
								end
							end
						end)
