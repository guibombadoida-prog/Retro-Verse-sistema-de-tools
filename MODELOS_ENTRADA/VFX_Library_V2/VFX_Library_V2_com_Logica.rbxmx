					<Properties>
						<ProtectedString name="Source">local plr = game:GetService('Players').LocalPlayer
local ui = script:WaitForChild('ImpactFrame',15)
game:GetService("Debris"):AddItem(ui,5.85+0.35)
local obj = script:WaitForChild('Value',15).Value
local camera = workspace.CurrentCamera
task.wait(0.125)
camera.CameraType = "Scriptable"
local ended = false
game:GetService("TweenService"):Create(camera,TweenInfo.new(0.75,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{CFrame = obj.CFrame}):Play()
script.Destroying:Connect(function()
	if ui then
		ui:Destroy()
	end
	camera.CameraType = "Custom"
	ended = true
end)
spawn(function()
	task.wait(5.85-0.125)
	ui.Parent = plr:FindFirstChildOfClass('PlayerGui')
	ui.Enabled = true
	task.wait(0.05)
	camera.CameraType = "Custom"
	ended = true
	ui:WaitForChild('ImageLabelTwo',15).Visible = true
	task.wait(0.05)
	ui:WaitForChild('ImageLabelTwo',15).Visible = false
	ui:WaitForChild('ImageLabel',15).Visible = true
	task.wait(0.25)
	ui:Destroy()
	script:WaitForChild('RemoteEvent',15):FireServer()
end)
task.wait(0.75)
game:GetService("RunService").RenderStepped:Connect(function()
	if ended == false then
		if obj then
			camera.CFrame = obj.CFrame
		else
			camera.CameraType = "Custom"
			ended = true
		end
	end
end)
