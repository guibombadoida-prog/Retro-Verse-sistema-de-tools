						<Item class="LocalScript" referent="RBXED7BF7DEA70F4589999D559F42ED26CC">
							<Properties>
								<ProtectedString name="Source">local char = script:WaitForChild('char',20).Value
local cloned = script:WaitForChild('Rig',15)
for i,v in pairs(char:GetChildren())do
	if v:IsA("BasePart") then
		for i,c in pairs(cloned:GetChildren())do
			if c:IsA("BasePart") then
				if v.Name == c.Name then
					c.CFrame = v.CFrame
					game.TweenService:Create(c,TweenInfo.new(0.75),{Transparency = 1}):Play()
				end
			end
		end
	end
end
cloned.Parent = workspace.Terrain or workspace
script.Destroying:Connect(function()
	cloned:Destroy()
end)</ProtectedString>
