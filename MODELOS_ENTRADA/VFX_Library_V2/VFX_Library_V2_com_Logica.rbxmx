					<Item class="Script" referent="RBX3ED2AC8D01644CE2814FCE1FAF17FE75">
						<Properties>
							<ProtectedString name="Source">local smoke = script.Smoke:Clone()
script.Smoke:Destroy()
local FX2 = script.Part:Clone()
script.Part:Destroy()
local FX = script.Thing:Clone()
script.Thing:Destroy()
local ring = script.Ring:Clone()
script.Ring:Destroy()
local lmodule = require(script.LightningBolt)
local smodule = require(script.LightningBolt.LightningSparks)
local emodule = require(script.LightningBolt.LightningExplosion)
local ogcf = script.Parent.Root.CFrame
--
local HiteffectBall = function(Target,Pos)
	spawn(function()
		local ClonedBall = FX:Clone()
		ClonedBall.Parent = Target
		ClonedBall.CFrame = Pos
		ClonedBall.CFrame = CFrame.new(ClonedBall.Position, Target.Position)
		game.Debris:AddItem(ClonedBall,0.5)
		game.TweenService:Create(ClonedBall,TweenInfo.new(0.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),{CFrame = ClonedBall.CFrame + ClonedBall.CFrame.lookVector * -35,Transparency = 1,Size = Vector3.new(0,0,0)}):Play()
	end)
	pcall(function()
		spawn(function()
			local ClonedBall = FX2:Clone()
			ClonedBall.Parent = Target
			ClonedBall.Position = Pos.Position
			game.Debris:AddItem(ClonedBall,0.5)
			game.TweenService:Create(ClonedBall,TweenInfo.new(0.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),{Position = (ClonedBall.CFrame + ClonedBall.CFrame.lookVector * -35).Position,Transparency = 1,Size = Vector3.new(0,0,0)}):Play()
		end)
	end)
end
--
game.TweenService:Create(script.Parent.EnemyRoot.PointLight,TweenInfo.new(0.2),{Brightness = 2}):Play()
local curpart2 = script.Parent.Points:GetChildren()[math.random(1,#script.Parent.Points:GetChildren())]
for i,v in pairs(script.Parent.Points:GetChildren())do
	if v:IsA("Part") then
		local sound = Instance.new("Sound",v)
		sound.PlayOnRemove = true
		sound.SoundId = "rbxassetid://9119736978"
		sound.Volume = 2
		sound:Destroy()
		script.Parent.Root.CFrame = v.CFrame
		curpart2 = v
		task.wait(.25)
	end
end
task.wait(.2)
script.Parent.Root.CFrame = ogcf
local curpart = script.Parent.Points:GetChildren()[math.random(1,#script.Parent.Points:GetChildren())]
for i,v in pairs(script.Parent.Points:GetChildren())do
	if v:IsA("Part") then
		local sound = Instance.new("Sound",curpart)
		sound.PlayOnRemove = true
		sound.SoundId = "rbxassetid://9114268761"
		sound.Volume = 3
		sound:Destroy()
		spawn(function()
			local lightning = lmodule.new(curpart.Attachment,script.Parent.EnemyRoot.Attachment,15)
			lightning.CurveSize0 = math.random(-5,5)
			lightning.CurveSize1 = math.random(-5,5)
			lightning.Frequency = 2
			lightning.Thickness = 3
			lightning.PulseSpeed = 20
			lightning.PulseLength = 0.5
			lightning.FadeLength = 0.25
			lightning.MaxRadius = 1
			lightning.AnimationSpeed = 30
			lightning.Color = Color3.fromRGB(128, 187, 219)
			local sparks = smodule.new(lightning,20)
			task.wait(.5)
			sparks:Destroy()
			lightning:Destroy()
		end)
		spawn(function()
			local lightning = lmodule.new(curpart.Attachment,script.Parent.EnemyRoot.Attachment,15)
			lightning.CurveSize0 = math.random(-5,5)
			lightning.CurveSize1 = math.random(-5,5)
			lightning.Frequency = 2
			lightning.Thickness = 3
			lightning.PulseSpeed = 20
			lightning.PulseLength = 0.5
			lightning.FadeLength = 0.25
			lightning.MaxRadius = 1
