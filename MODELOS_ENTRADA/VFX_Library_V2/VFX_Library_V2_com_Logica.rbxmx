							local cf = hit.CFrame*CFrame.new(math.random(-spread,spread),1,math.random(-spread,spread))
							debrismodule.Rocks(cf.Position,1,Vector3.new(0,-15,0),true,false,-180,180,50,75,0.1,5,4.5,false)
						end
					end)
				end
				--
				if target and targethumanoid and hit then
					if targethumanoid.Health &lt; targethumanoid.MaxHealth/2.5 then
						for _,v in pairs(collisiongroup)do
