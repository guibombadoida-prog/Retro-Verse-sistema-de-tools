		end)
		spawn(function()
			for i = 1,(1.1-0.75)/0.01 do
				for i,hit in pairs(Hitbox:GetTouchingParts())do
					if hit.Parent then
						if hit.Parent:FindFirstChildOfClass("Humanoid") then
							if hit.Parent ~= char then
								if hit.Parent:FindFirstChild("Blocking") or hit.Parent:FindFirstChild("IFrame") then return end
								if hit.Parent:FindFirstChild("Torso") or hit.Parent:FindFirstChild("HumanoidRootPart") then
									if done == false then
										done = true
										local stun = Instance.new("BoolValue",hit.Parent)
										stun.Name = "Stunned"
										if hit.Parent:FindFirstChild("HumanoidRootPart") then
