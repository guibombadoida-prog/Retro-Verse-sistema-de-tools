					<Item class="ModuleScript" referent="RBX7BD3ED4AB1AA403DB7EAB8416E9F580E">
						<Properties>
							<Content name="LinkedSource"><null/></Content>
							<ProtectedString name="Source">--[[

   RAGDOLLIFY MODULE

