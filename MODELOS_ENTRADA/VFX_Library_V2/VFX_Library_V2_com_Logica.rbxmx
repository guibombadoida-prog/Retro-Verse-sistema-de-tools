					<Item class="LocalScript" referent="RBX734F5E23546145B8AAC791E00BBF4B50">
						<Properties>
							<ProtectedString name="Source">local cam = workspace.CurrentCamera
cam.CameraType = "Scriptable"
local oldfov = cam.FieldOfView
cam.CFrame = script:WaitForChild('Cam1',15).CFrame * CFrame.new(0,-2.3,0)
game.TweenService:Create(cam,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = script:WaitForChild('Cam1',15).CFrame}):Play()
script.Destroying:Connect(function()
	cam.CameraType = "Custom"
	cam.FieldOfView = oldfov
end)
cam.FieldOfView = 55
task.wait(2)
spawn(function()
	for i = 1,1.591/0.01 do
		if script:WaitForChild('enemypart',15).Value ~= nil then
			cam.CFrame = CFrame.new(script:WaitForChild('enemypart',15).Value.Position - Vector3.new(0,6,0),script:WaitForChild('enemypart',15).Value.Position)
		end
		task.wait(.01)
	end
end)
task.wait(1.591)
task.wait(2.5)
cam.CFrame = script:WaitForChild('Cam3',15).CFrame
game.TweenService:Create(cam,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{FieldOfView = 10}):Play()
task.wait(1.5)
game.TweenService:Create(cam,TweenInfo.new(1,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{FieldOfView = 85}):Play()
game.TweenService:Create(cam,TweenInfo.new(0.3),{CFrame = script:WaitForChild('Cam2',15).CFrame}):Play()
pcall(function()
	spawn(function()
		task.wait(.05)
		local camera = workspace.CurrentCamera
		local humanoid = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		script.Destroying:Connect(function()
			humanoid.CameraOffset = Vector3.new(0,0,0)
		end)
		local function shakeCamera(length)
			local startTime = tick()
			while true do
				if tick() - startTime &gt;= length then break end
				local x = math.random(-100, 100) / 50
				local y = math.random(-100, 100) / 50
				local z = math.random(-100, 100) / 50
				humanoid.CameraOffset = Vector3.new(x, y, z)
				cam.CFrame *= CFrame.Angles(x / 120, y / 120, z / 120)
				wait()
			end
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
		end
		shakeCamera(5.4)
	end)
end)
task.wait(5.5)
cam.FieldOfView = oldfov
cam.CameraType = "Custom"
script.RemoteEvent2:FireServer()</ProtectedString>
