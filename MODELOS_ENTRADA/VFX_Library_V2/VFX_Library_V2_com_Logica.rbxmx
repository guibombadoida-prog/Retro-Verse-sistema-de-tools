	rockmodule.createFaceInward(thing:WaitForChild("root"), 5, 10, 5,2,2,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 10, 20, 7,4,4,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 7, 30, 11,6,6,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 8, 40, 12,8,8,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 6, 100, 35,10,10,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 10, 120, 40,10,10,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 6, 65, 20,10,10,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 9, 75, 20,10,10,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 5, 85, 50,10,10,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 10, 90, 20,10,10,(9.1-2.5),true,params)
	task.wait()
	rockmodule.createFaceInward(thing:WaitForChild("root"), 10, 55, 15,8.5,8.5,(9.1-2.5),true,params)
	task.wait()
end)
for i,v in pairs(thing:WaitForChild('crack'):GetChildren())do
	game:GetService("TweenService"):Create(v,TweenInfo.new(9),{Transparency = 1}):Play()
end
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.FilterDescendantsInstances = {thing,workspace.Terrain,owner} or {thing,owner} or {}
local smoke = thing:WaitForChild('root').Attachment1.Smoke
local result = workspace:Raycast((thing:WaitForChild('root').CFrame*CFrame.new(0,1,0)).Position,Vector3.new(0,-15,0),params)
if result then
	smoke.Color = ColorSequence.new(result.Instance.Color)
	thing:WaitForChild('crack').Position = Vector3.new(thing:WaitForChild('crack').Position.X,(result.Position.Y+0.015),thing:WaitForChild('crack').Position.Z)
end
spawn(function()
	for i = 1,25 do
		debrismodule.Rocks((thing:WaitForChild('root').CFrame*CFrame.new(math.random(-85,85),0,math.random(-85,85))).Position,2,Vector3.new(0,-15,0),true,false,-180,180,85,150,0.1,15,8,false)
	end
end)
task.wait()
for i,v in pairs(thing:WaitForChild('root').Attachment1:GetChildren())do
	v:Emit(v:GetAttribute("EmitCount"))
end
game:GetService("Debris"):AddItem(thing,9.15)</ProtectedString>
