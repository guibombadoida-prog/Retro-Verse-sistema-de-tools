				spawn(function()
					while task.wait() do
						if movevelo then
							movevelo.Velocity = hrp.CFrame.LookVector * 80
							humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
						else
							break
						end
					end
				end)
				sfx(2599401908,0.75)
