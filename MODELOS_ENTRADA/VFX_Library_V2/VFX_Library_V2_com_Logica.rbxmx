						<Item class="Script" referent="RBXD0F1B2B7C2C14791B98359ED2C48F700">
							<Properties>
								<ProtectedString name="Source">local thing = script.Parent
local modules = thing:WaitForChild('Modules')
local rockmodule = require(modules:WaitForChild('RocksModule'))
local debrismodule = require(modules:WaitForChild('DebrisModule'))
local currentpos = Vector3.new(0,0,0)
for i,v in pairs(thing:WaitForChild('Root').WindBack:GetDescendants())do
	if v:IsA("ParticleEmitter") then
		v:Emit(v:GetAttribute('EmitCount'))
	end
end
for i,v in pairs(thing:WaitForChild('particle'):GetDescendants())do
	if v:IsA("ParticleEmitter") then
		v:Emit(1)
	end
end
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Blacklist
params.FilterDescendantsInstances = {workspace.Terrain,thing} or {thing} or {}
spawn(function()
	for i,v in pairs(thing:WaitForChild('debris'):GetChildren())do
		if v:IsA("Part") then
			if v.Name == "Debris2" then
				rockmodule.Ground(v.CFrame,50,v.Size,false,16,false,false)
			elseif v.Name == "DebrisGg" then
				rockmodule.Ground(v.CFrame,50,v.Size,false,16,true,true)
			else
				rockmodule.Ground(v.CFrame,50,v.Size,false,16,true,false)
			end
			local ray = workspace:Raycast(v.Position+Vector3.new(0,1,0),Vector3.new(0,-15,0),params)
			if v:FindFirstChild("Smoke") then
				if ray then
					v:FindFirstChild("Smoke").Color = ColorSequence.new(ray.Instance.Color)
					v:FindFirstChild("Smoke"):Emit(5)
				end
			end
		end
	end
end)
spawn(function()
	task.wait(0.25)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {thing}
	for i = 0,math.abs(415/21) do
		if thing:FindFirstChild('Root') then
			currentpos = currentpos - Vector3.new(0,0,21)
			local attach = Instance.new("Attachment",thing:FindFirstChild('Root'))
			attach.Position = currentpos
			game:GetService("Debris"):AddItem(attach,1.65)
			local ray = workspace:Raycast(attach.WorldPosition,Vector3.new(0,-15,0),params)
			if ray then
				local emitter = script:WaitForChild('Push'):Clone()
				emitter.Parent = attach
				emitter:Emit(35)
				if i &lt; 35 and i &gt; 5 then
					for z = 1,3 do
						debrismodule.Rocks((attach.WorldCFrame*CFrame.new(math.random(-200,200),0,0)).Position,1,Vector3.new(0,-15,0),true,false,-180,180,250,400,10,20,15)
					end
				end
				if i &lt;= 5 then
					for z = 1,4 do
						debrismodule.Rocks((attach.WorldCFrame*CFrame.new(math.random(-25,25),0,0)).Position,1,Vector3.new(0,-15,0),true,false,-180,180,100,150,2,3,15)
					end
				end
			end
		end
	end
end)
game:GetService("Debris"):AddItem(thing,22)</ProtectedString>
