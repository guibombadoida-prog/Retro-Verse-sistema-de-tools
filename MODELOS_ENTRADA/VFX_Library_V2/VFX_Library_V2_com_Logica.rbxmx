<Item class="Folder" referent="RBX36A3718B38F8440C9AF3BE382E95CCEF">
			<Properties>
				<string name="Name">Sunlight Yellow Overdrive!</string>
				</Properties>
			<Item class="Script" referent="RBX9C0922E9D9D94B589F1BBA5FEE1196AC">
				<Properties>
					<ProtectedString name="Source">local char = nil
local wave = script.Wave:Clone()
script.Wave:Destroy()
local HB = script.Hitbox:Clone()
script.Hitbox:Destroy()
local OL = script.Outline:Clone()
script.Outline:Destroy()
local CP = script.CamPos:Clone()
script.CamPos:Destroy()
local BEff = script.Barrage:Clone()
script.Barrage:Destroy()
local cd = false
script.Parent.Equipped:Connect(function()
	char = script.Parent.Parent
end)
script.Parent.Activated:Connect(function()
	if char then
		if char:FindFirstChild("Debounce") or cd == true or char:FindFirstChild("Stunned") then return end
		local Deb = Instance.new("BoolValue",char)
		Deb.Name = "Debounce"
		local val = Instance.new("BoolValue",char)
		val.Name = "IFrame"
		local oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
		local oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
		local sound3 = Instance.new("Sound",char.HumanoidRootPart)
		sound3.Volume = 2
		sound3.SoundId = "rbxassetid://8291695209"
		sound3.PlayOnRemove = true
		sound3:Destroy()
		require(script.Animation)(char,'Kick')
		char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		char:FindFirstChildOfClass("Humanoid").JumpPower = 0
		local done = false
		local outline = OL:Clone()
		outline.Parent = char
		spawn(function()
			local weld = Instance.new("Weld",outline)
			weld.Part0 = char['Right Arm']
			weld.Part1 = outline["Right Arm"]
		end)
		spawn(function()
			local weld = Instance.new("Weld",outline)
			weld.Part0 = char['Right Leg']
			weld.Part1 = outline["Right Leg"]
		end)
		spawn(function()
			local weld = Instance.new("Weld",outline)
			weld.Part0 = char['Left Arm']
			weld.Part1 = outline["Left Arm"]
		end)
		spawn(function()
			local weld = Instance.new("Weld",outline)
			weld.Part0 = char['Left Leg']
			weld.Part1 = outline["Left Leg"]
		end)
		spawn(function()
			local weld = Instance.new("Weld",outline)
			weld.Part0 = char['Head']
			weld.Part1 = outline["Head"]
		end)
		spawn(function()
			local weld = Instance.new("Weld",outline)
			weld.Part0 = char['Torso']
			weld.Part1 = outline["Torso"]
		end)
		for i,v in pairs(outline:GetChildren())do
			if v:IsA("BasePart") then
				game.TweenService:Create(v,TweenInfo.new(0.3),{Transparency = 0}):Play()
			end
		end
		for i = 1,1.4/0.1 do
			local ring = wave:Clone()
			ring.Parent = workspace
			ring:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
			ring.script.Disabled = false
			task.wait(.1)
		end
		spawn(function()
			for i = 1,0.2/0.05 do
				local hitbox = HB:Clone()
				hitbox:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
				game.Debris:AddItem(hitbox,0.1)
				for i,hit in pairs(workspace:GetPartsInPart(hitbox.Hitbox,OverlapParams.new()))do
					if hit.Parent:FindFirstChildOfClass("Humanoid") then
						if hit.Parent ~= char then
							if hit.Parent:FindFirstChild("Blocking") or hit.Parent:FindFirstChild("IFrame") then return end
							if done == false then
								done = true
								local stun = Instance.new("BoolValue",hit.Parent)
								stun.Name = "Stunned"
								script:WaitForChild('StopAnimation',15):FireAllClients()
								for i,v in pairs(script.HeavyEff:GetChildren())do
									local r = v:Clone()
									r.Parent = hit
									r:Emit(v:GetAttribute("EmitCount"))
									game.Debris:AddItem(r,1)
								end
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 4.5
								sound3.SoundId = "rbxassetid://5886412948"
								sound3.PlayOnRemove = true
								sound3:Destroy()
								char:FindFirstChildOfClass("Humanoid").AutoRotate = false
								char.HumanoidRootPart.Anchored = true
								local campos = CP:Clone()
								campos.Parent = char
								campos:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
								require(script.Animation)(char,'Idle')
								char.HumanoidRootPart.CFrame = campos.Root.CFrame
								hit.CFrame = campos.Root.CFrame * CFrame.new(0,0,-7.5)
								hit.Anchored = true
								game.TweenService:Create(hit,TweenInfo.new(6),{CFrame = hit.CFrame * CFrame.new(0,150,0)}):Play()
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 2.5
								sound3.SoundId = "rbxassetid://8291819008"
								sound3.PlayOnRemove = true
								sound3:Destroy()
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 2
								sound3.SoundId = "rbxassetid://5632674204"
								sound3.PlayOnRemove = true
								sound3:Destroy()
								local tabl = {}
								spawn(function()
									local text = campos.Camera:Clone()
									text.enemypart.Value = hit
									text.Parent = game.Players:GetPlayerFromCharacter(char):FindFirstChildOfClass("PlayerGui")
									text.Disabled = false
									table.insert(tabl,text)
									if hit then
										if hit.Parent then
											if game.Players:GetPlayerFromCharacter(hit.Parent) then
												local text2 = campos.Camera:Clone()
												text2.enemypart.Value = hit
												text2.Parent = game.Players:GetPlayerFromCharacter(hit.Parent):FindFirstChildOfClass("PlayerGui")
												text2.Disabled = false
												table.insert(tabl,text2)

											end
										end
									end
								end)
								spawn(function()
									local text = script.Text:Clone()
									text.Parent = game.Players:GetPlayerFromCharacter(char):FindFirstChildOfClass("PlayerGui")
									text.Enabled = true
									text.LocalScript.Disabled = false
									table.insert(tabl,text)
									if hit then
										if hit.Parent then
											if game.Players:GetPlayerFromCharacter(hit.Parent) then
												local text2 = script.Text:Clone()
												text2.Parent = game.Players:GetPlayerFromCharacter(hit.Parent):FindFirstChildOfClass("PlayerGui")
												text2.Enabled = true
												table.insert(tabl,text2)
												text2.LocalScript.Disabled = false
											end
										end
									end
								end)
								task.wait(3.591)
								spawn(function()
									local text = script.Viewport:Clone()
									text.Parent = game.Players:GetPlayerFromCharacter(char):FindFirstChildOfClass("PlayerGui")
									text.Enabled = true
									text.LocalScript.plr.Value = game.Players:GetPlayerFromCharacter(char)
									text.LocalScript.Disabled = false
									table.insert(tabl,text)
									if hit then
										if hit.Parent then
											if game.Players:GetPlayerFromCharacter(hit.Parent) then
												local text2 = script.Viewport:Clone()
												text2.Parent = game.Players:GetPlayerFromCharacter(hit.Parent):FindFirstChildOfClass("PlayerGui")
												text2.Enabled = true
												table.insert(tabl,text2)
												text2.LocalScript.plr.Value = game.Players:GetPlayerFromCharacter(char)
												text2.LocalScript.Disabled = false
											end
										end
									end
								end)
								task.wait(2.5)
								if hit then
									game.TweenService:Create(hit,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0,2.35,-4)}):Play()
								end
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 2.5
								sound3.SoundId = "rbxassetid://9116795681"
								sound3.PlayOnRemove = true
								sound3:Destroy()
								task.wait(1.5)
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 3
								sound3.SoundId = "rbxassetid://624164065"
								sound3.PlayOnRemove = true
								sound3:Destroy()
								script:WaitForChild('StopAnimation',15):FireAllClients()
								require(script.Animation)(char,'Barrage')
								local Ba = BEff:Clone()
								Ba.Parent = char
								Ba.Root.Anchored = false
								local weld = Instance.new("Weld",Ba)
								weld.Part0 = char.HumanoidRootPart
								weld.Part1 = Ba.Root
								local ended = false
								spawn(function()
									for i = 1,5.23/0.035 do
										if ended == false then
											local done2 = false
											if hit then
												if hit.Parent then
													for i,v in pairs(hit.Parent:GetChildren())do
														if v:IsA("BasePart") then
															if done2 == false then
																done2 = true
																for i,c in pairs(script.HitEff:GetChildren())do
																	local r = c:Clone()
																	r.Parent = v
																	r:Emit(c:GetAttribute("EmitCount"))
																	game.Debris:AddItem(r,0.5)
																end
															end
														end
													end
												end
											end
											pcall(function()
												Ba.Part["Smoke(1)"]:Emit(5)
											end)
											task.wait(0.035)
										end
									end
									spawn(function()
										Ba:Destroy()
									end)
								end)
								task.wait(5.235)
								ended = true
								script:WaitForChild('StopAnimation',15):FireAllClients()
								require(script.Animation)(char,'Finisher')
								task.wait(.25)
								if hit then
									for i,v in pairs(script.HeavyEff:GetChildren())do
										local r = v:Clone()
										r.Parent = hit
										r:Emit(v:GetAttribute("EmitCount"))
										game.Debris:AddItem(r,1)
									end
								end
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 4.5
								sound3.SoundId = "rbxassetid://5886412948"
								sound3.PlayOnRemove = true
								sound3:Destroy()
								task.wait(.1)
								if hit then
									hit.Anchored = false
								end
								for i,v in pairs(outline:GetChildren())do
									if v:IsA("BasePart") then
										if v:FindFirstChildOfClass("ParticleEmitter") then
											v:FindFirstChildOfClass("ParticleEmitter").Enabled = false
										end
										game.TweenService:Create(v,TweenInfo.new(0.3),{Transparency = 1}):Play()
									end
								end
								spawn(function()
									while task.wait() do
										if hit then
											if hit.Parent then
												hit.Parent:BreakJoints()
											end
										end
									end
								end)
								if hit then
									if hit.Parent then
										for i,v in pairs(hit.Parent:GetDescendants())do
											if v:IsA("BasePart") then
												local velo = Instance.new("BodyVelocity",v)
												velo.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
												velo.Velocity = Vector3.new(0,100,0) + char.HumanoidRootPart.CFrame.LookVector * 120
												game.Debris:AddItem(velo,0.25)
											end
										end
									end
								end
								if not game.MaterialService:FindFirstChild("CameraShaker") then
									script.CameraShaker:Clone().Parent = game.MaterialService
								end
								for i,v in pairs(game.Players:GetPlayers())do
									if v.Character then
										if v.Character.PrimaryPart then
											local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
											if Magnitude &lt; 50 then
												local Cutscene = script.Shake2:Clone()
												Cutscene.Parent = v.Backpack
												Cutscene.Disabled = false
											end
										end
									end
								end
								task.wait(.1)
								char.HumanoidRootPart.Anchored = false
								char:FindFirstChildOfClass("Humanoid").AutoRotate = true
								for i,v in pairs(tabl)do
									v:Destroy()
								end
								game.Debris:AddItem(outline,0.3)
								cd = true
								val:Destroy()
								Deb:Destroy()
								script:WaitForChild('StopAnimation',15):FireAllClients()
								char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
								char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
								task.wait(1.5)
								cd = false
							end
						end
					end
				end
