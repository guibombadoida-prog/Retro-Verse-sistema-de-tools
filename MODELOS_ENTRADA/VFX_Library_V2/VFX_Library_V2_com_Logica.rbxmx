									<ProtectedString name="Source">local Rocks = {}

local TS = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")
local PS = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local Modules = script.Parent
local cacheFolder = workspace:FindFirstChildOfClass("Terrain")
function Rocks.Ground(CF, Distance, Size, Ice, despawnTime,Collision,MORE)
	local random = Random.new()

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {cacheFolder}
	local size
	size = Size or Vector3.new(2, 2, 2)
	local pos = CF.Position+Vector3.new(0,2,0)
	if MORE == true then
		pos = CF.Position+Vector3.new(0,20,0)
	end
	despawnTime = despawnTime or 3
	local ray = workspace:Raycast(pos, (Vector3.new(0, -1, 0)*Distance), params)
	if ray then
		local part = Instance.new("Part")
		part.CFrame = CF --* CFrame.fromEulerAnglesXYZ(random:NextNumber(-.15, .15), random:NextNumber(-.15, .15), random:NextNumber(-.15, .15))
		part.Size = size
		part.Parent = cacheFolder
		part.Position = Vector3.new(CF.Position.X,ray.Position.Y,CF.Position.Z)
		if ray.Instance.Material == Enum.Material.Concrete or ray.Instance.Material == Enum.Material.Air or ray.Instance.Material == Enum.Material.Wood or ray.Instance.Material == Enum.Material.Neon or ray.Instance.Material == Enum.Material.WoodPlanks then
			part.Material = ray.Instance.Material	
		else
			part.Material = ray.Instance.Material	
		end
		part.Color = ray.Instance.Color
		part.Anchored = true
		part.CanTouch = false
		part.CanCollide = Collision
		part.Transparency = 0
		part.Position = part.Position - Vector3.new(0,part.Size.Y*1.5,0)
		game.Debris:AddItem(part,despawnTime)
		local rand = math.random(1,3)
		if rand == 1 then
			TS:Create(part,TweenInfo.new(1.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),{Position = part.Position + Vector3.new(0,part.Size.Y*1.5,0)}):Play()
		elseif rand == 2 then
			TS:Create(part,TweenInfo.new(2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),{Position = part.Position + Vector3.new(0,part.Size.Y*1.5,0)}):Play()
		elseif rand == 3 then
			TS:Create(part,TweenInfo.new(2.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),{Position = part.Position + Vector3.new(0,part.Size.Y*1.5,0)}):Play()
		end
		if Ice then
			part.BrickColor = BrickColor.new("Pastel light blue")
			part.Material = Enum.Material.Ice
		end
		local rand1 = math.random(-180,180)
		local rand2 = math.random(-180,180)
		local rand3 = math.random(-180,180)
		task.spawn(function()
			wait(despawnTime-4.5)
			TS:Create(part,TweenInfo.new(4.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),{Position = part.Position + Vector3.new(0,-part.Size.Y*1.25, 0),Orientation = part.Orientation + Vector3.new(math.random(-10,10),math.random(-10,10),math.random(-10,10))}):Play()
		end)
	end		
end

return Rocks
</ProtectedString>
