							local val2 = Instance.new("BoolValue",hit.Parent)
							val2.Name = "IFrame"
							game:GetService("Debris"):AddItem(val2,5)
							spawn(function()
								hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
