		end)
		task.wait(1.1-0.8)
		if done == false then
			done = true
			cd = true
			stand:Destroy()
			val:Destroy()
			char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
			char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
			task.wait(1.5)
			Deb:Destroy()
			task.wait(1.5)
			cd = false
		end
	end
end)</ProtectedString>
