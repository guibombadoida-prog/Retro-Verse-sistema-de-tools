					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local char = nil
local cd = false
local debris = game:GetService("Debris")
local owner = tool:WaitForChild('owner')
local players = game:GetService("Players")
local animation = require(script:WaitForChild('Animation'))
local assets = script:WaitForChild('Assets'):Clone()
script:WaitForChild('Assets'):Destroy()
local effectsfolder = workspace:FindFirstChildOfClass("Terrain") or workspace
local ragdollmodule = require(script:WaitForChild('Ragdoll'))
local rockmodule2 = require(script:WaitForChild('RockModule2'))
local debrismodule = require(script:WaitForChild('DebrisModule'))
local rockmodule = require(script:WaitForChild('RockModule'))
local StopRemote = script:WaitForChild('StopRemote')
---functions---
getnearobjects = function(pos,range,ignore)
	range = range or 12
	ignore = ignore or char
	local objects = {}
	for i,v in pairs(workspace:GetDescendants())do
		if v:IsA("Model") and v ~= char and v ~= ignore then
			if v:FindFirstChildOfClass("Humanoid") then
				if v.PrimaryPart then
					if (v.PrimaryPart.Position-pos).Magnitude &lt; range then
						table.insert(objects,v)
					end
				end
			end
		end
	end
	---
	return objects
end
smoke = function(pos,lifetime,size,speedmin,speedmax,emit)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {effectsfolder,char} or {effectsfolder}
	local result = workspace:Raycast(pos+Vector3.new(0,1.5,0),Vector3.new(0,-15,0),params)
	if result then
		local attach = Instance.new("Attachment",effectsfolder)
		attach.WorldPosition = result.Position+Vector3.new(0,0.5,0)
		local downsmoke = assets:WaitForChild('Smoke'):Clone()
		downsmoke.Parent = attach
		downsmoke.Size = NumberSequence.new(size)
		downsmoke.Speed = NumberRange.new(speedmin,speedmax)
		downsmoke.Lifetime = NumberRange.new(lifetime)
		downsmoke.Color = ColorSequence.new(result.Instance.Color)
		downsmoke:Emit(emit)
		local upsmoke = assets:WaitForChild('UpSmoke'):Clone()
		upsmoke.Parent = attach
		upsmoke.Size = NumberSequence.new(size)
		upsmoke.Lifetime = NumberRange.new(lifetime)
		upsmoke.Color = ColorSequence.new(result.Instance.Color)
		upsmoke:Emit(emit)
		debris:AddItem(attach,lifetime+0.5)
	end
end
shake = function(lifetime,range,magnitude,roughness,fadein,fadeout,preset)
	preset = preset or nil
	fadein = fadein or 0.3
	fadeout = fadeout or 0.3
	roughness = roughness or 5
	magnitude = magnitude or 5
	range = range or 50
	lifetime = lifetime or 1
	for _,v in pairs(players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Shaker = assets:WaitForChild('Shaker'):Clone()
					Shaker.Roughness.Value = roughness
					Shaker.Magnitude.Value = Magnitude
					Shaker.FadeIn.Value = fadein
					Shaker.FadeOut.Value = fadeout
					if preset ~= nil then
						Shaker.Preset.Value = preset
					end
					Shaker.Parent = v.Backpack
					Shaker.Disabled = false
					debris:AddItem(Shaker,lifetime)
				end
			end
		end
	end
end
newhitbox = function(lifetime,model)
	lifetime = lifetime or 0.5
	local hitboxz = model:Clone()
	hitboxz.Parent = effectsfolder
	debris:AddItem(hitboxz,0.5)
	return hitboxz
end
sfx = function(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
---tool_functions--
activate = function()
	if char ~= owner.Value then return end
	if cd then return end
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	--
	local hrp = char:WaitForChild('HumanoidRootPart')
	local head = char:WaitForChild('Head')
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local oldws = humanoid.WalkSpeed
	local oldjp = humanoid.JumpPower
	--
	local paramshitbox = OverlapParams.new()
	paramshitbox.FilterType = Enum.RaycastFilterType.Blacklist
	paramshitbox.FilterDescendantsInstances = {char}
	--
	animation(char,'barrage')
	humanoid.WalkSpeed = 3.5
	humanoid.JumpPower = 0
	local effs = {}
	local ended = false
	sfx(7325671724,0.65)
	task.wait(0.233)
	spawn(function()
		while task.wait(0.025) do
			if ended == false then
				sfx(9119737388,0.7)
				for i,v in pairs(game.Players:GetPlayers())do
					if v:FindFirstChildOfClass('Backpack') then
						if not v:FindFirstChildOfClass('Backpack'):FindFirstChild('BarrageEff') then
							local eff = assets:WaitForChild('BarrageEff'):Clone()
							eff.char.Value = char
							eff.Parent = v:FindFirstChildOfClass('Backpack')
							eff.Disabled = false
							table.insert(effs,eff)
							game:GetService('Debris'):AddItem(eff,1.067+0.8)
						end
					end
				end
			else
				break
			end
		end
	end)
	spawn(function()
		while task.wait(0.1) do
			if ended == false then
				local hitfunc = function(hit)
					local target = hit.Parent
					if target and target:FindFirstChildOfClass("Humanoid") then
						if not target:FindFirstChild("IFrame") and not target:FindFirstChild("Ragdolled") and not target:FindFirstChild('HitByGarouBarrage') and not char:FindFirstChild("Stunned") then
							local val = Instance.new("BoolValue",target)
							val.Name = "HitByGarouBarrage"
							debris:AddItem(val,0.1)
							--
							local targetroot = target:FindFirstChild('HumanoidRootPart') or target:FindFirstChild("Torso") or nil
							local targethumanoid = target:FindFirstChildOfClass("Humanoid")
							--
							if math.random(1,3) == 1 then
								sfx(9117969892,1,hit)
							elseif math.random(1,3) == 2 then
								sfx(9117969878,1,hit)
							elseif math.random(1,3) == 3 then
								sfx(9117969687,1,hit)
							end
							local val = Instance.new("BoolValue",target)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,0.15)
							local velo = Instance.new("BodyVelocity",hit)
							velo.MaxForce = Vector3.new(1,1,1) * math.huge
							velo.Velocity = Vector3.new(0.001,0.0001,.001)
							game:GetService("Debris"):AddItem(velo,0.15)
							targethumanoid.Health -= targethumanoid.MaxHealth/80
						end
					end
				end
				--
				local hitbox = newhitbox(0.15,assets:WaitForChild('Hitbox'))
				spawn(function()
					while task.wait() do
						if hitbox and hitbox:FindFirstChild('Hitbox') then
							hitbox:SetPrimaryPartCFrame(hrp.CFrame)
							local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
							for _,v in pairs(parts)do
								hitfunc(v)
							end
						else
							break
						end
					end
				end)
			else
				break
			end
		end
	end)
	task.wait(1.067)
	ended = true
	for i,v in pairs(effs)do
		if v:FindFirstChild("Ended") then
			v:FindFirstChild('Ended').Value = true
		end
		debris:AddItem(v,0.8)
	end
	sfx(7325671724,0.65)
	task.wait(0.3)
	--
	local donehit = false
	--
	local ignorethings = {char,effectsfolder}
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = ignorethings
	--
	spawn(function()
		local hitfunc = function(hit)
			local target = hit.Parent
			if target and target:FindFirstChildOfClass("Humanoid") and donehit == false then
				if not target:FindFirstChild("IFrame") and not char:FindFirstChild("Stunned") then
					donehit = true
					--
					local targetroot = target:FindFirstChild('HumanoidRootPart') or target:FindFirstChild("Torso") or nil
					local targethumanoid = target:FindFirstChildOfClass("Humanoid")
					--
					local stun = Instance.new("BoolValue",target)
					stun.Name = "Stunned"
					game:GetService("Debris"):AddItem(stun,2.5)
					local ragdolled = Instance.new("BoolValue",target)
					ragdolled.Name = "Ragdolled"
					game:GetService("Debris"):AddItem(ragdolled,2.5)
					table.insert(ignorethings,target)
					sfx(289842971,1.5,hit)
					sfx(3802270540,1.5,hit)
					shake(3,20,1,1,1,1,'Explosion')
					ragdollmodule:Ragdoll(target,2.5,false)
					targethumanoid.Health -= targethumanoid.MaxHealth/4.5
					rockmodule.createFaceInward(hrp,5,8,3,1.5,1.5,1,true,params)
					rockmodule.createFaceInward(hrp,7,12,4,2.5,2.5,1,true,params)
					spawn(function()
						for i = 1,10 do
							local spread = 8
							local cf = hit.CFrame*CFrame.new(math.random(-spread,spread),1,math.random(-spread,spread))
							debrismodule.Rocks(cf.Position,1,Vector3.new(0,-15,0),true,false,-180,180,40,60,0.1,3.5,3.5,false)
						end
					end)
					smoke(hrp.Position,3,5.5,50,100,30)
					for _,v in pairs(getnearobjects(hrp.Position,13,target))do
						if not v:FindFirstChild('IFrame') then
							local val = Instance.new("BoolValue",v)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,2)
							local val = Instance.new("BoolValue",v)
							val.Name = "Ragdolled"
							game:GetService("Debris"):AddItem(val,2)
							local velo = Instance.new("BodyVelocity",v.PrimaryPart)
							velo.MaxForce = Vector3.new(1,1,1) * 500000
							velo.Velocity = Vector3.new(0,65,0)
							game:GetService("Debris"):AddItem(velo,0.25)
							ragdollmodule:Ragdoll(v,2,false)
							v:FindFirstChildOfClass("Humanoid").Health -= v:FindFirstChildOfClass("Humanoid").MaxHealth/4
						end
					end
				end
			end
		end
		--
		local hitbox = newhitbox(0.2,assets:WaitForChild('Hitbox'))
		spawn(function()
			while task.wait() do
				if hitbox and hitbox:FindFirstChild('Hitbox') and donehit == false then
					hitbox:SetPrimaryPartCFrame(hrp.CFrame)
					local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
					for _,v in pairs(parts)do
						hitfunc(v)
					end
				else
					break
				end
			end
		end)
	end)
	--
	task.wait(0.2)
	donehit = true
	task.wait(0.15)
	deb:Destroy()
	iframe:Destroy()
	StopRemote:FireAllClients()
	humanoid.WalkSpeed = oldws
	humanoid.JumpPower = oldjp
	task.wait(0.25)
	cd = false
end
equip = function()
	char = tool.Parent
end
---connect---
tool.Equipped:Connect(equip)
tool.Activated:Connect(activate)</ProtectedString>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null/></Content>
						<token name="RunContext">0</token>
						<string name="ScriptGuid">{580D8FEF-7198-468B-941A-892914BD45FF}</string>
						<BinaryString name="AttributesSerialize"/>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Script</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
					<Item class="ModuleScript" referent="RBX72BF8488F4AD4804BDBBAA0648617BA5">
						<Properties>
							<Content name="LinkedSource"><null/></Content>
							<ProtectedString name="Source">--[[

   RAGDOLLIFY MODULE

   BY ZERX

   HOW TO USE:

   Module:Kill(Character)  INSTA-KILL
   Module:Ragdoll(Character,Duration,Kill)   Kill = true/false      Duration = How much time do you want them to ragdoll

   27/03/2022 - 9:18 AM
   
]]--
players = game:GetService("Players")
runservice = game:GetService("RunService")
tweenservice = game:GetService("TweenService")
bleedingtime = 3
bloodpuddlesizemultiplier = 1.8
bloodcolorfromtorso = false
cfnew = CFrame.new
cfeuler = CFrame.fromEulerAnglesXYZ
ragdolldespawntime = 5
rand = math.random
function monar(WHAT, duration)
	game:GetService("Debris"):AddItem(WHAT, duration)
end
function push(WHAT, force, debris)
	local v = Instance.new("BodyVelocity", WHAT)
	v.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
	v.Velocity = (WHAT.Position - WHAT.Position).unit*force
	monar(v, debris)
end
function makeballconnections(limb, attachementone, attachmenttwo, twistlower, twistupper, du)
	local connection = Instance.new('BallSocketConstraint', limb)
	local bone = Instance.new("Part", limb)
	connection.LimitsEnabled = true
	connection.Attachment0 = attachementone
	connection.Attachment1 = attachmenttwo
	connection.TwistLimitsEnabled = true
	connection.TwistLowerAngle = twistlower
	connection.TwistUpperAngle = twistupper
	bone:BreakJoints()
	local bonew = Instance.new("Weld", bone)
	bonew.Part0 = limb
	bonew.Part1 = bone
	bonew.C0 = cfeuler(0,0,math.pi/2) * cfnew(-limb.Size.y/4.5,0,0)
	if limb.Parent:FindFirstChildOfClass("Humanoid").RigType == Enum.HumanoidRigType.R6 then
		bone.Size = Vector3.new(limb.Size.y/1.8,limb.Size.z,limb.Size.x)
	else
		bone.Size = Vector3.new(limb.Size.y/3,limb.Size.z,limb.Size.x)
	end
	bone.Transparency = 1
	bone.Shape = "Cylinder"
	local noc = Instance.new("NoCollisionConstraint", bone)
	noc.Part0 = attachementone.Parent
	noc.Part1 = attachmenttwo.Parent
	monar(bone, du)
	monar(connection, du)
end
function makehingeconnections(limb, attachementone, attachmenttwo, lower, upper, du)
	local connection = Instance.new('HingeConstraint', limb)
	local bone = Instance.new("Part", limb)
	connection.LimitsEnabled = true
	connection.Attachment0 = attachementone
	connection.Attachment1 = attachmenttwo
	connection.LimitsEnabled = true
	connection.LowerAngle = lower
	connection.UpperAngle = upper
	bone:BreakJoints()
	local bonew = Instance.new("Weld", bone)
	bonew.Part0 = limb
	bonew.Part1 = bone
	bonew.C0 = cfeuler(0,0,math.pi/2) * cfnew(-limb.Size.y/4.5,0,0)
	if limb.Parent:FindFirstChildOfClass("Humanoid").RigType == Enum.HumanoidRigType.R6 then
		bone.Size = Vector3.new(limb.Size.y/1.8,limb.Size.z,limb.Size.x)
	elseif limb.Parent:FindFirstChildOfClass("Humanoid").RigType == Enum.HumanoidRigType.R15 then
		bone.Size = Vector3.new(limb.Size.y/3,limb.Size.z,limb.Size.x)
	elseif limb.Name == "Head" then
		bone.Size = Vector3.new(limb.Size.y/5,limb.Size.z,limb.Size.x)
	end
	bone.Transparency = 1
	bone.Shape = "Cylinder"
	local noc = Instance.new("NoCollisionConstraint", bone)
	noc.Part0 = attachementone.Parent
	noc.Part1 = attachmenttwo.Parent
	monar(bone, du)
	monar(connection, du)
end
function makeragdolllimbr6(limb, dudetorso, at1pos, at2pos, lowt, upt, duratio)
	local at1 = Instance.new("Attachment", dudetorso)
	local at2 = Instance.new("Attachment", limb)
	at1.Position = at1pos
	at2.Position = at2pos
	makeballconnections(limb, at1, at2, lowt, upt, duratio)
	game.Debris:AddItem(at1, duratio)
	game.Debris:AddItem(at2, duratio)
end
function ragdollify(ch, duration, dea)
	local chum = ch:FindFirstChildOfClass("Humanoid")
	if chum then
		if not chum.PlatformStand then
			chum.PlatformStand = true
			if dea then
				chum.RequiresNeck = false
				chum.Health = 0
				local hpsc = ch:FindFirstChild("Health")
				if hpsc then
					if hpsc:IsA("Script") then
						hpsc.Disabled = true
					end
				end
				if ch:FindFirstChild("HumanoidRootPart") then
					ch:FindFirstChild("HumanoidRootPart"):Destroy()
				end
				push(ch.Head, 10, 0.3)
				monar(ch, ragdolldespawntime)
			elseif ch:FindFirstChild("HumanoidRootPart") then
				if ch:FindFirstChild("HumanoidRootPart").CanCollide then
					ch:FindFirstChild("HumanoidRootPart").CanCollide = false
					coroutine.wrap(function()
						task.wait(duration)
						if ch then
							if ch:FindFirstChild("HumanoidRootPart") then
								ch:FindFirstChild("HumanoidRootPart").CanCollide = true
							end
						end
					end)()
				end
			end
			local savedglue = {}
			local mainpart
			if chum.RigType == Enum.HumanoidRigType.R6 then
				local chtor = ch.Torso
				mainpart = chtor
				if not dea then
					for i,v in pairs(chtor:GetChildren()) do
						if v:IsA("Motor6D") then
							if v.Part1 ~= nil and v.Part0 ~= nil then
