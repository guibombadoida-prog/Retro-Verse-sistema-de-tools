							<Properties>
								<ProtectedString name="Source">local thing = script.Parent
local modules = thing:WaitForChild('Modules')
local rockmodule = require(modules:WaitForChild('RocksModule'))
local debrismodule = require(modules:WaitForChild('DebrisModule'))
spawn(function()
	for i = 1,21 do
		spawn(function()
			for z = 1,3 do
				if thing:WaitForChild('yoo'):FindFirstChild(i) then
					if thing:WaitForChild('yoo'):FindFirstChild(i):FindFirstChildOfClass("ParticleEmitter") then
						thing:WaitForChild('yoo'):FindFirstChild(i):FindFirstChildOfClass("ParticleEmitter"):Emit(1)
					end
					debrismodule.Rocks((thing:WaitForChild('yoo'):FindFirstChild(i).CFrame*CFrame.new(math.random(-2,2),0,0)).Position,2,Vector3.new(0,-15,0),false,false,-180,180,50,150,1.5,10,2.5,false)
				end
				task.wait()
			end
		end)
		task.wait()
	end
end)
for i = 1,4 do
	spawn(function()
		local cf = thing:WaitForChild('r'..i).CFrame
		local size = 1
		for i = 1,200 do
			rockmodule.Ground(cf.Position + Vector3.new(0,1,0),20,Vector3.new(size,size,size),false,8.5)
			if i &lt; 35 and i &gt; 15 then
				size = size + 2.5
			elseif i &lt; 35 and i &lt;= 15 then
				size = size + 0.2
			elseif i &gt;= 35 then
				size = size + 8.5
			end
			cf = cf*CFrame.new(0,0,-size/Random.new():NextNumber(1.5,2))
		end
	end)
end
spawn(function()
	local currentpos = Vector3.new(0,0,0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {thing}
	for i = 0,math.abs(200/21) do
		currentpos = currentpos - Vector3.new(0,0,21)
		local attach = Instance.new("Attachment",thing:WaitForChild('Root'))
		attach.Position = currentpos
		game:GetService("Debris"):AddItem(attach,0.5)
		local ray = workspace:Raycast(attach.WorldPosition,Vector3.new(0,-15,0),params)
		if ray then
			if i &lt; 35 and i &gt; 5 then
				for z = 1,5 do
					debrismodule.Rocks((attach.WorldCFrame*CFrame.new(math.random(-30,30),0,0)).Position,1,Vector3.new(0,-15,0),true,false,-180,180,250,400,4,15,8.5)
				end
			end
			if i &lt;= 5 then
				for z = 1,8 do
					debrismodule.Rocks((attach.WorldCFrame*CFrame.new(math.random(-15,15),0,0)).Position,1,Vector3.new(0,-15,0),true,false,-180,180,100,150,2,3,8.5)
				end
			end
		end
	end
end)
game:GetService("TweenService"):Create(thing:WaitForChild('beam'),TweenInfo.new(3.5),{Size = Vector3.new(0,0,255.807)}):Play()
game:GetService("Debris"):AddItem(thing:WaitForChild('beam'),3.5)
game:GetService("Debris"):AddItem(thing,9)</ProtectedString>
