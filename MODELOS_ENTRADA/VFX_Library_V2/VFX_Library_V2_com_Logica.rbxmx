					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local owner = tool:WaitForChild('owner')
local cd = false
local balls = script:WaitForChild('balls'):Clone()
script:WaitForChild('balls'):Destroy()
local Hollow = script:WaitForChild('Hollow'):Clone()
script:WaitForChild('Hollow'):Destroy()
local Purple = script:WaitForChild('Purple'):Clone()
script:WaitForChild('Purple'):Destroy()
local RagdollModule = require(script:WaitForChild('Ragdoll'))
local rockmodule = require(script:WaitForChild('Modules'):WaitForChild('RocksModule'))
local debrismodule = require(script:WaitForChild('Modules'):WaitForChild('DebrisModule'))
local char = nil
local a = 0
---
local function lerp(a, b, c)
	return a + (b - a) * c
end
local function quadBezier(t, p0, p1, p2)
	local l1 = lerp(p0, p1, t)
	local l2 = lerp(p1, p2, t)
	local quad = lerp(l1, l2, t)
	return quad
end
function contains(v, t)
	for _, val in pairs(t) do
		if val == v then
			return true
		end
	end
	return false
end
function sfx(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function shake(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake3:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
function shake2(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake2:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
---
tool.Equipped:Connect(function()
	char = tool.Parent
end)
tool.Activated:Connect(function()
	if cd then return end
	if char ~= owner.Value then return end
	if char:FindFirstChild("Stunned") then return end
	if char:FindFirstChild("Debounce") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	local hum = char:FindFirstChildOfClass("Humanoid")
	local oldws = hum.WalkSpeed
	local oldjp = hum.JumpPower
	task.wait()
	local hrp = char:WaitForChild('HumanoidRootPart')
	require(script:WaitForChild('Animation'))(char,'paunch')
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	sfx(6863140116,0.65)
	task.wait(0.85)
	local ballz = balls:Clone()
	ballz.Welder.Anchored = false
	spawn(function()
		local wel = Instance.new("Weld",ballz)
		wel.Part0 = hrp
		wel.Part1 = ballz.Welder
	end)
	ballz.Parent = char
	ballz.Blue.Attachment.ImpactGlow:Emit(5)
	for i,v in pairs(ballz.Blue:GetDescendants())do
		if v:IsA("Beam") or v:IsA("ParticleEmitter") then
			if v.Name ~= "ImpactGlow" then
				v.Enabled = true
			end
		end
	end
	shake2(35)
	sfx(5753042081,1)
	task.wait(1.5-0.85)
	ballz.Red.Attachment.ImpactGlow:Emit(5)
	for i,v in pairs(ballz.Red:GetDescendants())do
		if v:IsA("Beam") or v:IsA("ParticleEmitter") then
			if v.Name ~= "ImpactGlow" then
				v.Enabled = true
			end
		end
	end
	sfx(5753042081,1)
	shake2(35)
	task.wait(2.1-1.5)
	for i,v in pairs(ballz.Red:GetChildren())do
		if v:IsA("Attachment") then
			for i,c in pairs(ballz.Red2:GetChildren())do
				if c:IsA('Attachment') then
					if v.Name == c.Name then
						game:GetService("TweenService"):Create(v,TweenInfo.new(3.2-2.1),{Position = c.Position}):Play()
					end
				end
			end
		end
	end
	for i,v in pairs(ballz.Blue:GetChildren())do
		if v:IsA("Attachment") then
			for i,c in pairs(ballz.Blue2:GetChildren())do
				if c:IsA('Attachment') then
					if v.Name == c.Name then
						game:GetService("TweenService"):Create(v,TweenInfo.new(3.2-2.1),{Position = c.Position}):Play()
					end
				end
			end
		end
	end
	sfx(9114428742,1.5)
	task.wait(3.2-2.1)
	ballz:Destroy()
	local ball1 = Hollow:Clone()
	ball1.Anchored = false
	spawn(function()
		local wel = Instance.new("Weld",ball1)
		wel.Part0 = hrp
		wel.Part1 = ball1
	end)
	shake2(35)
	ball1.Parent = char
	rockmodule.Ground((hrp.CFrame*CFrame.new(0,0,-10)).Position,10,Vector3.new(2,2,2),8,false,6.5)
	ball1.Attachment.ImpactGlow:Emit(15)
	task.wait(3.5-3.2)
	game:GetService("TweenService"):Create(ball1.Attachment,TweenInfo.new(3.8-3.5),{Position = ball1.Attachment2.Position}):Play()
