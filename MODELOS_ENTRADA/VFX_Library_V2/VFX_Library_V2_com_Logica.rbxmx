				<Item class="Script" referent="RBX4FFF782FF4594B799CF2DBBEBDA8F069">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local owner = tool:WaitForChild('owner')
local cd = false
local smash = script:WaitForChild('Smash'):Clone()
script:WaitForChild('Smash'):Destroy()
local aura = script:WaitForChild('Aura'):Clone()
script:WaitForChild('Aura'):Destroy()
local RagdollModule = require(script:WaitForChild('Ragdoll'))
local char = nil
---
function sfx(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function shake(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake2:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
---
tool.Equipped:Connect(function()
	char = tool.Parent
end)
tool.Activated:Connect(function()
	if cd then return end
	if char ~= owner.Value then return end
	if char:FindFirstChild("Stunned") then return end
	if char:FindFirstChild("Debounce") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	local hum = char:FindFirstChildOfClass("Humanoid")
	local oldws = hum.WalkSpeed
	local oldjp = hum.JumpPower
	local hrp = char:WaitForChild('HumanoidRootPart')
	require(script:WaitForChild('Animation'))(char,'smash')
	task.wait()
	hum.WalkSpeed = 0
	hum.AutoRotate = false
	hum.JumpPower = 0
	local cameraeffect = script:WaitForChild('Camera'):Clone()
	cameraeffect.Value.Value = char:WaitForChild('Head')
	cameraeffect.Value2.Value = char
	cameraeffect.Parent = game:GetService('Players'):GetPlayerFromCharacter(char):FindFirstChildOfClass("Backpack")
	cameraeffect.Disabled = false
	local attach = Instance.new("Attachment",char:WaitForChild('Head'))
	attach.Position = Vector3.new(0.181, -0.287, -0.589)
	local bleed1 = script:WaitForChild('Bleed'):FindFirstChild('1'):Clone()
	bleed1.Parent = attach
	local bleed2 = script:WaitForChild('Bleed'):FindFirstChild('2'):Clone()
	bleed2.Parent = attach
	local splat = script:WaitForChild('Bleed'):FindFirstChild("splat"):Clone()
	splat.Parent = attach
	bleed1.Enabled = true
	bleed2.Enabled = true
	local theme = Instance.new("Sound",hrp)
	theme.SoundId = "rbxasset://LastTheme.mp3"
	theme.Name = "LastTheme"
	theme.Volume = 1.75
	theme.RollOffMode =  Enum.RollOffMode.LinearSquare
	theme.RollOffMinDistance = 10
	theme.RollOffMaxDistance = 85
	theme:Play()
	task.wait(1.45)
	sfx(7002934778)
	task.wait(0.7)
	sfx(7002934832)
	task.wait(0.25)
	sfx(7002935021)
	task.wait(0.4)
	sfx(9119068992,0.85)
	task.wait(0.7)
	sfx(9113464550,0.75)
	bleed1.Enabled = false
	bleed2.Enabled = false
	splat:Emit(13)
	task.wait(0.5)
	sfx(7325671724,0.85)
	task.wait(0.75)
	sfx(3802269741,6)
	sfx(8468883729,2.5)
	local eff = smash:Clone()
	eff.Value.Value = char
	eff:SetPrimaryPartCFrame(hrp.CFrame)
	eff.Parent = workspace
	eff.mainscript.Disabled = false
	shake(200)
	game:GetService("Debris"):AddItem(theme,57)
	spawn(function()
		task.wait(54)
		if theme then
			game:GetService("TweenService"):Create(theme,TweenInfo.new(2),{Volume = 0}):Play()
		end
	end)
	if char:FindFirstChild("Left Arm") then
		pcall(function()
			local at1 = Instance.new("Attachment",char:FindFirstChild("Left Arm"))
			at1.Name = "BaseBeam"
			at1.Position = Vector3.new(-0.25,-0.25,0)
			local at2 = Instance.new("Attachment",char:FindFirstChild("Left Arm"))
			at2.Name = "BaseBeam2"
			at2.Position = Vector3.new(-1, 2.75, -0)
			local beam1 = script:WaitForChild('Beam1'):Clone()
			beam1.Parent = at1
			beam1.Attachment0 = at1
			beam1.Attachment1 = at2
			beam1.Enabled = true
			local beam2 = script:WaitForChild('Beam2'):Clone()
			beam2.Parent = at1
			beam2.Attachment0 = at1
			beam2.Attachment1 = at2
			beam2.Enabled = true
			game:GetService("Debris"):AddItem(at1,55.5)
			game:GetService("Debris"):AddItem(at2,55.5)
		end)
	end
	if char:FindFirstChild("Left Leg") then
		pcall(function()
			local at1 = Instance.new("Attachment",char:FindFirstChild("Left Leg"))
			at1.Name = "BaseBeam"
			at1.Position = Vector3.new(-0.25,-0.25,0)
			local at2 = Instance.new("Attachment",char:FindFirstChild("Left Leg"))
			at2.Name = "BaseBeam2"
			at2.Position = Vector3.new(-1, 2.75, -0)
			local beam1 = script:WaitForChild('Beam1'):Clone()
			beam1.Parent = at1
			beam1.Attachment0 = at1
			beam1.Attachment1 = at2
			beam1.Enabled = true
			local beam2 = script:WaitForChild('Beam2'):Clone()
			beam2.Parent = at1
			beam2.Attachment0 = at1
			beam2.Attachment1 = at2
			beam2.Enabled = true
			game:GetService("Debris"):AddItem(at1,55.5)
			game:GetService("Debris"):AddItem(at2,55.5)
		end)
	end
	if char:FindFirstChild("Right Arm") then
		pcall(function()
			local at1 = Instance.new("Attachment",char:FindFirstChild("Right Arm"))
			at1.Name = "BaseBeam"
			at1.Position = Vector3.new(0.25,-0.25,0)
			at1.Orientation = Vector3.new(0,180,0)
			local at2 = Instance.new("Attachment",char:FindFirstChild("Right Arm"))
			at2.Name = "BaseBeam2"
			at2.Position = Vector3.new(1, 2.75, -0)
			at2.Orientation = Vector3.new(0,180,0)
			local beam1 = script:WaitForChild('Beam1'):Clone()
			beam1.Parent = at1
			beam1.Attachment0 = at1
			beam1.Attachment1 = at2
			beam1.Enabled = true
			local beam2 = script:WaitForChild('Beam2'):Clone()
			beam2.Parent = at1
			beam2.Attachment0 = at1
			beam2.Attachment1 = at2
			beam2.Enabled = true
			game:GetService("Debris"):AddItem(at1,55.5)
			game:GetService("Debris"):AddItem(at2,55.5)
		end)
	end
	if char:FindFirstChild("Right Leg") then
		pcall(function()
			local at1 = Instance.new("Attachment",char:FindFirstChild("Right Leg"))
			at1.Name = "BaseBeam"
			at1.Position = Vector3.new(0.25,-0.25,0)
			at1.Orientation = Vector3.new(0,180,0)
			local at2 = Instance.new("Attachment",char:FindFirstChild("Right Leg"))
			at2.Name = "BaseBeam2"
			at2.Position = Vector3.new(1, 2.75, -0)
			at2.Orientation = Vector3.new(0,180,0)
			local beam1 = script:WaitForChild('Beam1'):Clone()
			beam1.Parent = at1
			beam1.Attachment0 = at1
			beam1.Attachment1 = at2
			beam1.Enabled = true
			local beam2 = script:WaitForChild('Beam2'):Clone()
			beam2.Parent = at1
			beam2.Attachment0 = at1
			beam2.Attachment1 = at2
			beam2.Enabled = true
			game:GetService("Debris"):AddItem(at1,55.5)
			game:GetService("Debris"):AddItem(at2,55.5)
		end)
	end
	if char:FindFirstChild("Head") then
		pcall(function()
			local at1 = Instance.new("Attachment",char:FindFirstChild("Head"))
			at1.Name = "BaseBeam"
			at1.Position = Vector3.new(0,0,0)
			local at2 = Instance.new("Attachment",char:FindFirstChild("Head"))
			at2.Name = "BaseBeam2"
			at2.Position = Vector3.new(0, 2, -0)
			local beam1 = script:WaitForChild('Beam1'):Clone()
			beam1.Parent = at1
			beam1.Attachment0 = at1
			beam1.Attachment1 = at2
			beam1.Enabled = true
			local beam2 = script:WaitForChild('Beam2'):Clone()
			beam2.Parent = at1
			beam2.Attachment0 = at1
			beam2.Attachment1 = at2
			beam2.Enabled = true
			game:GetService("Debris"):AddItem(at1,55.5)
			game:GetService("Debris"):AddItem(at2,55.5)
		end)
	end
	for i,v in pairs(char:GetChildren())do
		if v:IsA("BasePart") then
			if v.Name ~= "HumanoidRootPart" then
				for i,c in pairs(aura:GetChildren())do
					local auraeff = c:Clone()
					auraeff.Parent = v
					spawn(function()
						task.wait(55)
						if auraeff then
							if auraeff:IsA('ParticleEmitter') then
								auraeff.Enabled = false
							end
						end
					end)
					game:GetService("Debris"):AddItem(auraeff,57)
				end
			end
		end
	end
	for i,v in pairs(workspace:GetDescendants())do
		if v:IsA("Model") and v ~= char then
			if v:FindFirstChildOfClass("Humanoid") then
				if v.PrimaryPart then
					if (v.PrimaryPart.Position-hrp.Position).Magnitude &lt; 125 then
						if not v:FindFirstChild('IFrame') then
							local val = Instance.new("BoolValue",v)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,2)
							local val = Instance.new("BoolValue",v)
							val.Name = "Ragdolled"
							game:GetService("Debris"):AddItem(val,2)
							local velo = Instance.new("BodyVelocity",v.PrimaryPart)
							velo.MaxForce = Vector3.new(1,1,1) * 500000
							velo.Velocity = Vector3.new(0,65,0)
							game:GetService("Debris"):AddItem(velo,0.25)
							RagdollModule:Ragdoll(v,2,false)
							v:FindFirstChildOfClass("Humanoid").Health -= v:FindFirstChildOfClass("Humanoid").MaxHealth/3
						end
					end
				end
			end
		end
	end
	task.wait(0.85)
	local oldmaxhealth = hum.MaxHealth
	attach:Destroy()
	hum.WalkSpeed = oldws
	hum.JumpPower = oldjp
	deb:Destroy()
	iframe:Destroy()
	hum.AutoRotate = true
	if cameraeffect then
		cameraeffect:Destroy()
	end
	script:WaitForChild('StopAnimation'):FireAllClients()
	hum.MaxHealth *= 3.5
	hum.Health = hum.MaxHealth
	spawn(function()
		task.wait(56.15)
		hum.MaxHealth = oldmaxhealth
	end)
	task.wait(56.15)
	cd = false
end)</ProtectedString>
