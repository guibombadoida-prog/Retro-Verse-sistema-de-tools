<Item class="Folder" referent="RBX099AAA72AA8841E287C9BE99C73D3824">
				<Properties>
					<string name="Name">Normal Punch</string>
					</Properties>
				<Item class="Script" referent="RBX69FA7F3CC32D4836B836768A511E2B1E">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local owner = tool:WaitForChild('owner')
local cd = false
local hitbox = script.Hitbox:Clone()
script.Hitbox:Destroy()
local rockseff = script:WaitForChild('rocks'):Clone()
script:WaitForChild('rocks'):Destroy()
local ringeff = script.ring:Clone()
script.ring:Destroy()
local RagdollModule = require(script:WaitForChild('Ragdoll'))
local rockmodule = require(script:WaitForChild('Modules'):WaitForChild('RocksModule'))
local debrismodule = require(script:WaitForChild('Modules'):WaitForChild('DebrisModule'))
local char = nil
local a = 0
---
local function lerp(a, b, c)
	return a + (b - a) * c
end
local function quadBezier(t, p0, p1, p2)
	local l1 = lerp(p0, p1, t)
	local l2 = lerp(p1, p2, t)
	local quad = lerp(l1, l2, t)
	return quad
end
function contains(v, t)
	for _, val in pairs(t) do
		if val == v then
			return true
		end
	end
	return false
end
function sfx(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function shake(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake2:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
---
tool.Equipped:Connect(function()
	char = tool.Parent
end)
tool.Activated:Connect(function()
	if cd then return end
	if char ~= owner.Value then return end
	if char:FindFirstChild("Stunned") then return end
	if char:FindFirstChild("Debounce") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	local hum = char:FindFirstChildOfClass("Humanoid")
	local oldws = hum.WalkSpeed
	local oldjp = hum.JumpPower
	task.wait()
	local hrp = char:WaitForChild('HumanoidRootPart')
	require(script:WaitForChild('Animation'))(char,'paunch')
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	task.wait(0.067)
	sfx(6863140116,0.65)
	task.wait(0.567-0.067)
	sfx(7325671724,0.65)
	task.wait(0.65-0.567)
	sfx(3183222154,1.5)
	local effectrock = rockseff:Clone()
	effectrock:SetPrimaryPartCFrame(hrp.CFrame)
	effectrock.Parent = workspace.Terrain or workspace
	effectrock.mainscript.Disabled = false
	shake(40)
	local done = false
	spawn(function()
		local indi = hitbox:Clone()
		indi.Parent = workspace:FindFirstChildOfClass("Terrain")
		indi.Weld.Anchored = false
		local weld = Instance.new("Weld",indi)
		weld.Part0 = hrp
		weld.Part1 = indi.Weld
		game:GetService("Debris"):AddItem(indi,0.8-0.65)
		indi.Hitbox.Touched:Connect(function(hit)
			if done == true then return end
			if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
				if not hit.Parent:FindFirstChild("IFrame") then
					if not hit.Parent:FindFirstChild('hitbysaitamalol') then
						local val3 = Instance.new("BoolValue",hit.Parent) 
						val3.Name = "hitbysaitamalol"
						game:GetService("Debris"):AddItem(val3,0.8-0.65)
						local magnitude = (hit.Position-hrp.Position).Magnitude
						if magnitude &lt; 12.5 then
							local ring = ringeff:Clone()
							ring.Parent = workspace.Terrain or workspace
							ring:SetPrimaryPartCFrame(hrp.CFrame)
							ring.mainscript.Disabled = false
							sfx(3802269741,0.5)
							shake(35)
							if hit.Parent then
								if hit.Parent:FindFirstChild('HumanoidRootPart') then
									pcall(function()
										local attach1 = Instance.new("Attachment",hit.Parent:FindFirstChild('HumanoidRootPart'))
										local attach2 = Instance.new("Attachment",hit.Parent:FindFirstChild('HumanoidRootPart'))
										attach1.Position = Vector3.new(1,0,0)
										attach2.Position = Vector3.new(-1,0,0)
										local trail = script:WaitForChild('Trail'):Clone()
										trail.Parent = hit.Parent:FindFirstChild('HumanoidRootPart')
										trail.Attachment0 = attach1
										trail.Attachment1 = attach2
										trail.Enabled = true
										game:GetService("Debris"):AddItem(trail,2.5)
										game:GetService("Debris"):AddItem(attach1,2.5)
										game:GetService("Debris"):AddItem(attach2,2.5)
										spawn(function()
											task.wait(2)
											if trail then
												trail.Enabled = false
											end
										end)
									end)
								elseif hit.Parent:FindFirstChild('Torso') then
									pcall(function()
										local attach1 = Instance.new("Attachment",hit.Parent:FindFirstChild('Torso'))
										local attach2 = Instance.new("Attachment",hit.Parent:FindFirstChild('Torso'))
										attach1.Position = Vector3.new(1,0,0)
										attach2.Position = Vector3.new(-1,0,0)
										local trail = script:WaitForChild('Trail'):Clone()
										trail.Parent = hit.Parent:FindFirstChild('Torso')
										trail.Attachment0 = attach1
										trail.Attachment1 = attach2
										trail.Enabled = true
										game:GetService("Debris"):AddItem(trail,2.5)
										game:GetService("Debris"):AddItem(attach1,2.5)
										game:GetService("Debris"):AddItem(attach2,2.5)
										spawn(function()
											task.wait(2)
											if trail then
												trail.Enabled = false
											end
										end)
									end)
								end
							end
							local velo = Instance.new("BodyVelocity",hit)
							velo.MaxForce = Vector3.new(1,1,1) * 300000
							velo.Velocity = hrp.CFrame.LookVector * 100 + Vector3.new(0,50,0)
							game:GetService("Debris"):AddItem(velo,0.35)
							local val = Instance.new("BoolValue",hit.Parent)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,2.5)
							local val2 = Instance.new("BoolValue",hit.Parent)
							val2.Name = "Ragdolled"
							game:GetService("Debris"):AddItem(val2,2.5)
							RagdollModule:Ragdoll(hit.Parent,2.5,false)
							hit.Parent:FindFirstChildOfClass("Humanoid").Health -= hit.Parent:FindFirstChildOfClass("Humanoid").MaxHealth/2.5
							spawn(function()
								task.wait(1.5)
								if hit then
									if hit.Parent then
										if hit.Parent:FindFirstChildOfClass("Humanoid") then
											sfx(2648568095,3.5,hit)
											spawn(function()
												for i = 1,6 do
													debrismodule.Rocks((hit.CFrame*CFrame.new(math.random(-20,20),1,math.random(-20,20))).Position,math.random(3,10),Vector3.new(0,-15,0),false,false,-180,180,50,80,1,2,4,false)
												end
											end)
											rockmodule.Ground(hit.Position,10,Vector3.new(3,3,3),5,false,4.5)
											rockmodule.Ground(hit.Position,5,Vector3.new(1.5,1.5,1.5),3,false,4.5)
											spawn(function()
												local params = RaycastParams.new()
												params.FilterType = Enum.RaycastFilterType.Exclude
												params.FilterDescendantsInstances = {char,workspace.Terrain} or {char} or {}
												local smoke = script:WaitForChild('Smoke'):Clone()
												local result = workspace:Raycast(hit.Position,Vector3.new(0,-15,0),params)
												if result then
													smoke.Color = ColorSequence.new(result.Instance.Color)
												end
												smoke.Parent = hit
												smoke:Emit(4)
												game:GetService("Debris"):AddItem(smoke,2.5)
											end)
											hit.Parent:FindFirstChildOfClass("Humanoid").Health -= hit.Parent:FindFirstChildOfClass("Humanoid").MaxHealth/10
										end
									end
								end
							end)
						else
							local velo = Instance.new("BodyVelocity",hit)
							velo.MaxForce = Vector3.new(1,1,1) * 300000
							velo.Velocity = hrp.CFrame.LookVector * 50
							game:GetService("Debris"):AddItem(velo,0.35)
							local val = Instance.new("BoolValue",hit.Parent)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,2.5)
							local val2 = Instance.new("BoolValue",hit.Parent)
							val2.Name = "Ragdolled"
							game:GetService("Debris"):AddItem(val2,2.5)
							RagdollModule:Ragdoll(hit.Parent,2.5,false)
							hit.Parent:FindFirstChildOfClass("Humanoid").Health -= hit.Parent:FindFirstChildOfClass("Humanoid").MaxHealth/4.5
						end
					end
				end
			end
		end)
		if indi then
			if indi.Hitbox then
				for i,hit in pairs(indi.Hitbox:GetTouchingParts())do
