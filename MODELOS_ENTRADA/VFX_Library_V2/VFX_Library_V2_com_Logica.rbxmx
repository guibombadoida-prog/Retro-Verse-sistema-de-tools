game:GetService("Debris"):AddItem(col,0.833-0.283+0.1)
task.wait(0.833-0.283)
col.Brightness = 0.5
game:GetService("TweenService"):Create(col,TweenInfo.new(0.1),{TintColor = Color3.fromRGB(255, 255, 255)}):Play()
task.wait(0.1)
col.Brightness = 0
script:WaitForChild('RemoteEvent',15):FireServer()</ProtectedString>
