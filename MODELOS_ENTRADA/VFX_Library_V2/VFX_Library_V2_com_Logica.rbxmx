							spawn(function()
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 3.5
								sound3.PlayOnRemove = true
								sound3.SoundId = "rbxassetid://9071337529"
								sound3:Destroy()
								task.wait(0.773)
								local sound3 = Instance.new("Sound",char.HumanoidRootPart)
								sound3.Volume = 1.5
								sound3.PlayOnRemove = true
								sound3.SoundId = "rbxassetid://7280544801"
