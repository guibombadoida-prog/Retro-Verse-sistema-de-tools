			local sparks = smodule.new(lightning,20)
			task.wait(.5)
			sparks:Destroy()
			lightning:Destroy()
		end)
		spawn(function()
			local lightning = lmodule.new(curpart.Attachment,script.Parent.EnemyRoot.Attachment,15)
			lightning.CurveSize0 = math.random(-5,5)
			lightning.CurveSize1 = math.random(-5,5)
			lightning.Frequency = 2
			lightning.Thickness = 3
			lightning.PulseSpeed = 20
			lightning.PulseLength = 0.5
			lightning.FadeLength = 0.25
			lightning.MaxRadius = 1
			lightning.AnimationSpeed = 30
			lightning.Color = Color3.fromRGB(128, 187, 219)
			local sparks = smodule.new(lightning,20)
			task.wait(.5)
			sparks:Destroy()
			lightning:Destroy()
		end)
		spawn(function()
			local lightning = lmodule.new(curpart.Attachment,script.Parent.EnemyRoot.Attachment,15)
			lightning.CurveSize0 = math.random(-5,5)
			lightning.CurveSize1 = math.random(-5,5)
			lightning.Frequency = 2
			lightning.Thickness = 3
			lightning.PulseSpeed = 20
			lightning.PulseLength = 0.5
			lightning.FadeLength = 0.25
			lightning.MaxRadius = 1
			lightning.AnimationSpeed = 30
			lightning.Color = Color3.fromRGB(128, 187, 219)
			local sparks = smodule.new(lightning,20)
			task.wait(.5)
			sparks:Destroy()
			lightning:Destroy()
		end)
		spawn(function()
			local lightning = lmodule.new(curpart.Attachment,script.Parent.EnemyRoot.Attachment,15)
			lightning.CurveSize0 = math.random(-5,5)
			lightning.CurveSize1 = math.random(-5,5)
			lightning.Frequency = 2
			lightning.Thickness = 3
			lightning.PulseSpeed = 20
			lightning.PulseLength = 0.5
			lightning.FadeLength = 0.25
			lightning.MaxRadius = 1
			lightning.AnimationSpeed = 30
			lightning.Color = Color3.fromRGB(128, 187, 219)
			local sparks = smodule.new(lightning,20)
			task.wait(.5)
			sparks:Destroy()
			lightning:Destroy()
		end)
		spawn(function()
			local eff = ring:Clone()
			eff.Parent = workspace
			local ran1 = math.random(-180,180)
			local ran2 = math.random(-180,180)
			local ran3 = math.random(-180,180)
			eff.Ring.Position = script.Parent.EnemyRoot.Position
			eff.Ring.Orientation = Vector3.new(ran1,ran2,ran3)
			game.TweenService:Create(eff.Ring,TweenInfo.new(0.65),{Size = Vector3.new(100,1.5,100),Transparency = 1}):Play()
			game.Debris:AddItem(eff,0.65)
		end)
		HiteffectBall(script.Parent.EnemyRoot,script.Parent.EnemyRoot.CFrame * CFrame.new(math.random(-1,5),math.random(-1,5),math.random(-1,5)))
		spawn(function()
			if math.random(1,8) == 1 then
