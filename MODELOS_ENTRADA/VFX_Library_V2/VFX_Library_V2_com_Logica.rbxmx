									<ProtectedString name="Source">local Rocks = {}

local TS = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")
local PS = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local Modules = script.Parent
local cacheFolder = workspace:FindFirstChildOfClass("Terrain")
function Rocks.Ground(Pos, Distance, Size, Ice, despawnTime)
	local random = Random.new()

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {cacheFolder}
	local size
	size = Size or Vector3.new(2, 2, 2)
	local pos = Pos
	despawnTime = despawnTime or 3

	local ray = workspace:Raycast(Pos, (Vector3.new(0, -1, 0)*Distance), params)
	if ray then
		local part = Instance.new("Part")
		
		part.CFrame = CFrame.new(ray.Position, Pos) * CFrame.fromEulerAnglesXYZ(random:NextNumber(-.25, .5), random:NextNumber(-.25, .25), random:NextNumber(-.25, .25))
		part.Size = size * random:NextNumber(0.5, 1.2)

		if ray.Instance.Material == Enum.Material.Concrete or ray.Instance.Material == Enum.Material.Air or ray.Instance.Material == Enum.Material.Wood or ray.Instance.Material == Enum.Material.Neon or ray.Instance.Material == Enum.Material.WoodPlanks then
			part.Material = ray.Instance.Material	
		else
			part.Material = ray.Instance.Material	
		end

		part.Color = ray.Instance.Color
		part.Anchored = true
		part.CanTouch = false
		part.CanCollide = true
		part.Transparency = 0
		part.Position = part.Position - Vector3.new(0,part.Size.Y,0)
		game.Debris:AddItem(part,despawnTime)
		part.Parent = cacheFolder
		TS:Create(part,TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.InOut),{Position = part.Position + Vector3.new(0,part.Size.Y,0)}):Play()
		if Ice then
			part.BrickColor = BrickColor.new("Pastel light blue")
			part.Material = Enum.Material.Ice
		end
		local rand1 = math.random(-180,180)
		local rand2 = math.random(-180,180)
		local rand3 = math.random(-180,180)
		task.spawn(function()
			wait(despawnTime-2.5)
			TS:Create(part,TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),{Position = part.Position + Vector3.new(0,-part.Size.Y*1.05, 0),Orientation = part.Orientation + Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
		end)
	end		
end

return Rocks
