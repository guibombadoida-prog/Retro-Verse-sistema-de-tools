						<Properties>
							<ProtectedString name="Source">local cam = workspace.CurrentCamera
cam.CameraType = "Scriptable"
local oldfov = cam.FieldOfView
cam.CFrame = script:WaitForChild('C1',15).CFrame * CFrame.new(0,-1.5,0)
game.TweenService:Create(cam,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = script:WaitForChild('C1',15).CFrame}):Play()
script.Destroying:Connect(function()
	cam.CameraType = "Custom"
	cam.FieldOfView = oldfov
end)
cam.FieldOfView = 60
game.TweenService:Create(cam,TweenInfo.new(1),{FieldOfView = 75}):Play()
task.wait(1.5)
cam.CFrame = script:WaitForChild('C2',15).CFrame
game.TweenService:Create(cam,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = script:WaitForChild('C3',15).CFrame}):Play()
task.wait(1.5)
cam.CFrame = script:WaitForChild('C4',15).CFrame
game.TweenService:Create(cam,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = script:WaitForChild('C5',15).CFrame}):Play()
task.wait(1.5)
cam.FieldOfView = 60
cam.CFrame = script:WaitForChild('C6',15).CFrame
task.wait(1.5)
cam.FieldOfView = 75
cam.CFrame = script:WaitForChild('C7',15).CFrame
game.TweenService:Create(cam,TweenInfo.new(4.6,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = script:WaitForChild('C8',15).CFrame}):Play()
task.wait(4.6)
cam.FieldOfView = 65
cam.CFrame = script:WaitForChild('C9',15).CFrame
task.wait(1.5)
cam.CameraType = "Custom"
cam.FieldOfView = oldfov
