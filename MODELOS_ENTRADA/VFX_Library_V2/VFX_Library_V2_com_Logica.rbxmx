						<Item class="Script" referent="RBX26BA19C3BDB748CEB63AB29972C1A408">
							<Properties>
								<ProtectedString name="Source">local thing = script.Parent
local modules = thing:WaitForChild('Modules')
local rockmodule = require(modules:WaitForChild('RocksModule'))
local debrismodule = require(modules:WaitForChild('DebrisModule'))
spawn(function()
	for i = 1,19 do
		if thing:WaitForChild('yoo'):FindFirstChild(i) then
			if thing:WaitForChild('yoo'):FindFirstChild(i):FindFirstChildOfClass("ParticleEmitter") then
				thing:WaitForChild('yoo'):FindFirstChild(i):FindFirstChildOfClass("ParticleEmitter"):Emit(10)
			end
			debrismodule.Rocks((thing:WaitForChild('yoo'):FindFirstChild(i).CFrame*CFrame.new(math.random(-5,5),0,0)).Position,2,Vector3.new(0,-15,0),false,false,-180,180,50,100,1,4,2.5,false)
		end
		task.wait()
	end
end)
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Blacklist
params.FilterDescendantsInstances = {workspace.Terrain,thing} or {thing} or {}
local result = workspace:Raycast(thing:WaitForChild('SmokeFront').Position+Vector3.new(0,1,0),Vector3.new(0,-5,0),params)
if result then
	thing:WaitForChild('SmokeFront').SmokeFront2.Smoke.Color = ColorSequence.new(result.Instance.Color)
	thing:WaitForChild('SmokeFront').SmokeFront2.Smoke:Emit(5)
	thing:WaitForChild('SmokeFront').SmokeFront.Smoke.Color = ColorSequence.new(result.Instance.Color)
	thing:WaitForChild('SmokeFront').SmokeFront.Smoke:Emit(5)
end
spawn(function()
	for i,v in pairs(thing:WaitForChild('things'):GetChildren())do
		if v:IsA("Part") then
			if v.Name == "Debris2" then
				rockmodule.Ground(v.CFrame,15,v.Size,false,7.5,false)
			else
				rockmodule.Ground(v.CFrame,15,v.Size,false,7.5,true)
			end
			local ray = workspace:Raycast(v.Position+Vector3.new(0,1,0),Vector3.new(0,-5,0),params)
			if v:FindFirstChild("Smoke") then
				if ray then
					v:FindFirstChild("Smoke").Color = ColorSequence.new(ray.Instance.Color)
					v:FindFirstChild("Smoke"):Emit(2)
				end
			end
		end
	end
end)
game:GetService("Debris"):AddItem(thing,8)</ProtectedString>
