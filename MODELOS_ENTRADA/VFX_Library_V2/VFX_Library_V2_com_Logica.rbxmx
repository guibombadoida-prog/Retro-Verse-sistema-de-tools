	local light2 = Instance.new("PointLight",char['Left Arm'])
	light2.Brightness = 0
	light2.Color = Color3.new(0.137255, 0.811765, 1)
	game.TweenService:Create(light1,TweenInfo.new(0.2),{Brightness = 15}):Play()
	game.TweenService:Create(light2,TweenInfo.new(0.2),{Brightness = 15}):Play()
	local aura = {}
	for i,v in pairs(script.Aura:GetChildren())do
		local r = v:Clone()
		r.Parent = char['Right Arm']
		r.Enabled = true
		table.insert(aura,r)
	end
	for i,v in pairs(script.Aura:GetChildren())do
		local r = v:Clone()
		r.Parent = char['Left Arm']
