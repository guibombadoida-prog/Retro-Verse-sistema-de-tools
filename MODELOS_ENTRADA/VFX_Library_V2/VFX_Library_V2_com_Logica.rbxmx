			<Item class="Script" referent="RBXDF82CDB36A714987A3548976FAE0F1C5">
				<Properties>
					<ProtectedString name="Source">local tool = script.Parent
local owner = tool:WaitForChild('owner')
local cd = false
local hitbox = script.Hitbox:Clone()
script.Hitbox:Destroy()
local rockseff = script:WaitForChild('rocks'):Clone()
script:WaitForChild('rocks'):Destroy()
local ArmEffect = script:WaitForChild('Arm'):Clone()
script:WaitForChild('Arm'):Destroy()
local cam = script:WaitForChild('CameraRig'):Clone()
script:WaitForChild('CameraRig'):Destroy()
local RagdollModule = require(script:WaitForChild('Ragdoll'))
local char = nil
local a = 0
---
local function lerp(a, b, c)
	return a + (b - a) * c
end
local function quadBezier(t, p0, p1, p2)
	local l1 = lerp(p0, p1, t)
	local l2 = lerp(p1, p2, t)
	local quad = lerp(l1, l2, t)
	return quad
end
function sfx(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function sfx2(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function contains(v, t)
	for _, val in pairs(t) do
		if val == v then
			return true
		end
	end
	return false
end
function shake(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake2:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
---
tool.Equipped:Connect(function()
	char = tool.Parent
end)
tool.Activated:Connect(function()
	if cd then return end
	if char ~= owner.Value then return end
	if char:FindFirstChild("Stunned") then return end
	if char:FindFirstChild("Debounce") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	local hum = char:FindFirstChildOfClass("Humanoid")
	local oldws = hum.WalkSpeed
	local oldjp = hum.JumpPower
	task.wait()
	local hrp = char:WaitForChild('HumanoidRootPart')
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	sfx2('rbxasset://seriouspunch.mp3',3,workspace)
	hum.AutoRotate = false
	require(script:WaitForChild('Animation'))(char,'flip')
	local camera = cam:Clone()
	camera.Parent = char
	local wel = Instance.new("Weld",camera)
	wel.Part0 = hrp
	wel.Part1 = camera.camerarootpart
	local arm1
	if char:FindFirstChild('Right Arm') and char:FindFirstChild('Left Arm') then
		arm1 = ArmEffect:Clone()
		arm1.Parent =  char
		arm1.Anchored = false
		local wel1 = Instance.new("Weld",arm1)
		wel1.Part0 = char:WaitForChild('Right Arm')
		wel1.Part1 = arm1
	end
	game:GetService("Debris"):AddItem(camera,8.733)
	require(script:WaitForChild('Animation2'))(camera,'cam')
	local cuts = script:WaitForChild('Cutscene'):Clone()
	cuts.Parent = game:GetService('Players'):GetPlayerFromCharacter(char).Backpack
	cuts.Value.Value = camera.camera
	cuts.Disabled = false
	game:GetService("Debris"):AddItem(cuts,8.8)
	task.wait(1.1)
	sfx(9113823418,1.5)
	task.wait(1.3-1.1)
	sfx(9120706614,1.5)
	spawn(function()
		local push = script:WaitForChild('Push'):Clone()
		push.Parent = hrp
		push:Emit(20)
		game:GetService("Debris"):AddItem(push,0.65)
		shake(40)
	end)
	for i,v in pairs(workspace:GetDescendants())do
		if v:IsA("Model") and v ~= char then
			if v:FindFirstChildOfClass("Humanoid") then
				if v.PrimaryPart then
					if (v.PrimaryPart.Position-hrp.Position).Magnitude &lt; 25 then
						if not v:FindFirstChild('IFrame') then
							local val = Instance.new("BoolValue",v)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,4)
							local oldws2 = v:FindFirstChildOfClass("Humanoid").WalkSpeed
							local unit = (v.PrimaryPart.Position - hrp.Position).Unit
							local velo = Instance.new("BodyVelocity",v.PrimaryPart)
							velo.MaxForce = Vector3.new(1,1,1) * 500000
							velo.Velocity = Vector3.new(unit.X,0,unit.Z) * 128
							game:GetService("Debris"):AddItem(velo,0.3)
							RagdollModule:Ragdoll(v,2,false)
							v:FindFirstChildOfClass("Humanoid").WalkSpeed = 2
							spawn(function()
								task.wait(8)
								if v then
									if v:FindFirstChildOfClass("Humanoid") then
										v:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws2
									end
								end
							end)
						end
					end
				end
			end
		end
	end
	task.wait(2.583-1.3)
	sfx(9113824230,1.5)
	task.wait(2.983-2.583)
	sfx(8031021863,0.6)
	task.wait(3.95-2.983)
	sfx(5876642681,1.5)
	task.wait(4.883-3.95)
	if arm1 then
		arm1.WaterPalm.Push.Enabled = true
	end
	sfx(9125615451,1)
	task.wait(5.85-4.883)
	if arm1 then
		arm1.WaterPalm.Push.Enabled = false
		for i,v in pairs(arm1:GetDescendants())do
			if v:IsA("Trail") then
				v.Enabled = false
			end
		end
		game:GetService("Debris"):AddItem(arm1,0.65)
	end
	shake(40)
	if camera then
		camera:Destroy()
	end
	local rocks = rockseff:Clone()
	rocks.Parent = workspace:WaitForChild('Terrain')
	rocks:SetPrimaryPartCFrame(hrp.CFrame)
	rocks.mainscript.Disabled = false
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; 800 then
					local Cutscene = script.Effects:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
					local Cutscene2 = script.Shake3:Clone()
					Cutscene2.Parent = v.Backpack
					Cutscene2.Disabled = false
				end
			end
		end
	end
	sfx(341301373,9.5)
	sfx(447041606,2.5)
	sfx(449025737,2.5)
	local done = false
	spawn(function()
		local indi = hitbox:Clone()
		indi.Parent = workspace:FindFirstChildOfClass("Terrain") or workspace
		indi:SetPrimaryPartCFrame(hrp.CFrame)
		game:GetService("Debris"):AddItem(indi,0.35)
		indi.Hitbox.Touched:Connect(function(hit)
			if hit.Parent then
				if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
					if not hit.Parent:FindFirstChild('IFrame') then
						if not hit.Parent:FindFirstChild('deadbysaitamalol') then
							local val3 = Instance.new("BoolValue",hit.Parent) 
							val3.Name = "deadbysaitamalol"
							game:GetService("Debris"):AddItem(val3,5)
							local val = Instance.new("BoolValue",hit.Parent)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,5)
							local val2 = Instance.new("BoolValue",hit.Parent)
							val2.Name = "IFrame"
							game:GetService("Debris"):AddItem(val2,5)
							spawn(function()
								hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
								task.wait(2.5)
								if hit then
									if hit.Parent then
										hit.Parent:BreakJoints()
									end
								end
							end)
							RagdollModule:Ragdoll(hit.Parent,math.huge,false)
							local vel = Instance.new("BodyVelocity",hit)
							vel.Velocity = Vector3.new(0,200,0) + hrp.CFrame.LookVector * 300
							vel.MaxForce = Vector3.new(1,1,1) * 500000
							game:GetService("Debris"):AddItem(vel,0.5)
						end
					end
				end
			end
		end)
		spawn(function()
			while task.wait() do
				if indi then
					if indi:FindFirstChild('Hitbox') then
						for i,hit in pairs(indi.Hitbox:GetTouchingParts())do
							if done == false then
								if hit.Parent then
									if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
										if not hit.Parent:FindFirstChild('IFrame') then
											if not hit.Parent:FindFirstChild('deadbysaitamalol') then
												local val3 = Instance.new("BoolValue",hit.Parent) 
												val3.Name = "deadbysaitamalol"
												game:GetService("Debris"):AddItem(val3,5)
												local val = Instance.new("BoolValue",hit.Parent)
												val.Name = "Stunned"
												game:GetService("Debris"):AddItem(val,5)
												local val2 = Instance.new("BoolValue",hit.Parent)
												val2.Name = "IFrame"
												game:GetService("Debris"):AddItem(val2,5)
												spawn(function()
													hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
													task.wait(2.5)
													if hit then
														if hit.Parent then
															hit.Parent:BreakJoints()
														end
													end
												end)
												RagdollModule:Ragdoll(hit.Parent,math.huge,false)
												local vel = Instance.new("BodyVelocity",hit)
												vel.Velocity = Vector3.new(0,200,0) + hrp.CFrame.LookVector * 300
												vel.MaxForce = Vector3.new(1,1,1) * 500000
												game:GetService("Debris"):AddItem(vel,0.5)
											end
										end
									end
								end
							end
						end
						for i,hit in pairs(workspace:GetPartsInPart(indi.Hitbox,OverlapParams.new()))do
							if done == false then
								if hit.Parent then
									if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
										if not hit.Parent:FindFirstChild('IFrame') then
											if not hit.Parent:FindFirstChild('deadbysaitamalol') then
												local val3 = Instance.new("BoolValue",hit.Parent) 
												val3.Name = "deadbysaitamalol"
												game:GetService("Debris"):AddItem(val3,5)
												local val = Instance.new("BoolValue",hit.Parent)
												val.Name = "Stunned"
												game:GetService("Debris"):AddItem(val,5)
												local val2 = Instance.new("BoolValue",hit.Parent)
												val2.Name = "IFrame"
												game:GetService("Debris"):AddItem(val2,5)
												spawn(function()
													hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
													task.wait(2.5)
													if hit then
														if hit.Parent then
															hit.Parent:BreakJoints()
														end
													end
												end)
												RagdollModule:Ragdoll(hit.Parent,math.huge,false)
												local vel = Instance.new("BodyVelocity",hit)
												vel.Velocity = Vector3.new(0,200,0) + hrp.CFrame.LookVector * 300
												vel.MaxForce = Vector3.new(1,1,1) * 500000
												game:GetService("Debris"):AddItem(vel,0.5)
											end
										end
									end
								end
							end
						end
					else
						break
					end
				else
					break
				end
			end
		end)
	end)
	task.wait(9.117-5.85)
	done = true
	deb:Destroy()
	iframe:Destroy()
	hum.AutoRotate = true
	script:WaitForChild('StopAnimation'):FireAllClients()
	hum.WalkSpeed = oldws
	hum.JumpPower = oldjp
	task.wait(4)
	cd = false
end)</ProtectedString>
