						<Content name="LinkedSource"><null/></Content>
						<ProtectedString name="Source">local module = {}

local RunService = game:GetService("RunService")

function module.Lightning(StartPos, EndPos, Corners, Segments, TimesLooped, Color, Outness,size)
	if not Corners then
		Corners = false
	end
	if not Color then
		Color = Color
	end
	for l = 1, TimesLooped do
		local Points = {}
		local Distance = (EndPos - StartPos).Magnitude
		local Folder = Instance.new("Model")
		Folder.Name = "Lightning"
		Folder.Parent = workspace
		for i =  0, Segments+2 do
			local Power = 20
			local OffsetX = math.random(-1,1)*Outness
			local OffsetY = math.random(-1,1)*Outness
			local OffsetZ = math.random(-1,1)*Outness
			
			local OffsetVec = Vector3.new(OffsetX,OffsetY,OffsetZ)
			
			if i == 0 or i == Segments+2 then
				OffsetX = 0
				OffsetY = 0
				OffsetZ = 0
			end
			local PointPos = StartPos + ((EndPos-StartPos).Unit * i * Distance)/(Segments+2) + OffsetVec
			table.insert(Points, PointPos)
			if Corners == true then
				local Part = Instance.new("Part")
				Part.Position = PointPos
				Part.Anchored = true
				Part.CanCollide = false
				Part.Size = Vector3.new(size,size,size)
				Part.Material = "Neon"
				Part.Color = Color
				Part.Parent = Folder
			end
		end
		for i = 1, #Points do
			if i ~= #Points then
				local FirstP = Points[i]
				local SecondP = Points[i+1]
				local Lightning = Instance.new("Part")
				Lightning.Size = Vector3.new(size,size, (FirstP-SecondP).Magnitude)
				Lightning.Anchored = true
				Lightning.CanCollide = false
				Lightning.CFrame = CFrame.new((SecondP+FirstP)/2, SecondP)
				Lightning.Material = "Neon"
				Lightning.Color = Color
				Lightning.Parent = Folder
			end
		end
		local co = coroutine.create(function(Thing)
			task.wait(.1)
			for i, v in pairs(Thing:GetChildren()) do
				local Info = TweenInfo.new(.2)
				local Goal = {
					Transparency = 1,
					Size = Vector3.new(0,0,0)
				}
				local Tweening = game:GetService("TweenService"):Create(v, Info, Goal)
				Tweening:Play()
			end
			task.wait(0.2)
			Thing:Destroy()
		end)
		coroutine.resume(co,Folder)
		task.wait(math.random()/25)
	end
end


return module
