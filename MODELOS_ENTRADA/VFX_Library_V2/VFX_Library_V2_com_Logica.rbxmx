					rockmodule.createFaceInward(hrp,6,15,5,3,3,2.5,false,params)
					rockmodule.createFaceInward(hrp,7,18,8,4,4,2.5,false,params)
					for _,v in pairs(getnearobjects(hit.Position,20,target))do
