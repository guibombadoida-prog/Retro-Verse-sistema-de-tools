					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local players = game:GetService("Players")
local plr = players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local remote = tool:WaitForChild('RemoteFunction',15)
local UIS = game:GetService('UserInputService')
local hrp = char:WaitForChild('HumanoidRootPart',15)
local humanoid = char:WaitForChild('Humanoid',15) or char:FindFirstChildOfClass("Humanoid")
--
remote.OnClientInvoke = function(pos,tim)
	hrp.Anchored = true
	humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,true)
	game:GetService("TweenService"):Create(hrp,TweenInfo.new(tim,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{CFrame = pos}):Play()
	task.wait(tim)
	hrp.Velocity = Vector3.new(0,0,0)
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	hrp.Anchored = false
	remote:InvokeServer()
end</ProtectedString>
