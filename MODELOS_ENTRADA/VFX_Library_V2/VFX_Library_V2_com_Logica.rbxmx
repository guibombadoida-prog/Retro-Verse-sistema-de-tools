					<Item class="LocalScript" referent="RBX29448DA58DA64507989CE56840CE39F6">
						<Properties>
							<ProtectedString name="Source">local screen = Instance.new("ScreenGui",game.Players.LocalPlayer:FindFirstChildOfClass("PlayerGui"))
script.Destroying:Connect(function()
	screen:Destroy()
end)
local viewport = Instance.new("ViewportFrame",screen)
script.Destroying:Connect(function()
	viewport:Destroy()
end)
viewport.Size = UDim2.new(1,0,1.05,0)
viewport.Position = UDim2.new(0,0,-0.05,0)
viewport.BackgroundTransparency = 1
viewport.CurrentCamera = workspace.CurrentCamera
local char = script:WaitForChild('char',20).Value
char.Archivable = true
local cloned = char:Clone()
for i,v in pairs(cloned:GetDescendants())do
	if v:IsA("LocalScript") or v:IsA("Script") then
		v:Destroy()
	elseif v:IsA("BasePart") then
		v.Anchored = true
	end
end
cloned.Parent = viewport
script.Destroying:Connect(function()
	cloned:Destroy()
end)
game.TweenService:Create(viewport,TweenInfo.new(0.5),{ImageTransparency = 1}):Play()</ProtectedString>
