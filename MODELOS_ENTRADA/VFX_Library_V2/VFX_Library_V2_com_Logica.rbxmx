						end
					end
				end
				if hit then
					if target and targethumanoid then
						targethumanoid.PlatformStand = false
						targethumanoid.Health -= targethumanoid.MaxHealth/3.5
					end
				end
				ended = true
				if weldpart then
					for i,v in pairs(weldpart:GetChildren())do
						if v:IsA("Weld") then
							v:Destroy()
						end
					end
					weldpart.root.Anchored = true
					game:GetService("Debris"):AddItem(weldpart,1.65)
				end
				if charvelo2 then
					spawn(function()
						charvelo2.Velocity = Vector3.new(0,0,0)
						task.wait(0.05)
						if charvelo2 then
							charvelo2:Destroy()
						end
					end)
				end
				if hit then
					if target then
						local velo2 = Instance.new("BodyVelocity",hit)
						velo2.Velocity = hrp.CFrame.LookVector * 35 + Vector3.new(0,10,0)
						game:GetService("Debris"):AddItem(velo2,0.45)
						local val6 = Instance.new("BoolValue",target)
						val6.Name = "Stunned"
						game:GetService("Debris"):AddItem(val6,3.5)
						local val7 = Instance.new("BoolValue",target)
						val7.Name = "Ragdolled"
						game:GetService("Debris"):AddItem(val7,3.5)
						ragdollmodule:Ragdoll(target,3.5,false)
					end
				end
				for _,v in pairs(collisiongroup)do
					if v:GetAttribute("OldCollisionGroup") then
						v.CollisionGroup = v:GetAttribute("OldCollisionGroup")
					end
				end
				if armeffect then
					armeffect.WaterPalm.WaterTrail.Enabled = false
					debris:AddItem(armeffect,1.1)
				end
				if armeffect2 then
					armeffect2.WaterPalm.WaterTrail.Enabled = false
					debris:AddItem(armeffect2,1.1)
				end
				for _,v in pairs(mass)do
					v.Massless = false
				end
				for _,v in pairs(collide)do
					v.CanCollide = true
				end
				task.wait(2.017-1.6)
				hrp.Anchored = false
				humanoid.AutoRotate = true
				deb:Destroy()
				iframe:Destroy()
				StopRemote:FireAllClients()
				humanoid.WalkSpeed = oldws
				humanoid.JumpPower = oldjp
				task.wait(5)
				cd = false
			end
		end
	end
	--
	local hitbox = newhitbox(0.3,assets:WaitForChild('Hitbox'))
	spawn(function()
		while task.wait() do
			if hitbox and hitbox:FindFirstChild('Hitbox') and donehit == false then
				hitbox:SetPrimaryPartCFrame(hrp.CFrame)
				local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
				for _,v in pairs(parts)do
					hitfunc(v)
				end
			else
				break
			end
		end
	end)
	--
	spawn(function()
		task.wait(0.717-0.5)
		if donehit == false then
			deb:Destroy()
			iframe:Destroy()
			if charvelo then
				charvelo:Destroy()
			end
			if armeffect then
				armeffect.WaterPalm.WaterTrail.Enabled = false
				debris:AddItem(armeffect,1.1)
			end
			if armeffect2 then
				armeffect2.WaterPalm.WaterTrail.Enabled = false
				debris:AddItem(armeffect2,1.1)
			end
			humanoid.WalkSpeed = oldws
			humanoid.JumpPower = oldjp
			StopRemote:FireAllClients()
			task.wait(5)
			cd = false
		end
	end)
end
