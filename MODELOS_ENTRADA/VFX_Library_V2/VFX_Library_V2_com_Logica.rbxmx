				</Item>
				<Item class="Model" referent="RBX247460F8E5604BC6B60F823AC6F2973D">
					<Properties>
						<token name="LevelOfDetail">0</token>
						<CoordinateFrame name="ModelMeshCFrame">
							<X>0</X>
							<Y>0</Y>
							<Z>0</Z>
							<R00>1</R00>
							<R01>0</R01>
							<R02>0</R02>
