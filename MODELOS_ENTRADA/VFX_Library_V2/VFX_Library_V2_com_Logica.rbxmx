						<Properties>
							<ProtectedString name="Source">script.RemoteEvent:FireServer()
spawn(function()
	while task.wait(0.065) do
		game.TweenService:Create(script.Parent.ImageLabel.ViewportFrame,TweenInfo.new(0.065),{Position = UDim2.new(0,math.random(-5,5),0,math.random(-15,15))}):Play()
		game.TweenService:Create(script.Parent.ImageLabel2.ViewportFrame2,TweenInfo.new(0.065),{Position = UDim2.new(0,math.random(-5,5),0,math.random(-15,15))}):Play()
	end
end)
script.loot_appears:Play()
script["jonathan - charging"]:Play()
task.wait(1)
script.loot_appears:Play()
script.Parent.ImageLabel2.Visible = true
task.wait(1.5)
script.RemoteEvent2:FireServer()</ProtectedString>
