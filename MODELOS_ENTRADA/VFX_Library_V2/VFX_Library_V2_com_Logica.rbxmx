							<Item class="Script" referent="RBX4A1E4E2DCBF04535A0362E1119E13D17">
								<Properties>
									<ProtectedString name="Source">for _,v in pairs(script.Parent.Part:GetChildren())do
	v:Emit(v:GetAttribute('EmitCount'))
end
game:GetService("TweenService"):Create(script.Parent.root.PointLight,TweenInfo.new(1),{Brightness = 0}):Play()
for _,v in pairs(script.Parent.root:GetChildren())do
	if v:IsA('Decal') then
		game:GetService("TweenService"):Create(v,TweenInfo.new(3.5),{Transparency = 1}):Play()
	end
end
game:GetService("Debris"):AddItem(script.Parent,3.5)</ProtectedString>
