			local hitfunc = function(hit)
				local target = hit.Parent
				if target and target:FindFirstChildOfClass("Humanoid") and donehit == false then
					if not target:FindFirstChild("IFrame") and not target:FindFirstChild("Ragdolled") and not target:FindFirstChild("cantbehitbym1") and not char:FindFirstChild("Stunned") then
						donehit = true
						--
						local targetroot = target:FindFirstChild('HumanoidRootPa`rt') or target:FindFirstChild("Torso") or nil
						local targethumanoid = target:FindFirstChildOfClass("Humanoid")
						--
						local stun = Instance.new("BoolValue",target)
						stun.Name = "Stunned"
						local ragdollvalue = Instance.new("BoolValue",target)
						ragdollvalue.Name = "Ragdolled"
						local velo = Instance.new("BodyVelocity",hit)
						velo.MaxForce = Vector3.new(1,1,1) * 500000000
						velo.Velocity = hrp.CFrame.LookVector * 45
						ragdollmodule:Ragdoll(target,2,false)
						debris:AddItem(velo,0.15)
						debris:AddItem(stun,2)
						debris:AddItem(ragdollvalue,2)
						--
						targethumanoid.Health -= targethumanoid.MaxHealth/20
					end
				end
			end
			--
			local hitbox = newhitbox(0.2,assets:WaitForChild('Hitbox2'))
			spawn(function()
				while task.wait() do
					if hitbox and hitbox:FindFirstChild('Hitbox') and donehit == false then
						hitbox:SetPrimaryPartCFrame(hrp.CFrame)
						local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
						for _,v in pairs(parts)do
							hitfunc(v)
						end
					else
						break
					end
				end
			end)
			--
			spawn(function()
				task.wait(0.95-.367)
				deb:Destroy()
				iframe:Destroy()
				StopRemote:FireAllClients()
				humanoid.JumpPower = realoldjp
				humanoid.WalkSpeed = oldws
				task.wait(1.25)
				cd = false
			end)
		end
	end
end
activate = function()
	holding = true
	m1()
end
deactivate = function()
	holding = false
end
equip = function()
	char = tool.Parent
end
---connect---
tool.Equipped:Connect(equip)
tool.Activated:Connect(activate)
tool.Deactivated:Connect(deactivate)
tool.Unequipped:Connect(deactivate)
---
spawn(function()
	while task.wait() do
		if holding == true and char ~= nil then
			m1()
		end
	end
end)</ProtectedString>
