							<Content name="LinkedSource"><null/></Content>
							<ProtectedString name="Source">local Tweenservice = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local RockModule = {}

function RockModule.createBasic(orb, numRocks, distance, LifeTime, CanCollide, rayparam)

	local ray = workspace:Raycast(orb.Position, orb.CFrame.UpVector * -20)
	if ray then
		local centerPosition = ray.Position
		local newCFr = CFrame.new(centerPosition)

		local angle = 0

		local function loop()
			for i=1, numRocks do
				local Rock = Instance.new("Part")
				Rock.Anchored = true
				Rock.CanCollide = CanCollide
				Rock.CanQuery = false
				Rock.CanTouch = false
				Rock.Size = Vector3.new(3,3,3)
				Rock.CFrame = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, -Rock.Size.Y, -distance)
				Rock.Orientation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
				Rock.Color = ray.Instance.Color
				Rock.Material = ray.Instance.Material
				Rock.Parent = workspace.Terrain
				Debris:AddItem(Rock, LifeTime+5)
				Tweenservice:Create(Rock, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = Rock.Position + Vector3.new(0, Rock.Size.Y, 0)}):Play()
				delay(LifeTime,function()
					Tweenservice:Create(Rock, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
				end)
				angle += 360/numRocks
			end
		end
		loop()
	end
end

function RockModule.createBasic2(orb, numRocks, distance, LifeTime, CanCollide, rayparam)
	local ray = workspace:Raycast(orb.Position, orb.CFrame.UpVector * -20)
	if ray then
		local centerPosition = ray.Position
		local newCFr = CFrame.new(centerPosition)

		local angle = 0

		local function loop()
			for i=1, numRocks do
				local newRayCFr = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, 2, -distance)

				local newRay = workspace:Raycast(newRayCFr.Position, newRayCFr.UpVector * -10, rayparam)
				if newRay then
					local Rock = Instance.new("Part")
					Rock.Anchored = true
					Rock.CanCollide = CanCollide
					Rock.CanQuery = false
					Rock.CanTouch = false
					Rock.Size = Vector3.new(3,3,3)
					Rock.CFrame = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, -Rock.Size.Y, -distance)
					Rock.Orientation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
					Rock.Color = newRay.Instance.Color
					Rock.Material = newRay.Instance.Material
					Rock.Parent = workspace.Terrain
					Debris:AddItem(Rock, LifeTime+5)
					task.delay(LifeTime,function()
						Tweenservice:Create(Rock, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
					end)

					Tweenservice:Create(Rock, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = Rock.Position + Vector3.new(0, Rock.Size.Y, 0)}):Play()
				end

				angle += 360/numRocks
			end
		end
		loop()
	end
end

function RockModule.createOutward(orb, numRocks, startDistance, endDistance, LifeTime, CanCollide, rayparam)

	local ray = workspace:Raycast(orb.Position, orb.CFrame.UpVector * -20)
	if ray then
		local centerPosition = ray.Position
		local newCFr = CFrame.new(centerPosition)

		local angle = 0

		local function loop()
			for i=1, numRocks do
				local newPosition = (newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, 0, -endDistance * 2)).Position

				local Rock = Instance.new("Part")
				Rock.Anchored = true
				Rock.CanCollide = CanCollide
				Rock.CanQuery = false
				Rock.CanTouch = false
				Rock.Size = Vector3.new(3,3,3)
				Rock.CFrame = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, 0, -startDistance)
				Rock.Orientation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))
				Rock.Color = ray.Instance.Color
				Rock.Material = ray.Instance.Material
				Rock.Parent = workspace.Terrain
				Debris:AddItem(Rock, LifeTime+5)
				task.delay(LifeTime,function()
					Tweenservice:Create(Rock, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
				end)
				Tweenservice:Create(Rock, TweenInfo.new(.5, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {Position = newPosition, Size = Rock.Size * 3, Orientation = Vector3.new(math.random(-180, 180), math.random(-180, 180), math.random(-180, 180))}):Play()

				angle += 360/numRocks
			end
		end
		loop()
	end
end

function RockModule.createFaceInward(orb, numRocks, distance, sizeX, sizeY, sizeZ, LifeTime, CanCollide, rayparam)

	local ray = workspace:Raycast(orb.Position, orb.CFrame.UpVector * -20)
	if ray then
		local centerPosition = ray.Position
		local newCFr = CFrame.new(centerPosition)

		local angle = 0

		local function loop()
			for i=1, numRocks do
				local cfthingy = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, sizeY, -distance) * CFrame.Angles(math.rad(40), 0,0)
				local result = workspace:Raycast(cfthingy.Position, Vector3.new(0,-20,0),rayparam)
				if result then
					local Rock = Instance.new("Part")
					Rock.Anchored = true
					Rock.CanCollide = CanCollide
					Rock.CanQuery = false
					Rock.CanTouch = false
					local smoke = script:WaitForChild('Smoke'):Clone()
					smoke.Color = ColorSequence.new(result.Instance.Color)
					smoke.Size = NumberSequence.new(sizeX)
					smoke.Lifetime = NumberRange.new(LifeTime)
					smoke.Parent = Rock
					smoke:Emit(5)
					Rock.Size = Vector3.new(sizeX,sizeY,sizeZ)
					Rock.CFrame = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, -Rock.Size.Y, -distance) * CFrame.Angles(math.rad(40), 0,0)
					Rock.Color = result.Instance.Color
					Rock.Material = result.Instance.Material
					Rock.Position = Vector3.new(Rock.Position.X,result.Position.Y,Rock.Position.Z)-Vector3.new(0, Rock.Size.Y, 0)
					Rock.Parent = workspace.Terrain
					Debris:AddItem(Rock, LifeTime+5)
					task.delay(LifeTime,function()
						Tweenservice:Create(Rock, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
					end)

					Tweenservice:Create(Rock, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = Rock.Position + Vector3.new(0, Rock.Size.Y, 0)}):Play()

					angle += 360/numRocks
				end
			end
		end
		loop()
	end
end

function RockModule.createFaceInwardRing(orb, numRocks, distance, sizeX, sizeY, sizeZ, rows, LifeTime, CanCollide, rayparam)

	local ray = workspace:Raycast(orb.Position, orb.CFrame.UpVector * -20)
	if ray then
		local centerPosition = ray.Position
		local newCFr = CFrame.new(centerPosition)

		local function loop()
			for k=1, rows do
				local angle = 0

				for i=1, numRocks do
					local Rock = Instance.new("Part")
					Rock.Anchored = true
					Rock.CanCollide = CanCollide
					Rock.CanQuery = false
					Rock.CanTouch = false
					Rock.Size = Vector3.new(sizeX,sizeY,sizeZ)
					Rock.CFrame = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, -Rock.Size.Y, -distance) * CFrame.Angles(math.rad(40), 0,0)
					Rock.Color = ray.Instance.Color
					Rock.Material = ray.Instance.Material
					Rock.Parent = workspace.Terrain
					Debris:AddItem(Rock, LifeTime+5)
					task.delay(LifeTime,function()
						Tweenservice:Create(Rock, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
					end)
					Tweenservice:Create(Rock, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = Rock.Position + Vector3.new(0, Rock.Size.Y, 0)}):Play()
					angle += 360/numRocks
				end

				distance *= 1.5
				sizeX *= 1.5
				sizeY *= 1.5
				sizeZ *= 1.5

				task.wait(.25)
			end
		end
		loop()
	end
end

function RockModule.createFaceInwardLayers(orb, numRocks, distance, sizeX, sizeY, sizeZ, material1, material2, color1, color2, LifeTime, CanCollide, rayparam)

	local ray = workspace:Raycast(orb.Position, orb.CFrame.UpVector * -20)
	if ray then
		local centerPosition = ray.Position
		local newCFr = CFrame.new(centerPosition)

		local angle = 0

		local function loop()
			for i=1, numRocks do
				local Rock = Instance.new("Part")
				Rock.Anchored = true
				Rock.CanCollide = CanCollide
				Rock.CanQuery = false
				Rock.CanTouch = false
				Rock.Size = Vector3.new(sizeX,sizeY,sizeZ)
				Rock.CFrame = newCFr * CFrame.Angles(0, math.rad(angle),0) * CFrame.new(0, -Rock.Size.Y*2, -distance) * CFrame.Angles(math.rad(45), 0,0)
				Rock.Color = ray.Instance.Color
				Rock.Material = ray.Instance.Material
				Rock.Parent = workspace.Terrain
				Debris:AddItem(Rock, LifeTime+5)
				task.delay(LifeTime,function()
					Tweenservice:Create(Rock, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2.5, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
				end)

				local grass = script.Rock:Clone()
				grass.Size = Vector3.new(sizeX, .5, sizeZ)
				grass.CFrame = Rock.CFrame * CFrame.new(0, Rock.Size.Y/2 + grass.Size.Y/2, 0)
				grass.Color = color2
				grass.CanCollide = CanCollide
				grass.Material = material2
				grass.Parent = workspace.Terrain
				Debris:AddItem(grass, LifeTime+5)
				task.delay(LifeTime,function()
					Tweenservice:Create(grass, TweenInfo.new(4.5,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut), {Position = Rock.Position + Vector3.new(0, -Rock.Size.Y*2.5, 0), Orientation = Rock.Orientation+Vector3.new(math.random(-50,50),math.random(-50,50),math.random(-50,50))}):Play()
				end)

				Tweenservice:Create(Rock, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = Rock.Position + Vector3.new(0, Rock.Size.Y*2, 0)}):Play()
				Tweenservice:Create(grass, TweenInfo.new(.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = grass.Position + Vector3.new(0, Rock.Size.Y*2, 0)}):Play()

				angle += 360/numRocks
			end
		end
		loop()
	end
end

return RockModule</ProtectedString>
