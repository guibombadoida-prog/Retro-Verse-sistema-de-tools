<Item class="Folder" referent="RBX776AFDD432324258A960C2E69C07D25B">
				<Properties>
					<string name="Name">Lethal Whirlwind Stream</string>
					</Properties>
				<Item class="Script" referent="RBXC75629213F8B438A9CCA281EC1674077">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local char = nil
local cd = false
local debris = game:GetService("Debris")
local owner = tool:WaitForChild('owner')
local players = game:GetService("Players")
local animation = require(script:WaitForChild('Animation'))
local assets = script:WaitForChild('Assets'):Clone()
script:WaitForChild('Assets'):Destroy()
local effectsfolder = workspace:FindFirstChildOfClass("Terrain") or workspace
local ragdollmodule = require(script:WaitForChild('Ragdoll'))
local StopRemote = script:WaitForChild('StopRemote')
local rockmodule = require(script:WaitForChild('RockModule'))
local rockmodule2 = require(script:WaitForChild('RocksModule2'))
local debrismodule = require(script:WaitForChild('DebrisModule'))
local ps = game:GetService("PhysicsService")
if not ps:IsCollisionGroupRegistered("targetCollide") then
	ps:RegisterCollisionGroup("targetCollide")
end
ps:CollisionGroupSetCollidable('targetCollide','Default',false)
--
game:GetService("RunService").Heartbeat:Connect(function()
	for _,v in pairs(ps:GetRegisteredCollisionGroups())do
		if v~="targetCollide" then
			if ps:IsCollisionGroupRegistered("targetCollide") and ps:IsCollisionGroupRegistered(v) then
				ps:CollisionGroupSetCollidable('targetCollide',v,false)
			end
		end
	end
end)
---functions---
getnearobjects = function(pos,range,ignore)
	range = range or 12
	ignore = ignore or char
	local objects = {}
	for i,v in pairs(workspace:GetDescendants())do
		if v:IsA("Model") and v ~= char and v ~= ignore then
			if v:FindFirstChildOfClass("Humanoid") then
				if v.PrimaryPart then
					if (v.PrimaryPart.Position-pos).Magnitude &lt; range then
						table.insert(objects,v)
					end
				end
			end
		end
	end
	---
	return objects
end
shake = function(lifetime,range,magnitude,roughness,fadein,fadeout,preset)
	preset = preset or nil
	fadein = fadein or 0.3
	fadeout = fadeout or 0.3
	roughness = roughness or 5
	magnitude = magnitude or 5
	range = range or 50
	lifetime = lifetime or 1
	for _,v in pairs(players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Shaker = assets:WaitForChild('Shaker'):Clone()
					Shaker.Roughness.Value = roughness
					Shaker.Magnitude.Value = Magnitude
					Shaker.FadeIn.Value = fadein
					Shaker.FadeOut.Value = fadeout
					if preset ~= nil then
						Shaker.Preset.Value = preset
					end
					Shaker.Parent = v.Backpack
					Shaker.Disabled = false
					debris:AddItem(Shaker,lifetime)
				end
			end
		end
	end
end
smoke = function(pos,lifetime,size,speedmin,speedmax,emit)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {effectsfolder,char} or {effectsfolder}
	local result = workspace:Raycast(pos+Vector3.new(0,1.5,0),Vector3.new(0,-20,0),params)
	if result then
		local attach = Instance.new("Attachment",effectsfolder)
		attach.WorldPosition = result.Position+Vector3.new(0,0.5,0)
		local downsmoke = assets:WaitForChild('Smoke'):Clone()
		downsmoke.Parent = attach
		downsmoke.Size = NumberSequence.new(size)
		downsmoke.Speed = NumberRange.new(speedmin,speedmax)
		downsmoke.Lifetime = NumberRange.new(lifetime)
		downsmoke.Color = ColorSequence.new(result.Instance.Color)
		downsmoke:Emit(emit)
		local upsmoke = assets:WaitForChild('UpSmoke'):Clone()
		upsmoke.Parent = attach
		upsmoke.Size = NumberSequence.new(size)
		upsmoke.Lifetime = NumberRange.new(lifetime)
		upsmoke.Color = ColorSequence.new(result.Instance.Color)
		upsmoke:Emit(emit)
		debris:AddItem(attach,lifetime+0.5)
	end
end
sfx = function(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
---tool_functions--
activate = function()
	if char ~= owner.Value then return end
	if cd == true then return end
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	--
	local hrp = char:WaitForChild('HumanoidRootPart')
	local head = char:WaitForChild('Head')
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local oldws = humanoid.WalkSpeed
	local oldjp = humanoid.JumpPower
	--
	animation(char,'lethal')
	--
	humanoid.JumpPower = 0
	humanoid.WalkSpeed = 0
	--
	local armeffect = nil
	if char:FindFirstChild('Right Arm') then
		armeffect = assets:WaitForChild('Arm'):Clone()
		armeffect.Parent = char
		armeffect.Anchored = false
		local weld = Instance.new("Weld",armeffect)
		weld.Part0 = char:FindFirstChild("Right Arm")
		weld.Part1 = armeffect
		armeffect.WaterPalm.WaterTrail.Enabled = true
		for _,v in pairs(armeffect.WaterPalm.ConstantEmit:GetChildren())do
			v:Emit(2)
		end
	end
	task.wait(0.15)
	sfx(9113824230,1)
	local funnyvelo = Instance.new("BodyVelocity",hrp)
	funnyvelo.MaxForce = Vector3.new(1,0,1) * 50000
	funnyvelo.Velocity = hrp.CFrame.LookVector * 20
	debris:AddItem(funnyvelo,0.35)
	task.wait(0.467-0.15)
	--
	local paramshitbox = OverlapParams.new()
	paramshitbox.FilterType = Enum.RaycastFilterType.Blacklist
	paramshitbox.FilterDescendantsInstances = {char}
	--
	local donehit = false
	--
	local hitfunc = function(hit)
		local target = hit.Parent
		if target and target:FindFirstChildOfClass("Humanoid") and donehit == false then
			if not target:FindFirstChild("IFrame") and not target:FindFirstChild('Ragdolled') and not char:FindFirstChild("Stunned") then
				donehit = true
				--
				local stun = Instance.new("BoolValue",target)
				stun.Name = "Stunned"
				local iframe2 = Instance.new("BoolValue",target)
				iframe2.Name = "IFrame"
				debris:AddItem(stun,1.95)
				debris:AddItem(iframe2,1.95)
				--
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Blacklist
				params.FilterDescendantsInstances = {char,target,effectsfolder}
				--
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics,false)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.GettingUp,true)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding,false)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
				--
				StopRemote:FireAllClients()
				--
				animation(char,'stream')
				--
				local targetroot = target:FindFirstChild('HumanoidRootPart') or target:FindFirstChild("Torso") or nil
				local targethumanoid = target:FindFirstChildOfClass("Humanoid")
				local mass = {}
				local collide = {}
				local collisiongroup = {}
				local grabpart = nil
				local welds = {}
				--
				targethumanoid:ChangeState(Enum.HumanoidStateType.Physics)
				--
				if armeffect then
					armeffect.WaterPalm.WaterTrail.Enabled = false
					debris:AddItem(armeffect,1.1)
				end
				--
				hrp.Velocity = Vector3.new()
				--
				for _,v in pairs(target:GetChildren())do
					if v:IsA("BasePart") then
						v:SetAttribute("OldCollisionGroup",v.CollisionGroup)
						v.CollisionGroup = "targetCollide"
						table.insert(collisiongroup,v)
						if v.Massless == false then
							v.Massless = true
							table.insert(mass,v)
						end
						if v.CanCollide == true then
							v.CanCollide = false
							table.insert(collide,v)
						end
					end
				end
				--
				if char:FindFirstChild("Right Arm") then
					grabpart = assets:WaitForChild('Welder'):Clone()
					grabpart.Parent = char
					grabpart.Weld.Anchored = false
					local weld2 = Instance.new("Weld",grabpart)
					weld2.Part0 = char:WaitForChild('Right Arm')
					weld2.Part1 = grabpart.Weld
					local weld = Instance.new("Weld",grabpart)
					weld.Part0 = grabpart.WeldPart
					weld.Part1 = hit
					table.insert(welds,weld2)
					table.insert(welds,weld)
				end
				--
				sfx(9066673412,0.65)
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				task.wait(0.283)
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				if hit then
					shake(1,30,5,8,0.1,0.5)
					sfx(289842971,1.5,hit)
					sfx(3802270540,1.5,hit)
					for _,v in pairs(getnearobjects(hit.Position,18,target))do
						if not v:FindFirstChild("IFrame") then
							local val = Instance.new("BoolValue",v)
							val.Name = "Stunned"
							game:GetService("Debris"):AddItem(val,2)
							local val = Instance.new("BoolValue",v)
							val.Name = "Ragdolled"
							game:GetService("Debris"):AddItem(val,2)
							local velo = Instance.new("BodyVelocity",v.PrimaryPart)
							velo.MaxForce = Vector3.new(1,1,1) * 500000
							velo.Velocity = Vector3.new(0,65,0)
							game:GetService("Debris"):AddItem(velo,0.25)
							ragdollmodule:Ragdoll(v,2,false)
							v:FindFirstChildOfClass("Humanoid").Health -= v:FindFirstChildOfClass("Humanoid").MaxHealth/10
						end
					end
					rockmodule.createFaceInward(hrp,5,8,3,2,2,1,false,params)
					rockmodule.createFaceInward(hrp,7,12,4,3,3,1,false,params)
					spawn(function()
						for i = 1,10 do
							local spread = 8
							local cf = hit.CFrame*CFrame.new(math.random(-spread,spread),1,math.random(-spread,spread))
							debrismodule.Rocks(cf.Position,1,Vector3.new(0,-15,0),true,false,-180,180,40,60,0.1,3.5,3.5,false)
						end
					end)
					smoke(hrp.Position,3,5.5,50,100,30)
					if grabpart then
						for i,v in pairs(grabpart.Weld.Attachment2:GetChildren())do
							v:Emit(v:GetAttribute('EmitCount'))
						end
					end
				end
				task.wait(0.383-0.283)
				local ended = false
				if grabpart then
					for i,v in pairs(grabpart.Weld.donedrag:GetChildren())do
						v.Enabled = true
					end
				end
				local params = RaycastParams.new()
				params.FilterType = Enum.RaycastFilterType.Blacklist
				params.FilterDescendantsInstances = {workspace.Terrain,char} or {char} or {}
				if hit then
					if hit.Parent then
