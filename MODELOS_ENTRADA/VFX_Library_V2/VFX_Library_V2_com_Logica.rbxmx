<Item class="Folder" referent="RBXCDB7C6607B4B4972A847566D0B8E1BDA">
			<Properties>
				<string name="Name">Instant Death</string>
				</Properties>
			<Item class="Script" referent="RBX45561A88F3A5438B99990EBCC691CD78">
				<Properties>
					<ProtectedString name="Source">local owner = script.Parent.Owner.Value
local tool = script.Parent
local dash = script.Dash:Clone()
script.Dash:Destroy()
local heart = script.HeartWeld:Clone()
script.HeartWeld:Destroy()
local indicator = script.Indicator:Clone()
script.Indicator:Destroy()
local eff = script.LocalViewPort:Clone()
script.LocalViewPort:Destroy()
local char
local oldws = 16
local oldjp = 50
----
tool.Equipped:Connect(function()
	char = tool.Parent
end)
tool.Activated:Connect(function()
	char = tool.Parent
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then
		return
	end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
	oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
	require(script.Animation)(char)
	local indi = indicator:Clone()
	indi.Parent = char
	indi.Weld.Anchored = false
	local weld = Instance.new("Weld",indi)
	weld.Part0 = char.HumanoidRootPart
	weld.Part1 = indi.Weld
	indi.script.Disabled = false
	local sound = Instance.new("Sound",char.HumanoidRootPart)
	sound.PlayOnRemove = true
	sound.Volume = 1.5
	sound.SoundId = "rbxassetid://7419159380"
	sound:Destroy()
	char:FindFirstChildOfClass("Humanoid").JumpPower = 0
	char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0.1
	task.wait(1.41)
	local sound = Instance.new("Sound",char.HumanoidRootPart)
	sound.PlayOnRemove = true
	sound.Volume = 1.5
	sound.SoundId = "rbxassetid://4479083227"
	sound:Destroy()
	spawn(function()
		for i = 1,2 do
			for i,v in pairs(game.Players:GetPlayers())do
				if v.Character then
					if v.Character.PrimaryPart then
						if (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude &lt; 45 then
							local ef = eff:Clone()
							ef.Parent = v:FindFirstChildOfClass("PlayerGui")
							eff.char.Value = char
							ef.Disabled = false
							game.Debris:AddItem(ef,1)
						end
					end
				end
			end
			task.wait(.1)
		end
	end)
	task.wait(.19)
	local das = dash:Clone()
	das.Parent = char
	das:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
	das.script.Disabled = false
	char:FindFirstChildOfClass("Humanoid").AutoRotate = false
	local done = false
	game.TweenService:Create(char.HumanoidRootPart,TweenInfo.new(0.1),{CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0,0,-50)}):Play()
	indi.a1:Destroy()
	indi.a2:Destroy()
	indi.Hitbox.Touched:Connect(function(hit)
		if hit.Parent:FindFirstChildOfClass("Humanoid") then
			if hit.Parent ~= char then
				if done == false then
					if hit.Parent:FindFirstChild("IFrame") then return end
					spawn(function()
						done = true
						--indi.Hitbox:Destroy()
						local sound = Instance.new("Sound",char.HumanoidRootPart)
						sound.PlayOnRemove = true
						sound.Volume = 1.5
						sound.SoundId = "rbxassetid://9105467029"
						sound:Destroy()
						hit.Anchored = true
						task.wait(3.5)
						if hit then
							hit.Anchored = false
							if hit.Parent then
								hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
								task.wait(0.015)
								spawn(function()
									while task.wait() do
										if hit then
											if hit.Parent then
												hit.Parent:BreakJoints()
											end
										end
									end
								end)
							end
						end
					end)
				end
			end
		end
	end)
	spawn(function()
		for i = 1,0.25/0.005 do
			pcall(function()
				if indi then
					if indi:FindFirstChild("Hitbox") then
						for i,hit in pairs(workspace:GetPartsInPart(indi.Hitbox,OverlapParams.new()))do
							if hit.Parent:FindFirstChildOfClass("Humanoid") then
								if hit.Parent ~= char then
									if done == false then
										if hit.Parent:FindFirstChild("IFrame") then return end
										spawn(function()
											done = true
											--indi.Hitbox:Destroy()
											local sound = Instance.new("Sound",char.HumanoidRootPart)
											sound.PlayOnRemove = true
											sound.Volume = 1.5
											sound.SoundId = "rbxassetid://9105467029"
											sound:Destroy()
											hit.Anchored = true
											task.wait(3.5)
											if hit then
												hit.Anchored = false
												if hit.Parent then
													hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
													task.wait(0.015)
													spawn(function()
														while task.wait() do
															if hit then
																if hit.Parent then
																	hit.Parent:BreakJoints()
																end
															end
														end
													end)
												end
											end
										end)
									end
								end
							end
						end
					end
				end
			end)
			if indi then
				if indi:FindFirstChild("Hitbox") then
					for i,hit in pairs(indi.Hitbox:GetTouchingParts())do
						if hit.Parent:FindFirstChildOfClass("Humanoid") then
							if hit.Parent ~= char then
								if done == false then
									if hit.Parent:FindFirstChild("IFrame") then return end
									spawn(function()
										done = true
										--indi.Hitbox:Destroy()
										local sound = Instance.new("Sound",char.HumanoidRootPart)
										sound.PlayOnRemove = true
										sound.Volume = 1.5
										sound.SoundId = "rbxassetid://9105467029"
										sound:Destroy()
										hit.Anchored = true
										task.wait(3.5)
										if hit then
											hit.Anchored = false
											if hit.Parent then
												hit.Parent:FindFirstChildOfClass("Humanoid").Health = -1
												task.wait(0.015)
												spawn(function()
													while task.wait() do
														if hit then
															if hit.Parent then
																hit.Parent:BreakJoints()
															end
														end
													end
												end)
											end
										end
									end)
								end
							end
						end
					end
				end
			end
			task.wait(0.005)
		end
	end)
	task.wait(.01)
	game.Debris:AddItem(indi,0.25)
	spawn(function()
		local e = false
		for i = 1,(3-1.61)/0.01 do
			if e == false then
				if done == true then
					e = true
					local hea = heart:Clone()
					hea.Parent = char
					hea.Weld.Anchored = false
					local weld2 = Instance.new("Weld",hea)
					weld2.Part0 = char['Left Arm']
					weld2.Part1 = hea.Weld
					hea.script.Disabled = false
					spawn(function()
						task.wait(1.5)
						local sound = Instance.new("Sound",char.HumanoidRootPart)
						sound.PlayOnRemove = true
						sound.Volume = 1.5
						sound.SoundId = "rbxassetid://9125510051"
						sound:Destroy()
						weld2:Destroy()
					end)
				end
			end
			task.wait()
		end
	end)
	task.wait(3-1.61)
	char:FindFirstChildOfClass("Humanoid").AutoRotate = true
	char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
	char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
	pcall(function()
		script:WaitForChild('StopAnimation',10):FireAllClients()
	end)
	deb:Destroy()
end)</ProtectedString>
