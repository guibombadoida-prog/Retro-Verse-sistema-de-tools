<Item class="Folder" referent="RBX51ECAD1B638B408799A8705EF2A462E4">
				<Properties>
					<string name="Name">Death Counter</string>
					</Properties>
				<Item class="Script" referent="RBXCB915DD747B040A5A824218D5355A2E6">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local owner = tool:WaitForChild('owner')
local cd = false
local cutscene = script:WaitForChild('localcutscene'):Clone()
script:WaitForChild('localcutscene'):Destroy()
local poseff = script:WaitForChild('yo'):Clone()
script:WaitForChild('yo'):Destroy()
local rockseff = script:WaitForChild('rocks'):Clone()
script:WaitForChild('rocks'):Destroy()
local face = script:WaitForChild('face'):Clone()
script:WaitForChild('face'):Destroy()
local RagdollModule = require(script:WaitForChild('Ragdoll'))
local char = nil
local remote = tool:WaitForChild('RemoteEvent')
local a = 0
---
local function lerp(a, b, c)
	return a + (b - a) * c
end
local function quadBezier(t, p0, p1, p2)
	local l1 = lerp(p0, p1, t)
	local l2 = lerp(p1, p2, t)
	local quad = lerp(l1, l2, t)
	return quad
end
function sfx(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function contains(v, t)
	for _, val in pairs(t) do
		if val == v then
			return true
		end
	end
	return false
end
function shake(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake2:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
---
tool.Equipped:Connect(function()
	char = tool.Parent
end)
remote.OnServerEvent:Connect(function(plr,hit)
	if cd then return end
	if char ~= owner.Value then return end
	if char:FindFirstChild("Stunned") then return end
	if char:FindFirstChild("Debounce") then return end
	if plr.Character then
		if plr.Character == char then
			if hit.Parent then
				if hit.Parent:FindFirstChild("IFrame") then return end
				if hit.Parent:FindFirstChild("Ragdolled") then return end
				if hit.Parent:FindFirstChildOfClass("Humanoid") then
					if hit.Parent:FindFirstChild("Torso") or hit.Parent:FindFirstChild("HumanoidRootPart") then
						local deb = Instance.new("BoolValue",char)
						deb.Name = "Debounce"
						local iframe = Instance.new("BoolValue",char)
						iframe.Name = "IFrame"
						local iframe2 = Instance.new("BoolValue",hit.Parent)
						iframe2.Name = "IFrame"
						local stun = Instance.new("BoolValue",hit.Parent)
						stun.Name = "Stunned"
						cd = true
						if char:FindFirstChild('Right Arm') then
							if char:WaitForChild('Right Arm'):FindFirstChild("AttachSteam") then
								char:WaitForChild('Right Arm'):FindFirstChild("AttachSteam"):Destroy()
							end
						end
						require(script:WaitForChild('Animation'))(char,'paunch')
						for i,v in pairs(game.Players:GetPlayers())do
							if v.Character then
								if v.Character.PrimaryPart then
									if (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude &lt; 50 then
										local ef = script:WaitForChild('LocalViewPort'):Clone()
										ef.Parent = v:FindFirstChildOfClass("PlayerGui")
										ef.char.Value = char
										ef.Disabled = false
										game.Debris:AddItem(ef,0.6)
									end
								end
							end
						end
						local hum = char:FindFirstChildOfClass("Humanoid")
						local targethum = hit.Parent:FindFirstChildOfClass("Humanoid") 
						local targetroot = hit.Parent:FindFirstChild("Torso") or hit.Parent:FindFirstChild("HumanoidRootPart")
						local hrp = char:WaitForChild('HumanoidRootPart')
						local pos = poseff:Clone()
						pos.PrimaryPart = pos.root
						pos:SetPrimaryPartCFrame(targetroot.CFrame)
						local oldcframe = targetroot.CFrame
						pos.Parent = workspace.Terrain or workspace
						targetroot.Anchored = true
						targetroot.CFrame = oldcframe
						game:GetService("TweenService"):Create(hrp,TweenInfo.new(0.35),{CFrame = pos.Part2.CFrame}):Play()
						hum.AutoRotate = false
						hrp.Anchored = true
						targethum.AutoRotate = false
						spawn(function()
							local Effects = cutscene:Clone()
							Effects.cf.Value = pos.cam.CFrame
							task.wait()
							Effects.Parent = game:GetService('Players'):GetPlayerFromCharacter(char):FindFirstChildOfClass("PlayerGui")
							Effects.Disabled = false
						end)
						if game:GetService("Players"):GetPlayerFromCharacter(hit.Parent) then
							spawn(function()
								local Effects2 = cutscene:Clone()
								Effects2.cf.Value = pos.cam.CFrame
								task.wait()
								Effects2.Parent = game:GetService('Players'):GetPlayerFromCharacter(hit.Parent):FindFirstChildOfClass("PlayerGui")
								Effects2.Disabled = false
							end)
						end
						local hl = Instance.new("Highlight",char)
						hl.FillColor = Color3.new(0,0,0)
						hl.FillTransparency = 0.35
						hl.OutlineTransparency = 1
						hl.DepthMode = Enum.HighlightDepthMode.Occluded
						local eyes = face:Clone()
						eyes.Parent = workspace.Terrain or workspace
						eyes.Anchored = false
						local weld = Instance.new("Weld",eyes)
						weld.Part0 = char:WaitForChild('Head')
						weld.Part1 = eyes
						sfx(7069067211,3.5,hit)
						task.wait(2+1+0.5+2.5-0.1)
						task.wait(0.1)
						sfx(7157159568,2)
						local effectrock = rockseff:Clone()
						effectrock:SetPrimaryPartCFrame(hrp.CFrame)
						effectrock.Parent = workspace.Terrain or workspace
						effectrock.mainscript.Disabled = false
						shake(40)
						if hit then
							if hit.Parent then
								hit.Parent:BreakJoints()
								if targetroot then
									targetroot.Anchored = false
								end
								if targethum then
									targethum.AutoRotate = true
								end
							end
						end
						if char:FindFirstChild('Right Arm') then
							if not char:WaitForChild('Right Arm'):FindFirstChild("AttachSteam") then
								local attach = Instance.new("Attachment",char:WaitForChild('Right Arm'))
								attach.Name = "AttachSteam"
								attach.Position = Vector3.new(0, -1.178, 0)
								local particle = script:WaitForChild('steam'):Clone()
								particle.Parent = attach
								particle.Enabled = true
								spawn(function()
									task.wait(8)
									if attach then
										particle.Enabled = false
										game:GetService('Debris'):AddItem(attach,1.25)
									end
								end)
							end
						end
						task.wait(1)
						if pos then
							pos:Destroy()
						end
						if hl then
							game:GetService("TweenService"):Create(hl,TweenInfo.new(1.25),{FillTransparency = 1}):Play()
						end
						if eyes then
							game:GetService("TweenService"):Create(eyes.Eye1,TweenInfo.new(1.25),{Transparency = 1}):Play()
							game:GetService("TweenService"):Create(eyes.Eye2,TweenInfo.new(1.25),{Transparency = 1}):Play()
						end
						task.wait(1.25)
						hum.AutoRotate = true
						deb:Destroy()
						iframe2:Destroy()
						iframe:Destroy()
						script:WaitForChild('StopAnimation'):FireAllClients()
						hrp.Anchored = false
						task.wait(1.15)
						cd = false
					end
				end
			end
		end
	end
end)</ProtectedString>
