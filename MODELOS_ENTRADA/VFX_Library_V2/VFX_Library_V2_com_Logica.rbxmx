				<Item class="Script" referent="RBXC471F53C9E2C45A8BBF2D4DE9D8D5741">
					<Properties>
						<ProtectedString name="Source">local tool = script.Parent
local owner = tool:WaitForChild('owner')
local cd = false
local hitbox = script.Hitbox:Clone()
script.Hitbox:Destroy()
local rockseff = script:WaitForChild('rocks'):Clone()
script:WaitForChild('rocks'):Destroy()
local ArmEffect = script:WaitForChild('Arm'):Clone()
script:WaitForChild('Arm'):Destroy()
local cam = script:WaitForChild('CameraRig'):Clone()
script:WaitForChild('CameraRig'):Destroy()
local RagdollModule = require(script:WaitForChild('Ragdoll'))
local char = nil
local a = 0
---
local function lerp(a, b, c)
	return a + (b - a) * c
end
local function quadBezier(t, p0, p1, p2)
	local l1 = lerp(p0, p1, t)
	local l2 = lerp(p1, p2, t)
	local quad = lerp(l1, l2, t)
	return quad
end
function sfx(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function sfx2(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = id
	sound.PlayOnRemove = true
	sound:Destroy()
end
function contains(v, t)
	for _, val in pairs(t) do
		if val == v then
			return true
		end
	end
	return false
end
function shake(range)
	range = range or 50
	if not game.MaterialService:FindFirstChild("CameraShaker") then
		script.CameraShaker:Clone().Parent = game.MaterialService
	end
	for i,v in pairs(game.Players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Cutscene = script.Shake2:Clone()
					Cutscene.Parent = v.Backpack
					Cutscene.Disabled = false
				end
			end
		end
	end
end
