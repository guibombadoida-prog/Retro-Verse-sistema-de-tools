					<Item class="LocalScript" referent="RBX8E8A5782B759499AB3E40BB209E0A2D3">
						<Properties>
							<ProtectedString name="Source">local ended = script:WaitForChild('Ended',15)
local char = script:WaitForChild('char',15).Value
local LeftEff = script:WaitForChild('LeftEff',15)
local RightEff = script:WaitForChild('RightEff',15)
local Ring = script:WaitForChild('Ring',15)
local hrp = char:WaitForChild('HumanoidRootPart',15)
--
local function lerp(a, b, c)
	return a + (b - a) * c
end
local function quadBezier(t, p0, p1, p2)
	local l1 = lerp(p0, p1, t)
	local l2 = lerp(p1, p2, t)
	local quad = lerp(l1, l2, t)
	return quad
end
--
spawn(function()
	while task.wait(0.025) do
		if char then
			if ended.Value == false then
				spawn(function()
					local choose = math.random(1,2)
					local part = nil
					local hrpc = hrp.CFrame
					local endc = hrp.CFrame*CFrame.new(math.random(-3,3),math.random(-2,2),-7.2)
					local hrpp = (hrp.CFrame*CFrame.new(0,0,1)).Position
					local endp = endc.Position
					local mid = (hrp.CFrame*CFrame.new(math.random(-8,8),math.random(-2,2),-3.5)).Position
					if choose == 1 then
						part = LeftEff:Clone()
						if char:FindFirstChildOfClass("Shirt") then
							char:FindFirstChildOfClass("Shirt"):Clone().Parent = part
						end
						if char:FindFirstChild("Left Arm") then
							if part:FindFirstChild('Left Arm') then
								part:FindFirstChild("Left Arm").Color = char:FindFirstChild("Left Arm").Color
							end
						end
						hrpp = (hrp.CFrame*CFrame.new(1.15,1,0.75)).Position
						mid = (hrp.CFrame*CFrame.new(math.random(0,8),math.random(-2,2),-3.5)).Position
						--game:GetService("TweenService"):Create(part:WaitForChild('Ring'),TweenInfo.new(0.35),{Size = Vector3.new(1.5,0.01,1.5),Transparency = 1}):Play()
						--game:GetService("TweenService"):Create(part:WaitForChild('Left Arm'),TweenInfo.new(0.45),{Transparency = 1}):Play()
					elseif choose == 2 then
						part = RightEff:Clone()
						if char:FindFirstChildOfClass("Shirt") then
							char:FindFirstChildOfClass("Shirt"):Clone().Parent = part
						end
						if char:FindFirstChild("Right Arm") then
							if part:FindFirstChild('Right Arm') then
								part:FindFirstChild("Right Arm").Color = char:FindFirstChild("Right Arm").Color
							end
						end
						mid = (hrp.CFrame*CFrame.new(math.random(-8,0),math.random(-2,2),-3.5)).Position
						hrpp = (hrp.CFrame*CFrame.new(-1.15,1,0.75)).Position
						--game:GetService("TweenService"):Create(part:WaitForChild('Ring'),TweenInfo.new(0.35),{Size = Vector3.new(1.5,0.01,1.5),Transparency = 1}):Play()
						--game:GetService("TweenService"):Create(part:WaitForChild('Right Arm'),TweenInfo.new(0.45),{Transparency = 1}):Play()
					end
					part.PrimaryPart.CFrame = hrpc
					game:GetService("Debris"):AddItem(part,.35)
					spawn(function()
						for i= 1, 9 do
							local t = i/9
							local q = quadBezier(t,hrpp,mid,endp)
							--part.PrimaryPart.CFrame = CFrame.new(q)
							game:GetService("TweenService"):Create(part.PrimaryPart,TweenInfo.new(0.025),{CFrame = CFrame.new(q,quadBezier(t + 0.1,hrpp,mid,endp))}):Play()
							--part.PrimaryPart.CFrame = CFrame.new(q,quadBezier(t + 0.1,hrpp,mid,endp))
							part.Parent = char
							wait()
						end
					end)
					spawn(function()
						task.wait(0.25)
						local ringeff = Ring:Clone()
						ringeff.Parent = char
						ringeff:SetPrimaryPartCFrame(endc)
						game:GetService("Debris"):AddItem(ringeff,0.2)
						game:GetService("TweenService"):Create(ringeff:WaitForChild('Ring'),TweenInfo.new(0.2),{Size = Vector3.new(3, 0, 3),Transparency = 1}):Play()
					end)
				end)
			else
				break
			end
		else
			break
		end
	end
end)</ProtectedString>
