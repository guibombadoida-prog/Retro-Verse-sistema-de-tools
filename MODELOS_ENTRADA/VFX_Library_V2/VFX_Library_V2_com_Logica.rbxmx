						<Item class="Script" referent="RBXA01254874AD449309A7B7B8F9503C4AC">
							<Properties>
								<ProtectedString name="Source">local puddle = script.Parent
local tweenService = game:GetService("TweenService")
local debris = game:GetService("Debris")
local despawnTime = 15


wait(despawnTime)

local info = TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, false, 0)
local properties = {
	Transparency = 1;
}
local tween = tweenService:Create(puddle, info, properties)
tween:Play() -- start tweening the transparency

debris:AddItem(puddle, info.Time) -- despawns the puddle after an amount of seconds</ProtectedString>
								<bool name="Disabled">false</bool>
