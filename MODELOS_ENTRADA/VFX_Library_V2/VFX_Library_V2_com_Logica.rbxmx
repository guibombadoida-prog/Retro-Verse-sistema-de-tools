								<string name="ScriptGuid">{DFA647F7-43C9-49FF-BDE8-A774388C36AF}</string>
								<BinaryString name="AttributesSerialize"/>
								<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
								<bool name="DefinesCapabilities">true</bool>
								<string name="Name">Shaker</string>
								<int64 name="SourceAssetId">-1</int64>
								<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							</Properties>
							<Item class="IntValue" referent="RBX939933CA96A84B5C8F766B4B1DF530E2">
								<Properties>
									<int64 name="Value">0</int64>
									<BinaryString name="AttributesSerialize"/>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<string name="Name">FadeIn</string>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
