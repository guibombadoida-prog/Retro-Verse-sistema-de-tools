					<Item class="Script" referent="RBXDF6D4D4F1FEE4D248EA039D88A62DA33">
						<Properties>
							<ProtectedString name="Source">local ran1 = math.random(-180,180)
local ran2 = math.random(-180,180)
game.TweenService:Create(script.Parent.Wind,TweenInfo.new(0.75),{Transparency = 1,Size = script.Parent.Wind2.Size,CFrame = script.Parent.Wind2.CFrame}):Play()
for i,v in pairs(script.Parent.Lines:GetChildren())do
	game.TweenService:Create(v:FindFirstChildOfClass("SpecialMesh"),TweenInfo.new(0.5),{Offset = Vector3.new(5,0,0)}):Play()
	game.TweenService:Create(v,TweenInfo.new(0.5),{Transparency = 1}):Play()
end
game.Debris:AddItem(script.Parent,0.75)</ProtectedString>
							<bool name="Disabled">true</bool>
