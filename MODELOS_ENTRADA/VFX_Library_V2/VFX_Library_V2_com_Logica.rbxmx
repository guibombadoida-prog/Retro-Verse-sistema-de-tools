						<Item class="ModuleScript" referent="RBXA91618DB559A4AA1BAD31BFEA642A8AB">
							<Properties>
								<Content name="LinkedSource"><null/></Content>
								<ProtectedString name="Source">local Rocks = {}

local TS = game:GetService("TweenService")
local RS = game:GetService("ReplicatedStorage")
local PS = game:GetService("PhysicsService")
local RunService = game:GetService("RunService")
local Modules = script.Parent
local cacheFolder = workspace:FindFirstChildOfClass("Terrain")
function Rocks.Ground(Pos, Distance, Size, MaxRocks, Ice, despawnTime)
	local random = Random.new()

	local angle = 30
	local otherAngle = 360/MaxRocks
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {cacheFolder}
	local size
	size = Size or Vector3.new(2, 2, 2)
	local pos = Pos
	despawnTime = despawnTime or 3

	local function OuterRocksLoop ()
		for i = 1, MaxRocks do
			local cf = CFrame.new(Pos)
			local newCF = cf * CFrame.fromEulerAnglesXYZ(0, math.rad(angle), 0) * CFrame.new(Distance/2 + Distance/2.7, 10, 0)
			local ray = workspace:Raycast(newCF.Position, Vector3.new(0, -20, 0), params)
			angle += otherAngle
			if ray then
				local part = Instance.new("Part")
				local hoof = Instance.new("Part")

				part.CFrame = CFrame.new(ray.Position - Vector3.new(0, 0.5, 0), Pos) * CFrame.fromEulerAnglesXYZ(random:NextNumber(-.25, .5), random:NextNumber(-.25, .25), random:NextNumber(-.25, .25))
				part.Size = Vector3.new(size.X * 1.3, size.Y/1.4, size.Z * 1.3) * random:NextNumber(1, 1.5)

				hoof.Size = Vector3.new(part.Size.X * 1.01, part.Size.Y * 0.25, part.Size.Z * 1.01)
				hoof.CFrame = part.CFrame * CFrame.new(0, part.Size.Y/2 - hoof.Size.Y / 2.1, 0)

				part.Parent = cacheFolder
				hoof.Parent = cacheFolder

				if ray.Instance.Material == Enum.Material.Concrete or ray.Instance.Material == Enum.Material.Air or ray.Instance.Material == Enum.Material.Wood or ray.Instance.Material == Enum.Material.Neon or ray.Instance.Material == Enum.Material.WoodPlanks then
					part.Material = ray.Instance.Material	
					hoof.Material = ray.Instance.Material	
				else
					part.Material = ray.Instance.Material
					hoof.Material = ray.Instance.Material	
				end
				game.Debris:AddItem(part,despawnTime)
				game.Debris:AddItem(hoof,despawnTime)
				part.Color = ray.Instance.Color
				part.Anchored = true
				part.CanTouch = false
				part.CanCollide = true
				--part.Transparency = 0
				hoof.Position = hoof.Position - Vector3.new(0,part.Size.Y,0)
				part.Position = part.Position - Vector3.new(0,part.Size.Y,0)
				hoof.Color = ray.Instance.Color
				hoof.Anchored = true
				hoof.CanTouch = false
				hoof.CanCollide = false
				spawn(function()
					TS:Create(hoof,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position = hoof.Position + Vector3.new(0,part.Size.Y,0)}):Play()
					TS:Create(part,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position = part.Position + Vector3.new(0,part.Size.Y,0)}):Play()
				end)
				if Ice then
					part.BrickColor = BrickColor.new("Pastel light blue")
					hoof.BrickColor = BrickColor.new("Lily white")
					part.Material = Enum.Material.Ice
					hoof.Material = Enum.Material.Sand
				end
				local rand1 = math.random(-180,180)
				local rand2 = math.random(-180,180)
				local rand3 = math.random(-180,180)
				task.delay(despawnTime-2, function()
					TS:Create(hoof,TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),{Position = hoof.Position + Vector3.new(0,-part.Size.Y*1.5, 0),Orientation = hoof.Orientation + Vector3.new(math.random(-20,20),math.random(-20,20),math.random(-20,20))}):Play()
					TS:Create(part,TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),{Position = part.Position + Vector3.new(0,-part.Size.Y*1.5, 0),Orientation = hoof.Orientation + Vector3.new(math.random(-20,20),math.random(-20,20),math.random(-20,20))}):Play()
				end)
			end		
		end
	end

	local function InnerRocksLoop ()
		for i = 1, MaxRocks do
			local cf = CFrame.new(Pos)
			local newCF = cf * CFrame.fromEulerAnglesXYZ(0, math.rad(angle), 0) * CFrame.new(Distance/2 + Distance/10, 10, 0)
			local ray = game.Workspace:Raycast(newCF.Position, Vector3.new(0, -20, 0), params)
			angle += otherAngle
			if ray then
				local part = Instance.new("Part")
				local hoof = Instance.new("Part")

				part.CFrame = CFrame.new(ray.Position - Vector3.new(0, size.Y * 0.4, 0), Pos) * CFrame.fromEulerAnglesXYZ(random:NextNumber(-1,-0.3),random:NextNumber(-0.15,0.15),random:NextNumber(-.15,.15))
				part.Size = Vector3.new(size.X * 1.3, size.Y * 0.7, size.Z * 1.3) * random:NextNumber(1, 1.5)

				hoof.Size = Vector3.new(part.Size.X * 1.01, part.Size.Y * 0.25, part.Size.Z * 1.01)
				hoof.CFrame = part.CFrame * CFrame.new(0, part.Size.Y/2 - hoof.Size.Y / 2.1, 0)

				part.Parent = cacheFolder
				hoof.Parent = cacheFolder

				if ray.Instance.Material == Enum.Material.Concrete or ray.Instance.Material == Enum.Material.Air or ray.Instance.Material == Enum.Material.Wood or ray.Instance.Material == Enum.Material.Neon or ray.Instance.Material == Enum.Material.WoodPlanks then
					part.Material = ray.Instance.Material	
					hoof.Material = ray.Instance.Material	
				else
					part.Material = ray.Instance.Material	
					hoof.Material = ray.Instance.Material	
				end

				game.Debris:AddItem(part,despawnTime)
				game.Debris:AddItem(hoof,despawnTime)
				part.Color = ray.Instance.Color
				part.Anchored = true
				part.CanTouch = false
				part.CanCollide = true
				--part.Transparency = 0
				hoof.Position = hoof.Position - Vector3.new(0,part.Size.Y,0)
				part.Position = part.Position - Vector3.new(0,part.Size.Y,0)
				hoof.Color = ray.Instance.Color
				hoof.Anchored = true
				hoof.CanTouch = false
				hoof.CanCollide = false
				spawn(function()
					TS:Create(hoof,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position = hoof.Position + Vector3.new(0,part.Size.Y,0)}):Play()
					TS:Create(part,TweenInfo.new(0.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position = part.Position + Vector3.new(0,part.Size.Y,0)}):Play()
				end)
				if Ice then
					part.BrickColor = BrickColor.new("Pastel light blue")
					hoof.BrickColor = BrickColor.new("Lily white")
					part.Material = Enum.Material.Ice
					hoof.Material = Enum.Material.Sand
				end
				local rand1 = math.random(-180,180)
				local rand2 = math.random(-180,180)
				local rand3 = math.random(-180,180)
				task.delay(despawnTime-3.5, function()
					TS:Create(hoof,TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),{Position = hoof.Position + Vector3.new(0,-part.Size.Y*1.5, 0),Orientation = hoof.Orientation + Vector3.new(math.random(-20,20),math.random(-20,20),math.random(-20,20))}):Play()
					TS:Create(part,TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),{Position = part.Position + Vector3.new(0,-part.Size.Y*1.5, 0),Orientation = hoof.Orientation + Vector3.new(math.random(-20,20),math.random(-20,20),math.random(-20,20))}):Play()
				end)
			end		
		end
	end
	InnerRocksLoop()
	OuterRocksLoop()
end

return Rocks</ProtectedString>
