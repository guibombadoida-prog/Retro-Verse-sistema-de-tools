	local soundL = Instance.new("Sound",char.HumanoidRootPart)
	soundL.PlayOnRemove = true
	soundL.Volume = 1.5
	soundL.SoundId = "rbxassetid://7414289494"
	soundL:Destroy()
	char:FindFirstChildOfClass("Humanoid").JumpPower = 5
	char:FindFirstChildOfClass("Humanoid").WalkSpeed = 2
