						<ProtectedString name="Source">local tool = script.Parent
local char = nil
local cd = false
local debris = game:GetService("Debris")
local owner = tool:WaitForChild('owner')
local players = game:GetService("Players")
local animation = require(script:WaitForChild('Animation'))
local assets = script:WaitForChild('Assets'):Clone()
script:WaitForChild('Assets'):Destroy()
local effectsfolder = workspace:FindFirstChildOfClass("Terrain") or workspace
local ragdollmodule = require(script:WaitForChild('Ragdoll'))
local rockmodule2 = require(script:WaitForChild('RockModule2'))
local debrismodule = require(script:WaitForChild('DebrisModule'))
local rockmodule = require(script:WaitForChild('RockModule'))
local StopRemote = script:WaitForChild('StopRemote')
---functions---
getnearobjects = function(pos,range,ignore)
	range = range or 12
	ignore = ignore or char
	local objects = {}
	for i,v in pairs(workspace:GetDescendants())do
		if v:IsA("Model") and v ~= char and v ~= ignore then
			if v:FindFirstChildOfClass("Humanoid") then
				if v.PrimaryPart then
					if (v.PrimaryPart.Position-pos).Magnitude &lt; range then
						table.insert(objects,v)
					end
				end
			end
		end
	end
	---
	return objects
end
smoke = function(pos,lifetime,size,speedmin,speedmax,emit,params)
	local result = workspace:Raycast(pos,Vector3.new(0,-50,0),params)
	if result then
		local attach = Instance.new("Attachment",effectsfolder)
		attach.WorldPosition = result.Position+Vector3.new(0,0.5,0)
		local downsmoke = assets:WaitForChild('Smoke'):Clone()
		downsmoke.Parent = attach
		downsmoke.Size = NumberSequence.new(size)
		downsmoke.Speed = NumberRange.new(speedmin,speedmax)
		downsmoke.Lifetime = NumberRange.new(lifetime)
		downsmoke.Color = ColorSequence.new(result.Instance.Color)
		downsmoke:Emit(emit)
		if size &lt; 35 then
			local upsmoke = assets:WaitForChild('UpSmoke'):Clone()
			upsmoke.Parent = attach
			upsmoke.Size = NumberSequence.new(size)
			upsmoke.Lifetime = NumberRange.new(lifetime)
			upsmoke.Color = ColorSequence.new(result.Instance.Color)
			upsmoke:Emit(emit)
		end
		debris:AddItem(attach,lifetime+0.5)
	end
end
shake = function(lifetime,range,magnitude,roughness,fadein,fadeout,preset)
	preset = preset or nil
	fadein = fadein or 0.3
	fadeout = fadeout or 0.3
	roughness = roughness or 5
	magnitude = magnitude or 5
	range = range or 50
	lifetime = lifetime or 1
	for _,v in pairs(players:GetPlayers())do
		if v.Character then
			if v.Character.PrimaryPart then
				local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
				if Magnitude &lt; range then
					local Shaker = assets:WaitForChild('Shaker'):Clone()
					Shaker.Roughness.Value = roughness
					Shaker.Magnitude.Value = Magnitude
					Shaker.FadeIn.Value = fadein
					Shaker.FadeOut.Value = fadeout
					if preset ~= nil then
						Shaker.Preset.Value = preset
					end
					Shaker.Parent = v.Backpack
					Shaker.Disabled = false
					debris:AddItem(Shaker,lifetime)
				end
			end
		end
	end
end
newhitbox = function(lifetime,model)
	lifetime = lifetime or 0.5
	local hitboxz = model:Clone()
	hitboxz.Parent = effectsfolder
	debris:AddItem(hitboxz,0.5)
	return hitboxz
end
sfx = function(id,vol,parent)
	vol = vol or 0.5
	parent = parent or char:WaitForChild('HumanoidRootPart')
	local sound = Instance.new("Sound",parent)
	sound.Volume = vol
	sound.SoundId = "rbxassetid://"..id
	sound.PlayOnRemove = true
	sound:Destroy()
end
---tool_functions--
activate = function()
	if char ~= owner.Value then return end
	if cd then return end
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then return end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	local iframe = Instance.new("BoolValue",char)
	iframe.Name = "IFrame"
	cd = true
	--
	local hrp = char:WaitForChild('HumanoidRootPart')
	local head = char:WaitForChild('Head')
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local oldws = humanoid.WalkSpeed
	local oldjp = humanoid.JumpPower
	--
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {char,effectsfolder}
	--
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	animation(char,'final1')
	task.wait(0.267)
	sfx(7325671724,0.75)
	task.wait(0.166)
	sfx(289842971,2)
	rockmodule.createFaceInward(hrp,6,8,3,2,2,1,true,params)
	rockmodule.createFaceInward(hrp,9,12,4,3,3,1,true,params)
	shake(2,20,1,1,1,1,"Bump")
	spawn(function()
		for i = 1,10 do
			local spread = 8
			local cf = hrp.CFrame*CFrame.new(math.random(-spread,spread),1,math.random(-spread,spread))
			debrismodule.Rocks(cf.Position,1,Vector3.new(0,-15,0),true,false,-180,180,40,60,0.1,3.5,3.5,false)
		end
	end)
	smoke(hrp.Position,3,5.5,50,100,30,params)
	--
	local paramshitbox = OverlapParams.new()
	paramshitbox.FilterType = Enum.RaycastFilterType.Blacklist
	paramshitbox.FilterDescendantsInstances = {char}
	--
	local donehit = false
	--
	local hitfunc = function(hit)
		local target = hit.Parent
		if target and target:FindFirstChildOfClass("Humanoid") and donehit == false then
			if not target:FindFirstChild("IFrame") and not char:FindFirstChild("Stunned") then
				donehit = true
				--
				local targethumanoid = target:FindFirstChildOfClass("Humanoid")
				--
				StopRemote:FireAllClients()
				--
				animation(char,'final2')
				--
				local stun = Instance.new("BoolValue",target)
				stun.Name = "Stunned"
				debris:AddItem(stun,1.55)
				local iframe2 = Instance.new("BoolValue",target)
				iframe2.Name = "IFrame"
				debris:AddItem(iframe2,1.55)
				local ragdollvalue = Instance.new("BoolValue",target)
				ragdollvalue.Name = "Ragdolled"
				debris:AddItem(ragdollvalue,1.55)
				local pos = (hrp.CFrame*CFrame.new(0,155,0)).Position
				local pos2 = (hrp.CFrame*CFrame.new(0,155,-5.5)).Position
				local velo = Instance.new("BodyPosition",hit)
				velo.Position = pos2
				velo.D = 3250
				velo.P = 80000
				velo.MaxForce = Vector3.new(1,1,1) * 500000
				debris:AddItem(velo,1.55)
				ragdollmodule:Ragdoll(target,6.55,false)
				humanoid.AutoRotate = false
				task.wait(0.217)
				local velo2 = Instance.new("BodyPosition",hrp)
				velo2.Position = pos
				velo2.D = 3250
				velo2.P = 80000
				velo2.MaxForce = Vector3.new(1,1,1) * 500000
				debris:AddItem(velo2,1.333)
				sfx(9114890978,1.5)
				task.wait(0.266)
				sfx(5530025800,0.65)
				task.wait(0.467)
				sfx(8388601745,1.5)
				task.wait(0.05)
				sfx(3183222154,2)
				shake(2,20,1,1,1,1,"Bump")
				local attach = Instance.new("Attachment",char:WaitForChild('HumanoidRootPart'))
				attach.Position = Vector3.new(0.326, -0.154, -3.555)
				attach.Orientation = Vector3.new(-80, 180, -180)
				for _,v in pairs(assets:WaitForChild('particles'):GetChildren())do
					local eff = v:Clone()
					eff.Parent = attach
					eff:Emit(v:GetAttribute('EmitCount'))
				end
				debris:AddItem(attach,1)
				if velo then
					velo:Destroy()
				end
				if target and targethumanoid then
					local val5 = Instance.new("BoolValue",target)
					val5.Name = "Ragdolled"
					debris:AddItem(val5,5)
					local val4 = Instance.new("BoolValue",target)
					val4.Name = "Stunned"
					debris:AddItem(val4,5)
					local donetouch = false
					local velo3 = Instance.new("BodyVelocity",hit)
					velo3.MaxForce = Vector3.new(1,1,1) * 500000
					velo3.Velocity = hrp.CFrame.LookVector * 10 - Vector3.new(0,50,0)
					debris:AddItem(velo3,0.3)
					spawn(function()
						task.wait(1.45)
						if hit then
							if target and targethumanoid then
								target:BreakJoints()
								params.FilterDescendantsInstances = {char,effectsfolder,target}
								local targetroot = Instance.new("Part",effectsfolder)
								targetroot.Transparency = 1
								targetroot.Anchored = true
								targetroot.Size = Vector3.new(1,1,1)
								targetroot.CanCollide = false
								targetroot.Locked = true
								targetroot.Position = hit.Position+Vector3.new(0,20,0)
								if targetroot ~= nil then
									sfx(3802269741,5,targetroot)
									sfx(5532556720,2,targetroot)
									shake(2,100,1,1,1,1,"Explosion")
									spawn(function()
										for i = 1,25 do
											local spread = 65
											local cf = targetroot.CFrame*CFrame.new(math.random(-spread,spread),1,math.random(-spread,spread))
											debrismodule.Rocks(cf.Position,1,Vector3.new(0,-50,0),true,false,-180,180,60,150,0.1,15,3.5,false)
										end
									end)
									smoke(targetroot.Position,4,45,300,500,65,params)
									rockmodule.createFaceInward(targetroot,8,10,8,3,2.5,2.5,true,params)
									rockmodule.createFaceInward(targetroot,7,20,9.5,4.5,4.5,2.5,true,params)
									rockmodule.createFaceInward(targetroot,8,35,12,5,5,2.5,true,params)
									rockmodule.createFaceInward(targetroot,9,45,20,8,8,2.5,true,params)
									rockmodule.createFaceInward(targetroot,8,65,20,10,10,2.5,true,params)
									rockmodule.createFaceInward(targetroot,8,80,35,15,15,2.5,true,params)
									for _,v in pairs(getnearobjects(targetroot.Position,85,target))do
										if not v:FindFirstChild('IFrame') then
											local val1 = Instance.new("BoolValue",v)
											val1.Name = "Stunned"
											game:GetService("Debris"):AddItem(val1,2)
											local val2 = Instance.new("BoolValue",v)
											val2.Name = "Ragdolled"
											game:GetService("Debris"):AddItem(val2,2)
											local velo4 = Instance.new("BodyVelocity",v.PrimaryPart)
											velo4.MaxForce = Vector3.new(1,1,1) * 500000
											velo4.Velocity = Vector3.new(0,65,0)
											debris:AddItem(velo4,0.25)
											ragdollmodule:Ragdoll(v,2,false)
											v:FindFirstChildOfClass("Humanoid").Health -= v:FindFirstChildOfClass("Humanoid").MaxHealth/3.5
										end
									end
								end
							end
						end
					end)
				end
				task.wait(1.55)
				if velo2 then
					velo2:Destroy()
				end
				humanoid.AutoRotate = true
				deb:Destroy()
				iframe:Destroy()
				StopRemote:FireAllClients()
				humanoid.WalkSpeed = oldws
				humanoid.JumpPower = oldjp
				task.wait(0.25)
				cd = false
			end
		end
	end
	--
	local hitbox = newhitbox(0.15,assets:WaitForChild('Hitbox'))
	spawn(function()
		while task.wait() do
			if hitbox and hitbox:FindFirstChild('Hitbox') and donehit == false then
				hitbox:SetPrimaryPartCFrame(hrp.CFrame)
				local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
				for _,v in pairs(parts)do
					hitfunc(v)
				end
			else
				break
			end
		end
	end)
	--
	spawn(function()
		task.wait(0.45)
		if donehit == false then
			deb:Destroy()
			iframe:Destroy()
			humanoid.WalkSpeed = oldws
			humanoid.JumpPower = oldjp
			StopRemote:FireAllClients()
			task.wait(0.25)
			cd = false
		end
	end)
end
equip = function()
	char = tool.Parent
end
---connect---
tool.Equipped:Connect(equip)
tool.Activated:Connect(activate)</ProtectedString>
