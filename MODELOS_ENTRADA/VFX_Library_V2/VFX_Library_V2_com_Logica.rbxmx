							<Properties>
								<ProtectedString name="Source">script.Parent.RemoteEvent.OnServerEvent:Connect(function()
	local plr = script.Parent.plr.Value
	local desc = game.Players:GetHumanoidDescriptionFromUserId(plr.UserId)
	if script.Parent.Parent.ImageLabel.ViewportFrame:FindFirstChild("Rig") then
		script.Parent.Parent.ImageLabel.ViewportFrame:FindFirstChild("Rig"):FindFirstChildOfClass("Humanoid"):ApplyDescription(desc)
	end
	if script.Parent.Parent.ImageLabel2.ViewportFrame2:FindFirstChild("Rig") then
		script.Parent.Parent.ImageLabel2.ViewportFrame2:FindFirstChild("Rig"):FindFirstChildOfClass("Humanoid"):ApplyDescription(desc)
	end
end)</ProtectedString>
