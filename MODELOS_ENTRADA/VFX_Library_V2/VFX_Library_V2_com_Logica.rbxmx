					<Item class="LocalScript" referent="RBXF553E3FC427C4BB390D90B8FABC18815">
						<Properties>
							<ProtectedString name="Source">local cam = workspace.CurrentCamera
local plr = game.Players.LocalPlayer
local cf = script:WaitForChild('cf',15)
local cutscene = script:WaitForChild('cutscene',15)
local deathgui = script:WaitForChild("Death",15)
local vig = script:WaitForChild("HeavyVi",15)
cam.CameraType = "Scriptable"
script.Destroying:Connect(function()
	cam.CameraType = "Custom"
	cam.FieldOfView = 70
	if cutscene then
		cutscene:Destroy()
	end
	if deathgui then
		deathgui:Destroy()
	end
	if vig then
		vig:Destroy()
	end
end)
cam.FieldOfView = 80
game:GetService("TweenService"):Create(cam,TweenInfo.new(2),{FieldOfView = 70}):Play()
game:GetService("TweenService"):Create(cam,TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{CFrame = cf.Value}):Play()
task.wait(2)
script:WaitForChild('boom'):Play()
deathgui.Parent = plr:FindFirstChildOfClass("PlayerGui")
deathgui.Enabled = true
game:GetService("TweenService"):Create(deathgui.Image,TweenInfo.new(1),{ImageTransparency = 0}):Play()
game:GetService("Debris"):AddItem(deathgui,1)
task.wait(1)
cam.CFrame = cutscene:WaitForChild('Camm').CFrame
local random = Random.new()
local ended = false
vig.Parent = plr:FindFirstChildOfClass("PlayerGui")
vig.Enabled = true
game:GetService("Debris"):AddItem(vig,2.85)
spawn(function()
	while task.wait() do
		if ended == false then
			cam.CFrame = cam.CFrame*CFrame.new(random:NextNumber(-0.1,0.1),random:NextNumber(-0.1,0.1),random:NextNumber(-0.1,0.1))
		else
			break
		end
	end
end)
game:GetService("TweenService"):Create(cutscene:WaitForChild('Fist'),TweenInfo.new(2.85,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame = cutscene:WaitForChild('Fist2').CFrame}):Play()
game:GetService("TweenService"):Create(cam,TweenInfo.new(2.85),{FieldOfView = 80}):Play()
script:WaitForChild('expl'):Play()
cutscene.Parent = workspace.Terrain or workspace
game:GetService("Debris"):AddItem(cutscene,2.85)
task.wait(1.5)
cutscene:WaitForChild('Fist').Attachment.Effect:Emit(10)
script:WaitForChild('whoosh'):Play()
task.wait(2.85-1.5)
ended = true
cam.CameraType = "Custom"
cam.FieldOfView = 70
script:WaitForChild('RemoteEvent',15):FireServer()</ProtectedString>
