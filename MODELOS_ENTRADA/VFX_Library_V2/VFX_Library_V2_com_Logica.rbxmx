<Item class="Folder" referent="RBXDFA18F8FBFC8439F870661DB3F8660BB">
			<Properties>
				<string name="Name">What's it feel like when time stands still?</string>
				</Properties>
			<Item class="Script" referent="RBX7A160D5655B7481BA6117FB25DAECE2E">
				<Properties>
					<ProtectedString name="Source">local char = nil
local wave = script.Wave:Clone()
script.Wave:Destroy()
local seff = script.Smash:Clone()
script.Smash:Destroy()
local HB = script.Hitbox:Clone()
script.Hitbox:Destroy()
local BEff = script.Barrage:Clone()
script.Barrage:Destroy()
local SP = script.Stand:Clone()
script.Stand:Destroy()
local FixP = script.Pos:Clone()
script.Pos:Destroy()
local cd = false
script.Parent.Equipped:Connect(function()
	char = script.Parent.Parent
end)
script.Parent.Activated:Connect(function()
	if char then
		if char:FindFirstChild("Debounce") or cd == true or char:FindFirstChild("Stunned") then return end
		local Deb = Instance.new("BoolValue",char)
		Deb.Name = "Debounce"
		local val = Instance.new("BoolValue",char)
		val.Name = "IFrame"
		local oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
		local oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
		local sound3 = Instance.new("Sound",char.HumanoidRootPart)
		sound3.Volume = 2
		sound3.PlayOnRemove = true
		sound3.SoundId = "rbxassetid://4903895449"
		sound3:Destroy()
		require(script.Animation)(char,'Attack')
		char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		char:FindFirstChildOfClass("Humanoid").JumpPower = 0
		local done = false
		spawn(function()
			for i = 1,1/0.1 do
				local ring = wave:Clone()
				ring.Parent = workspace
				ring:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
				ring.script.Disabled = false
				task.wait(.1)
			end
		end)
		task.wait(1.05)
		local velo = Instance.new("BodyVelocity",char.HumanoidRootPart)
		velo.Velocity = char.HumanoidRootPart.CFrame.LookVector * 10
		velo.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
		game.Debris:AddItem(velo,0.75)
		local hitbox = HB:Clone()
		hitbox.Parent = workspace
		hitbox.HumanoidRootPart.Anchored = false
		local weld = Instance.new("Weld",hitbox)
		weld.Part0 = char.HumanoidRootPart
		weld.Part1 = hitbox.HumanoidRootPart
		game.Debris:AddItem(hitbox,0.75)
		hitbox.Hitbox.Touched:Connect(function(hit)
			if hit.Parent:FindFirstChildOfClass("Humanoid") then
				if hit.Parent ~= char then
					if hit.Parent:FindFirstChild("Blocking") or hit.Parent:FindFirstChild("IFrame") then return end
					if done == false then
						done = true
						local stun = Instance.new("BoolValue",hit.Parent)
						stun.Name = "Stunned"
						velo:Destroy()
						local smash = seff:Clone()
						smash.Parent = workspace
						smash:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
						smash.script.Disabled = false
						char.HumanoidRootPart.Anchored = true
						hit.Anchored = true
						if not game.MaterialService:FindFirstChild("CameraShaker") then
							script.CameraShaker:Clone().Parent = game.MaterialService
						end
						for i,v in pairs(game.Players:GetPlayers())do
							if v.Character then
								if v.Character.PrimaryPart then
									local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
									if Magnitude &lt; 50 then
										local Cutscene = script.Shake2:Clone()
										Cutscene.Parent = v.Backpack
										Cutscene.Disabled = false
									end
								end
							end
						end
						char:FindFirstChildOfClass("Humanoid").AutoRotate = false
						local pfix = FixP:Clone()
						pfix.Parent = workspace
						pfix:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
						hit.CFrame = pfix.EnemyRoot.CFrame
						char.HumanoidRootPart.CFrame = pfix.Root.CFrame
						game.Debris:AddItem(pfix,1)
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 2
						sound3.PlayOnRemove = true
						sound3.SoundId = "rbxassetid://5886412948"
						sound3:Destroy()
						script:WaitForChild('StopAnimation',25):FireAllClients()
						local stand = SP:Clone()
						stand.Parent = char
						stand.HumanoidRootPart.Anchored = false
						local weld3 = Instance.new("Weld",stand)
						weld3.Part0 = char.HumanoidRootPart
						weld3.Part1 = stand.HumanoidRootPart
						require(script.Animator):LoadAnimation(stand,require(10449982955)('SPBeatdown')):Play(0,1)
						task.wait(.35)
						local smash = seff:Clone()
						smash.Parent = workspace
						smash:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
						smash.script.Disabled = false
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 2
						sound3.SoundId = "rbxassetid://8659358224"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						task.wait(.35)
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 1.5
						sound3.SoundId = "rbxassetid://6186260230"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 3
						sound3.SoundId = "rbxassetid://2102274452"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						local eff = script.Ring:Clone()
						eff.Parent = stand.HumanoidRootPart
						spawn(function()
							for i = 1,3 do
								eff:Emit(1)
								task.wait(.075)
							end
							game.Debris:AddItem(eff,0.5)
						end)
						task.wait(1.45-.7)
						local sfx = Instance.new("Sound",char.HumanoidRootPart)
						sfx.Volume = 2
						sfx.SoundId = "rbxassetid://6678126154"
						sfx:Play()
						local barrage = BEff:Clone()
						barrage.Parent = char
						barrage.Root.Anchored = false
						local weld2 = Instance.new("Weld",barrage)
						weld2.Part0 = char.HumanoidRootPart
						weld2.Part1 = barrage.Root
						local ended = false
						spawn(function()
							for i = 1,3.5/0.035 do
								if ended == false then
									local done2 = false
									if hit then
										if hit.Parent then
											for i,v in pairs(hit.Parent:GetChildren())do
												if v:IsA("BasePart") then
													if done2 == false then
														done2 = true
														for i,c in pairs(script.HitEff:GetChildren())do
															local r = c:Clone()
															r.Parent = v
															r:Emit(c:GetAttribute("EmitCount"))
															game.Debris:AddItem(r,0.5)
														end
													end
												end
											end
										end
									end
									local sound3 = Instance.new("Sound",char.HumanoidRootPart)
									sound3.Volume = 0.8
									sound3.SoundId = "rbxassetid://8659358224"
									sound3.PlayOnRemove = true
									sound3:Destroy()
									pcall(function()
										barrage.Part2.dp:Emit(1)
										barrage.Part.dp:Emit(1)
										barrage.Part["Smoke(1)"]:Emit(5)
									end)
									task.wait(0.035)
								end
							end
						end)
						task.wait(3.517-1.45)
						ended = true
						barrage:Destroy()
						sfx:Destroy()
						task.wait(4-3.517)
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 3
						sound3.SoundId = "rbxassetid://4903897880"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						spawn(function()
							task.wait(.25)
							if not game.MaterialService:FindFirstChild("CameraShaker") then
								script.CameraShaker:Clone().Parent = game.MaterialService
							end
							for i,v in pairs(game.Players:GetPlayers())do
								if v.Character then
									if v.Character.PrimaryPart then
										local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
										if Magnitude &lt; 50 then
											local Cutscene = script.Shake2:Clone()
											Cutscene.Parent = v.Backpack
											Cutscene.Disabled = false
										end
									end
								end
							end
							if hit then
								if hit.Parent then
									for i,v in pairs(hit.Parent:GetChildren())do
										if v:IsA("BasePart") then
											for i,c in pairs(script.HeavyEff:GetChildren())do
												local r = c:Clone()
												r.Parent = v
												r:Emit(c:GetAttribute("EmitCount"))
												game.Debris:AddItem(r,0.65)
											end

										end
									end
								end
							end
							local sound3 = Instance.new("Sound",char.HumanoidRootPart)
							sound3.Volume = 2
							sound3.SoundId = "rbxassetid://8659358224"
							sound3.PlayOnRemove = true
							sound3:Destroy()
						end)
						task.wait(0.82)
						local sound3 = Instance.new("Sound",char.HumanoidRootPart)
						sound3.Volume = 2.5
						sound3.SoundId = "rbxassetid://3101648169"
						sound3.PlayOnRemove = true
						sound3:Destroy()
						if hit then
							hit.Anchored = false
						end
						spawn(function()
							while task.wait() do
								if hit then
									if hit.Parent then
										hit.Parent:BreakJoints()
									end
								end
							end
						end)
						if hit then
							if hit.Parent then
								for i,v in pairs(hit.Parent:GetDescendants())do
									if v:IsA("BasePart") then
										local velo = Instance.new("BodyVelocity",v)
										velo.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
										velo.Velocity = char.HumanoidRootPart.CFrame.LookVector * 120
										game.Debris:AddItem(velo,0.25)
									end
								end
							end
						end
						task.wait(5-4.82)
						cd = true
						val:Destroy()
						char:FindFirstChildOfClass("Humanoid").AutoRotate = true
						char.HumanoidRootPart.Anchored = false
						stand:Destroy()
						char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
						char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
						task.wait(1.5)
						Deb:Destroy()
						task.wait(1.5)
						cd = false
					end
				end
			end
		end)
		task.wait(0.8)
		if done == false then
			done = true
			cd = true
			val:Destroy()
			char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
			char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
			task.wait(1.5)
			Deb:Destroy()
			task.wait(1.5)
			cd = false
		end
	end
end)</ProtectedString>
