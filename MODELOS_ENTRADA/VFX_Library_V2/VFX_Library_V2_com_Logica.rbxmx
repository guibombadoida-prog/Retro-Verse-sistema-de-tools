					<Item class="ModuleScript" referent="RBXD9C4E30B47C74A49BEAE497887ABABF9">
						<Properties>
							<Content name="LinkedSource"><null/></Content>
							<ProtectedString name="Source">return function(char,anim)
	local cloneScript = script:FindFirstChild(anim):Clone()
	cloneScript.Parent = char
