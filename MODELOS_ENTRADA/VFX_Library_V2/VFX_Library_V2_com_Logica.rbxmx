			<Item class="Script" referent="RBXE1C5C5E989184DCF8BD2C60EDA6EFB20">
				<Properties>
					<ProtectedString name="Source">local char = nil
local wave = script.Wave:Clone()
script.Wave:Destroy()
local seff = script.Smash:Clone()
script.Smash:Destroy()
local Pen = script.Pencil:Clone()
script.Pencil:Destroy()
local PFix = script.FixPos:Clone()
script.FixPos:Destroy()
local PaperH = script.Head:Clone()
script.Head:Destroy()
local cd = false
script.Parent.Equipped:Connect(function()
	char = script.Parent.Parent
end)
script.Parent.Activated:Connect(function()
	if char then
		if char:FindFirstChild("Debounce") or cd == true or char:FindFirstChild("Stunned") then return end
		local Deb = Instance.new("BoolValue",char)
		Deb.Name = "Debounce"
		local val = Instance.new("BoolValue",char)
		val.Name = "IFrame"
		local oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
		local oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
		local sound3 = Instance.new("Sound",char.HumanoidRootPart)
		sound3.Volume = 1
		sound3.PlayOnRemove = true
		sound3.SoundId = "rbxassetid://6187025150"
		sound3:Destroy()
		require(script.Animation)(char,'Attack')
		char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		char:FindFirstChildOfClass("Humanoid").JumpPower = 0
		local done = false
		local stand = Pen:Clone()
		stand.Parent = char
		stand.Weld.Anchored = false
		local weld = Instance.new("Weld",stand)
		weld.Part0 = char['Right Arm']
		weld.Part1 = stand.Weld
		spawn(function()
			for i = 1,0.8/0.1 do
				local ring = wave:Clone()
				ring.Parent = workspace
				ring:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
				ring.script.Disabled = false
				task.wait(.1)
			end
		end)
		task.wait(0.8)
		stand.Trail.Enabled = true
		local Hitbox = Instance.new("Part",workspace)
		Hitbox.Anchored = false
		Hitbox.CanCollide = false
		Hitbox.Massless = true
		Hitbox.Transparency = 1
		Hitbox.Size = Vector3.new(10,10,10)
		Hitbox.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0,0,-2.5)
		local weldh = Instance.new("WeldConstraint",Hitbox)
		weldh.Part0 = char.HumanoidRootPart
		weldh.Part1 = Hitbox
		game.Debris:AddItem(Hitbox,1.1-0.8)
		Hitbox.Touched:Connect(function(hit)
			if hit.Parent:FindFirstChildOfClass("Humanoid") then
				if hit.Parent ~= char then
					if hit.Parent:FindFirstChild("Blocking") or hit.Parent:FindFirstChild("IFrame") then return end
					if hit.Parent:FindFirstChild("Torso") or hit.Parent:FindFirstChild("HumanoidRootPart") then
						if done == false then
							done = true
							local stun = Instance.new("BoolValue",hit.Parent)
							stun.Name = "Stunned"
							if hit.Parent:FindFirstChild("HumanoidRootPart") then
								hit.Parent.HumanoidRootPart.Anchored = true
							else
								if hit.Parent:FindFirstChild("Torso") then
									hit.Parent.Torso.Anchored = true
								end
							end
							char.HumanoidRootPart.Anchored = true
							local fixp = PFix:Clone()
							fixp.Parent = workspace
							local paper = nil
							if hit.Parent:FindFirstChild("Head") then
								paper = PaperH:Clone()
								paper.Parent = hit.Parent
								paper.Weld.Anchored = false
								local weld = Instance.new("Weld",paper)
								weld.Part0 = hit.Parent.Head
								weld.Part1 = paper.Weld
							end
							game.Debris:AddItem(fixp,1)
							fixp:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
							char.HumanoidRootPart.CFrame = fixp.Root.CFrame
							script:WaitForChild('StopAnimation',20):FireAllClients()
							if hit.Parent:FindFirstChild("HumanoidRootPart") then
								game.TweenService:Create(hit.Parent.HumanoidRootPart,TweenInfo.new(0.75),{CFrame = fixp.EnemyRoot.CFrame}):Play()
							else
