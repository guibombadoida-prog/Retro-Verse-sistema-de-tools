<Item class="Folder" referent="RBXF2222E4B010740379266BFBEDE911C6A">
			<Properties>
				<string name="Name">You're going to fail, no matter what, when you're a piece of ____.</string>
				</Properties>
			<Item class="Script" referent="RBXEF19A2F95FDA456AA94E7EF44751C798">
				<Properties>
					<ProtectedString name="Source">local char = nil
local wave = script.Wave:Clone()
script.Wave:Destroy()
local seff = script.Smash:Clone()
script.Smash:Destroy()
local SF = script.Stand:Clone()
script.Stand:Destroy()
local BEff = script.Barrage:Clone()
script.Barrage:Destroy()
local HB = script.Hitbox:Clone()
script.Hitbox:Destroy()
local cd = false
script.Parent.Equipped:Connect(function()
	char = script.Parent.Parent
end)
script.Parent.Activated:Connect(function()
	if char then
		if char:FindFirstChild("Debounce") or cd == true or char:FindFirstChild("Stunned") then return end
		local Deb = Instance.new("BoolValue",char)
		Deb.Name = "Debounce"
		local val = Instance.new("BoolValue",char)
		val.Name = "IFrame"
		local oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
		local oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
		local sound3 = Instance.new("Sound",char.HumanoidRootPart)
		sound3.Volume = 1
		sound3.PlayOnRemove = true
		sound3.SoundId = "rbxassetid://6181672221"
		sound3:Destroy()
		char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		char:FindFirstChildOfClass("Humanoid").JumpPower = 0
		spawn(function()
			for i = 1,1.8/0.1 do
				local ring = wave:Clone()
				ring.Parent = workspace
				ring:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
				ring.script.Disabled = false
				task.wait(.1)
			end
		end)
		task.wait(1.8)
		local stand = SF:Clone()
		stand.Parent = char
		stand.HumanoidRootPart.Anchored = false
		local weld = Instance.new("Weld",stand)
		weld.Part0 = char.HumanoidRootPart
		weld.Part1 = stand.HumanoidRootPart
		local finisher = require(script.Animator):LoadAnimation(stand,require(10449982955)('BEATDOWNSF'))
		local attack = require(script.Animator):LoadAnimation(stand,require(10449982955)('ATTACKSF'))
		attack:Play(0,1)
		task.wait(0.3)
		local Hitbox = HB:Clone()
		Hitbox.Parent = workspace
		Hitbox.Root.Anchored = false
		local weldh = Instance.new("Weld",Hitbox)
		weldh.Part0 = char.HumanoidRootPart
		weldh.Part1 = Hitbox.Root
		game.Debris:AddItem(Hitbox,1.2-0.3)
		local done = false
		spawn(function()
			for i = 1,(1.2-0.3)/0.01 do
				if Hitbox then
					if Hitbox.Hitbox then
						for i,hit in pairs(Hitbox.Hitbox:GetTouchingParts())do
							if hit.Parent:FindFirstChildOfClass("Humanoid") then
								if hit.Parent ~= char then
									if hit.Parent:FindFirstChild("IFrame") or hit.Parent:FindFirstChild("Blocking") then return end
									if done == false then
										done = true
										local stun = Instance.new("BoolValue",hit.Parent)
										stun.Name = "Stunned"
										if hit then
											if hit.Parent then
												if hit.Parent:FindFirstChild("HumanoidRootPart") then
													local targetroot = hit.Parent:FindFirstChild("HumanoidRootPart")
													local smosh = seff:Clone()
													smosh.Parent = workspace
													smosh:SetPrimaryPartCFrame(targetroot.CFrame)
													smosh.script.Disabled = false
												else
													if hit.Parent:FindFirstChild("Torso") then
														local targetroot = hit.Parent:FindFirstChild("Torso")
														local smosh = seff:Clone()
														smosh.Parent = workspace
														smosh:SetPrimaryPartCFrame(targetroot.CFrame)
														smosh.script.Disabled = false
													end
												end
											end
										end
										if not game.MaterialService:FindFirstChild("CameraShaker") then
											script.CameraShaker:Clone().Parent = game.MaterialService
										end
										for i,v in pairs(game.Players:GetPlayers())do
											if v.Character then
												if v.Character.PrimaryPart then
													local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
													if Magnitude &lt; 50 then
														local Cutscene = script.Shake2:Clone()
														Cutscene.Parent = v.Backpack
														Cutscene.Disabled = false
													end
												end
											end
										end
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 1
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://4707194537"
										sound3:Destroy()
										char.HumanoidRootPart.Anchored = true
										char:FindFirstChildOfClass("Humanoid").AutoRotate = false
										local weld2 = Instance.new("Weld",hit)
										weld2.Part0 = stand.StandWeld
										weld2.Part1 = hit
										task.wait(.25)
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 0.65
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://5636321910"
										sound3:Destroy()
										task.wait(4.85)
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 2
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://4736243166"
										sound3:Destroy()
										task.wait(2.35)
										attack:Stop()
										finisher:Play(0,1)
										spawn(function()
											task.wait(1.85)
											if hit then
												hit.Anchored = true
											end
											if weld2 then
												weld2:Destroy()
											end
										end)
										task.wait(2.35)
										stand.Zip.Enabled = false
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 0.7
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://2788912669"
										sound3:Destroy()
										local ended = false
										spawn(function()
											local Ba = BEff:Clone()
											Ba.Parent = char
											Ba.Root.Anchored = false
											local weld = Instance.new("Weld",Ba)
											weld.Part0 = stand.HumanoidRootPart
											weld.Part1 = Ba.Root
											for i = 1,(7.2-2.25)/0.035 do
												if ended == false then
													local done2 = false
													if hit then
														if hit.Parent then
															for i,v in pairs(hit.Parent:GetChildren())do
																if v:IsA("BasePart") then
																	if done2 == false then
																		done2 = true
																		for i,c in pairs(script.HitEff:GetChildren())do
																			local r = c:Clone()
																			r.Parent = v
																			r:Emit(c:GetAttribute("EmitCount"))
																			game.Debris:AddItem(r,0.5)
																		end
																	end
																end
															end
														end
													end
													pcall(function()
														Ba.Part["Smoke(1)"]:Emit(5)
														Ba.Part2.dp:Emit(1)
													end)
													task.wait(0.035)
												end
											end
											Ba:Destroy()
										end)
										task.wait(7.233-2.25)
										ended = true
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 0.7
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://2788912395"
										sound3:Destroy()
										task.wait(7.367-7.233)
										if not game.MaterialService:FindFirstChild("CameraShaker") then
											script.CameraShaker:Clone().Parent = game.MaterialService
										end
										for i,v in pairs(game.Players:GetPlayers())do
											if v.Character then
												if v.Character.PrimaryPart then
													local Magnitude = (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude
													if Magnitude &lt; 50 then
														local Cutscene = script.Shake2:Clone()
														Cutscene.Parent = v.Backpack
														Cutscene.Disabled = false
													end
												end
											end
										end
										if hit then
											if hit.Parent then
												hit.Anchored = false
												for i,v in pairs(hit.Parent:GetChildren())do
													if v:IsA("BasePart") then
														for i,c in pairs(script.HeavyEff:GetChildren())do
															local r = c:Clone()
															r.Parent = v
															r:Emit(c:GetAttribute("EmitCount"))
															game.Debris:AddItem(r,0.65)
														end

													end
												end
											end
										end
										if hit then
											if hit.Parent then
												for i,v in pairs(hit.Parent:GetDescendants())do
													if v:IsA("BasePart") then
														local velo = Instance.new("BodyVelocity",v)
														velo.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
														velo.Velocity = char.HumanoidRootPart.CFrame.LookVector * 120
														game.Debris:AddItem(velo,0.25)
													end
												end
											end
										end
										if hit then
											if hit.Parent then
												if hit.Parent:FindFirstChild("HumanoidRootPart") then
													local targetroot = hit.Parent:FindFirstChild("HumanoidRootPart")
													local smosh = seff:Clone()
													smosh.Parent = workspace
													smosh:SetPrimaryPartCFrame(targetroot.CFrame)
													smosh.script.Disabled = false
												else
													if hit.Parent:FindFirstChild("Torso") then
														local targetroot = hit.Parent:FindFirstChild("Torso")
														local smosh = seff:Clone()
														smosh.Parent = workspace
														smosh:SetPrimaryPartCFrame(targetroot.CFrame)
														smosh.script.Disabled = false
													end
												end
											end
										end
										spawn(function()
											while task.wait() do
												if hit then
													if hit.Parent then
														hit.Parent:BreakJoints()
													end
												end
											end
										end)
										if hit then
											if hit.Parent then
												for i,v in pairs(hit.Parent:GetDescendants())do
													if v:IsA("BasePart") then
														local velo = Instance.new("BodyVelocity",v)
														velo.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
														velo.Velocity = char.HumanoidRootPart.CFrame.LookVector * 120
														game.Debris:AddItem(velo,0.25)
													end
												end
											end
										end
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 2.5
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://5886412948"
										sound3:Destroy()
										task.wait(.1)
										stand:Destroy()
										char.HumanoidRootPart.Anchored = false
										char:FindFirstChildOfClass("Humanoid").AutoRotate = true
										cd = true
										val:Destroy()
										stand:Destroy()
										char:FindFirstChildOfClass("Humanoid").WalkSpeed = oldws
										char:FindFirstChildOfClass("Humanoid").JumpPower = oldjp
										Deb:Destroy()
										task.wait(0.75)
										local sound3 = Instance.new("Sound",char.HumanoidRootPart)
										sound3.Volume = 0.5
										sound3.PlayOnRemove = true
										sound3.SoundId = "rbxassetid://2788912827"
										sound3:Destroy()
										task.wait(1.5)
										cd = false
									end
								end
							end
						end
					end
				end
				task.wait(0.01)
			end
		end)
