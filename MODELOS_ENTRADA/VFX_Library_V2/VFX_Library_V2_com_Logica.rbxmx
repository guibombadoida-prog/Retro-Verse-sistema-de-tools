					<Item class="LocalScript" referent="RBXCDA32FA01FAC408CB323D5326D9F8D41">
						<Properties>
							<ProtectedString name="Source">local obj = script:WaitForChild('HL',15).Value
local cam = workspace.CurrentCamera
local hl1 = script:WaitForChild('HIGHLIGHT',15)
local hl2 = script:WaitForChild('HIGHLIGHT2',15)
---
task.wait(0.2)
local col = Instance.new("ColorCorrectionEffect",cam)
col.Brightness = 25
hl1.Parent = obj
hl1.Adornee = obj
hl1.Enabled = true
game:GetService("Debris"):AddItem(col,0.25+0.35+0.3)
game:GetService("Debris"):AddItem(hl1,0.25)
task.wait(0.25)
col.Enabled = false
task.wait(0.35)
col.Enabled = true
hl2.Parent = obj
hl2.Adornee = obj
hl2.Enabled = true
game:GetService("Debris"):AddItem(hl2,0.2)
col.Brightness = -25
task.wait(0.3)
script:WaitForChild('RemoteEvent',15):FireServer()</ProtectedString>
