						velo2.MaxForce = Vector3.new(1,1,1) * 50000
						velo2.Velocity = hrp.CFrame.LookVector * 2.5+Vector3.new(0,35,0)
						game:GetService("Debris"):AddItem(velo2,0.5)
						targethumanoid.Health -= targethumanoid.MaxHealth/3
					end
				end
				--
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,true)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics,true)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding,true)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown,true)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead,true)
				for _,v in pairs(mass)do
					v.Massless = false
				end
				for _,v in pairs(welds)do
					v:Destroy()
				end
				for _,v in pairs(collide)do
					v.CanCollide = true
				end
				spawn(function()
					task.wait(0.5)
					for _,v in pairs(collisiongroup)do
						if v:GetAttribute("OldCollisionGroup") then
							v.CollisionGroup = v:GetAttribute("OldCollisionGroup")
						end
					end
				end)
				if grabpart ~= nil then
					grabpart:Destroy()
				end
				--
				task.wait(1.8-1.65)
				sfx(6240702531,0.65)
				task.wait(1.95-1.8)
				--
				deb:Destroy()
				iframe:Destroy()
				humanoid.JumpPower = oldjp
				humanoid.WalkSpeed = oldws
				StopRemote:FireAllClients()
				task.wait(6.5)
				cd = false
			end
		end
	end
	--
	local hitbox = assets:WaitForChild('Hitbox'):Clone()
	hitbox.Parent = effectsfolder
	debris:AddItem(hitbox,0.75-0.467)
	spawn(function()
		while task.wait() do
			if hitbox and hitbox:FindFirstChild('Hitbox') and donehit == false then
				hitbox:SetPrimaryPartCFrame(hrp.CFrame)
				local parts = workspace:GetPartsInPart(hitbox.Hitbox,paramshitbox)
				for _,v in pairs(parts)do
					hitfunc(v)
				end
			else
				break
			end
		end
	end)
	--
	task.wait(0.75-0.467)
	if donehit == false then
		deb:Destroy()
		iframe:Destroy()
		if armeffect then
			armeffect.WaterPalm.WaterTrail.Enabled = false
			debris:AddItem(armeffect,1.1)
		end
		StopRemote:FireAllClients()
		humanoid.JumpPower = oldjp
		humanoid.WalkSpeed = oldws
		task.wait(6.5)
		cd = false
	end
end
