				charvelo2.Velocity = Vector3.new(0,40,0)
				debris:AddItem(charvelo2,0.05)
				task.wait(1.2-1.1)
				sfx(9113823418,1.5)
				task.wait(1.317-1.2)
				if grabpart then
					for i,v in pairs(grabpart.Weld.sparkthinglol:GetChildren())do
						v:Emit(v:GetAttribute('EmitCount'))
					end
				end
				sfx(9114476034,1)
				sfx(9113824050,1)
				task.wait(1.65-1.317)
				if hit and target then
					local eff = assets:WaitForChild('Effects'):Clone()
					eff.Parent = workspace.Terrain or workspace
					eff.Anchored = false
					local wel = Instance.new("Weld",eff)
					wel.Part0 = hrp
					wel.Part1 = eff
					for i,v in pairs(eff.Attachment1:GetChildren())do
						v:Emit(v:GetAttribute("EmitCount"))
					end
