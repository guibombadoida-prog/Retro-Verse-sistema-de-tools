				<Item class="LocalScript" referent="RBXA566CF7B2DC045AE8A7082F31D6C4C79">
					<Properties>
						<ProtectedString name="Source">local cameraShaker = require(game.MaterialService.CameraShaker) -- get the module to be used and
local camera = workspace.CurrentCamera -- define the camera that needs to be shook.
local camShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCFrame) -- make a new camera shaker with the module
	camera.CFrame = camera.CFrame * shakeCFrame
end)
camShake:Start() -- start the camera shaker we just made and
camShake:Shake(cameraShaker.Presets.Explosion) -- shake the camera with the Explosion preset from the module.
wait(3)
script.RemoteRemove:FireServer()</ProtectedString>
