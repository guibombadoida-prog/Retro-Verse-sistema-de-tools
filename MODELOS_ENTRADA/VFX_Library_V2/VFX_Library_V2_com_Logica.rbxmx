			<Item class="Script" referent="RBX0E08445C7E6244098CB98C027E626EEB">
				<Properties>
					<ProtectedString name="Source">local owner = script.Parent.Owner.Value
local tool = script.Parent
local ring = script.Ring:Clone()
script.Ring:Destroy()
local smoke = script.Smoke:Clone()
script.Smoke:Destroy()
local char
local oldws = 16
local oldjp = 50
local cd = false
----
tool.Equipped:Connect(function()
	char = tool.Parent
end)
script.Parent.RemoteEvent.OnServerEvent:Connect(function(plr,posi)
	char = tool.Parent
	if plr.Character ~= char then
		return
	end
	if cd then return end
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then
		return
	end
	if (posi-char.HumanoidRootPart.Position).Magnitude &gt; 150 then
		return
	end
	local state = char:FindFirstChildOfClass("Humanoid"):GetState()
	if state == Enum.HumanoidStateType.Flying or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.FallingDown then
		cd = true
		local deb = Instance.new("BoolValue",char)
		deb.Name = "Debounce"
		local sound = Instance.new("Sound",char.HumanoidRootPart)
		sound.PlayOnRemove = true
		sound.Volume = 1
		sound.SoundId = "rbxassetid://379557765"
		sound:Destroy()
		oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
		oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
		require(script.Animation2)(char)
		char:FindFirstChildOfClass("Humanoid").JumpPower = 0
		char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		local aura = {}
		for i,v in pairs(script.Aura:GetChildren())do
			local r = v:Clone()
			r.Parent = char['Right Arm']
			r.Enabled = true
			table.insert(aura,r)
		end
