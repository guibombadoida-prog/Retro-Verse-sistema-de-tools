			<Item class="Script" referent="RBXC6211C54853B45B6B9E140D5AC9224A4">
				<Properties>
					<ProtectedString name="Source">local owner = script.Parent.Owner.Value
local tool = script.Parent
local hitbox = script.Hitbox:Clone()
script.Hitbox:Destroy()
local FX = script.Thing:Clone()
script.Thing:Destroy()
local FX2 = script.Part:Clone()
script.Part:Destroy()
local eff = script.LocalViewPort:Clone()
script.LocalViewPort:Destroy()
local char
local oldws = 16
local oldjp = 50
local ring = script.Ring:Clone()
script.Ring:Destroy()
----
local HiteffectBall = function(Target,Pos)
	spawn(function()
		local ClonedBall = FX:Clone()
		ClonedBall.Parent = Target
		ClonedBall.CFrame = Pos
		ClonedBall.CFrame = CFrame.new(ClonedBall.Position, Target.Position)
		game.Debris:AddItem(ClonedBall,0.3)
		game.TweenService:Create(ClonedBall,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),{CFrame = ClonedBall.CFrame + ClonedBall.CFrame.lookVector * -7,Transparency = 1,Size = Vector3.new(0,0,0)}):Play()
	end)
	pcall(function()
		spawn(function()
			local ClonedBall = FX2:Clone()
			ClonedBall.Parent = Target
			ClonedBall.Position = Pos.Position
			game.Debris:AddItem(ClonedBall,0.3)
			game.TweenService:Create(ClonedBall,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.InOut),{Position = (ClonedBall.CFrame + ClonedBall.CFrame.lookVector * -7).Position,Transparency = 1,Size = Vector3.new(0,0,0)}):Play()
		end)
	end)
end
----
tool.Equipped:Connect(function()
	char = tool.Parent
end)
tool.Activated:Connect(function()
	char = tool.Parent
	if char:FindFirstChild("Debounce") or char:FindFirstChild("Stunned") then
		return
	end
	local deb = Instance.new("BoolValue",char)
	deb.Name = "Debounce"
	oldjp = char:FindFirstChildOfClass("Humanoid").JumpPower
	oldws = char:FindFirstChildOfClass("Humanoid").WalkSpeed
	require(script.Animation)(char)
	char:FindFirstChildOfClass("Humanoid").JumpPower = 0
	char:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
	char:FindFirstChildOfClass("Humanoid").AutoRotate = false
	local velo2 = Instance.new("BodyVelocity",char.HumanoidRootPart)
	velo2.MaxForce = Vector3.new(1,1,1) * math.huge
	velo2.Velocity = char.HumanoidRootPart.CFrame.LookVector * 12
	local aura = {}
	for i,v in pairs(char:GetChildren())do
		if v:IsA("BasePart") then
			if v.Name ~= "HumanoidRootPart" then
				for i,t in pairs(script.Aura:GetChildren())do
					local r = t:Clone()
					r.Parent = v
					r.Enabled = true
					table.insert(aura,r)
				end
			end
		end
	end
	spawn(function()
		for i = 1,2/0.05 do
			local ran1 = math.random(-2,2)
			local ran2 = math.random(-2,2)
			local ran3 = math.random(-2,2)
			local a0 = Instance.new("Attachment",char['HumanoidRootPart'])
			local a1 = Instance.new("Attachment",char['HumanoidRootPart'])
			a1.Position = Vector3.new(ran1,ran2,ran3)
			pcall(function()
				require(script.Lightning).Lightning(a0.WorldPosition,a1.WorldPosition,true,3,1,Color3.fromRGB(128, 187, 219),1,0.15)
			end)
			game.Debris:AddItem(a1,0.05)
			game.Debris:AddItem(a0,0.05)
			task.wait(.05)
		end
		for i,v in pairs(aura)do
			v:Destroy()
		end
	end)
	for i = 1,2.3/0.1 do
		if math.random(1,4) == 1 then
			local soundL = Instance.new("Sound",char.HumanoidRootPart)
			soundL.PlayOnRemove = true
			soundL.Volume = 0.8
			soundL.PlaybackSpeed = 1.5
			soundL.SoundId = "rbxassetid://1693499499"
			soundL:Destroy()
		elseif math.random(1,4) == 2 then
			local soundL = Instance.new("Sound",char.HumanoidRootPart)
			soundL.PlayOnRemove = true
			soundL.Volume = 0.8
			soundL.PlaybackSpeed = 1
			soundL.SoundId = "rbxassetid://1693499499"
			soundL:Destroy()
		elseif math.random(1,4) == 3 then
			local soundL = Instance.new("Sound",char.HumanoidRootPart)
			soundL.PlayOnRemove = true
			soundL.Volume = 0.8
			soundL.PlaybackSpeed = 1.5
			soundL.SoundId = "rbxassetid://6968100828"
			soundL:Destroy()
		else
			local soundL = Instance.new("Sound",char.HumanoidRootPart)
			soundL.PlayOnRemove = true
			soundL.Volume = 0.8
			soundL.SoundId = "rbxassetid://6968100828"
			soundL:Destroy()
		end
		for i,v in pairs(game.Players:GetPlayers())do
			if v.Character then
				if v.Character.PrimaryPart then
					if (v.Character.PrimaryPart.Position - char.HumanoidRootPart.Position).Magnitude &lt; 50 then
						local ef = eff:Clone()
						ef.Parent = v:FindFirstChildOfClass("PlayerGui")
						eff.char.Value = char
						ef.Disabled = false
						game.Debris:AddItem(ef,0.35)
					end
				end
			end
		end
		local done = false
		local indi = hitbox:Clone()
		indi.Parent = char
		indi.Weld.Anchored = false
		local weld = Instance.new("Weld",indi)
		weld.Part0 = char.HumanoidRootPart
		weld.Part1 = indi.Weld
		game.Debris:AddItem(indi,0.2)
		if i == 20 or  i == 22 or i == 21 or i == 23 then
			indi.Hitbox.Touched:Connect(function(hit)
				if done == false then
					if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
						if hit.Parent:FindFirstChild("IFrame") then return end
						done = true

						local sound = Instance.new("Sound",hit)
						sound.PlayOnRemove = true
						sound.Volume = 2
						sound.SoundId = "rbxassetid://8595977193"
						sound:Destroy()
						if hit.Parent:FindFirstChild("Torso") then
							local eff = ring:Clone()
							eff.Parent = workspace
							eff:SetPrimaryPartCFrame(hit.Parent:FindFirstChild("Torso").CFrame)
							game.TweenService:Create(eff.Ring,TweenInfo.new(0.5),{Size = Vector3.new(10,0.5,10),Transparency = 1}):Play()
							game.Debris:AddItem(eff,0.5)
						elseif hit.Parent:FindFirstChild("HumanoidRootPart") then
							local eff = ring:Clone()
							eff.Parent = workspace
							eff:SetPrimaryPartCFrame(hit.Parent:FindFirstChild("HumanoidRootPart").CFrame)
							game.TweenService:Create(eff.Ring,TweenInfo.new(0.5),{Size = Vector3.new(10,0.5,10),Transparency = 1}):Play()
							game.Debris:AddItem(eff,0.5)
						end
						for i = 1,3 do
							HiteffectBall(hit,hit.CFrame )
						end
						local val = Instance.new("BoolValue",hit.Parent)
						val.Name = "Stunned"
						game.Debris:AddItem(val,0.35)
						local velo = Instance.new("BodyVelocity",hit)
						velo.MaxForce = Vector3.new(1,1,1) * math.huge
						velo.Velocity = Vector3.new(0.0000001,0.000001,0.00001)
						hit.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0,0,-8)
						game.Debris:AddItem(velo,0.15)
						hit.Parent:BreakJoints()

					end
				end
			end)
			if indi then
				if indi.Hitbox then
					for i,hit in pairs(indi.Hitbox:GetTouchingParts())do
						if done == false then
							if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
								if hit.Parent:FindFirstChild("IFrame") then return end
								done = true

								local sound = Instance.new("Sound",hit)
								sound.PlayOnRemove = true
								sound.Volume = 2
								sound.SoundId = "rbxassetid://8595977193"
								sound:Destroy()
								if hit.Parent:FindFirstChild("Torso") then
									local eff = ring:Clone()
									eff.Parent = workspace
									eff:SetPrimaryPartCFrame(hit.Parent:FindFirstChild("Torso").CFrame)
									game.TweenService:Create(eff.Ring,TweenInfo.new(0.5),{Size = Vector3.new(10,0.5,10),Transparency = 1}):Play()
									game.Debris:AddItem(eff,0.5)
								elseif hit.Parent:FindFirstChild("HumanoidRootPart") then
									local eff = ring:Clone()
									eff.Parent = workspace
									eff:SetPrimaryPartCFrame(hit.Parent:FindFirstChild("HumanoidRootPart").CFrame)
									game.TweenService:Create(eff.Ring,TweenInfo.new(0.5),{Size = Vector3.new(10,0.5,10),Transparency = 1}):Play()
									game.Debris:AddItem(eff,0.5)
								end
								for i = 1,3 do
									HiteffectBall(hit,hit.CFrame )
								end
								local val = Instance.new("BoolValue",hit.Parent)
								val.Name = "Stunned"
								game.Debris:AddItem(val,0.35)
								local velo = Instance.new("BodyVelocity",hit)
								velo.MaxForce = Vector3.new(1,1,1) * math.huge
								velo.Velocity = Vector3.new(0.0000001,0.000001,0.00001)
								hit.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0,0,-8)
								game.Debris:AddItem(velo,0.15)
								hit.Parent:BreakJoints()

							end
						end
					end
					for i,hit in pairs(workspace:GetPartsInPart(indi.Hitbox,OverlapParams.new()))do
						if done == false then
							if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
								if hit.Parent:FindFirstChild("IFrame") then return end
								done = true

								if hit.Parent:FindFirstChild("Torso") then
									local eff = ring:Clone()
									eff.Parent = workspace
									eff:SetPrimaryPartCFrame(hit.Parent:FindFirstChild("Torso").CFrame)
									game.TweenService:Create(eff.Ring,TweenInfo.new(0.5),{Size = Vector3.new(10,0.5,10),Transparency = 1}):Play()
									game.Debris:AddItem(eff,0.5)
								elseif hit.Parent:FindFirstChild("HumanoidRootPart") then
									local eff = ring:Clone()
									eff.Parent = workspace
									eff:SetPrimaryPartCFrame(hit.Parent:FindFirstChild("HumanoidRootPart").CFrame)
									game.TweenService:Create(eff.Ring,TweenInfo.new(0.5),{Size = Vector3.new(10,0.5,10),Transparency = 1}):Play()
									game.Debris:AddItem(eff,0.5)
								end
								for i = 1,3 do
									HiteffectBall(hit,hit.CFrame )
								end
								local sound = Instance.new("Sound",hit)
								sound.PlayOnRemove = true
								sound.Volume = 2
								sound.SoundId = "rbxassetid://8595977193"
								sound:Destroy()
								local val = Instance.new("BoolValue",hit.Parent)
								val.Name = "Stunned"
								game.Debris:AddItem(val,0.35)
								local velo = Instance.new("BodyVelocity",hit)
								velo.MaxForce = Vector3.new(1,1,1) * math.huge
								velo.Velocity = Vector3.new(0.0000001,0.000001,0.00001)
								hit.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0,0,-8)
								game.Debris:AddItem(velo,0.15)
								hit.Parent:BreakJoints()

							end
						end
					end
				end
			end
		else
			indi.Hitbox.Touched:Connect(function(hit)
				if done == false then
					if hit.Parent:FindFirstChildOfClass("Humanoid") and hit.Parent ~= char then
						if hit.Parent:FindFirstChild("IFrame") then return end
						done = true

						local sound = Instance.new("Sound",hit)
						sound.PlayOnRemove = true
						sound.Volume = 2
						sound.SoundId = "rbxassetid://8595977193"
						sound:Destroy()
						if hit.Parent:FindFirstChild("Torso") then
							local eff = ring:Clone()
