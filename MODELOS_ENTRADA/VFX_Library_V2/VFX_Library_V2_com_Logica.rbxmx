						<Item class="LocalScript" referent="RBX5446D402AAFF42949D596D076F9D0610">
							<Properties>
								<ProtectedString name="Source">local cameraShaker = require(script:WaitForChild('CameraShaker',15)) -- get the module to be used and
local camera = workspace.CurrentCamera -- define the camera that needs to be shook.
local camShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCFrame) -- make a new camera shaker with the module
	camera.CFrame = camera.CFrame * shakeCFrame
end)
camShake:Start() -- start the camera shaker we just made and
camShake:Shake(cameraShaker.Presets.Explosion)
if script:WaitForChild('Preset',15).Value == "" and script:WaitForChild('Preset',15).Value == nil then
	camShake:ShakeOnce(script:WaitForChild('Magnitude',15).Value,script:WaitForChild('Roughness',15).Value,script:WaitForChild('FadeIn',15).Value,script:WaitForChild('FadeOut',15).Value)
else
	if script:WaitForChild('Preset',15).Value == "Explosion" then
		camShake:Shake(cameraShaker.Presets.Explosion)
	elseif script:WaitForChild('Preset',15).Value == "Bump" then
		camShake:Shake(cameraShaker.Presets.Bump)
	end
end</ProtectedString>
