					<Item class="Trail" referent="RBXDAC7A3546CA64BCB88360BE96C4944F7">
						<Properties>
							<Ref name="Attachment0">null</Ref>
							<Ref name="Attachment1">null</Ref>
							<float name="Brightness">1</float>
							<ColorSequence name="Color">0 0.403922 0.403922 0.403922 0 1 0.403922 0.403922 0.403922 0 </ColorSequence>
							<bool name="Enabled">false</bool>
							<bool name="FaceCamera">true</bool>
							<float name="Lifetime">0.300000012</float>
