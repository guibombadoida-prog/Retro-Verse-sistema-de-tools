						<Item class="LocalScript" referent="RBXA5AF7D38B8BF478CA3FD9C99F1930671">
							<Properties>
								<ProtectedString name="Source">wait()
repeat wait() until script.Parent == game.Players.LocalPlayer.PlayerGui
script.Parent = game.Players.LocalPlayer.PlayerScripts
local TARGET_FRAMERATE = 60
while true do
	game:GetService("RunService").RenderStepped:Wait()
	local t0 = tick()
	game:GetService("RunService").Heartbeat:Wait()
	repeat until t0 + 1/TARGET_FRAMERATE &lt; tick()
end</ProtectedString>
