		<Item class="Script" referent="RBX136E6C9ACDB84A21BD7F3B43336BEDE7">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local scripts = script.Parent.Scripts

local tool = script.Parent

local animationsR6 = script.Parent.Animation.R6

local animationsR15 = script.Parent.Animation.R15

local MainAnimation = animationsR6.Main
local IdleAnimation = animationsR6.Idle

local mainAnim = nil
local idleAnim = nil

local sound = script.Parent.Atk

repeat
	wait()
until script.Parent:FindFirstChild("GetMouse")

local theThing = script.Parent.GetMouse

local frozenAttacks = false

function MainAttack(player, pos)
	local Attack = Instance.new("Model")
	local cloud = Instance.new("Part")
	local mesh = script.Parent.Mesh:Clone()
	mesh.Parent = cloud
	cloud.Parent = Attack
	cloud.Name = "Cloud"
	cloud.Orientation = Vector3.new(0, math.random(0, 360), 0)
	local PositionPlaceThing = pos
	local newPos = PositionPlaceThing + Vector3.new(math.random(-3, 3), 10, math.random(-3, 3))
	for x = 1, 4 do
		local strike = Instance.new("Part")
		strike.Material = "Neon"
		strike.Anchored = true
		strike.CanCollide = false
		strike.Parent = Attack
		strike.BrickColor = BrickColor.new("Bright yellow")
		strike.Name = "HurtPart"
		
		local RopeLength = (PositionPlaceThing - newPos).Magnitude
		strike.CFrame = (CFrame.new(((PositionPlaceThing + newPos) / 2), newPos) * CFrame.Angles(-(math.pi / 2), 0, 0))
		strike.Size = Vector3.new(.1, RopeLength, .1)
		
		-- animation
		local Change = {
			Size = Vector3.new(2, RopeLength, 2),
			Transparency = 1
		}
		
		local PartSlideInfo = TweenInfo.new(
			1, --- Time to tween from position to position
			Enum.EasingStyle.Sine, 
			Enum.EasingDirection.Out, 
			0, --- Times repeated
			false, --- Reverse the tween or not
			0 --- Delay time
		)
		
		local PartSlideTween = TweenService:Create(strike, PartSlideInfo, Change)
		
		PartSlideTween:Play()
		
		if x ~= 1 and math.random(0, 10) == 0 then
			local strike = Instance.new("Part")
			strike.Material = "Neon"
			strike.Anchored = true
			strike.CanCollide = false
			strike.Parent = Attack
			strike.BrickColor = BrickColor.new("Bright yellow")
			strike.Name = "HurtPart"
			
			local extraPos = PositionPlaceThing + Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5))
			
			local RopeLength = (PositionPlaceThing - extraPos).Magnitude
			strike.CFrame = (CFrame.new(((PositionPlaceThing + extraPos) / 2), extraPos) * CFrame.Angles(-(math.pi / 2), 0, 0))
			strike.Size = Vector3.new(.1, RopeLength, .1)
			
			-- animation
			local Change = {
				Size = Vector3.new(1, RopeLength, 1),
				Transparency = 1
			}
			
			local PartSlideInfo = TweenInfo.new(
				1, --- Time to tween from position to position
				Enum.EasingStyle.Sine, 
				Enum.EasingDirection.Out, 
				0, --- Times repeated
				false, --- Reverse the tween or not
				0 --- Delay time
			)
			
			local PartSlideTween = TweenService:Create(strike, PartSlideInfo, Change)
			
			PartSlideTween:Play()
		end
		
		PositionPlaceThing = newPos
		newPos = PositionPlaceThing + Vector3.new(math.random(-3, 3), 10, math.random(-3, 3))
	end
	
	local ex = Instance.new("Explosion", Attack)
	ex.Position = pos
	ex.BlastRadius = 10
	ex.BlastPressure = 50
	ex.DestroyJointRadiusPercent = 0
	
	local blastDamagePart = Instance.new("Part")
	blastDamagePart.Shape = Enum.PartType.Ball
	blastDamagePart.Parent = Attack
	blastDamagePart.Name = "HurtPart"
	blastDamagePart.Size = Vector3.new(20, 20, 20)
	blastDamagePart.Position = pos
	blastDamagePart.CanCollide = false
	blastDamagePart.Transparency = 1
	blastDamagePart.Anchored = true
	
	cloud.Anchored = true
	cloud.Position = PositionPlaceThing
	
	Attack.Parent = workspace
	
	local attackSound = sound:Clone()
	attackSound.Parent = cloud
	attackSound.Playing = true
	
	-- animation
	mainAnim:Play()
	
	-- scripts
	local script1 = scripts.Dissapear:Clone()
	script1.Time.Value = attackSound.TimeLength
	script1.Parent = Attack
	script1.Disabled = false
	
	local script2 = scripts.Hurt:Clone()
	script2.Owner.Value = script.Parent.Parent
	script2.Damage.Value = 10
	script2.Dissapear.Value = false
	script2.Parent = Attack
	script2.Disabled = false
end

script.Parent.GetMouse.OnServerEvent:Connect(MainAttack)
script.Parent.Equipped:Connect(function()
	local character = script.Parent.Parent
	if character.Humanoid.RigType == "R15" then
		MainAnimation = animationsR15.Main
		IdleAnimation = animationsR15.Idle
	end
	mainAnim = character.Humanoid:LoadAnimation(MainAnimation)
	idleAnim = character.Humanoid:LoadAnimation(IdleAnimation)
	idleAnim:Play()
end)

script.Parent.Unequipped:Connect(function() idleAnim:Stop() end)

function findNearestTorso(pos)
	local list = game.Workspace:GetDescendants()
	local torso = nil
	local dist = 50
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		local Owner = false
		if temp2:FindFirstChild("PossessFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.PossessFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("SuitFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.SuitFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("ControlFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.ControlFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2 == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if (temp2.className == "Model") and (temp2 ~= script.Parent.Parent) and (Owner == false) then
			temp = temp2:findFirstChild("HumanoidRootPart")
			human = temp2:findFirstChildOfClass("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

local MainCooldown = false

while true do
	if MainCooldown == false and game.Players:GetPlayerFromCharacter(tool.Parent) == nil then
		MainCooldown = true
		local humanoidRootPart = findNearestTorso(script.Parent.Parent.HumanoidRootPart.Position)
		if humanoidRootPart ~= nil then
			local pos = humanoidRootPart.Position
			MainAttack(nil, pos)
		end
		print("attack")
		wait(1)
		MainCooldown = false
	end
	wait()
end]]></ProtectedString>
