local wandering = false

function wander(humanoid, wanderTrueFalse)
	if wandering ~= wanderTrueFalse then
		wandering = wanderTrueFalse
		local rootPart = owner.Value.HumanoidRootPart
		while wandering == true do
			humanoid:MoveTo(rootPart.Position + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10)))
			wait(2)
		end
	end
end

script.Parent.WanderEvent.Event:Connect(wander)]]></ProtectedString>
