			<Item class="Script" referent="RBXB87EDDBBF6364394AEE9B5BA551FF0A7">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

wait(script.Time.Value)

if script.Parent:FindFirstChildOfClass("Weld") ~= nil then
	script.Parent:FindFirstChildOfClass("Weld"):Destroy()
end

local Change = {
	Transparency = 1,
	Size = Vector3.new(script.Parent.Size.X * 2, 0, script.Parent.Size.Z * 2),
	Color = Color3.new(0, 255, 255)
}

local PartSlideInfo = TweenInfo.new(
	1, --- Time to tween from position to position
	Enum.EasingStyle.Sine, 
	Enum.EasingDirection.In, 
	0, --- Times repeated
	false, --- Reverse the tween or not
	0 --- Delay time
)

local PartSlideTween = TweenService:Create(script.Parent, PartSlideInfo, Change)

PartSlideTween:Play()

script.Parent.CanCollide = false

wait(1)

script.Parent:Destroy()]]></ProtectedString>
