		<Item class="LocalScript" referent="RBXF4AF32A8AFC340C580FC8D18DB49B910">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local MainCooldown = false
local UIS = game:GetService("UserInputService")

repeat
	wait()
until script.Parent:FindFirstChild("GetMouse")

local theThing = script.Parent.GetMouse
local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local InputType = Enum.UserInputType

local Tool = script.Parent

function getMouse(Which)
	local cFrame = mouse.Hit
	local pos = mouse.Hit.Position
	local target = mouse.Target
	if Which == "Position" then
		return pos
	elseif Which == "Target" then
		return target
	elseif Which == "CFrame" then
		return cFrame
	end
end

function Activate()
	if MainCooldown == false then
		MainCooldown = true
		local pos = getMouse("Position")
		script.Parent.GetMouse:FireServer(pos)
		print("attack")
		wait(1)
		MainCooldown = false
	end
end

Tool.Activated:Connect(Activate)]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
