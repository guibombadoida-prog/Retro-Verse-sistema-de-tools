		<Item class="LocalScript" referent="RBX4742CE56B8E54A3890E365085DF8B7E0">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local MainCooldown = false
local UIS = game:GetService("UserInputService")

repeat
	wait()
until script.Parent:FindFirstChild("GetMouse")

local theThing = script.Parent.GetMouse
local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local InputType = Enum.UserInputType

local camera = workspace.CurrentCamera

local Tool = script.Parent

function getMouse(Which)
	local cFrame = mouse.Hit
	local pos = mouse.Hit.Position
	local target = mouse.Target
	if Which == "Position" then
		return pos
	elseif Which == "Target" then
		return target
	elseif Which == "CFrame" then
		return cFrame
	end
end

function Activate()
	if MainCooldown == false then
		MainCooldown = true
		local pos = getMouse("Target")
		local actualPos = getMouse("Position")
		script.Parent.GetMouse:FireServer(pos, actualPos)
		print("attack")
		wait(1)
		MainCooldown = false
	end
end

function changeCamToCharacter(character)
	camera.CameraSubject = character:FindFirstChildOfClass("Humanoid")
end

Tool.Activated:Connect(Activate)
Tool.GetMouse.OnClientEvent:Connect(changeCamToCharacter)]]></ProtectedString>
