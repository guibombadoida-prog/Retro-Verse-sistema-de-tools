			<Item class="Script" referent="RBXED9AC2091F574145BC0642140577632D">
				<Properties>
					<ProtectedString name="Source"><![CDATA[function findNearestTorso(pos)
	local list = game.Workspace:GetDescendants()
	local torso = nil
	local dist = script.Range.Value
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if (temp2.className == "Model") and (temp2 ~= script.Owner.Value) then
			temp = temp2:findFirstChild("HumanoidRootPart")
			human = temp2:findFirstChild("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

while true do
	wait()
	local target = findNearestTorso(script.Parent.Position)
	if target ~= nil then
		script.Parent.BodyVelocity.Velocity = CFrame.new(script.Parent.Position, target.Position).LookVector * script.Velocity.Value
	end
end]]></ProtectedString>
