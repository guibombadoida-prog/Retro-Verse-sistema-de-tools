		<Item class="Script" referent="RBX5DC671D41A2B4180A6459867970CBD91">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local tool = script.Parent

local animationsR6 = script.Parent.Animation.R6

local animationsR15 = script.Parent.Animation.R15

local MainAnimation = animationsR6.Main
local IdleAnimation = animationsR6.Idle

local mainAnim = nil
local idleAnim = nil

local sound = script.Parent.Atk

repeat
	wait()
until script.Parent:FindFirstChild("GetMouse")

local theThing = script.Parent.GetMouse

local scripts = script.Parent.Scripts

function MainAttack(player, Part, pos)
	local humanoid = nil
	if Part.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
		humanoid = Part.Parent:FindFirstChildOfClass("Humanoid")
	elseif Part.Parent.Parent:FindFirstChildOfClass("Humanoid") ~= nil then --incase u click an accessory
		humanoid = Part.Parent.Parent:FindFirstChildOfClass("Humanoid")
	end
	if Part:IsDescendantOf(script.Parent.Parent) then
		humanoid = nil
	end
	if humanoid ~= nil then
		local beam = Instance.new("Part", workspace)
		beam.Anchored = true
		beam.CanCollide = false
		beam.Material = "Ice"
		beam.BrickColor = BrickColor.new("Toothpaste")
		beam.Transparency = .5
		
		local pos1 = script.Parent.Parent.HumanoidRootPart.Position
		local pos2 = humanoid.Parent.HumanoidRootPart.Position
		
		local Length = (pos1 - pos2).Magnitude
		beam.CFrame = (CFrame.new(((pos1 + pos2) / 2), pos2) * CFrame.Angles(-(math.pi / 2), 0, 0))
		beam.Size = Vector3.new(2, Length, 2)
		
		local attackSound = sound:Clone()
		attackSound.Parent = beam
		attackSound.Playing = true
		
		-- animation
		mainAnim:Play()
		
		local script1 = scripts.Dissapear:Clone()
		script1.Time.Value = attackSound.TimeLength
		script1.Parent = beam
		script1.Disabled = false
		
		local ice = Instance.new("Part", workspace)
		ice.Anchored = true
		ice.CanCollide = true
		ice.Material = "Ice"
		ice.BrickColor = BrickColor.new("Toothpaste")
		ice.Transparency = .5
		ice.Size = Vector3.new(.1, .1, .1)
		ice.CFrame = humanoid.Parent.HumanoidRootPart.CFrame

		humanoid.Parent.HumanoidRootPart.Anchored = true
		
		local script2 = scripts.IceDissapear:Clone()
		script2.Time.Value = 10
		script2.Parent = ice
		script2.Disabled = false
		
		local Change = {
			Size = Vector3.new(6, 6, 3)
		}
		
		local PartSlideInfo = TweenInfo.new(
			1, --- Time to tween from position to position
			Enum.EasingStyle.Sine, 
			Enum.EasingDirection.InOut, 
			0, --- Times repeated
			false, --- Reverse the tween or not
			0 --- Delay time
		)
		
		local PartSlideTween = TweenService:Create(ice, PartSlideInfo, Change)
		
		PartSlideTween:Play()

		local weld = Instance.new("Weld", ice)
		weld.Part0 = ice
		weld.Part1 = humanoid.Parent.HumanoidRootPart
		weld.C0 = ice.CFrame:inverse()
		weld.C1 = humanoid.Parent.HumanoidRootPart.CFrame:inverse()
		
		humanoid.Parent.HumanoidRootPart.Anchored = false
	else
		local beam = Instance.new("Part", workspace)
		beam.Anchored = true
		beam.CanCollide = false
		beam.Material = "Ice"
		beam.BrickColor = BrickColor.new("Toothpaste")
		beam.Transparency = .5
		
		local pos1 = script.Parent.Parent.HumanoidRootPart.Position
		local pos2 = pos
		
		local Length = (pos1 - pos2).Magnitude
		beam.CFrame = (CFrame.new(((pos1 + pos2) / 2), pos2) * CFrame.Angles(-(math.pi / 2), 0, 0))
		beam.Size = Vector3.new(2, Length, 2)
		
		local attackSound = sound:Clone()
		attackSound.Parent = beam
		attackSound.Playing = true
		
		-- animation
		mainAnim:Play()
		
		local script1 = scripts.Dissapear:Clone()
		script1.Time.Value = attackSound.TimeLength
		script1.Parent = beam
		script1.Disabled = false
		
		local ice = Instance.new("Part", workspace)
		ice.Anchored = true
		ice.CanCollide = true
		ice.Material = "Ice"
		ice.BrickColor = BrickColor.new("Toothpaste")
		ice.Transparency = .5
		ice.Size = Vector3.new(5, .1, 5)
		ice.Position = pos

		local anchored = false
		
		if Part.Anchored == true then
			anchored = true
		end
		if anchored ~= true then
			Part.Anchored = true
		end
		
		local script2 = scripts.IceDissapear:Clone()
		script2.Time.Value = 11
		script2.Parent = ice
		script2.Disabled = false
		
		local Change = {
			Size = Vector3.new(5, 5, 5),
			Position = Vector3.new(ice.Position.X, ice.Position.Y + 2.5, ice.Position.Z)
		}
		
		local PartSlideInfo = TweenInfo.new(
			1, --- Time to tween from position to position
			Enum.EasingStyle.Sine, 
			Enum.EasingDirection.InOut, 
			0, --- Times repeated
			false, --- Reverse the tween or not
			0 --- Delay time
		)
		
		local PartSlideTween = TweenService:Create(ice, PartSlideInfo, Change)
		
		PartSlideTween:Play()

		wait(1)

		ice.Anchored = false

		local weld = Instance.new("Weld")
		weld.Part0 = ice
		weld.Part1 = Part
		weld.C0 = ice.CFrame:inverse()
		weld.C1 = Part.CFrame:inverse()
		weld.Parent = ice
		
		if anchored ~= true then
			Part.Anchored = false
		end
	end
end

script.Parent.GetMouse.OnServerEvent:Connect(MainAttack)
script.Parent.Equipped:Connect(function()
	local character = script.Parent.Parent
	if character.Humanoid.RigType == "R15" then
		MainAnimation = animationsR15.Main
		IdleAnimation = animationsR15.Idle
	end
	mainAnim = character.Humanoid:LoadAnimation(MainAnimation)
	idleAnim = character.Humanoid:LoadAnimation(IdleAnimation)
	idleAnim:Play()
end)

script.Parent.Unequipped:Connect(function() idleAnim:Stop() end)

function findNearestTorso(pos)
	local list = game.Workspace:GetDescendants()
	local torso = nil
	local dist = 50
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		local Owner = false
		if temp2:FindFirstChild("PossessFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.PossessFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("SuitFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.SuitFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("ControlFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.ControlFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2 == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if (temp2.className == "Model") and (temp2 ~= script.Parent.Parent) and (Owner == false) then
			temp = temp2:findFirstChild("HumanoidRootPart")
			human = temp2:findFirstChildOfClass("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

local MainCooldown = false

while true do
	if MainCooldown == false and game.Players:GetPlayerFromCharacter(tool.Parent) == nil then
		MainCooldown = true
		local humanoidRootPart = findNearestTorso(script.Parent.Parent.HumanoidRootPart.Position)
		if humanoidRootPart ~= nil then
			MainAttack(nil, humanoidRootPart)
		end
		print("attack")
		wait(1)
		MainCooldown = false
	end
	wait()
end]]></ProtectedString>
