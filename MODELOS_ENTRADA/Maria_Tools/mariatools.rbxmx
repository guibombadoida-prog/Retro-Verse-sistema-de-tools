				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX21812A1B532E46918D83ACA5034AE6D9">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local scripts = script.Parent.Scripts

local tool = script.Parent

local animationsR6 = script.Parent.Animation.R6

local animationsR15 = script.Parent.Animation.R15

local MainAnimation = animationsR6.Main
local IdleAnimation = animationsR6.Idle

local mainAnim = nil
local idleAnim = nil

local sound = script.Parent.Atk

repeat
	wait()
until script.Parent:FindFirstChild("GetMouse")

local theThing = script.Parent.GetMouse

local frozenAttacks = false

function MainAttack(player, pos)
	local Attack = Instance.new("Part")
	Attack.Shape = Enum.PartType.Ball
	Attack.Size = Vector3.new(53, 53, 53)
	Attack.Color = Color3.new(86, 36, 36)
	Attack.Material = "Granite"
	Attack.CanCollide = false
	Attack.Massless = true
	Attack.Position = script.Parent.Parent.HumanoidRootPart.Position + Vector3.new(math.random(-100, 100), 200, math.random(-100, 100))
	Attack.Parent = workspace
	
	local stuff = Attack:Clone()
	
	local BoostPart = Attack:Clone()
	BoostPart.Parent = Attack
	BoostPart.Massless = false
	BoostPart.Transparency = 1
	BoostPart.Size = Vector3.new(1, 1, 1)
	
	local particles = script.Parent.Particle:Clone()
	particles.Parent = Attack
	particles.Enabled = true
	
	local weld = Instance.new("Weld")
	weld.Parent = Attack
	weld.Part0 = Attack
	weld.Part1 = BoostPart
	
	-- boost
	local boost = Instance.new("BodyVelocity")
	boost.Parent = BoostPart
	boost.Velocity = CFrame.new(BoostPart.Position, pos).LookVector * 30
	
	-- animation
	mainAnim:Play()
	
	-- scripts
	local script2 = scripts.Hurt:Clone()
	script2.Owner.Value = script.Parent.Parent
	script2.Damage.Value = 50
	script2.TimeToExpand.Value = 2
	--script2.HitMoreThanOnce.Value = true
	--script2.HitMoreThanOnce.TimeBeforeHitAgain.Value = 1
	script2.Parent = Attack
	script2.Disabled = false
	
	particles.Enabled = false
	wait(5)
	particles:Destroy()
end

script.Parent.GetMouse.OnServerEvent:Connect(MainAttack)
script.Parent.Equipped:Connect(function()
	local character = script.Parent.Parent
	if character.Humanoid.RigType == "R15" then
		MainAnimation = animationsR15.Main
		IdleAnimation = animationsR15.Idle
	end
	mainAnim = character.Humanoid:LoadAnimation(MainAnimation)
	idleAnim = character.Humanoid:LoadAnimation(IdleAnimation)
	idleAnim:Play()
end)

script.Parent.Unequipped:Connect(function() idleAnim:Stop() end)

function findNearestTorso(pos)
	local list = game.Workspace:GetDescendants()
	local torso = nil
	local dist = 50
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		local Owner = false
		if temp2:FindFirstChild("PossessFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.PossessFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("SuitFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.SuitFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("ControlFollow") ~= nil and script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2.ControlFollow.Owner.Value == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if script.Parent.Parent:FindFirstChild("ControlFollow") ~= nil then
			if temp2 == script.Parent.Parent.ControlFollow.Owner.Value then
				Owner = true
			end
		end
		if (temp2.className == "Model") and (temp2 ~= script.Parent.Parent) and (Owner == false) then
			temp = temp2:findFirstChild("HumanoidRootPart")
			human = temp2:findFirstChildOfClass("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

local MainCooldown = false

while true do
	if MainCooldown == false and game.Players:GetPlayerFromCharacter(tool.Parent) == nil then
		MainCooldown = true
		local humanoidRootPart = findNearestTorso(script.Parent.Parent.HumanoidRootPart.Position)
		if humanoidRootPart ~= nil then
			local pos = humanoidRootPart.Position
			MainAttack(nil, pos)
		end
		print("attack")
		wait(1)
		MainCooldown = false
	end
	wait()
end]]></ProtectedString>
