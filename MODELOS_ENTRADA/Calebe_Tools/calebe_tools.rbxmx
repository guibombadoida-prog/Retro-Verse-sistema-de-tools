		<Item class="Script" referent="RBXF5DD7BE4250E43EF87F772907E6AC14D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--Made by ThisBaconAintFakin
local tool = script.Parent
local visual = tool.Handle.ShiftVisual
local cooldown = 0.75
local debounce = false
local gravity = 1 -- 1 is normal, 2 is low gravity, 3 is high gravity

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

function visualfx()
	visual.Rays.Enabled = true
	visual.Wave.Enabled = true
	local shockwave = Instance.new("Part")
	local weld = Instance.new("Motor6D")
	shockwave.Parent = tool.Handle.FX
	weld.Parent = shockwave
	weld.Part0 = tool.Handle
	weld.Part1 = shockwave
	weld.Name = "Weld"
	shockwave.Shape = Enum.PartType.Ball
	shockwave.Position = tool.Handle.Position
	shockwave.Massless = true
	shockwave.CanCollide = false
	shockwave.Size = Vector3.new(0.1,0.1,0.1)
	shockwave.Name = "Shockwave"
	shockwave.Material = Enum.Material.ForceField
	shockwave.Color = Color3.fromRGB(255, 0, 255)
	shockwave.CastShadow = false
	Debris:AddItem(shockwave,2)
	local shockwaveinfo = TweenInfo.new(
		0.25, -- Length
		Enum.EasingStyle.Sine, -- Easing Style
		Enum.EasingDirection.InOut, -- Easing Direction
		0, -- Times repeated
		true, -- Reverse
		0 -- Delay
	)
	local tweenvalues =
		{
			Transparency = 0;
			Size = Vector3.new(25,25,25);
		}
	local tween = TweenService:Create(shockwave,shockwaveinfo,tweenvalues)
	if gravity == 1 then
		local newui = tool.UI.NormG:Clone()
		local playerguis = game:GetService("Players"):GetChildren()
		for i, players in pairs(playerguis) do
			newui.Parent = players.PlayerGui
			newui.Movement.Enabled = true
			Debris:AddItem(newui,4)
		end
	elseif gravity == 2 then
		local newui = tool.UI.LowG:Clone()
		local playerguis = game:GetService("Players"):GetChildren()
		for i, players in pairs(playerguis) do
			newui.Parent = players.PlayerGui
			newui.Movement.Enabled = true
			Debris:AddItem(newui,4)
		end
	elseif gravity == 3 then
		local newui = tool.UI.HighG:Clone()
		local playerguis = game:GetService("Players"):GetChildren()
		for i, players in pairs(playerguis) do
			newui.Parent = players.PlayerGui
			newui.Movement.Enabled = true
			Debris:AddItem(newui,4)
		end
	end
	wait(0.5)
	tween:Play()
	visual.Rays.Enabled = false
	visual.Wave.Enabled = false
end

function gravityshift()
	if debounce == false then
		if gravity == 1 then
			print("Lowered gravity")
			game.Workspace.Gravity = 21.2 --low
			tool.Handle.Shift:Play()
			gravity = 2
			debounce = true
			visualfx()
			wait(cooldown)
			debounce = false
		elseif gravity == 2 then
			print("Increased gravity")
			game.Workspace.Gravity = 471.2 --high
			tool.Handle.Shift:Play()
			gravity = 3
			debounce = true
			visualfx()
			wait(cooldown)
			debounce = false
		elseif gravity == 3 then
			print("Returned to normal gravity")
			game.Workspace.Gravity = 196.2 --default
			tool.Handle.Shift:Play()
			gravity = 1
			debounce = true
			visualfx()
			wait(cooldown)
			debounce = false
		end
	end
end

function onEquipped()
	tool.Handle.BillboardGui.TextLabel["Random Text"].Enabled = true
end

function onUnequipped()
	tool.Handle.Shift:Stop()
	tool.Handle.Beep:Stop()
	tool.Handle.BillboardGui.TextLabel["Random Text"].Enabled = false
end

tool.Equipped:Connect(onEquipped)
tool.Unequipped:Connect(onUnequipped)
tool.Activated:Connect(gravityshift)]]></ProtectedString>
