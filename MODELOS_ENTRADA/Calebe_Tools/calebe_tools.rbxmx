		</Item>
		<Item class="Script" referent="RBX87A216B9A0C54969AB5D331BFA79AF45">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--made by thisbaconaintfakin
local tool = script.Parent

local character
local humanoid
local root

local sounds = tool:WaitForChild("Sounds")
local effects = tool:WaitForChild("Effects")

local attackEvent = tool:WaitForChild("Attack")

local debris = game:GetService("Debris")
local playerservice = game:GetService("Players")

local radius = 25
local damage = radius*2
local lifetime = 5

tool.Equipped:Connect(function()
	character = tool.Parent
	humanoid = character:FindFirstChild("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
end)

tool.Unequipped:Connect(function()
	--nothing needed
end)

function searchRadius(origin, radius)
	local characters = {}
	local rootParts = {}
	local torsos = {}
	for i, v in pairs(workspace:GetDescendants()) do
		if v.Name == "HumanoidRootPart" then table.insert(rootParts, v) end
		if #torsos == 0 then
			if v.Name == "Torso" then table.insert(torsos, v) end
		end
	end
	for i, v in pairs(rootParts) do
		if (v.Position - origin).Magnitude <= radius then
			table.insert(characters, v.Parent)
		end
	end
	for i, v in pairs(torsos) do
		if (v.Position - origin).Magnitude <= radius then
			table.insert(characters, v.Parent)
		end
	end
	return characters
end

function createRupture(radius, damage, pos, target)
	--create rupture
	local r = Instance.new("Part")
	r.Name = "Rupture"
	r.Position = pos
	r.Size = Vector3.new(radius, 0.1, radius)
	r.Transparency = 1
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.Parent = workspace
	debris:AddItem(r,lifetime)
	--effects
	local sA = Instance.new("Attachment")
	sA.Parent = r
	local smokeEffect = effects.Smoke:Clone()
	smokeEffect.Parent = sA
	smokeEffect:Emit(75)
	--raycast (for the surface normal and making the rupture face correct way)
	local rayOrigin = tool.Handle.Position
	local rayDirection = (pos - rayOrigin).unit*999999
	local rayCastParams = RaycastParams.new()
	rayCastParams.FilterDescendantsInstances = {character}
	rayCastParams.IgnoreWater = true
	local rayCast = workspace:Raycast(rayOrigin, rayDirection, rayCastParams)
	local normal = rayCast.Normal
	if normal then r.CFrame = CFrame.new(pos, pos + normal) * CFrame.Angles(-math.pi/2, math.random(0,360), 0) end
	sA.Orientation = r.Orientation * Vector3.new(0,1,0)
	--debris
	for i=0,10,1 do
		local d = Instance.new("Part")
		d.Name = "Debris"
		d.Material = target.Material
		d.Color = target.Color
		d.Size = Vector3.new(0.75,0.75,0.75)
		d.Position = r.Position + Vector3.new(math.random(-r.Size.X,r.Size.X)/3,0,math.random(-r.Size.Z,r.Size.Z)/3)
		d.Orientation = Vector3.new(math.random(0,360),math.random(0,360),math.random(0,360))
		d.Velocity = Vector3.new(math.random(-50,50),math.random(25,75),math.random(-50,50))
		d.CastShadow = false
		d.CanQuery = false
		d.Parent = workspace
		debris:AddItem(d,lifetime)
		coroutine.resume(coroutine.create(function()
			wait(lifetime-4)
			for i=0,1,0.05 do
				wait(0.01)
				d.Transparency = i
			end
		end))
	end
	--decal
	local rd = Instance.new("Decal")
	rd.Texture = "http://www.roblox.com/asset/?id=10228065900"
	rd.Face = Enum.NormalId.Top
	rd.Color3 = Color3.fromRGB(0,0,0)
	rd.Transparency = 0.76
	rd.Parent = r
	--fade out
	coroutine.resume(coroutine.create(function()
		wait(lifetime-2)
		for i=0.76,1,0.01 do
			wait(0.01)
			rd.Transparency = i
			r.Size -= Vector3.new(radius/100,0,radius/100)
		end
	end))
	--sound
	local hitSound = sounds.Hit:Clone()
	hitSound.Parent = r
	hitSound.PlaybackSpeed = math.random(90,110)/100
	hitSound:Play()
	--area of effect
	local characters = searchRadius(r.Position, radius)
	for i, v in pairs(characters) do
		local effectedHumanoid = v:FindFirstChildOfClass("Humanoid")
		if effectedHumanoid ~= character.Humanoid then effectedHumanoid:TakeDamage(damage) end
	end
end

attackEvent.OnServerEvent:Connect(function(plr, hit, target)
	local swingSound = sounds.Swing:Clone()
	swingSound.Parent = tool.Handle
	swingSound:Play()
	if target then
		debris:AddItem(swingSound,swingSound.TimeLength*1.25)
		createRupture(radius, damage, hit, target)
	end
end)]]></ProtectedString>
