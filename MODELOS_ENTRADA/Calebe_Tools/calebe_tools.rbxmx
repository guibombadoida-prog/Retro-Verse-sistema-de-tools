			<Item class="Script" referent="RBX95CFECF7632F41D2B4329FAA6EF1B6A2">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--/ Any Flying Debris That Hits you will Hurt you
--/ (People Do More Damage)


local Debounce = true

function Trail()
	local A1 = Instance.new("Attachment")
	A1.Position = 	Vector3.new(0,(script.Parent.Size.Unit.Y),0)/2					
	A1.Parent = script.Parent
	A1.Name = "A1"
	
	local A2 = Instance.new("Attachment")
	A2.Position = Vector3.new(0,(script.Parent.Size.Unit.Y),0)/-2
	A2.Parent = script.Parent
	A2.Name = "A2"
	
	local Trail = script.Conponments.Trail:Clone()
	Trail.Parent = script.Parent
	Trail.Enabled = true
	Trail.Attachment0 = A1
	Trail.Attachment1 = A2
end
Trail()

script.Parent.Touched:Connect(function(Thing)
	if Thing.Parent:FindFirstChild("Humanoid") and Debounce == true then
		Thing.Parent.Humanoid:TakeDamage(5)
		Thing.Parent.Humanoid.Sit = true
		local HitSound = script.Conponments.Whack:Clone()
		HitSound.Parent = Thing
		HitSound:Play()
		Debounce = false
		wait(1)
		HitSound:Destroy()
		Debounce = true
	end
end)

wait(5)
script.Parent.A1:Destroy()
script.Parent.A2:Destroy()
script.Parent.Trail:Destroy()
script:Destroy()
]]></ProtectedString>
