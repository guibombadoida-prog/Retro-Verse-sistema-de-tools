		<Item class="Script" referent="RBX7EE85C7FCB1A42E0B8ECF5F284813D32">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local Staff = Tool.Handle
Debris = game:GetService("Debris")
Tool.Enabled = true

local staffAOE = Vector3.new(25,25,25)

bodyVelocity = Instance.new("BodyVelocity")
bodyVelocity.P = 10000
bodyVelocity.maxForce = Vector3.new(bodyVelocity.P, bodyVelocity.P, bodyVelocity.P)
bodyVelocity.Name = "BV"

bodyForce = Instance.new("BodyForce")
bodyForce.Name = "BF"

bodyAngularVelocity = Instance.new("BodyAngularVelocity")
bodyAngularVelocity.angularvelocity = Vector3.new(10.0, 10.0, 10.0)
bodyAngularVelocity.P = 10000
bodyAngularVelocity.Name =  "BAV"

local tempBV
local tempHumanoid
local myHumanoid
local myTorso

local scifiLiftSound
local scifiBlastSound

local spatialUniqueness = {}
-- Now the script is unique!

local forceField = Instance.new("Part")
forceField.Name = "Field"
forceField.Shape = Enum.PartType.Ball
forceField.Size = Vector3.new(7,7,7)
forceField.Material = Enum.Material.Neon
forceField.Massless = true
forceField.Color = Color3.new(0, 0, 0.509804)
forceField.Transparency = 0.8
forceField.CanCollide = false


function onActivated()
	
	if Tool.Enabled == false then 
		return
	end
	Tool.Enabled = false
	Tool.Handle.Mesh.TextureId = "rbxassetid://1445684592"
	local Light = Instance.new("PointLight")
	Light.Parent = Tool.Handle
	Light.Range = 13
	Light.Brightness = 10
	Light.Color = Color3.fromRGB(0,33,125)

	vCharacter = Tool.Parent 

	myHumanoid = vCharacter:FindFirstChild("Humanoid")
	if myHumanoid == nil then 
		print("Humanoid not found")
		return
	end

	myTorso = vCharacter:FindFirstChild("Torso") or vCharacter:FindFirstChild("UpperTorso")
	if myTorso == nil then 
		print("Torso not found")
		return
	end

	if myTorso:FindFirstChild("BV") ~= nil then 
		print("Meet the force")
		return
	end

	myHead = vCharacter:FindFirstChild("Head")
	if myHead == nil then
		print("Head not found")
		return
	end

	scifiLiftSound = Tool:FindFirstChild("ScifiLiftSound")
	scifiBlastSound = Tool:FindFirstChild("ScifiBlastSound")
	
--	myHumanoid.Jump = true
--	myTorso.Anchored = true	

	if scifiLiftSound then scifiLiftSound:Play() end
	
	parts = game.Workspace:FindPartsInRegion3(Region3.new(myTorso.Position - staffAOE, myTorso.Position + staffAOE), vCharacter, 84)
	for i = 1, #parts do		
		--tempHumanoid = parts[i].Parent:FindFirstChild("Humanoid")
		if parts[i].Anchored == false and not parts[i].Parent:FindFirstChild("Humanoid") then --tempHumanoid == nil then 
			tempBV = bodyVelocity:Clone()
			tempBV.Parent = parts[i]
			tempBV.velocity = Vector3.new(0.0, 10.0, 0.0)		
			fieldClone = forceField:Clone()
			fieldClone.Parent = parts[i]
			fieldClone.Position = parts[i].Position
			Bright = Tool.Handle.Rays:Clone()
			Bright.Parent = fieldClone
			Bright.Rays.Enabled = true
			Bright.Effect.Enabled = true
	
			newWeld = Instance.new("WeldConstraint")
			newWeld.Part0 = fieldClone
			newWeld.Part1 = parts[i]
			newWeld.Name = "FieldWeld"
			newWeld.Parent = parts[i]

		else
			tempBV = bodyVelocity:Clone()
			tempBV.velocity = Vector3.new(0.0, 14.0, 0.0)			
			torso = parts[i].Parent:FindFirstChild("Torso") or parts[i].Parent:FindFirstChild("UpperTorso")
			if torso and torso:FindFirstChild("BV") == nil then
				tempBV.Parent = torso
				fieldClone = forceField:Clone()
				fieldClone.Parent = torso
				fieldClone.Position = torso.Position
				Bright = Tool.Handle.Rays:Clone()
				Bright.Parent = fieldClone
				Bright.Rays.Enabled = true
				Bright.Effect.Enabled = true

				newWeld = Instance.new("WeldConstraint")
				newWeld.Part0 = fieldClone
				newWeld.Part1 = torso
				newWeld.Name = "FieldWeld"
				newWeld.Parent = torso
				
				Debris:AddItem(fieldClone,5)
				Debris:AddItem(tempBV,5)
			end
		end
	end

	wait(1.7)
--	myHumanoid.Jump = true

	Tool.Handle.Mesh.TextureId = "http://www.roblox.com/asset/?id=48473344"
	Light:Destroy()
	if scifiBlastSound then scifiBlastSound:Play() end
	for i = 1, #parts do
		--tempHumanoid = parts[i].Parent:FindFirstChild("Humanoid")
		if parts[i].Anchored == false and not parts[i].Parent:FindFirstChild("Humanoid") then --tempHumanoid == nil then 
			BF = bodyForce:Clone()
			BAV = bodyAngularVelocity:Clone()
			BF.force = Vector3.new(parts[i].Position.X - myTorso.Position.X, 0.0, parts[i].Position.Z - myTorso.Position.Z) * 100.0
			BF.Parent = parts[i]
			BAV.Parent = parts[i]
			local function Particles()
				wait(.1)
				local Bam = script.Bam:Clone()
				Bam.Parent = parts[i]
				Bam:Play()
				local Explosion = script.Boom:Clone()
				Explosion.Parent = parts[i]
				Explosion.Enabled = true
				wait(.1)
				Explosion.Enabled = false
			end
			Particles()
		else 
			BF = bodyForce:Clone()
			BAV = bodyAngularVelocity:Clone()					
			torso = parts[i].Parent:FindFirstChild("Torso") or parts[i].Parent:FindFirstChild("UpperTorso")
			if torso and torso:FindFirstChild("BF") == nil then 
				BF.force = Vector3.new(torso.Position.X - myTorso.Position.X, torso.Position.Y - myTorso.Position.Y, torso.Position.Z - myTorso.Position.Z) * 100
				BF.Parent = torso
				BAV.Parent = torso
				local function Particles()
					wait(.05)
					local Bam = script.Bam:Clone()
					Bam.Parent = torso
					Bam:Play()
					local Explosion = script.Boom:Clone()
					Explosion.Parent = torso
					Explosion.Enabled = true
					local Fall = script.Physycs:Clone()
					Fall.Parent = torso.Parent
					Fall.Disabled = false
					wait(.1)
					Explosion.Enabled = false
				end
				Particles()
				if parts[i].Parent:FindFirstChild("Humanoid") and parts[i].Parent:FindFirstChild("Humanoid").Health > 0 then --if tempHumanoid and tempHumanoid.Health > 0 then					
					parts[i].Parent:FindFirstChild("Humanoid"):TakeDamage(50)					
				end
			end	
			
			if parts[i].Parent:FindFirstChild("Humanoid") then
				parts[i].Parent:FindFirstChild("Humanoid"):ChangeState(Enum.HumanoidStateType.FallingDown)	
			end
		end			
	end

	wait(0.5)
	if myTorso.Anchored then myHumanoid.Jump = true end
	
	for i = 1, #parts do 
		--tempHumanoid = parts[i].Parent:FindFirstChild("Humanoid")
		BV = parts[i]:FindFirstChild("BV")
		BAV = parts[i]:FindFirstChild("BAV")
		field = parts[i]:FindFirstChild("Field")
		weld = parts[i]:FindFirstChild("FieldWeld")
		if BV ~= nil then 
			BV:Remove()
		end			
		if BAV ~= nil then 
			BAV:Remove()
		end		
		if field ~= nil then field:Remove() end
		if weld ~= nil then weld:Remove() end
	end

	wait(0.5)

	for i = 1, #parts do 
		BF = parts[i]:FindFirstChild("BF")
		if BF ~= nil then 
			BF:Remove()
		end
	end		

	wait(1)
	myTorso.Anchored = false	
	Tool.Enabled = true
	
end

function onEquipped()
	wait(1)
end

function onUnequipped()
	wait(1.5)	
	
	if scifiLiftSound then scifiLiftSound:Stop() end
	if scifiBlastSound then scifiBlastSound:Stop() end
	if myTorso then myTorso.Anchored = false end
end

Tool.Activated:connect(onActivated)
Tool.Equipped:connect(onEquipped)
Tool.Unequipped:connect(onUnequipped)]]></ProtectedString>
