		<Item class="LocalScript" referent="RBX1A29648E1E5A4CB9B7B992DA94B8E699">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local ui = script:WaitForChild("Controls")

local tool = script.Parent
local player = game.Players.LocalPlayer

local playerGui = player:WaitForChild("PlayerGui")

tool.Equipped:Connect(function()
	ui.Parent = playerGui
end)

tool.Unequipped:Connect(function()
	ui.Parent = script
end)
]]></ProtectedString>
