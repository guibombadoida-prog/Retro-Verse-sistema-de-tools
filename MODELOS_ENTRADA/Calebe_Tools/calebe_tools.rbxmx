		<Item class="LocalScript" referent="RBXDB543D6005C24FCDA2F2F3640F7B846A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent

local player = game.Players.LocalPlayer
local character
local mouse = player:GetMouse()

local attackEvent = tool:WaitForChild("Attack")

local debounce = false
local cooldown = 0.25

tool.Equipped:Connect(function()
	character = script.Parent
end)

tool.Activated:Connect(function()
	if debounce then return end
	debounce = true
	local hit = mouse.Hit.Position
	mouse.TargetFilter = character
	local target = mouse.Target
	attackEvent:FireServer(hit, target)
	wait(cooldown)
	debounce = false
end)]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{84221f7b-3f1f-42ab-93a4-1cf4b259d6ff}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
				<bool name="DefinesCapabilities">true</bool>
				<string name="Name">LocalScript</string>
