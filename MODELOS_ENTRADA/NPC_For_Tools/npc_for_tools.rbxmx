				<Properties>
					<ProtectedString name="Source"><![CDATA[script.Wander.Disabled = false

function getHumanoid(model)
	for _, v in pairs(model:GetChildren()) do
		if v:IsA'Humanoid' then
			return v
		end
	end
end


local ai = script.Parent
local human = getHumanoid(ai)
local hroot = ai.HumanoidRootPart
local zspeed = hroot.Velocity.magnitude

script.WanderEvent:Fire(human, true)

function findNearestTorso(pos)
	local list = game.Workspace:GetDescendants()
	local torso = nil
	local dist = script.Range.Value
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		local Owner = false
		if temp2:FindFirstChild("PossessFollow") ~= nil then
			if temp2.PossessFollow.Owner.Value == script.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("SuitFollow") ~= nil then
			if temp2.SuitFollow.Owner.Value == script.Owner.Value then
				Owner = true
			end
		end
		if temp2:FindFirstChild("ControlFollow") ~= nil then
			if temp2.ControlFollow.Owner.Value == script.Owner.Value then
				Owner = true
			end
		end
		if (temp2.className == "Model") and (temp2 ~= script.Parent) and (temp2 ~= script.Owner.Value) and (Owner == false) then
			temp = temp2:findFirstChild("HumanoidRootPart")
			human = temp2:findFirstChildOfClass("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end

local debounce = false

function Attack(touched)
	local Owner = false
	
	if touched.Parent:FindFirstChild("SuitFollow") ~= nil then
		if touched.Parent:FindFirstChild("SuitFollow").Owner.Value == script.Owner.Value then
			Owner = true
		end
	end
	if touched.Parent:FindFirstChild("PossessFollow") ~= nil then
		if touched.Parent:FindFirstChild("PossessFollow").Owner.Value == script.Owner.Value then
			Owner = true
		end
	end
	if touched.Parent:FindFirstChild("ControlFollow") ~= nil then
		if touched.Parent.ControlFollow.Owner.Value == script.Owner.Value then
			Owner = true
		end
	end
	if touched.Parent:FindFirstChildOfClass("Humanoid") and touched.Parent ~= script.Owner.Value and Owner == false and debounce == false then
		debounce = true
		
		touched.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(script.Damage.Value)
		
		wait(2)
		debounce = false
	end
end

local hurtParts = script.Parent:GetChildren()

for x = 1, #hurtParts do
	if hurtParts[x].ClassName == "Part" or hurtParts[x].ClassName == "MeshPart" then
		hurtParts[x].Touched:Connect(Attack)
	end
end

-- no touchy
local path
local waypoint
local oldpoints

function onDead()
	script.Parent:Destroy()
end
human.Died:Connect(onDead)

while true do
	wait()
	local target = findNearestTorso(script.Parent.HumanoidRootPart.Position)
	local healer = false
	if script.Parent:FindFirstChildOfClass("Tool") ~= nil then
		if script.Parent:FindFirstChildOfClass("Tool").Name == "Healing Staff" or script.Parent:FindFirstChildOfClass("Tool").Name == "Healing Area Staff" then
			healer = true
		end
	end
	if target ~= nil and healer == false then
		script.WanderEvent:Fire(human, false)
		human:MoveTo(target.Position, target)
	else
		script.WanderEvent:Fire(human, true)
	end
end]]></ProtectedString>
