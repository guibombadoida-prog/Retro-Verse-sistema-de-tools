			<Item class="LocalScript" referent="RBXD40D1E7492CE40C6BA2037F43285280F">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- LocalScript_HisCubeUIS_V1.lua
-- Coloque DENTRO do RemoteEvent "veryinnacurateshoot" com o nome "uis"
-- SUBSTITUI: uis (script original sem versão)

--[[
═══════════════════════════════════════════════════════════════
            HIS CUBE - UIS (INPUT) V1
═══════════════════════════════════════════════════════════════
DESCRIÇÃO:
- Detecta clique do mouse / toque
- Envia posição do mouse ao servidor para tiro normal

CORREÇÕES V1 (sobre o script original "uis"):
- ✅ FIX: Envia mouse.Hit.Position ao servidor (antes não enviava)
- ✅ FIX: Referência correta ao Parent (veryinnacurateshoot → Tool)
- ✅ FIX: Cleanup de conexão ao desequipar
═══════════════════════════════════════════════════════════════
--]]

local Players = game:GetService("Players")
local Player  = Players.LocalPlayer
local mouse   = Player:GetMouse()

local shootRemote = script.Parent            -- veryinnacurateshoot (RemoteEvent)
local Tool        = script.Parent.Parent     -- His Cube (Tool)

local clickConnection = nil

Tool.Equipped:Connect(function()
	if clickConnection then
		clickConnection:Disconnect()
	end
	clickConnection = mouse.Button1Down:Connect(function()
		shootRemote:FireServer(mouse.Hit.Position)
	end)
end)

Tool.Unequipped:Connect(function()
	if clickConnection then
		clickConnection:Disconnect()
		clickConnection = nil
	end
end)]]></ProtectedString>
