		<Item class="ModuleScript" referent="RBX8D348F2456BB47119C4BAED1BAAE0CC4">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--// PUTS LIGHTNINGBOLT IN REPLICATEDSTORAGE, THIS IS FOR PERFORMANCE WHEN USING SEAMLESS LIGHTNING MODULE

--// Hello, This is Stella.
--// This is an addon to Takeo's VFX Module, there are various vfx's that are customisable! this module gets updated frequently so make sure to require via ID!
--// Takeo's VFX Module: [ https://www.roblox.com/library/8199013483/Takeos-VFX-System ]


local ReplicatedStorage = game:FindService("ReplicatedStorage") or game:GetService("ReplicatedStorage")

local Script = script:WaitForChild("LightningBolt")


local Name = "LightningBolt"

local Script = script:FindFirstChild(Name)
if Script then
	if not ReplicatedStorage:FindFirstChild(Name) then
		Script.Parent = ReplicatedStorage;
	else
		Script:Destroy()
	end
else
	if ReplicatedStorage:FindFirstChild(Name) then
		--// Thumbs up
	else
		warn("LIGHTNINGBOLT IS NOT DESCENDANT OF REPLICATEDSTORAGE OR ITSELF")
	end

end

--// LOADER;
--// PUTS MODULE IN REPLICATEDSTORAGE SO TAKEO'S VFX MODULE CAN EASILY FIND IT, AND ALSO TO IMPROVE PERFORMANCE

local Name = "Stella's VFX Addon"

local Script = script:FindFirstChild(Name)
if Script then
	if not ReplicatedStorage:FindFirstChild(Name) then
		Script.Parent = ReplicatedStorage;
		return Script
	else
		Script:Destroy()
		return ReplicatedStorage:FindFirstChild(Name)
	end
else
	if ReplicatedStorage:FindFirstChild(Name) then
		return ReplicatedStorage:FindFirstChild(Name)
	else
		warn("ADDON IS NOT DESCENDANT OF REPLICATEDSTORAGE OR ITSELF")
	end
	
end

]]></ProtectedString>
