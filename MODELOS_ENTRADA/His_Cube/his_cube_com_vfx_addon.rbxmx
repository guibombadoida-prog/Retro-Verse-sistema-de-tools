		<Item class="LocalScript" referent="RBX7B4E4BABC88E45FC9BA5573C16E10555">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- LocalScript_HisCubeClient_V4.lua
-- Coloque DENTRO da Tool "His Cube" com o nome "Client"
-- SUBSTITUI: LocalScript_HisCubeClient_V3.lua
-- REMOVER: LocalScript_HisCubeClient_V3.lua

--[[
═══════════════════════════════════════════════════════════════
            HIS CUBE - CLIENT SCRIPT V4
═══════════════════════════════════════════════════════════════
- Q: Dark Nuke (binding + readyToFire)
- E: Sala do Abismo (NOVO V4)
- Screen shake receiver

CORREÇÕES V4 (sobre V3):
- ✅ NOVO: Binding tecla E para Sala do Abismo
- ✅ Botão mobile para E (ContextActionService)
═══════════════════════════════════════════════════════════════
--]]

local Players    = game:GetService("Players")
local CAS        = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local Player       = Players.LocalPlayer
local mouse        = Player:GetMouse()
local camera       = workspace.CurrentCamera
local Tool         = script.Parent
local remoteKey    = Tool:WaitForChild("Remote")
local skill1Remote = Tool:WaitForChild("Skill1")

local shaking  = false
local equipped = false

-- ═══════════ SCREEN SHAKE ═══════════
local function doScreenShake(intensity, duration)
	if shaking then return end
	shaking = true
	local elapsed = 0
	local conn
	conn = RunService.RenderStepped:Connect(function(dt)
		elapsed = elapsed + dt
		if elapsed >= duration then
			shaking = false
			if conn then conn:Disconnect(); conn = nil end
			return
		end
		local progress = elapsed / duration
		local ci = intensity * (1 - progress)
		local sx = math.sin(elapsed * 35) * ci
		local sy = math.cos(elapsed * 40) * ci
		camera.CFrame = camera.CFrame * CFrame.new(sx, sy, 0)
	end)
end

-- ═══════════ BINDINGS ═══════════
local function OnQPressed(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		remoteKey:FireServer(Enum.KeyCode.Q)
	end
end

local function OnEPressed(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		remoteKey:FireServer(Enum.KeyCode.E)
	end
end

-- ═══════════ SINAIS DO SERVIDOR ═══════════
skill1Remote.OnClientEvent:Connect(function(action, param1, param2)
	if action == "readyToFire" then
		remoteKey:FireServer("NukeFire", mouse.Hit.Position)
	elseif action == "ScreenShake" then
		doScreenShake(param1 or 0.5, param2 or 0.2)
	end
end)

-- ═══════════ EQUIPAR / DESEQUIPAR ═══════════
Tool.Equipped:Connect(function()
	equipped = true
	-- Q: Nuke (habilidade extra = botão permitido)
	CAS:BindAction("HisCube_Nuke", OnQPressed, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	CAS:SetTitle("HisCube_Nuke", "Dark Nuke")
	CAS:SetPosition("HisCube_Nuke", UDim2.new(0.5, 0, -0.5, 0))
	-- E: Sala do Abismo (habilidade extra = botão permitido)
	CAS:BindAction("HisCube_Abyss", OnEPressed, true, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
	CAS:SetTitle("HisCube_Abyss", "Sala do Abismo")
	CAS:SetPosition("HisCube_Abyss", UDim2.new(0.5, 0, -1.2, 0))
end)

Tool.Unequipped:Connect(function()
	equipped = false
	CAS:UnbindAction("HisCube_Nuke")
	CAS:UnbindAction("HisCube_Abyss")
end)]]></ProtectedString>
