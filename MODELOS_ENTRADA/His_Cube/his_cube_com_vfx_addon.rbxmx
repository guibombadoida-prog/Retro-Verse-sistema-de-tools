				<Item class="ModuleScript" referent="RBXE55D1133D3C344338A88BE8AE8E5417B">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Explosion = script:WaitForChild("Explosion")

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")


return function(CF, Duration, Size_A, Size_B, Color_A, Color_B, Easing)

	CF = CF or CFrame.new();
	Size_A = Size_A or 0;
	Size_B = Size_B or 0;
	Color_A = Color_A or Color3.fromRGB(0, 0, 0)
	Color_B = Color_B or Color_A
	Easing = Easing or Enum.EasingStyle.Quad

	local ExplosionModel = Explosion:Clone()
	ExplosionModel.Parent = workspace.CurrentCamera
	
	ExplosionModel:PivotTo(CF)
	
	Debris:AddItem(Explosion,Duration + 2)
	
	local BaseSize = Vector3.new(1.133, 0.077, 1.133)
	local BaseSizeB = Vector3.new(0.357, 0.357, 0.357)
	local BaseSizeC = Vector3.new(0.437, 0.437, 0.437)
	
	ExplosionModel.Shockwave.Color = Color_A;
	ExplosionModel.Shockwave.Size = (BaseSize * Size_A)
	
	--ExplosionModel.Core.Color = Color_B
	ExplosionModel.Core.Size = (BaseSizeB * Size_A)
	
	ExplosionModel.Outer.Color = Color_A;
	ExplosionModel.Outer.Size = (BaseSizeC * Size_A)
	
	TweenService:Create(ExplosionModel.Shockwave,TweenInfo.new(Duration,Easing),{Size = BaseSize * Size_B,Color = Color_B}):Play()
	TweenService:Create(ExplosionModel.Outer,TweenInfo.new(Duration,Easing),{Size = BaseSizeC * Size_B,Color = Color_B}):Play()
	TweenService:Create(ExplosionModel.Core,TweenInfo.new(Duration,Easing),{Size = BaseSizeB * Size_B}):Play()
	
	task.delay(Duration + 0.5,function()
		TweenService:Create(ExplosionModel.Shockwave,TweenInfo.new(.5),{Transparency = 1}):Play()
		TweenService:Create(ExplosionModel.Outer,TweenInfo.new(.5),{Transparency = 1}):Play()
		TweenService:Create(ExplosionModel.Core,TweenInfo.new(.5),{Transparency = 1}):Play()
	end)
	

end]]></ProtectedString>
