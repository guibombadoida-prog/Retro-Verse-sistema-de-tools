				<Item class="ModuleScript" referent="RBX30E2840850494C8286EDEBBD79869167">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized Impact Frame for convenience.
	
	
]]
local RunService = game:FindService("RunService") or game:GetService("RunService")
local Lighting = game:FindService("Lighting") or game:GetService("Lighting")
local Debris = game:FindService("Debris") or game:GetService("Debris")
local Players = game:FindService("Players") or game:GetService("Players")



return function(Person_A, Person_B, Duration)
	
	if Person_A:IsA("Player") then
		Person_A = Person_A.Character;
	end
	
	if Person_B:IsA("Player") then
		Person_B = Person_B.Character
	end
	
	Duration = Duration or 1
	
	local LocalPlayer = Players.LocalPlayer;
	
	local OldSkies = {}
	
	local Exposure
	local Inversion
	local Sky
	local FogColor-- = Lighting.FogColor
	local FogEnd --= Lighting.FogEnd;
	if false then
		
		Exposure = Lighting.ExposureCompensation;
		
		
		Lighting.ExposureCompensation = -100 --// blackify the world without occluding the highlight
		
		Inversion = script.Invert:Clone()
		Inversion.Parent = Lighting;
		Inversion.Enabled = true
		
		Debris:AddItem(Inversion,Duration + 3)
	else
		
		for i,v in pairs(Lighting:GetChildren()) do
			if v:IsA("Sky") then
				v.Parent = script;
				OldSkies[#OldSkies + 1] = Sky;
			end
		end
		
		Sky = script.Sky:Clone();
		Sky.Parent = Lighting;
		
		if Lighting.FogColor ~= Color3.new(1,1,1) then
			FogColor = Lighting.FogColor
			FogEnd = Lighting.FogEnd;
			Lighting.FogColor = Color3.new(1,1,1);
			Lighting.FogEnd = 0;
		end
		
	end
	
	
	local Highlight_1 = Instance.new("Highlight")
	Highlight_1.Adornee = Person_A;
	Highlight_1.FillColor = Color3.fromRGB(0,0,0); --// inverted it will be 255
	Highlight_1.OutlineColor = Color3.fromRGB(255, 255, 255); --// inverted it will be 0;
	Highlight_1.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop;
	Highlight_1.FillTransparency = 0;
	Highlight_1.OutlineTransparency = 0;
	Highlight_1.Parent = Person_A;
	
	local Highlight_2 = Instance.new("Highlight")
	Highlight_2.Adornee = Person_B;
	Highlight_2.FillColor = Color3.fromRGB(0,0,0); --// inverted it will be 255
	Highlight_2.OutlineColor = Color3.fromRGB(255, 255, 255); --// inverted it will be 0;
	Highlight_2.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop;
	Highlight_2.FillTransparency = 0;
	Highlight_2.OutlineTransparency = 0;
	Highlight_2.Parent = Person_B;
	
	local Hit_Gui = script.Hit:Clone()
	Hit_Gui.Enabled = true
	Hit_Gui.Parent = LocalPlayer.PlayerGui;
	
	local Move
	Move = RunService.RenderStepped:Connect(function()
		
		Lighting.ExposureCompensation = -100;
		
		
		
		
		local Position_A = Person_A:GetPivot().Position;
		local Position_B = Person_B:GetPivot().Position;
		local worldPoint = Position_A:Lerp(Position_B,.5)
		local vector, onScreen = workspace.CurrentCamera:WorldToScreenPoint(worldPoint)
		
		Hit_Gui.Impact.Position = UDim2.new(0,vector.X,0,vector.Y)
		
		
	end)
	
	local Impact_Sound = script.Impact_Sound:Clone()
	Impact_Sound.PlayOnRemove = true;
	Impact_Sound.Parent = workspace;
	Impact_Sound:Destroy()
	
	task.wait(Duration)
	
	if Move then
		Move:Disconnect();Move = nil
	end
	
	if Highlight_1 then
		Highlight_1.Adornee = nil;Highlight_1:Destroy();Highlight_1 = nil
	end
	if Highlight_2 then
		Highlight_2.Adornee = nil;Highlight_2:Destroy();Highlight_2 = nil
	end
	
	if Hit_Gui then
		Hit_Gui:Destroy();Hit_Gui = nil;
	end
	
	if Inversion then
		Inversion:Destroy();Inversion = nil;
	end
	
	if Sky then
		Sky:Destroy();
		
		for i,v in pairs(OldSkies) do
			v.Parent = Lighting;
		end
		if FogEnd then
			Lighting.FogEnd = FogEnd
		end
		if FogColor then
			Lighting.FogColor = FogColor
		end
		
	end
	
	if Lighting and Exposure then
		Lighting.ExposureCompensation = Exposure
	end
	
	
end]]></ProtectedString>
