				<Item class="ModuleScript" referent="RBXB6D588379F004FC69D456B1B8F069795">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Run = game:GetService("RunService")
local Debris = game:GetService("Debris")

return function(Reference, Color_A, Color_B, Size_A, Size_B, Duration, Spin)
	
	
	Reference = Reference or CFrame.new();
	Color_A = Color_A or Color3.new(1,1,1);
	Color_B = Color_B or Color_A;
	Size_A = Size_A or Vector3.new();
	Size_B = Size_B or Vector3.new(0.4,0.2,0.4) * 30;
	


	local windEffect = Instance.new("Part")
	windEffect.CastShadow = false
	windEffect.Massless = true;
	windEffect.CanCollide = false
	windEffect.Color = Color_A
	windEffect.Size = Vector3.new(0,0,0)
	windEffect.Parent = workspace.CurrentCamera

	Debris:AddItem(windEffect,1)
	
	local windWeld;
	local windMesh = Instance.new("SpecialMesh")
	windMesh.MeshId = "http://www.roblox.com/asset/?id=1051557"
	windMesh.Scale = Vector3.new(7,4,7)
	windMesh.Parent = windEffect
	
	if typeof(Reference) == "Instance" and Reference:IsA("Part") then
		windWeld = Instance.new("Weld")
		windWeld.Part0 = Reference
		windWeld.Part1 = windEffect
		windWeld.C0 = CFrame.new(Vector3.new(0,0,0)) * CFrame.Angles(0,math.random(-300,300),0)
		windWeld.Parent = windEffect
	else
		windEffect.Anchored = true
		windEffect.CFrame = Reference
	end

	local T = 0
	
	local function Lerp(a,b,t)
		return (a + ((b-a) * t))
	end
	
	repeat

		local Delta_1 = Run.Heartbeat:Wait()
		local Delta =  Delta_1/Duration
		
		T += Delta
		
		windMesh.Scale = Size_A:Lerp(Size_B,T * Duration)
		
		if windWeld then
			windWeld.C0 = windWeld.C0 * CFrame.Angles(0,math.rad(Spin * Delta_1),0)
		else
			windEffect.CFrame *= CFrame.Angles(0,math.rad(Spin * Delta_1),0)
		end
		
		windEffect.Transparency = Lerp(0,1,T* Duration)
		
		windEffect.Color = Color_A:Lerp(Color_B,T * Duration)
		
	until not windEffect or not windEffect.Parent or windEffect.Transparency >= 1
	
	windEffect:Destroy()
	script:Destroy()

	
end]]></ProtectedString>
						<string name="ScriptGuid">{9AE2EA38-AEE9-454E-89E1-9C903F0A5C25}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Wind_Spiral</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX5ACBB5C1C1E443FAA3571B47B060047F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")


return function(Position, Radius, Lasting, SegmentSize)
	
	Position = Position or Vector3.new(0,10,0);
	Radius = Radius or 10;
	Lasting = Lasting or 4;
	SegmentSize = SegmentSize or 3
	
	local Ignore = {}
	for i,v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") then
			table.insert(Ignore,v.Parent)
		elseif v:IsA("BasePart") and v.Name == "Stella_Crater_VFXPart" then
			table.insert(Ignore,v)
		end
	end
	
	local Circumference = math.ceil(2*math.pi*Radius)/SegmentSize
	
	for a = 0,Circumference do
		local NewC = (CFrame.new(Position) * CFrame.Angles(0,a*math.rad(360/Circumference),math.rad(90))) * CFrame.new(0,Radius,0)
		
		local Params = RaycastParams.new();Params.FilterDescendantsInstances = Ignore;Params.IgnoreWater = true
		
		
		local RayC = workspace:Raycast(NewC.Position + Vector3.new(0,1,0),Vector3.new(0,-16,0),Params)
		
		
		if RayC and RayC.Instance.Anchored == true then
			--Dirt = NewPart:Clone()
			local CraterSegment = Instance.new("Part")
			CraterSegment.Name = "Stella_Crater_VFXPart"
			CraterSegment.Color = RayC.Instance.Color
			CraterSegment.Material = RayC.Instance.Material
			CraterSegment.Anchored = true
			CraterSegment.Massless = true;
			CraterSegment.Transparency = 0
			CraterSegment.TopSurface = Enum.SurfaceType.Smooth
			CraterSegment.BottomSurface = Enum.SurfaceType.Smooth
			CraterSegment.Size = Vector3.new(1,1,1) * math.random((SegmentSize * 0.8) * 100,SegmentSize * 100)/100
			CraterSegment.CFrame = CFrame.new(RayC.Position) * CFrame.Angles(math.random(-99,99),math.random(-99,99),math.random(-99,99))
			CraterSegment.Parent = workspace
			task.delay(Lasting - 1,function()
				TweenService:Create(CraterSegment,TweenInfo.new(1),{Size = Vector3.new(),Position = CraterSegment.Position - Vector3.new(0,SegmentSize/2,0),Transparency = 1}):Play()
			end)
			Debris:AddItem(CraterSegment,Lasting)
			--else print("part not found")
		end
	end
	
	
	
end]]></ProtectedString>
						<string name="ScriptGuid">{36B8BC46-AC3E-41CF-AEA7-472C84C76AC2}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Sharp_Crater</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX314146AC441A4904874E47CF5202D50D">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")


return function(Position, Radius, Lasting, SegmentSize)
	
	Position = Position or Vector3.new(0,10,0);
	Radius = Radius or 10;
	Lasting = Lasting or 4;
	SegmentSize = SegmentSize or 3
	
	local Ignore = {}
	for i,v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") then
			table.insert(Ignore,v.Parent)
		elseif v:IsA("BasePart") and v.Name == "Stella_Crater_VFXPart" then
			table.insert(Ignore,v)
		end
	end
	
	local Circumference = math.ceil(2*math.pi*Radius)/SegmentSize
	local Params = RaycastParams.new();Params.FilterDescendantsInstances = Ignore;Params.IgnoreWater = true

	local CenterRay = workspace:Raycast(Position,Vector3.new(0,-15,0),Params)
	
	if CenterRay then
		
		for a = 0,Circumference do
			local NewC = (CFrame.new(Position) * CFrame.Angles(0,a*math.rad(360/Circumference),math.rad(90))) * CFrame.new(0,Radius,0)
			
			
			
			local RayC = workspace:Raycast(NewC.Position + Vector3.new(0,1,0),Vector3.new(0,-16,0),Params)
			
			if RayC and RayC.Instance.Anchored == true then
				--Dirt = NewPart:Clone()
				local CraterSegment = Instance.new("Part")
				CraterSegment.Name = "Stella_Crater_VFXPart"
				CraterSegment.Color = RayC.Instance.Color
				CraterSegment.Material = RayC.Instance.Material
				CraterSegment.Anchored = true
				CraterSegment.Transparency = 0
				CraterSegment.TopSurface = Enum.SurfaceType.Smooth
				CraterSegment.BottomSurface = Enum.SurfaceType.Smooth
				CraterSegment.Size = Vector3.new(1,.5,1) * SegmentSize
				CraterSegment.CFrame = CFrame.new(RayC.Position,CenterRay.Position - (CenterRay.Normal * 3))
				CraterSegment.Parent = workspace
				task.delay(Lasting - 1,function()
					TweenService:Create(CraterSegment,TweenInfo.new(1),{Size = Vector3.new(),Position = CraterSegment.Position - Vector3.new(0,SegmentSize/2,0),Transparency = 1}):Play()
				end)
				Debris:AddItem(CraterSegment,Lasting)
				--else print("part not found")
			end
		end
	end
	
	
	
end]]></ProtectedString>
