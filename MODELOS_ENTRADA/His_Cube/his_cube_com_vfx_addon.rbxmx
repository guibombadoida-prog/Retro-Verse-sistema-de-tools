					<string name="ScriptGuid">{D6EAB890-7F17-4E3D-A5B8-60D87030FFC7}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
					<bool name="DefinesCapabilities">true</bool>
					<string name="Name">Stella&apos;s VFX Addon</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX6AA8A6D681314DAB8D73CFBC2F9D5D70">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized Lightning effect for convenience.
	
	
]]
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")
local Debris = game:FindService("Debris") or game:GetService("Debris")


local Neon_Part = Instance.new("Part")
Neon_Part.Material = Enum.Material.Neon;
Neon_Part.Size = Vector3.new(1,1,1) * 1 --// Filters thru mouse without having to filter;
Neon_Part.Color = Color3.fromRGB(255, 255, 255);
Neon_Part.Anchored = true
Neon_Part.CanCollide = false;
Neon_Part.CanTouch = false;
Neon_Part.CastShadow = false;
Neon_Part.CanQuery = false;


local Neon_Mesh = Instance.new("SpecialMesh")
Neon_Mesh.MeshType = Enum.MeshType.Cylinder;
Neon_Mesh.Name = "Neon_Mesh";
Neon_Mesh.Scale = Vector3.new(1,1,1) * 1;
Neon_Mesh.Parent = Neon_Part

local Seed = Random.new(os.clock()*10^6)

return function(StartPosition, EndPosition, Lifetime, Thickness_Start, Thickness_End ,Segments, Offset, LightningColor_A, LightningColor_B)
	
	--function Lightning.new(StartPos,EndPos,Segments,Thickness,LightningColor)
	
	StartPosition = StartPosition or Vector3.new(0,5,0);
	EndPosition = EndPosition or Vector3.new(0,100,0)
	Lifetime = Lifetime or 2;
	Thickness_Start = Thickness_Start or 2;
	Thickness_End = Thickness_End or 0.5;
	Segments = Segments or math.floor((StartPosition - EndPosition).Magnitude/15)
	Offset = Offset or math.floor((StartPosition - EndPosition).Magnitude/Segments)
	
	EndPosition = (EndPosition ~= StartPosition and EndPosition) or EndPosition + Vector3.new(0,0.001,0)

	local Points = {}
	
	local LightningModel = Instance.new("Model")
	LightningModel.Name = "LightningModel"
	
	for i = 0,Segments,1 do
		--task.wait()
		local Offset = Vector3.new(Seed:NextNumber(-Offset,Offset),Seed:NextInteger(-Offset,Offset),Seed:NextInteger(-Offset,Offset))
		local Pos = StartPosition + (EndPosition - StartPosition).Unit * i * (EndPosition - StartPosition).Magnitude / Segments
		if i == 0 or i == Segments then
			Offset = Vector3.new(0,0,0)
		end
		
		
		Points[#Points + 1] = Pos + Offset
		
		local Color_A,Color_B = LightningColor_A or Color3.fromRGB(0, 255, 217),LightningColor_B or LightningColor_A
		
		local LightningPoint = Neon_Part:Clone()
		LightningPoint.Color = Color_A:Lerp(Color_B,i/Segments)
		LightningPoint.Name = "Point"
		LightningPoint.Transparency = 1
		LightningPoint.Neon_Mesh.MeshType = Enum.MeshType.Sphere
		LightningPoint.Size = Vector3.new(1,1,1) * Thickness_Start
		LightningPoint.Position = Pos + Offset
		LightningPoint.Parent = LightningModel
		
		TweenService:Create(LightningPoint.Neon_Mesh,TweenInfo.new(Lifetime,Enum.EasingStyle.Linear),{Scale = Vector3.new(Thickness_End,Thickness_End,Thickness_End)}):Play()
		TweenService:Create(LightningPoint,TweenInfo.new(Lifetime,Enum.EasingStyle.Linear),{Transparency = 1}):Play()
	end
	
	for i = 1,#Points,1 do
		if Points[i + 1] ~= nil then
			
			local Color_A,Color_B = LightningColor_A or Color3.fromRGB(0, 255, 217),LightningColor_B or LightningColor_A

			
			local LightningBeam = Neon_Part:Clone()
			LightningBeam.Color = Color_A:Lerp(Color_B,i/#Points)
			LightningBeam.Name = "ThunderStreak"
			LightningBeam.Transparency = .25
			LightningBeam.Neon_Mesh.Scale = Vector3.new((Points[i] - Points[i + 1]).Magnitude,Thickness_Start,Thickness_Start)
			LightningBeam.CFrame = CFrame.new((Points[i] + Points[i + 1]) / 2,Points[i + 1]) * CFrame.Angles(0,math.pi/2,0)
			LightningBeam.Parent = LightningModel
			
			TweenService:Create(LightningBeam.Neon_Mesh,TweenInfo.new(Lifetime,Enum.EasingStyle.Linear),{Scale = Vector3.new(LightningBeam.Neon_Mesh.Scale.X,Thickness_End,Thickness_End)}):Play()
			TweenService:Create(LightningBeam,TweenInfo.new(Lifetime,Enum.EasingStyle.Linear),{Transparency = 1}):Play()
			
			
		end
	end
	
	LightningModel.Parent = workspace
	
	
	Debris:AddItem(LightningModel,Lifetime + 3)
end
]]></ProtectedString>
						<string name="ScriptGuid">{B9299939-21AE-41AD-BCAE-6CA82BD5898F}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Lightning</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXD6852E73966D422D9F7D6474CFE17B19">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized Pillar for convenience.
	
	
]]
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")
local Debris = game:FindService("Debris") or game:GetService("Debris")

local Seed = Random.new(os.clock() * 10^6)
local NextInteger = Seed.NextNumber

return function(Start_Position, End_Position, Color_A, Color_B, Lasting, Thickness_Start, Thickness_End, Shape)
	
	Start_Position = Start_Position or Vector3.new(0,0,0)
	End_Position = End_Position or Vector3.new(0,100,0)
	Thickness_Start = Thickness_Start or 1;
	Thickness_End = Thickness_End or 0;
	Lasting = Lasting or .5;
	Shape = Shape or "Cylinder"
	Color_A = Color_A or Color3.fromRGB(255, 255, 255);
	Color_B = Color_B or Color_A
	
	
	local Distance = (Start_Position - End_Position).magnitude

	local Laser = Instance.new("Part")
	Laser.Name = "Shot"
	Laser.Locked = true
	Laser.Anchored = true
	Laser.CastShadow = false
	Laser.CanCollide = false
	Laser.Material = Enum.Material.Neon
	Laser.Size = Vector3.new(1,1,1) * 0.001

	local Mesh = Instance.new("SpecialMesh")
	Mesh.Scale = (Vector3.new((Distance + 1),Thickness_Start,Thickness_Start)) * 1000
	Mesh.MeshType = Shape
	Mesh.Parent = Laser

	Laser.Color = Color_A

	Laser.CFrame = CFrame.lookAt(Start_Position, End_Position) * CFrame.Angles(0,math.pi/2,0) * CFrame.new((Distance / 2),0,0)
	Debris:AddItem(Laser, Lasting + 1)
	Laser.Parent = workspace
	
	local Tween_Create = TweenInfo.new(Lasting, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, 0)

	
	TweenService:Create(Laser,Tween_Create,{Transparency = 1,Color = Color_B}):Play()
	TweenService:Create(Mesh,Tween_Create,{Scale = Vector3.new(Distance + 1,Thickness_End,Thickness_End) * 1000}):Play()
	
