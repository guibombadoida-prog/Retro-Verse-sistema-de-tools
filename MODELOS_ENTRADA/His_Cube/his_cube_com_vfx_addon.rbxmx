					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local CircleObject = script:WaitForChild("Circle")
local ExplosionObject = script:WaitForChild("Fire")

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")


return function(Position, Duration, Size_A, Size_B, Color, RingColors)
	
	Position = Position or Vector3.new();
	Size_A = Size_A or 0;
	Size_B = Size_B or 0;
	Color = Color or Color3.fromRGB(255,255,255)
	RingColors = RingColors or {Color, Color3.new(1,1,1), Color3.new(0,0,0)}
	
	local Fire = ExplosionObject:Clone();
	Fire.Color = Color
	Fire.Position = Position;
	Fire.Size = Vector3.new(Size_A,Size_A,Size_A);
	Fire.Parent = workspace;
	Debris:AddItem(Fire,Duration + 1)
	
	
	local tween = TweenService:Create(Fire,TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		Size = Vector3.new(Size_B,Size_B,Size_B);
		Transparency = 1;
		CFrame = Fire.CFrame * CFrame.Angles(math.rad(math.random(-50,50)),math.rad(math.random(-50,50)),math.rad(math.random(-50,50)))
	})

	tween:Play()
	
	local function circleeffects(Part,Amount)
		
		
		
		local colors = (typeof(RingColors) == "Color3" and {RingColors}) or RingColors

		local Model = Instance.new("Model")
		Model.Name = "Circle"
		Model.Parent = workspace.CurrentCamera

		for i = 1, Amount do
			local ef = CircleObject:Clone()
			ef.Color = colors[math.random(1, #colors)]
			ef.Size = Size_A
			ef.CFrame = Part.CFrame * CFrame.Angles(math.rad(math.random(-180,180)),math.rad(math.random(-180,180)),math.rad(math.random(-180,180)))
			ef.Parent = Model

			local t = TweenService:Create(ef,TweenInfo.new(math.random((Duration * .6) * 100,(Duration) * 100)/100, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Size = Vector3.new(1, 0, 1) * math.random((Size_B * 0.5) * 100,(Size_B * 1.5) * 100) /100;
				Transparency = 1;
				CFrame = ef.CFrame * CFrame.Angles(math.rad(math.random(-50,50)),math.rad(math.random(-50,50)),math.rad(math.random(-50,50)))
			})

			t:Play()


			Debris:AddItem(Model, Duration + .5)
		end
	end
	
	circleeffects(
		Fire,
		10
	)
	
end]]></ProtectedString>
