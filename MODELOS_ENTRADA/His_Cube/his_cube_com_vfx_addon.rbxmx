	IDLE = {
		RightArm = CFrame.new(1.5, 0.2, -0.2) * CFrame.Angles(math.rad(50), 0, math.rad(8)),
		Head     = CFrame.new(0, 1.5, 0),
		HRP      = CFrame.new(),
	},
	SHOOT = {
		RightArm = CFrame.new(1.2, 0.5, -1.0) * CFrame.Angles(math.rad(90), 0, math.rad(-10)),
		Head     = CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(-5), math.rad(-10), 0),
		HRP      = CFrame.new(0, 0, -0.2) * CFrame.Angles(0, math.rad(-15), 0),
	},
	NUKE_CHARGE = {
		RightArm = CFrame.new(1.3, 0.8, 0) * CFrame.Angles(math.rad(150), 0, math.rad(15)),
		Head     = CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(15), 0, 0),
		HRP      = CFrame.new(),
	},
	NUKE_FIRE = {
		RightArm = CFrame.new(1.0, 0.5, -1.3) * CFrame.Angles(math.rad(95), math.rad(-5), math.rad(-20)),
		Head     = CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(-8), math.rad(-20), 0),
		HRP      = CFrame.new(0, 0, -0.4) * CFrame.Angles(math.rad(-3), math.rad(-25), 0),
	},
	-- NOVO V4: Pose de invocar sala
	ABYSS_CAST = {
		RightArm = CFrame.new(1.5, 0.8, 0) * CFrame.Angles(math.rad(160), 0, math.rad(20)),
		Head     = CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(10), 0, 0),
		HRP      = CFrame.new() * CFrame.Angles(math.rad(-5), 0, 0),
	},
}

local Tool   = script.Parent
local Handle = Tool:WaitForChild("Handle")
local shootRemote  = Tool:WaitForChild("veryinnacurateshoot")
local remoteKey    = Tool:WaitForChild("Remote")
local skill1Remote = Tool:WaitForChild("Skill1")

local Players      = game:GetService("Players")
local Debris       = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService   = game:GetService("RunService")

Tool.CanBeDropped   = false
Tool.RequiresHandle = true
Tool.ToolTip        = "His Cube - Cubo Sombrio"
Tool.Enabled        = true

local owner        = nil
local character    = nil
local humanoid     = nil
local equipped     = false
local shootCD      = false
local nukeCD       = false
local nukeCharging = false
local abyssCD      = false
local isAnimating  = false

local rightArmWeld = nil
local headWeld     = nil
local rootWeld     = nil

local music    = Instance.new("Sound")
music.Parent   = Handle
music.Looped   = true

-- Rotações pré-definidas (math.random PROIBIDO)
local ROTATIONS = {
	CFrame.Angles(math.rad(45),0,math.rad(135)),  CFrame.Angles(math.rad(-60),0,math.rad(210)),
	CFrame.Angles(math.rad(120),0,math.rad(315)), CFrame.Angles(math.rad(-150),0,math.rad(75)),
	CFrame.Angles(math.rad(30),0,math.rad(270)),  CFrame.Angles(math.rad(-90),0,math.rad(180)),
	CFrame.Angles(math.rad(165),0,math.rad(45)),  CFrame.Angles(math.rad(-15),0,math.rad(330)),
}
local rotIdx = 0
local function NextRotation() rotIdx = (rotIdx % #ROTATIONS) + 1; return ROTATIONS[rotIdx] end

local ORIENTATIONS = {
	Vector3.new(45,120,200),  Vector3.new(-30,250,85),  Vector3.new(170,60,310),
	Vector3.new(-110,190,40), Vector3.new(80,340,155),  Vector3.new(-55,15,270),
	Vector3.new(145,280,100), Vector3.new(-170,95,220), Vector3.new(20,200,350),
	Vector3.new(-80,310,140),
}
local oriIdx = 0
local function NextOrientation() oriIdx = (oriIdx % #ORIENTATIONS) + 1; return ORIENTATIONS[oriIdx] end

local DEBRIS_OFFSETS = {
	Vector3.new(25,15,-30),  Vector3.new(-40,35,20),  Vector3.new(10,45,50),
	Vector3.new(-20,25,-45), Vector3.new(50,10,15),   Vector3.new(-35,40,-10),
	Vector3.new(15,50,35),   Vector3.new(-10,20,-55), Vector3.new(40,30,25),
	Vector3.new(-50,15,40),  Vector3.new(30,55,-20),  Vector3.new(-25,10,30),
	Vector3.new(45,20,-35),  Vector3.new(-15,45,15),  Vector3.new(20,35,-40),
	Vector3.new(-35,55,10),  Vector3.new(40,10,50),   Vector3.new(-50,35,-30),
	Vector3.new(10,45,60),   Vector3.new(-60,30,15),
}
local debIdx = 0
local function NextDebrisOffset() debIdx = (debIdx % #DEBRIS_OFFSETS) + 1; return DEBRIS_OFFSETS[debIdx] end

local function CreatePart(props)
	local p = Instance.new("Part"); for k,v in pairs(props) do p[k]=v end; return p
end
local function TweenObj(obj, info, goals) TweenService:Create(obj, info, goals):Play() end

-- ═══════════ WELDS R6 ═══════════
local function createWelds()
	if not character then return false end
	local torso = character:FindFirstChild("Torso")
	local rArm = character:FindFirstChild("Right Arm")
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (torso and rArm and head and root) then return false end
	local rg = rArm:FindFirstChild("RightGrip")
	if rg then rg.C0 = CFrame.new(0,-1,0)*CFrame.Angles(math.rad(-90),0,0) end

	rightArmWeld = Instance.new("Weld")
	rightArmWeld.Part0=torso; rightArmWeld.Part1=rArm; rightArmWeld.C0=CFrame.new(1.5,0,0)
	rightArmWeld.Name="RightArmWeldHisCube"; rightArmWeld.Parent=torso

	headWeld = Instance.new("Weld")
	headWeld.Part0=torso; headWeld.Part1=head; headWeld.C0=CFrame.new(0,1.5,0)
	headWeld.Name="HeadWeldHisCube"; headWeld.Parent=torso

	rootWeld = Instance.new("Weld")
	rootWeld.Part0=root; rootWeld.Part1=torso; rootWeld.C0=CFrame.new()
	rootWeld.Name="HRPWeldHisCube"; rootWeld.Parent=root
	return true
end

local function removeWelds()
	for _,w in ipairs({rightArmWeld, headWeld, rootWeld}) do
		if w and w.Parent then w.Parent = nil end
	end
	rightArmWeld=nil; headWeld=nil; rootWeld=nil
end

local function tweenToPose(poseName, duration)
	local pose = POSES[poseName]; if not pose then return end
	local ti = TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local map = {RightArm=rightArmWeld, Head=headWeld, HRP=rootWeld}
	for k,cf in pairs(pose) do
		local w = map[k]; if w and w.Parent then TweenService:Create(w, ti, {C0=cf}):Play() end
	end
end

-- ═══════════ ANTI-FRIENDLY FIRE (BombaNuclear_V4) ═══════════
local function IsAlly(c1, c2)
	if c1==c2 then return true end
	if not c1 or not c2 then return false end
	local p1=Players:GetPlayerFromCharacter(c1); local p2=Players:GetPlayerFromCharacter(c2)
	if p1 and p2 and p1.Team and p2.Team and p1.Team==p2.Team then return true end
	if c1:FindFirstChild("AllyTag") and c2:FindFirstChild("AllyTag") then
		if c1.AllyTag.Value==c2.AllyTag.Value then return true end
	end
	if c1:FindFirstChild("ControlFollow") and c2:FindFirstChild("ControlFollow") then
		if c1.ControlFollow.Owner.Value==c2.ControlFollow.Owner.Value then return true end
	end
	return false
end

-- ═══════════ SCREEN SHAKE ═══════════
local function triggerScreenShake(position, intensity, duration, range)
	range = range or 80
	for _,player in pairs(Players:GetPlayers()) do
		if player.Character and player.Character:FindFirstChild("Head") then
			local dist = (player.Character.Head.Position - position).Magnitude
			if dist <= range then
				local f = 1-(dist/range)
				if intensity*f > 0.05 then skill1Remote:FireClient(player, "ScreenShake", intensity*f, duration) end
			end
		end
	end
end

-- ═══════════ SHOCKWAVE ═══════════
local function Shockwave(pos,t1,t2,ss,e1,s1,sc1,p1,tm1,e2,s2,sc2,p2,tm2,r,g,b)
	local p=Instance.new("Part",workspace:FindFirstChildOfClass("Terrain"))
	p.Anchored=true;p.Transparency=0.1;p.Name="Shockwave";p.CanCollide=false;p.CanTouch=false
	p.CanQuery=false;p.Size=Vector3.new(1,1,1);p.CFrame=pos;p.CastShadow=false
	local m=Instance.new("SpecialMesh",p);m.MeshId="rbxassetid://643098245"
	m.TextureId="rbxassetid://643064975";m.VertexColor=Vector3.new(r,g,b);m.Scale=ss
	task.spawn(function()
		TweenService:Create(m,TweenInfo.new(tm1,e1,s1),{Scale=sc1}):Play()
		TweenService:Create(p,TweenInfo.new(tm1,e1,s1),{CFrame=p1,Transparency=t1}):Play()
		task.wait(tm1/2)
		TweenService:Create(m,TweenInfo.new(tm2,e2,s2),{Scale=sc2}):Play()
		TweenService:Create(p,TweenInfo.new(tm2,e2,s2),{CFrame=p2,Transparency=t2}):Play()
		task.wait(tm2); p.Parent=nil
	end)
end

-- ═══════════ RAYCAST ═══════════
local function CastRay(start, dir, dist, ignore)
	local params=RaycastParams.new();params.FilterDescendantsInstances=ignore
	params.FilterType=Enum.RaycastFilterType.Exclude;params.IgnoreWater=true
	local r=workspace:Raycast(start, dir*dist, params)
	if r then return r.Instance, r.Position, r.Normal end
	return nil, start+dir*dist, nil
end

-- ═══════════ VFX IMPACTO (Brawler_V1) ═══════════
local function createImpactVFX(position, isHeavy)
	local imp=CreatePart({Shape=Enum.PartType.Ball,Material=Enum.Material.Neon,Anchored=true,
		CanCollide=false,CanTouch=false,CFrame=CFrame.new(position),Transparency=0.3,CastShadow=false,
		Size=isHeavy and Vector3.new(3,3,3) or Vector3.new(1.5,1.5,1.5),
		BrickColor=isHeavy and BrickColor.new("Really black") or BrickColor.new("Institutional white"),
		Parent=workspace})
	TweenObj(imp,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
		{Size=isHeavy and Vector3.new(10,10,10) or Vector3.new(5,5,5),Transparency=1})
	Debris:AddItem(imp,0.5)
	local ring=CreatePart({Shape=Enum.PartType.Cylinder,Material=Enum.Material.Neon,Anchored=true,
		CanCollide=false,CanTouch=false,CFrame=CFrame.new(position)*CFrame.Angles(0,0,math.rad(90)),
		Transparency=0.5,CastShadow=false,
		Size=isHeavy and Vector3.new(0.3,3,3) or Vector3.new(0.2,1.5,1.5),
		BrickColor=isHeavy and BrickColor.new("Really black") or BrickColor.new("Institutional white"),
		Parent=workspace})
	TweenObj(ring,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
		{Size=isHeavy and Vector3.new(0.1,14,14) or Vector3.new(0.1,7,7),Transparency=1})
	Debris:AddItem(ring,0.5)
end

-- ═══════════ DANO BEAM ═══════════
local function DealBeamDamage(fromP, hitPos, damage, attackerChar)
	local dir=(hitPos-fromP).Unit; local dist=(hitPos-fromP).Magnitude; local hit=false
	for _,v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") and v.Health>0 then
			local root=v.RootPart or v.Parent:FindFirstChild("HumanoidRootPart") or v.Parent:FindFirstChild("Torso")
			if root and not IsAlly(attackerChar, v.Parent) then
				local toT=root.Position-fromP; local proj=toT:Dot(dir)
				if proj>0 and proj<dist then
					local cp=fromP+dir*proj
					if (root.Position-cp).Magnitude < CONFIG.ShootBeamRadius then
						v:TakeDamage(damage); hit=true; createImpactVFX(cp,false)
					end
				end
			end
		end
	end
	return hit
end

-- ═══════════ DANO AOE (BombaNuclear_V4) ═══════════
local function DealAoEDamage(position, radius, maxDmg, kb, attackerChar)
	for _,v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") and v.Health>0 then
			local root=v.RootPart or v.Parent:FindFirstChild("HumanoidRootPart") or v.Parent:FindFirstChild("Torso")
			if root then
				local d=(root.Position-position).Magnitude
				if d<radius and not IsAlly(attackerChar, v.Parent) then
					local f=1-(d/radius); local dmg=math.floor(maxDmg*f)
					if dmg>0 then v:TakeDamage(dmg) end
					if kb>0 then
						local bv=Instance.new("BodyVelocity");bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
						bv.P=10000000;bv.Velocity=(root.Position-position).Unit*kb*f;bv.Parent=root
						Debris:AddItem(bv,0.25)
					end
				end
			end
		end
	end
end

-- ═══════════ VFX TIRO NORMAL (SERVER-SIDE) ═══════════
local function DoShootVFX(fromP, hitPos)
	local Dist=(hitPos-fromP).Magnitude
	local snd=Instance.new("Sound");snd.SoundId="rbxassetid://2960518660";snd.Volume=3
	snd.Parent=Handle;snd:Play();Debris:AddItem(snd,4)
	local cast=Handle:FindFirstChild("bullet thing lol")
	if cast then
		local rot=NextRotation()
		Shockwave(cast.CFrame*rot,0,1,Vector3.new(1,1,1),Enum.EasingStyle.Sine,Enum.EasingDirection.In,
			Vector3.new(0,0,0),cast.CFrame*rot,0,Enum.EasingStyle.Quint,Enum.EasingDirection.Out,
			Vector3.new(0.06,0.06,0.06),cast.CFrame*rot,5,255,255,255)
	end
	local o1=NextOrientation();local o2=NextOrientation()
	local sq1=CreatePart({Color=Color3.new(0,0,0),CanCollide=false,CanTouch=false,Anchored=true,
		CFrame=cast and cast.CFrame or CFrame.new(fromP),Size=Vector3.new(0,0,0),
		Material=Enum.Material.Neon,CastShadow=false,Parent=workspace})
	local sq2=CreatePart({Color=Color3.new(0,0,0),CanCollide=false,CanTouch=false,Anchored=true,
		CFrame=sq1.CFrame,Size=Vector3.new(0,0,0),Material=Enum.Material.Neon,CastShadow=false,Parent=workspace})
	TweenObj(sq1,TweenInfo.new(0.7),{Size=Vector3.new(2,2,2),Transparency=1,Orientation=o1})
	TweenObj(sq2,TweenInfo.new(0.7),{Size=Vector3.new(2,2,2),Transparency=1,Orientation=o2})
	Debris:AddItem(sq1,1);Debris:AddItem(sq2,1)

	local Lz=CreatePart({Anchored=true,CanCollide=false,CanTouch=false,Size=Vector3.new(3,3,Dist),
		Shape=Enum.PartType.Block,Material=Enum.Material.Neon,
		CFrame=CFrame.new(fromP,hitPos)*CFrame.new(0,0,-Dist/2),
		Color=Color3.new(0,0,0),Transparency=0.35,CastShadow=false,Parent=workspace})
	local Lz1=CreatePart({Anchored=true,CanCollide=false,CanTouch=false,Size=Vector3.new(1.8,1.8,Dist),
		Shape=Enum.PartType.Block,Material=Enum.Material.Neon,
		CFrame=CFrame.new(fromP,hitPos)*CFrame.new(0,0,-Dist/2),
		Color=Color3.new(1,1,1),Transparency=0,CastShadow=false,Parent=workspace})
	task.spawn(function()
		local pos=hitPos
		for i=1,10 do
			local off=NextDebrisOffset();local ori=NextOrientation()
			local p=CreatePart({Parent=workspace,Anchored=true,CanCollide=false,CanTouch=false,
				Color=Color3.new(0,0,0),Material=Enum.Material.Neon,Position=pos,Size=Vector3.new(0.5,4,4),CastShadow=false})
			TweenObj(p,TweenInfo.new(0.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
				{Position=pos+off,Orientation=ori,Transparency=1});Debris:AddItem(p,1)
		end
		for i=1,5 do
			local off=NextDebrisOffset();local ori=NextOrientation()
			local p=CreatePart({Parent=workspace,Anchored=true,CanCollide=false,CanTouch=false,
				Color=Color3.new(1,1,1),Material=Enum.Material.Neon,Position=pos,Size=Vector3.new(0.5,3,3),CastShadow=false})
			TweenObj(p,TweenInfo.new(0.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
				{Position=pos+off,Orientation=ori,Transparency=1});Debris:AddItem(p,1)
		end
		for i=1,3 do
			local rot=NextRotation()
			local m=CreatePart({Parent=workspace,Shape=Enum.PartType.Cylinder,Anchored=true,CanCollide=false,CanTouch=false,
				Color=Color3.new(0,0,0),Material=Enum.Material.Neon,Size=Vector3.new(),CFrame=CFrame.new(pos)*rot,CastShadow=false})
			TweenObj(m,TweenInfo.new(1.5,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
				{Size=Vector3.new(15+i*10,0,15+i*10),Transparency=1});Debris:AddItem(m,2)
		end
		for i=0,1 do
			local ball=CreatePart({Parent=workspace,Anchored=true,CanCollide=false,CanTouch=false,
				Material=Enum.Material.Neon,Color=Color3.new(0,0,0),Position=pos,Shape=Enum.PartType.Ball,
				Size=Vector3.new(),Transparency=0.4*i,CastShadow=false})
			TweenObj(ball,TweenInfo.new(1.5,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
				{Size=Vector3.new(12+2*i,12+2*i,12+2*i),Transparency=1});Debris:AddItem(ball,2)
		end
	end)
	Debris:AddItem(Lz,3);Debris:AddItem(Lz1,3)
	TweenObj(Lz,TweenInfo.new(1,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1,Size=Vector3.new(0,0,Dist)})
	TweenObj(Lz1,TweenInfo.new(1,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1,Size=Vector3.new(0,0,Dist)})
end

-- ═══════════ VFX NUKE CARGA ═══════════
local function DoChargeVFX(handlePos)
	local sph=script:FindFirstChild("Sphere"); if not sph then return end
	local sizes={{6,"Really black"},{10,"Institutional white"},{14,"Really black"}}
	for idx,d in ipairs(sizes) do
		if idx>1 then task.wait(1) end
		local fx=sph:Clone();fx.Parent=workspace;fx.Name="ChargeFX"..idx
		fx.Anchored=true;fx.Locked=true;fx.BrickColor=BrickColor.new(d[2])
		fx.Material=Enum.Material.Neon;fx.CanCollide=false;fx.CanTouch=false
		fx.Size=Vector3.new(d[1],d[1],d[1]);fx.CastShadow=false;fx.Transparency=0.3
		fx.CFrame=CFrame.new(handlePos)
		TweenObj(fx,TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),
			{Size=Vector3.new(0,0,0),Transparency=1});Debris:AddItem(fx,1.5)
	end
end

-- ═══════════ VFX NUKE DISPARO ═══════════
local function DoNukeFireVFX(fromP, hitPos)
	local Dist=(hitPos-fromP).Magnitude
	local snd=Instance.new("Sound");snd.SoundId="rbxassetid://2960518660"
	snd.Volume=5;snd.PlaybackSpeed=0.87;snd.Parent=Handle;snd:Play();Debris:AddItem(snd,6)
	local cast=Handle:FindFirstChild("bullet thing lol")
	if cast then
		local rot=NextRotation()
		Shockwave(cast.CFrame*rot,0,1,Vector3.new(1,1,1),Enum.EasingStyle.Sine,Enum.EasingDirection.In,
			Vector3.new(0,0,0),cast.CFrame*rot,0,Enum.EasingStyle.Quint,Enum.EasingDirection.Out,
			Vector3.new(0.15,0.15,0.15),cast.CFrame*rot,5,255,255,255)
	end
	local Lz=CreatePart({Anchored=true,CanCollide=false,CanTouch=false,Size=Vector3.new(6,6,Dist),
		Shape=Enum.PartType.Block,Material=Enum.Material.Neon,
		CFrame=CFrame.new(fromP,hitPos)*CFrame.new(0,0,-Dist/2),
		Color=Color3.new(0,0,0),Transparency=0.35,CastShadow=false,Parent=workspace})
	local Lz1=CreatePart({Anchored=true,CanCollide=false,CanTouch=false,Size=Vector3.new(3.5,3.5,Dist),
		Shape=Enum.PartType.Block,Material=Enum.Material.Neon,
		CFrame=CFrame.new(fromP,hitPos)*CFrame.new(0,0,-Dist/2),
		Color=Color3.new(1,1,1),Transparency=0,CastShadow=false,Parent=workspace})
	task.spawn(function()
		local pos=hitPos
		local mT=script:FindFirstChild("Mushroom")
		if mT then
			local m=mT:Clone();m.Parent=workspace;m.Anchored=true;m.Position=pos+Vector3.new(0,8,0)
			m.Locked=true;m.Orientation=Vector3.new(0,165,0);m.BrickColor=BrickColor.new("Institutional white")
			m.Material=Enum.Material.Neon;m.CanCollide=false;m.CanTouch=false;m.Size=Vector3.new(0,0,0)
			m.CastShadow=false;m.Transparency=0
			TweenObj(m,TweenInfo.new(6),{Size=Vector3.new(80,76,80)})
			TweenObj(m,TweenInfo.new(2,Enum.EasingStyle.Sine,Enum.EasingDirection.In,0,false,2),{Transparency=1,Color=Color3.new(0,0,0)})
			TweenObj(m,TweenInfo.new(4),{Orientation=Vector3.new(0,-360,0)});Debris:AddItem(m,6)
		end
		local sp=CreatePart({Material=Enum.Material.Neon,Shape=Enum.PartType.Ball,CanCollide=false,CanTouch=false,
			Position=pos,Anchored=true,Locked=true,Transparency=0.075,BrickColor=BrickColor.new("Really black"),
			Size=Vector3.new(0,0,0),CastShadow=false,Parent=workspace})
		TweenObj(sp,TweenInfo.new(6),{Size=Vector3.new(50,50,50)})
		TweenObj(sp,TweenInfo.new(2.5,Enum.EasingStyle.Sine,Enum.EasingDirection.In,0,false,2.5),{Transparency=1})
		Debris:AddItem(sp,6)
		for i=1,12 do
			local off=NextDebrisOffset()*2;local ori=NextOrientation()
			local p=Instance.new("WedgePart");p.Parent=workspace;p.Anchored=true;p.CanCollide=false;p.CanTouch=false
			p.Color=Color3.new(0,0,0);p.Material=Enum.Material.Neon;p.Position=pos;p.Size=Vector3.new(0.5,5,5);p.CastShadow=false
			TweenObj(p,TweenInfo.new(0.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
				{Position=pos+off,Orientation=ori,Transparency=1});Debris:AddItem(p,1)
		end
		for i=1,8 do
			local off=NextDebrisOffset()*1.5;local ori=NextOrientation()
			local p=Instance.new("WedgePart");p.Parent=workspace;p.Anchored=true;p.CanCollide=false;p.CanTouch=false
			p.Color=Color3.new(1,1,1);p.Material=Enum.Material.Neon;p.Position=pos;p.Size=Vector3.new(0.5,4,4);p.CastShadow=false
			TweenObj(p,TweenInfo.new(0.8,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),
				{Position=pos+off,Orientation=ori,Transparency=1});Debris:AddItem(p,1)
		end
	end)
	Debris:AddItem(Lz,4);Debris:AddItem(Lz1,4)
	TweenObj(Lz,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1,Size=Vector3.new(0,0,Dist)})
	TweenObj(Lz1,TweenInfo.new(1.5,Enum.EasingStyle.Quad,Enum.EasingDirection.In),{Transparency=1,Size=Vector3.new(0,0,Dist)})
end

--[[
═══════════════════════════════════════════════════════════════
        SALA DO ABISMO (E) — NOVO V4
═══════════════════════════════════════════════════════════════
- Caixa 50x50x50 preta Neon ao redor do jogador
- Dono: invisível + silhueta escura, passa através
- Inimigos: sólida, dano contínuo 5/s
- Duração: 8s → evapora com VFX
- Cooldown: 30s
═══════════════════════════════════════════════════════════════
--]]

local function MakeOwnerInvisible(char, invisible)
	if not char then return end
	for _, part in pairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if invisible then
				-- Guardar transparência original como atributo
				if not part:GetAttribute("OrigTransparency") then
					part:SetAttribute("OrigTransparency", part.Transparency)
				end
				part.Transparency = 0.85 -- silhueta escura
			else
				local orig = part:GetAttribute("OrigTransparency")
				if orig then
					part.Transparency = orig
					part:SetAttribute("OrigTransparency", nil)
				end
			end
		end
	end
end

local function DoAbyssRoom(attackerChar)
	if not attackerChar then return end
	local rootPart = attackerChar:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end

	local centerPos = rootPart.Position
	local boxSize = CONFIG.AbyssBoxSize

	-- Criar 6 paredes da caixa (em vez de 1 part sólida, para que o dono passe)
	local walls = {}
	local wallDefs = {
		{name="Top",    size=Vector3.new(boxSize,1,boxSize),  cf=CFrame.new(centerPos+Vector3.new(0,boxSize/2,0))},
		{name="Bottom", size=Vector3.new(boxSize,1,boxSize),  cf=CFrame.new(centerPos+Vector3.new(0,-boxSize/2,0))},
		{name="Front",  size=Vector3.new(boxSize,boxSize,1),  cf=CFrame.new(centerPos+Vector3.new(0,0,-boxSize/2))},
		{name="Back",   size=Vector3.new(boxSize,boxSize,1),  cf=CFrame.new(centerPos+Vector3.new(0,0,boxSize/2))},
		{name="Left",   size=Vector3.new(1,boxSize,boxSize),  cf=CFrame.new(centerPos+Vector3.new(-boxSize/2,0,0))},
		{name="Right",  size=Vector3.new(1,boxSize,boxSize),  cf=CFrame.new(centerPos+Vector3.new(boxSize/2,0,0))},
	}

	for _, def in ipairs(wallDefs) do
		local wall = Instance.new("Part")
		wall.Name       = "AbyssWall_"..def.name
		wall.Size       = def.size
		wall.CFrame     = def.cf
		wall.Anchored   = true
		wall.CanCollide = true -- sólida para inimigos
		wall.CanTouch   = false
		wall.Material   = Enum.Material.Neon
		wall.BrickColor = BrickColor.new("Really black")
		wall.Transparency = 0.3
		wall.CastShadow = false
		wall.Parent     = workspace
		table.insert(walls, wall)
	end

	-- Configurar CollisionGroup: dono passa através
	-- Como não podemos criar CollisionGroups dinamicamente de forma simples,
	-- vamos usar CanCollide toggle via loop
	local ownerParts = {}
	for _, part in pairs(attackerChar:GetDescendants()) do
		if part:IsA("BasePart") then
			table.insert(ownerParts, part)
		end
	end

	-- Tornar dono invisível (silhueta escura)
	MakeOwnerInvisible(attackerChar, true)

	-- VFX de aparecimento: caixa surge do chão
	for _, wall in ipairs(walls) do
		local origSize = wall.Size
		wall.Size = Vector3.new(origSize.X, 0, origSize.Z)
		TweenObj(wall, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{Size = origSize, Transparency = 0.3})
	end

	-- Som de aparecimento
	local snd = Instance.new("Sound")
	snd.SoundId = "rbxassetid://2960518660"
	snd.Volume = 4; snd.PlaybackSpeed = 0.5
	snd.Parent = Handle; snd:Play()
	Debris:AddItem(snd, 5)

	-- Screen shake
	triggerScreenShake(centerPos, 1.0, 0.4, 80)

	-- Loop de dano contínuo + colisão do dono
	local abyssActive = true
	local damageInterval = 1 / CONFIG.AbyssDPS -- a cada tick de 1 dano

	task.spawn(function()
		local elapsed = 0
		local dmgTimer = 0
		while abyssActive and elapsed < CONFIG.AbyssDuration do
			local dt = RunService.Stepped:Wait()
			elapsed = elapsed + dt
			dmgTimer = dmgTimer + dt

			-- Cancelar colisão das paredes com o dono
			for _, wall in ipairs(walls) do
				if wall.Parent then
					for _, oPart in ipairs(ownerParts) do
						-- Mover levemente o dono se estiver tocando parede
						-- Alternativa: setar CanCollide false brevemente
					end
				end
			end

			-- Dano contínuo a inimigos dentro da caixa
			if dmgTimer >= 1 then
				dmgTimer = dmgTimer - 1
				local halfSize = boxSize / 2
				for _, v in pairs(workspace:GetDescendants()) do
					if v:IsA("Humanoid") and v.Health > 0 then
						local root = v.RootPart or v.Parent:FindFirstChild("HumanoidRootPart") or v.Parent:FindFirstChild("Torso")
						if root and not IsAlly(attackerChar, v.Parent) then
							local rel = root.Position - centerPos
							if math.abs(rel.X) < halfSize and math.abs(rel.Y) < halfSize and math.abs(rel.Z) < halfSize then
								v:TakeDamage(CONFIG.AbyssDPS)
							end
						end
					end
				end
			end
		end
		abyssActive = false
	end)

	-- Passabilidade do dono: desabilitar colisão das paredes para o dono via PhysicsService alternativa
	-- Solução: usar Touched para detectar e cancelar
	-- Melhor solução: setar collision group ou simplesmente usar CanCollide com check periódico
	task.spawn(function()
		while abyssActive do
			-- Verificar se o dono está perto de uma parede e temporariamente desligar colisão
			if attackerChar and attackerChar:FindFirstChild("HumanoidRootPart") then
				local ownerPos = attackerChar.HumanoidRootPart.Position
				for _, wall in ipairs(walls) do
					if wall.Parent then
						local dist = (ownerPos - wall.Position).Magnitude
						-- Se o dono está perto da parede (< 5 studs), desabilitar brevemente
						if dist < (boxSize/2 + 5) then
							wall.CanCollide = false
							task.wait(0.1)
							if wall.Parent and abyssActive then
								wall.CanCollide = true
							end
						end
					end
				end
			end
			task.wait(0.15)
		end
	end)

	-- Aguardar duração e evaporar
	task.wait(CONFIG.AbyssDuration)
	abyssActive = false

	-- VFX de evaporação
	for _, wall in ipairs(walls) do
		if wall.Parent then
			-- Debris de evaporação por parede
			for i = 1, 3 do
				local off = NextDebrisOffset()
				local ori = NextOrientation()
				local deb = CreatePart({Parent=workspace, Anchored=true, CanCollide=false, CanTouch=false,
					Color=Color3.new(0,0,0), Material=Enum.Material.Neon, Position=wall.Position,
					Size=Vector3.new(3,3,3), CastShadow=false})
				TweenObj(deb, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{Position=wall.Position+off, Orientation=ori, Transparency=1})
				Debris:AddItem(deb, 1)
			end
			-- Evaporar parede
			TweenObj(wall, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
				{Transparency=1, Size=Vector3.new(0,0,0)})
			Debris:AddItem(wall, 1)
		end
	end

	-- Screen shake na evaporação
	triggerScreenShake(centerPos, 0.8, 0.3, 60)

	-- Restaurar visibilidade do dono
	MakeOwnerInvisible(attackerChar, false)
end

-- ═══════════ EQUIPAR / DESEQUIPAR ═══════════
Tool.Equipped:Connect(function()
	equipped=true; character=Tool.Parent
	owner=Players:GetPlayerFromCharacter(character)
	humanoid=character and character:FindFirstChildOfClass("Humanoid")
	music:Resume()
	if createWelds() then
		tweenToPose("IDLE",0.3)
		task.spawn(function()
			while equipped and character do
				if not isAnimating then
					local b=math.sin(tick()*2)*0.02
					if rightArmWeld and rightArmWeld.Parent then
						rightArmWeld.C0=rightArmWeld.C0:Lerp(POSES.IDLE.RightArm*CFrame.new(0,b,0),0.05)
					end
				end
				RunService.Stepped:Wait()
			end
		end)
	end
end)

Tool.Unequipped:Connect(function()
	equipped=false;nukeCharging=false;isAnimating=false
	removeWelds()
	character=nil;owner=nil;humanoid=nil
	music:Pause()
end)

-- ═══════════ TIRO NORMAL (Click) — FIX V3 mantido ═══════════
shootRemote.OnServerEvent:Connect(function(client, mousePos)
	local toolChar=Tool.Parent; if not toolChar then return end
	local toolPlayer=Players:GetPlayerFromCharacter(toolChar)
	if client~=toolPlayer then return end
	local cHum=toolChar:FindFirstChildOfClass("Humanoid")
	if not cHum or cHum.Health<=0 then return end
	if shootCD then return end
	if typeof(mousePos)~="Vector3" then return end

	shootCD=true; isAnimating=true; tweenToPose("SHOOT",0.12)
	local bp=Handle:FindFirstChild("bullet thing lol")
	local fromP=bp and bp.CFrame.Position or Handle.Position
	local toP=mousePos
	local d=(toP-fromP).Magnitude
	if d>2048 then toP=fromP+(toP-fromP).Unit*2048 end
	local _,hitPos,_=CastRay(fromP,(toP-fromP).Unit,(toP-fromP).Magnitude,
		{workspace:FindFirstChildOfClass("Terrain"),toolChar})
	local hit=DealBeamDamage(fromP,hitPos,CONFIG.ShootDamage,toolChar)
	task.spawn(DoShootVFX,fromP,hitPos)
	if hit then triggerScreenShake(hitPos,0.5,0.2,60) end
	task.wait(0.2)
	if equipped then tweenToPose("IDLE",0.15) end
	isAnimating=false
	task.delay(CONFIG.ShootCooldown,function() shootCD=false end)
end)

-- ═══════════ HABILIDADES POR TECLA ═══════════
remoteKey.OnServerEvent:Connect(function(client, key, data)
	local toolChar=Tool.Parent; if not toolChar then return end
	local toolPlayer=Players:GetPlayerFromCharacter(toolChar)
	if client~=toolPlayer then return end
	local cHum=toolChar:FindFirstChildOfClass("Humanoid")
	if not cHum or cHum.Health<=0 then return end
	if not Tool.Enabled then return end

	-- Q: NUKE
	if key == Enum.KeyCode.Q then
		if nukeCD or nukeCharging then return end
		nukeCharging=true; isAnimating=true
		tweenToPose("NUKE_CHARGE",0.4)
		task.spawn(DoChargeVFX,Handle.Position)
		task.wait(CONFIG.NukeChargeTime)
		if not equipped or not toolChar then nukeCharging=false;isAnimating=false;return end
		local h2=toolChar:FindFirstChildOfClass("Humanoid")
		if not h2 or h2.Health<=0 then nukeCharging=false;isAnimating=false;return end
		nukeCharging=false
		skill1Remote:FireClient(client,"readyToFire")

		-- E: SALA DO ABISMO (NOVO V4)
	elseif key == Enum.KeyCode.E then
		if abyssCD then return end
		if nukeCharging then return end

		abyssCD=true; isAnimating=true
		tweenToPose("ABYSS_CAST",0.3)
		task.wait(0.3)

		-- Executar sala do abismo em thread separada
		task.spawn(DoAbyssRoom, toolChar)

		task.wait(0.5)
		if equipped then tweenToPose("IDLE",0.3) end
		isAnimating=false

		task.delay(CONFIG.AbyssCooldown, function() abyssCD=false end)

		-- NUKE FIRE
	elseif key == "NukeFire" then
		if nukeCD then return end
		if typeof(data)~="Vector3" then return end
		nukeCD=true; tweenToPose("NUKE_FIRE",0.15)
		local bp=Handle:FindFirstChild("bullet thing lol")
		local fromP=bp and bp.CFrame.Position or Handle.Position
		local toP=data; local d=(toP-fromP).Magnitude
		if d>2048 then toP=fromP+(toP-fromP).Unit*2048 end
		local _,hitPos,_=CastRay(fromP,(toP-fromP).Unit,(toP-fromP).Magnitude,
			{workspace:FindFirstChildOfClass("Terrain"),toolChar})
		DealAoEDamage(hitPos,CONFIG.NukeRadius,CONFIG.NukeMaxDamage,CONFIG.NukeKnockback,toolChar)
		task.spawn(DoNukeFireVFX,fromP,hitPos)
		triggerScreenShake(hitPos,2.0,0.6,120)
		task.wait(0.5)
		if equipped then tweenToPose("IDLE",0.3) end
		isAnimating=false
		task.delay(CONFIG.NukeCooldown,function() nukeCD=false end)
	end
end)

-- ═══════════ NPC (Brawler_V1) ═══════════
local npcShootCD=false; local npcNukeCD=false
local function FindNearestTarget(pos, range)
	local n=nil;local nd=range
	for _,m in pairs(workspace:GetChildren()) do
		if m:IsA("Model") and m~=character then
			local tH=m:FindFirstChildOfClass("Humanoid")
			local tR=m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
			if tH and tR and tH.Health>0 and not IsAlly(character,m) then
				local d=(tR.Position-pos).Magnitude
				if d<nd then n=tR;nd=d end
			end
		end
	end
	return n
end

task.spawn(function()
	while true do
		task.wait(1)
		if equipped and not owner then
			if not npcShootCD and character and character:FindFirstChild("HumanoidRootPart") then
				local t=FindNearestTarget(character.HumanoidRootPart.Position,CONFIG.NPCDetectRange)
				if t then
					npcShootCD=true;isAnimating=true;tweenToPose("SHOOT",0.12)
					local bp=Handle:FindFirstChild("bullet thing lol")
					local fromP=bp and bp.CFrame.Position or Handle.Position
					local _,hitPos,_=CastRay(fromP,(t.Position-fromP).Unit,(t.Position-fromP).Magnitude,
						{workspace:FindFirstChildOfClass("Terrain"),character})
					local hit=DealBeamDamage(fromP,hitPos,CONFIG.ShootDamage,character)
					task.spawn(DoShootVFX,fromP,hitPos)
					if hit then triggerScreenShake(hitPos,0.5,0.2,60) end
					task.wait(0.2);if equipped then tweenToPose("IDLE",0.15) end;isAnimating=false
					task.delay(CONFIG.NPCShootInterval,function() npcShootCD=false end)
				end
			end
			if not npcNukeCD and character and character:FindFirstChild("HumanoidRootPart") then
				local t=FindNearestTarget(character.HumanoidRootPart.Position,CONFIG.NPCDetectRange)
				if t then
					npcNukeCD=true;isAnimating=true;tweenToPose("NUKE_CHARGE",0.4)
					task.spawn(DoChargeVFX,Handle.Position);task.wait(CONFIG.NukeChargeTime)
					if equipped and character then
						local ch=character:FindFirstChildOfClass("Humanoid")
						if ch and ch.Health>0 then
							tweenToPose("NUKE_FIRE",0.15)
							local bp=Handle:FindFirstChild("bullet thing lol")
							local fromP=bp and bp.CFrame.Position or Handle.Position
							local _,hitPos,_=CastRay(fromP,(t.Position-fromP).Unit,(t.Position-fromP).Magnitude,
								{workspace:FindFirstChildOfClass("Terrain"),character})
							DealAoEDamage(hitPos,CONFIG.NukeRadius,CONFIG.NukeMaxDamage,CONFIG.NukeKnockback,character)
							task.spawn(DoNukeFireVFX,fromP,hitPos);triggerScreenShake(hitPos,2.0,0.6,120)
							task.wait(0.5);if equipped then tweenToPose("IDLE",0.3) end
						end
					end
					isAnimating=false
					task.delay(CONFIG.NPCNukeInterval,function() npcNukeCD=false end)
				end
			end
		end
	end
end)]]></ProtectedString>
