						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Smooth_Crater</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0DF518BA49EF45A6B90FB629411F0976">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")


local Seed = Random.new(os.clock()*10^6)

return function(Position, Amount, Size, Lasting, UpperVelocity, SideVelocity, CanCollide, Gravity)
	
	Position = Position or Vector3.new(0,10,0);
	Amount = Amount or 3;
	Size = Size or 3;
	Lasting = Lasting or 3
	UpperVelocity = UpperVelocity or 50;
	SideVelocity = SideVelocity or 35;
	
	Gravity = Gravity or 0
	CanCollide = CanCollide or true
	
	local Ignore = {}
	for i,v in pairs(workspace:GetDescendants()) do
		if v:IsA("Humanoid") then
			table.insert(Ignore,v.Parent)
		elseif v:IsA("BasePart") and (v.CanCollide == false or v.Transparency ~= 0) then
			table.insert(Ignore,v)
		end
	end
	
	local Params = RaycastParams.new();Params.FilterDescendantsInstances = Ignore;Params.IgnoreWater = true


	local RayC = workspace:Raycast(Position + Vector3.new(0,1,0),Vector3.new(0,-16,0),Params)
	
	if RayC then
		for i = 1,Amount do
			
			local NewC = (CFrame.new(Position + Vector3.new(0,Size * 1.2,0)) * CFrame.Angles(0,i*math.rad(360/Amount),math.rad(90))) * CFrame.new(0,Size * 1.2,0)
			
			
			
			local CraterSegment = Instance.new("Part")
			CraterSegment.Color = RayC.Instance.Color
			CraterSegment.Material = RayC.Instance.Material
			CraterSegment.Anchored = false
			CraterSegment.CanCollide = CanCollide
			CraterSegment.Transparency = 0
			CraterSegment.TopSurface = Enum.SurfaceType.Smooth
			CraterSegment.BottomSurface = Enum.SurfaceType.Smooth
			CraterSegment.Size = Vector3.new(1,1,1) * Seed:NextNumber(Size * 0.8,Size * 1.2)
			CraterSegment.CFrame = NewC
			
			local Attachment_0 = Instance.new("Attachment",CraterSegment)
			Attachment_0.Position = CraterSegment.Size * 0.25;
			
			local Attachment_1 = Instance.new("Attachment",CraterSegment)
			Attachment_1.Position = -CraterSegment.Size * 0.25;
			
			local Trail = script:WaitForChild("Trail"):Clone()
			Trail.Attachment0 = Attachment_0;
			Trail.Attachment1 = Attachment_1;
			Trail.Enabled = true;
			Trail.Parent = CraterSegment
			
			if Gravity and Gravity > 0 then

				Instance.new("BodyForce",CraterSegment).Force = Vector3.new(0,(workspace.Gravity * CraterSegment:GetMass()) * Gravity,0)

			end
			
			CraterSegment.Parent = workspace
			CraterSegment.AssemblyLinearVelocity = Vector3.new(Seed:NextNumber(-SideVelocity,SideVelocity),Seed:NextNumber(UpperVelocity * 0.8,UpperVelocity * 1.2),Seed:NextNumber(-SideVelocity,SideVelocity))
			CraterSegment.AssemblyAngularVelocity =  Vector3.new(Seed:NextNumber(-SideVelocity,SideVelocity),Seed:NextNumber(UpperVelocity * 0.8,UpperVelocity * 1.2),Seed:NextNumber(-SideVelocity,SideVelocity))
			
			
			task.delay(Lasting - 1,function() --// tweenservice might freeze part, so ill do old fashioned way
				local T = 0
				
				local function Lerp(a,b,t)
					return a + (b-a) * t
				end
				
				local Start = CraterSegment.Size
				
				if Trail then
					Trail.Enabled = false
				end
				
				repeat
					T += RunService.Heartbeat:Wait();
					CraterSegment.Size = Start:Lerp(Vector3.new(),T)
					CraterSegment.Transparency = Lerp(0,1,T)
				until T >= 1
			end)
			Debris:AddItem(CraterSegment,Lasting)
			
		end
		
	end
	
	
end]]></ProtectedString>
