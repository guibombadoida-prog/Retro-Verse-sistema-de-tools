				<Item class="ModuleScript" referent="RBX43742F75969045EAB7F0DF809BAE831C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized Basic Explosion for convenience.
	
	
]]
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")
local Debris = game:FindService("Debris") or game:GetService("Debris")

return function(Position, Duration, Size_A,Size_B,Color_A,Color_B)
	--// Keeping this local for performance and stability
	
	
	
	Position = Position or Vector3.new(0,5,0)
	Duration = Duration or .5;
	Size_A = Size_A or 0;
	Size_B = Size_B or 50;
	Color_A = Color_A or Color3.fromRGB(255,255,255);
	Color_B = Color_B or Color_A
	

	
	local function Explode(Position)
		local ExplosionPart = Instance.new("Part");
		ExplosionPart.Color = Color_A
		ExplosionPart.CanCollide = false;
		ExplosionPart.CanTouch = false;
		ExplosionPart.Anchored = true;
		ExplosionPart.Shape = Enum.PartType.Ball;
		ExplosionPart.Size = Vector3.new(1,1,1) * Size_A
		ExplosionPart.Position = Position
		ExplosionPart.CastShadow = false
		ExplosionPart.Material = "Neon"



		local LastTime = Duration + 3;

		
		ExplosionPart.Parent = workspace.Camera


		TweenService:Create(ExplosionPart,TweenInfo.new(Duration,Enum.EasingStyle.Linear),{Size = Vector3.new(1,1,1) * Size_B,Transparency = 1,Color = Color_B}):Play()

		Debris:AddItem(ExplosionPart,LastTime + 1)
	end

	do
		Explode(Position)
	end







end]]></ProtectedString>
						<string name="ScriptGuid">{20D4E338-4BE1-4ED4-862D-976E8BC8F99C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Small_Sphere</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX101CCA3F2C954D42B7AB5B107930CEF9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (8/8/2022)
	
	Modularized Pillar for convenience.
	
	
]]
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")
local Debris = game:FindService("Debris") or game:GetService("Debris")

local Seed = Random.new(os.clock() * 10^6)
local NextInteger = Seed.NextNumber

return function(Start_Position, End_Position, Color_A, Color_B, Lasting, Thickness, Shape, EasingStyle)
	
	Start_Position = Start_Position or Vector3.new(0,0,0)
	End_Position = End_Position or Vector3.new(0,100,0)
	Thickness = Thickness or 10
	Lasting = Lasting or 2;
	Shape = Shape or Enum.MeshType.Cylinder
	EasingStyle = EasingStyle or Enum.EasingStyle.Exponential
	Color_A = Color_A or Color3.fromRGB(255,255,255)
	Color_B = Color_B or Color_A
	
	local Distance = (Start_Position - End_Position).magnitude

	local Laser = Instance.new("Part")
	Laser.Name = "Shot"
	Laser.Locked = true
	Laser.Anchored = true
	Laser.CastShadow = false;
	Laser.CanCollide = false
	Laser.Transparency = 1;
	Laser.Material = Enum.Material.Neon
	Laser.Size = Vector3.new(1,1,1) * 0.001

	local Mesh = Instance.new("SpecialMesh")
	Mesh.Scale = (Vector3.new((Distance + 1),1,1)) * 1000
	Mesh.MeshType = Shape
	Mesh.Parent = Laser

	Laser.Color = Color_A

	Laser.CFrame = CFrame.lookAt(Start_Position, End_Position) * CFrame.Angles(0,math.pi/2,0) * CFrame.new((Distance / 2),0, 0)
	Debris:AddItem(Laser, Lasting + 1)
	Laser.Parent = workspace
	
	local Tween_Create = TweenInfo.new(Lasting  * 0.9, EasingStyle, Enum.EasingDirection.Out, 0, false, 0)

	
	TweenService:Create(Laser,TweenInfo.new(Lasting * 0.1),{Transparency = 0}):Play()
	TweenService:Create(Mesh,Tween_Create,{Scale = Vector3.new(Mesh.Scale.X,Thickness * 1000,Thickness * 1000)}):Play()
	
	task.wait(Lasting * 0.9)
	
	local Tween_Create = TweenInfo.new(Lasting  * 0.1, EasingStyle, Enum.EasingDirection.Out, 0, false, 0)

	
	TweenService:Create(Laser,Tween_Create,{Transparency = 1,Color = Color_B}):Play()
	TweenService:Create(Mesh,Tween_Create,{Scale = Vector3.new(Mesh.Scale.X,0,0)}):Play()

	
end
]]></ProtectedString>
						<string name="ScriptGuid">{0271DF78-E9A5-451D-BA53-1BCF45862E7B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Straight_Shot_Fade</string>
