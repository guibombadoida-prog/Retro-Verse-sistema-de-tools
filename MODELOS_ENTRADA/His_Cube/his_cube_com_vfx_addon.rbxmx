				<Item class="ModuleScript" referent="RBX8C57BCBBEAAB49609F88DFC87558B275">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")


return function(CF, Size, Lasting, ColorSeq)
	
	CF = CF or CFrame.new()
	Size = Size or 10;
	Lasting = Lasting or 4;
	ColorSeq = ColorSeq or ColorSequence.new(Color3.fromRGB(255, 255, 255))
	
	
	local Aura = script.Aura:Clone()
	Aura.CFrame = CF;
	Aura.Size = Size;
	Aura.Aura.Color = ColorSeq;
	Aura.Aura.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,((Size.Y + Size.Z)/2)/4,(Size.Y + Size.Z)/2/8),NumberSequenceKeypoint.new(1,((Size.Y + Size.Z)/2)/8, (Size.Y + Size.Z)/4)})
	
	Aura.Parent = workspace
	Aura.Aura:Emit(Size * 10);
	
end]]></ProtectedString>
