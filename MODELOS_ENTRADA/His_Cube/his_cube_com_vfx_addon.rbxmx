				</Item>
				<Item class="ModuleScript" referent="RBXAF545808E59D4F24B19E4CD4E624B515">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized MINECRAFT Explosion for convenience.
	
	
]]
local ReplicatedStorage = game:FindService("ReplicatedStorage") or game:GetService("ReplicatedStorage")
local Debris = game:FindService("Debris") or game:GetService("Debris")


return function(Position, Size, Rate, Lasting)
	Position = Position or Vector3.new(0,5,0)
	Size = Size or 20;
	Rate = Rate or 250
	Lasting = Lasting or .2
	
	local Part = script.ExplosionPart:Clone()
	Part.Position = Position;
	Part.Size = Vector3.new(1,1,1) * Size;
	
	Part.Explosion.RollOffMinDistance = Size;
	Part.Explosion:Play();
	Part.Parent = workspace;
	
	
	Part.E_1.Rate = Rate;
	Part.E_2.Rate = Rate;
	Part.E_1.Enabled = true;
	Part.E_2.Enabled = true;
	
	Debris:AddItem(Part,2.5 + Lasting);
	
	task.wait(Lasting)
	
	Part.E_1.Enabled = false;
	Part.E_2.Enabled = false;
	
	
	--Part.Size = Vector3.new();
end



]]></ProtectedString>
