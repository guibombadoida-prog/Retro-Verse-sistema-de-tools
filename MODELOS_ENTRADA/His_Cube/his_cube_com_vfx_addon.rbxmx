				<Item class="ModuleScript" referent="RBX81DC4FB06522488E8C0E77EBD30CC89F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[local RunService = (game:FindService("RunService") or game:GetService("RunService"));
local Debris = (game:FindService("Debris") or game:GetService("Debris"));

local Seed = Random.new(os.clock()*10^6)

local Slash_Model = Instance.new("Model");

do

	local Center = Instance.new("Part");
	Center.CastShadow = false;
	Center.Anchored = true;
	Center.CanCollide = false;
	Center.Size = Vector3.new(0, 0, 0);
	Center.Name = "1";
	Center.Material = Enum.Material.Neon;
	Center.Transparency = 1;
	Center.Massless = true;
	Center.Locked = true;
	Center.Parent = Slash_Model

	local Trail_Mesh = Instance.new("SpecialMesh");
	Trail_Mesh.MeshType = Enum.MeshType.FileMesh;
	Trail_Mesh.MeshId = "rbxassetid://3188638000";
	Trail_Mesh.Offset = Vector3.new(0, 0, 0);
	Trail_Mesh.TextureId = "";
	Trail_Mesh.Name = "Trail_Mesh";
	Trail_Mesh.Parent = Center;

	local Slash_Decal = Instance.new("Decal");
	Slash_Decal.Name = "Slash_Decal";
	Slash_Decal.Texture = "rbxassetid://3145429800"
	Slash_Decal.Color3 = Color3.new(1, 1, 1);
	Slash_Decal.Face = Enum.NormalId.Front;
	Slash_Decal.Transparency = 0;
	Slash_Decal.Parent = Center;

	Center = Center:Clone();
	Center.Name = "2";
	Center.Parent = Slash_Model;

	Slash_Model.Name = "Slash_Model";
	--Slash_Model.PrimaryPart = Center;
end

return function(Part: Instance, Start_Width: number, End_Width: number, Height: number, Duration: number, Rotation_Speed: number, Accent_Color)

	local Slash = Slash_Model:Clone();
	--Debris:AddItem(Slash, Duration + 1);

	task.delay(Duration + 1, function()
		Slash:Destroy();
	end)

	Slash:PivotTo(CFrame.lookAt(Part.Position, Part.Position + Part.AssemblyLinearVelocity) * CFrame.Angles(math.pi / 2, 0, 0) * CFrame.Angles(0, Seed:NextNumber(0, math.pi), 0));

	local Slash_1 = Slash["1"];
	local Slash_2 = Slash["2"];

	do
		local Mesh = Slash_1.Trail_Mesh;
		local Decal = Slash_1.Slash_Decal;

		local Color = Accent_Color:Lerp(Color3.new(1, 1, 1), .25);
		Color = Color3.new(Color.R * 10, Color.G * 10, Color.B * 10);

		Decal.Color3 = Color;
		Mesh.Scale = Vector3.new(Start_Width, Height, Start_Width);

		Mesh = Slash_2.Trail_Mesh;
		Decal = Slash_2.Slash_Decal;

		Decal.Color3 = Color;
		Mesh.Scale = Vector3.new(Start_Width, Height, Start_Width);
	end

	Slash.Parent = (RunService:IsClient() and workspace.CurrentCamera) or workspace;

	local current_duration = 0;

	--print("SLASH TRAIL");

	while current_duration < Duration and Part do

		local Delta = task.wait(0);

		local Alpha = math.clamp(current_duration / Duration, 0, 1);

		--local Angle = Vector2.new(Pitch_Start, Pitch_Start):Lerp(Vector2.new(Pitch_End, Pitch_End), Alpha).X

		local Width_Alpha = Vector2.new(Start_Width, Start_Width):Lerp(Vector2.new(End_Width, End_Width), Alpha).X;

		Slash:PivotTo(Slash:GetPivot() * CFrame.Angles(0, Rotation_Speed * Delta, 0));
		Slash_1.Slash_Decal.Transparency = Alpha;
		Slash_2.Slash_Decal.Transparency = Alpha;

		local Mesh = Slash_1.Trail_Mesh;
		Mesh.Scale = Vector3.new(Width_Alpha, Height, Width_Alpha);

		Mesh = Slash_2.Trail_Mesh;
		Mesh.Scale = Vector3.new(Width_Alpha, Height, Width_Alpha);

		current_duration += Delta;
	end

	Slash_1.Slash_Decal.Transparency = 1;
	Slash_2.Slash_Decal.Transparency = 1;
end
]]></ProtectedString>
						<string name="ScriptGuid">{3F67F79C-BF68-4F8B-8C53-6FB852D64D93}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
