				<Item class="ModuleScript" referent="RBX0646CC8B91F94F318E615631ACC031AC">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized Pillar Explosion for convenience.
	
	
]]
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")
local Debris = game:FindService("Debris") or game:GetService("Debris")

local RNG = math.random

local Glowing_Wind = script:WaitForChild("Glowing_Wind",10)

Glowing_Wind.Parent = nil

local Wave = script:WaitForChild("Wave",10)

Wave.Parent = nil

local Ball = script:WaitForChild("Boom",10)

Ball.Parent = nil;

return function(Position, Duration, Size, Color_A, Color_B)
	
	Position = Position or Vector3.new(0,5,0);
	Duration = Duration or 1.5
	Size = Size or 20
	Color_A = Color_A or Color3.fromRGB(255, 255, 255);
	Color_B = Color_B or Color_A
	
	local Wind = Glowing_Wind:Clone()
	Wind.Position = Position;
	Wind.Orientation = Vector3.new(0,RNG(-360,360),0)
	Wind.Color = Color_A
	Wind.Parent = workspace;

	TweenService:Create(Wind,TweenInfo.new(Duration,Enum.EasingStyle.Quad),{Size = Vector3.new(Size * 4,1,Size * 4),Transparency = 1,Orientation = Vector3.new(0,RNG(-360,360),0)}):Play()
	Debris:AddItem(Wind,Duration + 2)


	local Shockwave = Wave:Clone()
	Shockwave.Position = Position;
	Shockwave.Color = Color_A
	Shockwave.Orientation = Vector3.new(RNG(-360,360),RNG(-360,360),RNG(-360,360))
	Shockwave.Parent = workspace;

	TweenService:Create(Shockwave,TweenInfo.new(Duration/6,Enum.EasingStyle.Linear),{Size = Vector3.new(Size * 13,0,Size * 13),Transparency = 1}):Play()
	Debris:AddItem(Shockwave,Duration/6 + 1)

	local Ball = Ball:Clone()
	
	Ball.Core.Transparency = .5;
	Ball.Core.Size = Vector3.new(1,0.1,1) * Size
	
	Ball.Part.Transparency = .5;
	Ball.Part.Size = Vector3.new(1,0.1,1) * Size
	Ball.Part.Color = Color_A
	
	Ball.Parent = workspace
	Ball.PrimaryPart = Ball.Core;
	Ball:SetPrimaryPartCFrame(CFrame.new(Position))

	TweenService:Create(Ball.Core,TweenInfo.new(Duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false),{Size = Vector3.new(1,2,1) * Size,Transparency = 1,Color = Color_B}):Play()

	TweenService:Create(Ball.Part,TweenInfo.new(Duration,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false),{Size = Vector3.new(1.4,2.8,1.4) * Size,Transparency = 1,Color = Color_B}):Play()

	Debris:AddItem(Ball,Duration + 1)
	
end

]]></ProtectedString>
