				<Item class="ModuleScript" referent="RBXB418430D9672414EB74EDF82ED1446D9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[ 
	
	Made by Stellabotrus. (7/8/2022)
	
	Modularized Cartoony Explosion.
	
	
]]

	--// Variables;
local TweenService = game:FindService("TweenService") or game:GetService("TweenService") 
local Debris = game:FindService("Debris") or game:GetService("Debris") 
local Workspace = game:FindService("Workspace") or game:GetService("Workspace") 


local Seed = Random.new(os.clock()*10^6)

return function(CF, Size, Duration, Color_A, Color_B)
	
	CF = CF or CFrame.new(Vector3.new(0,10,0));
	Size = Size or 10;
	Duration = Duration or 4;
	Color_A = Color_A or Color3.fromRGB(255,150,0)
	Color_B = Color_B or Color_A
	
	local ExplosionPart = script:WaitForChild("Explosion"):Clone()
	ExplosionPart.Center.Puffball.Speed = NumberRange.new(Size * 2.5,Size * 3.5)
	ExplosionPart.Center.Puffball.Lifetime = NumberRange.new(Duration - (Duration/10),Duration + (Duration/10))
	
	local Keypoints = ExplosionPart.Center.Puffball.Size.Keypoints
	
	for I,v in pairs(Keypoints) do
		if v then
			
			local Keypoint = NumberSequenceKeypoint.new(v.Time,v.Value * (Size/10),(Size/10));
			--[[Keypoint.Value = v.Value * (Size/10)
			Keypoint.Time = v.Time;
			Keypoint.Envelope = (Size/10)]]
			
			
			Keypoints[I] = Keypoint
			
		end
	end
	--print(Keypoints)
	ExplosionPart.Center.Puffball.Size = NumberSequence.new(Keypoints);
	
	ExplosionPart.Center.Puffball.Drag = Size * 0.6;
	
	ExplosionPart.Center.Puffball.Color = ColorSequence.new(Color_A,Color_B)
	ExplosionPart.Center.Shockwave.Color = ColorSequence.new(Color_A,Color_B)
	ExplosionPart.Center.Glow.Color = ColorSequence.new(Color_A)
	ExplosionPart.Center.Sparks.Color = ColorSequence.new(Color_A,Color_B)
	
	ExplosionPart.Center.Shockwave.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,(Size/10)/2,((Size/10)/2)/2),NumberSequenceKeypoint.new(1,0)})
	ExplosionPart.Center.Shockwave.Speed =  NumberRange.new((Size * 4),Size * 6)
	ExplosionPart.Center.Shockwave.Drag = Size * 0.4
	ExplosionPart.Center.Shockwave.Lifetime = NumberRange.new(Duration);
	
	ExplosionPart.Center.Sparks.Speed = NumberRange.new((Size * 6),Size * 10)
	
	ExplosionPart.Center.Glow.Size = NumberSequence.new(Size * 1.5)
	
	ExplosionPart.CFrame = CF;
	ExplosionPart.Parent = workspace;
	
	
	ExplosionPart.Center.Shockwave:Emit(math.clamp(Size * 3,25,math.huge))
	ExplosionPart.Center.Puffball:Emit(math.clamp(Size * 3,25,math.huge))
	ExplosionPart.Center.Glow:Emit(1)
	ExplosionPart.Center.Sparks:Emit(math.clamp(Size * 3,25,math.huge))
	
	Debris:AddItem(ExplosionPart,Duration + 2)
	
end

]]></ProtectedString>
