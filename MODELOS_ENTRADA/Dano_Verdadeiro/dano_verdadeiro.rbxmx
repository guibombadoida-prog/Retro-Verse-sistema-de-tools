		<Item class="Script" referent="RBXC5C505CC741545A4A76A6148ABBDE98D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool=script.Parent
local rng=Random.new()
local kaboom=false

tool.Activated:Connect(function() 
	tool:WaitForChild("Handle"):WaitForChild("activate"):Play()
end)

tool.Activated:Once(function() 
	task.wait(2)
	local ssv=Instance.new("NumberValue")
	ssv.Parent=script
	ssv.Value=0
	spawn(function() 
		while kaboom==false do
			script:WaitForChild("spinweld").C1*=CFrame.Angles(ssv.Value,0,0)
			for i,v1 in pairs(script:WaitForChild("welds"):GetChildren()) do
				if v1:IsA("Motor6D") then
					v1.C1=CFrame.identity*CFrame.new(math.min(rng:NextNumber(-ssv.Value*0.015,ssv.Value*0.015),0.05),math.min(rng:NextNumber(-ssv.Value*0.015,ssv.Value*0.015),0.05),math.min(rng:NextNumber(-ssv.Value*0.015,ssv.Value*0.015),0.05))*
						CFrame.Angles(math.min(rng:NextNumber(-ssv.Value*0.015,ssv.Value*0.015),0.05),math.min(rng:NextNumber(-ssv.Value*0.015,ssv.Value*0.015),0.05),math.min(rng:NextNumber(-ssv.Value*0.015,ssv.Value*0.015),0.05))
				end
			end
			task.wait()
		end
	end)
	tool:WaitForChild("sender"):WaitForChild("charge"):Play()
	game:GetService("TweenService"):Create(ssv,TweenInfo.new(15,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{Value=100}):Play()
	spawn(function() 
		task.wait(2)
		for i=1,3 do
			tool:WaitForChild("Handle"):WaitForChild("alarm"):Play()
			task.wait(2)
		end
	end)
	task.wait(12.5)
	
	kaboom=true
	
	local light=Instance.new("ColorCorrectionEffect")
	light.Brightness=100
	light.Contrast=5
	light.Saturation=5
	light.Parent=game:GetService("Lighting")
	
	game:GetService("TweenService"):Create(light,TweenInfo.new(30,Enum.EasingStyle.Linear),{Brightness=0,Contrast=0,Saturation=0}):Play()
	
	local sfx=script:WaitForChild("boom")
	sfx.Parent=game:GetService("SoundService")
	sfx:Play()
	
	local sfx2=script:WaitForChild("hum")
	sfx2.Parent=game:GetService("SoundService")
	sfx2:Play()
	
	game:GetService("TweenService"):Create(sfx2,TweenInfo.new(25,Enum.EasingStyle.Linear),{Volume=0}):Play()
	
	game:GetService("Debris"):AddItem(sfx,20)
	game:GetService("Debris"):AddItem(sfx2,25+1)
	game:GetService("Debris"):AddItem(light,30+1)
	
	for i,v1 in pairs(workspace:GetDescendants()) do
		if v1 then
			spawn(function() 
				if v1:IsA("BallSocketConstraint") or v1:IsA("HingeConstraint") or v1:IsA("Humanoid") then
					game:GetService("Debris"):AddItem(v1,0)
				end
				if v1:IsA("BasePart") then
					if v1.Mass<=300 then
						v1.Anchored=false
						v1:BreakJoints()
					end
					local totalsize=v1.Size.X*0.5+v1.Size.Z*0.5+v1.Size.Y*0.5
					v1.CFrame*=CFrame.new(rng:NextNumber(-totalsize,totalsize),rng:NextNumber(-totalsize,totalsize),rng:NextNumber(-totalsize,totalsize))*CFrame.Angles(math.rad(rng:NextNumber(-totalsize,totalsize)),math.rad(rng:NextNumber(-totalsize,totalsize)),math.rad(rng:NextNumber(-totalsize,totalsize)))
					v1.Material=Enum.Material.CorrodedMetal
					local ex=Instance.new("Explosion")
					ex.Parent=workspace
					ex.Position=v1.Position
					ex.BlastRadius=math.huge
					ex.BlastPressure=v1.Mass*20
					local fire=Instance.new("Fire")
					fire.Parent=v1
					fire.Size=totalsize
				end
			end)
		end
	end
	
end)

]]></ProtectedString>
