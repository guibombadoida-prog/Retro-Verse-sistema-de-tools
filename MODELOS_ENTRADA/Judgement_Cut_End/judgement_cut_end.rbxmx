		<Item class="LocalScript" referent="RBXB6D5D995D98E45549E2A73C8EC307C50">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local rep = game:GetService("ReplicatedStorage")
local tw = game:GetService("TweenService")
local lighting = game:GetService("Lighting")
local cam = workspace.CurrentCamera
local Player = game.Players.LocalPlayer
local cha = Player.Character or Player.CharacterAdded:Wait()

rep.Cam.OnClientEvent:Connect(function(name,key,waittime)
	
	if key == "Reset" then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = cha.Humanoid
	end
	if key == "Zoom" then
		tw:Create(cam,TweenInfo.new(0.2,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{FieldOfView = 40}):Play()
		wait(waittime)
		tw:Create(cam,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{FieldOfView = 70}):Play()
	end
	if key == "WB" then
		lighting.BlackandWhite1.Enabled = true
		wait(0.2)
		lighting.BlackandWhite1.Enabled = false
	end
	if key == "TimeStopStart" then
		lighting.Main.Enabled = false
		lighting.BlackandWhite.Brightness = 0
		lighting.BlackandWhite.Contrast = 0
		lighting.BlackandWhite.Saturation = 0
		lighting.BlackandWhite.Enabled = true
				
		tw:Create(lighting.BlackandWhite,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Brightness = 0.2, Contrast = 1, Saturation = -1}):Play()
	end
	if key == "TimeStopEnd" then
		tw:Create(lighting.BlackandWhite,TweenInfo.new(0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Brightness = 0, Contrast = 0, Saturation = 0}):Play()
		wait(0.2)
		lighting.Main.Enabled = false
		lighting.BlackandWhite.Enabled = false
	end
	if key == "Dio" then
		local camroot = workspace:WaitForChild(name)
		if camroot then
			cam.CameraType = Enum.CameraType.Scriptable
			for i =1,100  do
				wait(0.0001)
				cam.CFrame = camroot.Torso.CFrame
			end
			cam.CameraType = Enum.CameraType.Custom
		end
	elseif key == "Punch" then
		local camroot = workspace:WaitForChild(name)
		if camroot then
			cam.CameraType = Enum.CameraType.Scriptable
			for i =1,100  do
				wait(0.0001)
				cam.CFrame = camroot.Torso.CFrame
			end
			cam.CameraType = Enum.CameraType.Custom
		end
	end
end)

rep.HitLight.OnClientEvent:Connect(function(types,times)
	if types == "Hited" then
		local HitColor = lighting.HitFolder.HitColor:Clone()
		HitColor.Parent = lighting
		HitColor.Enabled = true
		tw:Create(HitColor,TweenInfo.new(times,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{Brightness = 0, Contrast = 0.3, Saturation = 0}):Play()
		wait(times)
		HitColor:Destroy()
		
	elseif types == "GetHit" then
		
		local HitColor = lighting.HitFolder.GetHitColor:Clone()
		HitColor.Parent = lighting
		HitColor.Enabled = true
		tw:Create(HitColor,TweenInfo.new(times,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{Brightness = 0, Contrast = 0.3, Saturation = 0, TintColor = Color3.new(1, 1, 1)}):Play()
		wait(times)
		HitColor:Destroy()
	end
end)]]></ProtectedString>
