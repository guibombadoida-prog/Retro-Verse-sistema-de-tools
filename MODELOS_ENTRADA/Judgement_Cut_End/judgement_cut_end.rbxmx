			<Item class="ModuleScript" referent="RBX0E54346E47EE4E51B49C688DCC0D96FD">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local module = {}



module.JudgementCutEnd = function(HumanoidRootPart,CT,DMG,tool)
	local ss = game:GetService("ServerStorage")
	local tw = game:GetService("TweenService")
	local rep = game:GetService("ReplicatedStorage")
	local clienteffect = game:GetService("ReplicatedStorage").LookCam
	local stunmodule = require(ss.StunHandlerV2)
	local rock = require(ss.Rock)
	local hitboxray = require(ss["MuchachoHitboxV1.1"])
	if HumanoidRootPart.Parent:FindFirstChild("Humanoid") == nil then return end
	local Animation = HumanoidRootPart.Parent:FindFirstChild("Humanoid"):LoadAnimation(rep.Animation.JMCN)
	
	local function stop(Enamey)
		for i,FHuman in pairs(Enamey:GetDescendants()) do
			if FHuman.Name == "Humanoid" and FHuman ~= HumanoidRootPart then
				local Animator = FHuman:FindFirstChild("Animator")
				if Animator then

					for i,FA in pairs(Animator:GetPlayingAnimationTracks()) do
						
						local BanSkill = Instance.new("StringValue",FHuman.Parent)
						BanSkill.Name = "OnTimeStop"
						FHuman.Parent.HumanoidRootPart.Anchored = true
						FHuman.AutoRotate = false
						
						FA:AdjustSpeed(0)

						print("ST")

						print(FA.Name)

						spawn(function()
							wait(1.9)
							if BanSkill then
								BanSkill:Destroy()
							end
							FHuman.Parent.HumanoidRootPart.Anchored = false
							FHuman.AutoRotate = true
							FA:AdjustSpeed(1)
						end)
					end

				end
			end
		end
	end
	local PlayerS= game:GetService("Players")
	local getcha = PlayerS:playerFromCharacter(HumanoidRootPart.Parent)
	local P
	local Pa
	local Song1 = ss.Song["Judgement Cut End Start"]:Clone()
	local Song2 = ss.Song["Judgement Cut End End"]:Clone()
	local Song3 = ss.Song.ChangeE:Clone()
	Song1.Parent = HumanoidRootPart
	Song2.Parent = HumanoidRootPart
	Song3.Parent = HumanoidRootPart
	Song1.Volume = 5
	Song2.Volume = 5
	HumanoidRootPart.Anchored = true
	Animation:Play()
	Song3:Play()
	local Katana = ss.KatanaV2:Clone()
	local Weld = Instance.new("Motor6D",Katana)
	Katana.Parent = HumanoidRootPart.Parent
	Weld.Part0 = Katana["Meshes/KatanaNewVerions_Cylinder.004"]
	Weld.Part1 = HumanoidRootPart.Parent.LeftHand
	Katana.Blead.VC.Parent = HumanoidRootPart
	--[[spawn(function()
		for i = 1,20 do
			wait(0.01)
			local part = Instance.new("Part")
			part.Transparency = 1
			part.CFrame = HumanoidRootPart.CFrame * CFrame.new(math.random(-15,15),0,math.random(-15,15))
			part.Anchored = true
			part.CanCollide = false
			part.Parent = workspace.Ingores
			local rayparams = RaycastParams.new()
			rayparams.FilterDescendantsInstances = {HumanoidRootPart.Parent,workspace.Ingores}
			local ray = workspace:Raycast(part.Position,part.CFrame.UpVector * -60,rayparams)
			if ray then
				part.Transparency = 0
				part.Anchored = true
				part.CanCollide = false
				part.CastShadow = true
				part.Orientation = Vector3.new(math.random(-180,180),math.random(-180,180),math.random(-180,180))
				part.Position = ray.Position
				part.Color = ray.Instance.Color
				part.Material = ray.Material
				part.Size = Vector3.new(math.random(0.5,1),math.random(0.5,1),math.random(0.5,1))
				part.Parent = workspace.Ingores
				P = tw:Create(part,TweenInfo.new(math.random(3)),{Position = Vector3.new(part.Position.X,math.random(5,10),part.Position.Z)})
				P:Play()
				Pa = part
			end
		end
	end)]]
	local TimesWait = 2.25
	if CT ~= nil then
		TimesWait = CT
	end
	wait(1.5)
	Katana.Handle.Attachment[10]:Emit(10)
	Katana.Handle.Attachment.ParticleEmitter:Emit(2)
	Katana.Handle.TP.Parent = HumanoidRootPart
	HumanoidRootPart.TP:Emit(500)
	game.Debris:AddItem(HumanoidRootPart.TP,3)
	wait(0.1)
	Song1:Play()
	rep.Cam:FireClient(getcha,nil,"TimeStopStart",5)
	local getcha = PlayerS:playerFromCharacter(HumanoidRootPart.Parent)

	if getcha then
		clienteffect:FireClient(getcha,"SpawnPart")
		print(getcha.Name)
	end
	
	HumanoidRootPart.VC:Destroy()
	local ReturnT = false
	local tr = false
	for i,v in pairs(HumanoidRootPart.Parent:GetDescendants()) do
		
		if v.ClassName == "MeshPart" or v.ClassName == "Part" or v.ClassName == "Decal" and v.Name ~= "HumanoidRootPart" then
			v.Transparency = 1
			spawn(function()
				repeat
					wait(0.1)
				until tr == true
				if v.Parent.Name == "KatanaV2" then
					v.Transparency = 1
					game.Debris:AddItem(v,2)
				else
					v.Transparency = 0
				end
				
				HumanoidRootPart.Transparency = 1
			end)
		elseif v.ClassName == "ParticleEmitter" then
			if v.Enabled == true then
				v.Enabled = false
				spawn(function()
					repeat
						wait(0.1)
					until ReturnT == true 
					if v then
						v.Enabled = true
					end
				end)
			end
