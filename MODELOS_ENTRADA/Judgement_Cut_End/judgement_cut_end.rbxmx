			<Item class="Script" referent="RBX9C56B8250D964DE0BC34C5C15B1C3C72">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local tool = script.Parent

local db = false

local skill = require(script.Parent.SkillPack)

local Char = nil

tool.Equipped:Connect(function()
	Char = tool.Parent
end)

tool.Unequipped:Connect(function()
	Char = nil
end)

tool.Activated:Connect(function()
	if db == true then return end
	local HumanoidRootPart = Char:WaitForChild("HumanoidRootPart")
	if HumanoidRootPart then
		db = true
		--skill.JudgementCutEnd(HumanoidRootPart,2.5,100)
		skill.JudgementCutEnd(HumanoidRootPart,2.5,100,tool)
		wait(5)
		db = false
	end
end)
]]></ProtectedString>
