		wait(1.3)
		stp:Destroy()
		if DMG == nil then
		else
			hum:TakeDamage(80)
		end
		
		
		
	end)
	spawn(function()
		wait(0.3)
		hitbox:Stop()
	end)
	

	spawn(function()
		local Wa = false
		for i = 1,30 do
			if getcha then
				game.ReplicatedStorage.Remotes.Camera.BumpRemaked:FireClient(getcha)
			end
			local stp = ss.SlashTimeStop:Clone()
			stp.CFrame = HumanoidRootPart.CFrame * CFrame.new(math.random(-30,30),math.random(0,10),math.random(-30,30))
			stp.Orientation = Vector3.new(math.random(-50,50),math.random(-180,180),math.random(-50,50))
			stp.Parent = workspace.Ingores
			stp.Anchored = true
			stp.CanCollide = false
			stp.CastShadow = true
			
			local part = ss.SlashMir[math.random(1,3)]:Clone()
			part.Transparency = 0.9
			part.Anchored = true
			part.CanCollide = false
			part.CastShadow = true
			part.CFrame = stp.CFrame
			part.Color =Color3.new(1, 1, 1)
			part.Material = Enum.Material.Glass
			part.Size = Vector3.new(math.random(20,40),math.random(1,5),math.random(20,40))
			part.Parent = workspace.Ingores
