				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local module = {}
local tw = game:GetService("TweenService")
local ss = game:GetService("ServerStorage")
module.RockSpawn = function(root,times,Rage)
	local obj = Instance.new("Model",workspace.Ingores);obj.Name = "RockFolder"
	
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {workspace.Ingores}
	
	for i = 0,times do
		local r = math.random(1,6)
		local part = ss.Stone[r]:Clone()
		part.Name = "Rock"
		part.Anchored = true
		part.CanCollide = false
		part.Transparency = 1
		part.Size = Vector3.new(4,math.random(15,25)/10,math.random(15,25)/10)
		part.CFrame = root.CFrame * CFrame.new(0,3,0) * CFrame.Angles(0,math.rad(i * 24), 0) * CFrame.new(0,0,Rage or 24) * CFrame.Angles(math.rad(35),0,0)
		local ray = workspace:Raycast(part.Position,part.CFrame.UpVector * -10, params)
		if ray then
			local obj = ray.Instance
			part.Color = obj.Color
			part.Position = ray.Position
			part.Material = obj.Material
			part.Transparency = 0
		end
		--part.CFrame = root.CFrame * CFrame.new(0,times,0) * CFrame.Angles(0,math.rad(i * 24), 0) * CFrame.new(0,0,-8) * CFrame.Angles(math.rad(35),0,0)
		game.Debris:AddItem(part,10)
		spawn(function()
			wait(1.9)
			tw:Create(part,TweenInfo.new(math.random(1,2),Enum.EasingStyle.Sine,Enum.EasingDirection.In),{Position = part.Position + Vector3.new(0,-5,0)}):Play()
		end)
	end
	return obj
end

module.RocksExp = function(num,pos)
	for i = 1,num do
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Blacklist
		params.FilterDescendantsInstances = {workspace.Ingores,pos.Parent}
		local r = math.random(1,6)
		local part = ss.Stone[r]:Clone()
		part.Parent = workspace.Ingores
		part.Anchored = false
		part.CanCollide = false
		part.Transparency = 1
		part.Size = Vector3.new(math.random(1,2),math.random(1,2),math.random(1,2))
		part.CFrame = pos.CFrame * CFrame.new(0,6,0) * CFrame.Angles(0,math.rad(i * 24), 0) * CFrame.new(0,0,-8) * CFrame.Angles(math.rad(35),0,0)
		part.Transparency = 1
		part.CollisionGroupId = 1
		local ray = workspace:Raycast(part.Position,part.CFrame.UpVector * -10, params)
		local rayleft = workspace:Raycast(part.Position,part.CFrame.RightVector * -10, params)
		local rayright = workspace:Raycast(part.Position,part.CFrame.RightVector * 10, params)
		local rayup = workspace:Raycast(part.Position,part.CFrame.UpVector * 10, params)
		if ray then
			local obj = ray.Instance
			part.Color = obj.Color
			part.Position = ray.Position
			part.Material = obj.Material
			part.Transparency = 0
		end
		
		--part.CFrame = pos.CFrame * CFrame.new(0,0,0)
		
		
		local bv = Instance.new("BodyVelocity",part)
		bv.Velocity = Vector3.new(math.random(-40,40),math.random(10,40),math.random(-40,40))
		bv.MaxForce = Vector3.new(9e9,9e9,9e9)
		spawn(function()
			wait(0.3)
			part.CanCollide = true
		end)


		game.Debris:AddItem(bv,.15)
		--game.Debris:AddItem(bv,5)
		
		game.Debris:AddItem(part,4)
		spawn(function()
			wait(2)
			tw:Create(part,TweenInfo.new(math.random(1,2),Enum.EasingStyle.Sine,Enum.EasingDirection.In),{Size = Vector3.new(0,0,0)}):Play()
		end)
	end
end

module.BigRocksExp = function(num,pos)
	for i = 1,num do
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Blacklist
		params.FilterDescendantsInstances = {workspace.Ingores,pos.Parent}
		local r = math.random(1,6)
		local part = ss.Stone[r]:Clone()
		part.Parent = workspace.Ingores
		part.Anchored = false
		part.CanCollide = false
		part.Transparency = 1
		part.Size = Vector3.new(math.random(0.5,8),math.random(0.5,5),math.random(0.5,8))
		part.CFrame = pos.CFrame * CFrame.new(math.random(-2,2),2,math.random(-2,2)) * CFrame.Angles(0,math.rad(i * 24), 0) * CFrame.new(0,0,-8) * CFrame.Angles(math.rad(35),0,0)
		part.CollisionGroupId = 1
		local ray = workspace:Raycast(part.Position,part.CFrame.UpVector * -10, params)
		local rayleft = workspace:Raycast(part.Position,part.CFrame.RightVector * -10, params)
		local rayright = workspace:Raycast(part.Position,part.CFrame.RightVector * 10, params)
		local rayup = workspace:Raycast(part.Position,part.CFrame.UpVector * 10, params)
		
		if ray then
			local obj = ray.Instance
			part.Color = obj.Color
			part.Position = ray.Position
			part.Material = obj.Material
			part.Transparency = 0
		end

		--part.CFrame = pos.CFrame * CFrame.new(0,0,0)
		--part.Transparency = 1
		local bv = Instance.new("BodyPosition",part)
		bv.Position = pos.Position + Vector3.new(math.random(-30,30),math.random(40,70),math.random(-30,30))
		bv.MaxForce = Vector3.new(9e9,9e9,9e9)
		spawn(function()
			wait(1.5)
			part.CanCollide = true
		end)
		game.Debris:AddItem(bv,math.random(1.5))
		--game.Debris:AddItem(bv,5)

		game.Debris:AddItem(part,4)
		spawn(function()
			wait(math.random(1,2))
			tw:Create(part,TweenInfo.new(math.random(1,2),Enum.EasingStyle.Sine,Enum.EasingDirection.In),{Size = Vector3.new(0,0,0)}):Play()
		end)
	end
end

module.Rocks = function(pos,num,head)
	local cir = 0
	local space = 0.1
	for i = 0,math.pi*2,space do
		local x = pos.X + (cir+math.cos(i))
		local Z = pos.Z + cir+math.sin(i)
		
		local p = Instance.new("Part",workspace.Ingores)
		p.Anchored = true
		p.CanCollide = false
		p.Size = Vector3.new(5,5,5)
		p.CFrame = CFrame.new(Vector3.new(x,pos,Z))
		--local look = p.CFrame:PointToWorldSpace(Vector3.new(0,0,-3)):Lerp(head.Position,.1)
	      --p.CFrame = CFrame.lookAt(p.Position,look,p.CFrame.UpVector)
	end
end


return module
]]></ProtectedString>
