		<Item class="LocalScript" referent="RBXAE27CC23E0264A869A719A75EE7279A7">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--By Rufus14
owner = game:GetService("Players").LocalPlayer
renderstep = game:GetService("RunService").RenderStepped
tool = script.Parent
remote = tool:WaitForChild("kaboom")
handle = tool.Handle
character = owner.Character
mouse = owner:GetMouse()

equipped = false
tool.Equipped:connect(function()
	equipped = true
	owner = game:GetService("Players").LocalPlayer
	character = owner.Character
	if character:findFirstChild("LOICZone") then
		character.LOICZone:destroy()
	end
	local aim = Instance.new("Part", character)
	aim.Shape = "Cylinder"
	aim.CanCollide = false
	aim.Anchored = true
	aim.BrickColor = BrickColor.new("Really red")
	aim.Material = "ForceField"
	aim.Size = Vector3.new(0,0,0)
	aim.Name = "LOICZone"
	coroutine.wrap(function()
		for i = 1,20 do
			if mouse.Target ~= nil then
				if mouse.TargetSurface.Name == "Top" then
					aim.BrickColor = BrickColor.new("Really blue")
					aim.Transparency = 0
				else
					aim.BrickColor = BrickColor.new("Really red")
					aim.Transparency = 0
				end
				if tool:findFirstChild("usingrightnow") then
					aim.BrickColor = BrickColor.new("Really red")
					aim.Transparency = 0
				end
				aim.CFrame = CFrame.new(mouse.Hit.p) * CFrame.fromEulerAnglesXYZ(math.pi/2,math.pi/2,0)
			else
				aim.Transparency = 1
				aim.BrickColor = BrickColor.new("Really red")
			end
			aim.Size = aim.Size + Vector3.new(0,5,5)
			renderstep:wait()
		end
		while renderstep:wait() and equipped do
			if mouse.Target ~= nil then
				if mouse.TargetSurface.Name == "Top" then
					aim.BrickColor = BrickColor.new("Really blue")
					aim.Transparency = 0
				else
					aim.BrickColor = BrickColor.new("Really red")
					aim.Transparency = 0
				end
				if tool:findFirstChild("usingrightnow") then
					aim.BrickColor = BrickColor.new("Really red")
					aim.Transparency = 0
				end
				aim.CFrame = CFrame.new(mouse.Hit.p) * CFrame.fromEulerAnglesXYZ(math.pi/2,math.pi/2,0)
			else
				aim.Transparency = 1
				aim.BrickColor = BrickColor.new("Really red")
			end
		end
		for i = 1,20 do
			aim.Size = aim.Size - Vector3.new(0,5,5)
			aim.Transparency = aim.Transparency + 0.05
			renderstep:wait()
		end
		aim:destroy()
	end)()
end)
tool.Unequipped:connect(function()
	equipped = false
	if character:findFirstChild("LOICZone") then
		game.Debris:AddItem(character.LOICZone,1)
	end
end)

mouse.Button1Down:connect(function()
	if equipped and character:findFirstChild("LOICZone") then
		if character.LOICZone.BrickColor == BrickColor.new("Really blue") then
			if handle:findFirstChild("ClickAccept") then
				handle.ClickAccept:Play()
			end
			local zoneclone = character.LOICZone:Clone()
			character.LOICZone:destroy()
			zoneclone.Parent = character
			for i = 1,20 do
				zoneclone.Size = zoneclone.Size + Vector3.new(0,4,4)
				zoneclone.Transparency = zoneclone.Transparency + 0.05
				renderstep:wait()
			end
			remote:FireServer(zoneclone.CFrame)
			zoneclone:destroy()
		else
			if handle:findFirstChild("ClickDecline") then
				handle.ClickDecline:Play()
			end
		end
	end
end)]]></ProtectedString>
