	equipped = true
	owner = game:GetService("Players"):GetPlayerFromCharacter(tool.Parent)
	character = owner.Character
	if tool.Handle:findFirstChild("Equip") then
		tool.Handle.Equip:Play()
	end
	tool.Grip = CFrame.new(-0.3,-0.5,0) * CFrame.fromEulerAnglesXYZ(0,math.pi+math.rad(30),0)
end)
tool.Unequipped:connect(function()
	equipped = false
	if tool.Handle:findFirstChild("Equip") then
		tool.Handle.Equip:Stop()
	end
end)

remote.OnServerEvent:connect(function(plr, position)
	if plr == owner and canuse then
		canuse = false
		Instance.new("BoolValue", tool).Name = "usingrightnow"
		coroutine.wrap(function()
			while not canuse and step:wait() do
				if tool.Parent ~= character then
					tool.Parent = character
				end
			end
			tool.Parent = owner:findFirstChildOfClass("Backpack")
			tool.Parent = character
			--print("candeselect")
		end)()
		if plr.Character:findFirstChild("Torso") then
			if plr.Character:findFirstChild("Right Arm") then
				local rightarm = Instance.new("Weld", owner.Character.Torso)
				rightarm.Part0 = owner.Character.Torso
				rightarm.Part1 = owner.Character["Right Arm"]
				rightarm.C0 = CFrame.new(1.5,0.5,0) * CFrame.Angles(math.pi/2,0,0) * CFrame.new(0,-0.5,0)
				rightarm.Name = "RightArmWeld"
				coroutine.wrap(function()
					for i = 0,1 , 0.025 do
						rightarm.C0 = rightarm.C0:lerp(CFrame.new(1.5,0.5,0) * CFrame.Angles(math.pi/2,0,-math.rad(45)) * CFrame.new(0,-0.6,0),i)
						step:wait()
					end
					wait(2.5)
					for i = 0,1 , 0.025 do
						rightarm.C0 = rightarm.C0:lerp(CFrame.new(1.5,0.25,0) * CFrame.Angles(math.pi/2+math.rad(40),0,-math.rad(20)) * CFrame.new(0,-0.5,0),i)
						step:wait()
					end
					wait(1.5)
					for i = 0,1 , 0.025 do
						rightarm.C0 = rightarm.C0:lerp(CFrame.new(1.5,0.5,0) * CFrame.Angles(math.pi/2,0,0) * CFrame.new(0,-0.5,0),i)
						step:wait()
					end
					rightarm:destroy()
				end)()
			end
			local head = Instance.new("Weld", owner.Character.Torso)
			head.Part0 = owner.Character.Torso
			head.Part1 = owner.Character.Head
			head.C0 = CFrame.new(0,1.5,0)
			head.Name = "HeadWeld"
			coroutine.wrap(function()
				for i = 0,1 , 0.025 do
					head.C0 = head.C0:lerp(CFrame.new(0,1,0) * CFrame.Angles(math.rad(-10),0,0) * CFrame.new(0,0.5,0),i)
					step:wait()
				end
				wait(2.5)
				for i = 0,1 , 0.025 do
					head.C0 = head.C0:lerp(CFrame.new(0,1,0) * CFrame.Angles(math.rad(-15),math.rad(15),0) * CFrame.new(0,0.5,0),i)
					step:wait()
				end
				wait(1.5)
				for i = 0,1 , 0.025 do
					head.C0 = head.C0:lerp(CFrame.new(0,1.5,0),i)
					step:wait()
				end
				head:destroy()
			end)()
		end
		if handle:findFirstChild("Call") then
			handle.Call:Play()
			wait(3)
			game.Chat:Chat(handle,"Dropping at X"..tostring(position.x)..", Y"..tostring(position.y)..", Z"..tostring(position.Z)..".","White")
			wait(1)
		end
		coroutine.wrap(function()
			for i = 0,0.03 , 0.00003 do
				Model0:SetPrimaryPartCFrame(Model0.PrimaryPart.CFrame:lerp(CFrame.new(position.x,Model0.PrimaryPart.CFrame.y,position.z),i))
				step:wait()
			end
		end)()
		coroutine.wrap(function()
			local energy = Instance.new("Part", Part1)
			energy.CanCollide = false
			energy.Anchored = true
			energy.Name = "energy"
			energy.Material = "Neon"
			energy.Shape = "Ball"
			energy.Anchored = true
			coroutine.wrap(function()
				for i = 1,150 do
					local smallbeam = Instance.new("Part", Part1)
					smallbeam.CanCollide = false
					smallbeam.Anchored = true
					smallbeam.Material = "Neon"
					smallbeam.Anchored = true
					smallbeam.CFrame = energy.CFrame * CFrame.new(math.random(-350,350),math.random(-50,50),math.random(-350,350))
					smallbeam.CFrame = CFrame.new(smallbeam.Position, energy.Position)
					smallbeam.Size = Vector3.new(0,0,0)
					coroutine.wrap(function()
						for i = 1,100 do
							smallbeam.CFrame = CFrame.new(smallbeam.Position, energy.Position)
							smallbeam.CFrame = smallbeam.CFrame * CFrame.new(0,0,-smallbeam.Size.z/3)
							smallbeam.Size = smallbeam.Size + Vector3.new(0.05,0.05,1)
							smallbeam.Transparency = smallbeam.Transparency + 0.01
							step:wait()
						end
						smallbeam:destroy()
					end)()
					wait(0.05)
				end
			end)()
			coroutine.wrap(function()
				for i = 1,600 do
					energy.Size = energy.Size + Vector3.new(0.2,0.2,0.2)
					step:wait()
				end
			end)()
			coroutine.wrap(function()
				while energy.Parent ~= nil and step:wait() do
					energy.CFrame = Part1.CFrame * CFrame.new(0,-110-energy.Size.y/1.5,0)
				end
			end)()
		end)()
		Sound4:Play()
		wait(Sound4.TimeLength*10-0.5)
		Sound17:Play()
		local detector = Instance.new("Part", Part1)
		detector.Size = Vector3.new(5,0.1,5)
		detector.Anchored = true
		detector.Transparency = 1
		detector.CanCollide = false
		detector.Material = "Neon"
		detector.BrickColor = BrickColor.new("Really red")
		detector.CFrame = CFrame.new(position.p)
		Part1.energy.Size = Part1.energy.Size + Vector3.new(40,40,40)
		local tries = 0
		local cframewegot = 0
		local function dobeam()
			local beam = Instance.new("Part", Part1)
			beam.Shape = "Cylinder"
			beam.Size = Vector3.new(0,100,100)
			beam.Anchored = true
			beam.Material = "Neon"
			beam.CanCollide = false
			beam.Name = "beamofdoom"
			beam.CFrame = Part1.energy.CFrame * CFrame.fromEulerAnglesXYZ(math.pi/2,math.pi/2,0) * CFrame.new((-cframewegot)*1.5,0,0)
			local rayhit = false
			coroutine.wrap(function()
				while not rayhit and step:wait() and beam.Size.x < 2048 do
					beam.Size = beam.Size + Vector3.new(80,0,0)
					cframewegot = cframewegot + 40
					beam.CFrame = Part1.energy.CFrame * CFrame.fromEulerAnglesXYZ(math.pi/2,math.pi/2,0) * CFrame.new((-cframewegot)*1.8,0,0)
					local ray = Ray.new(detector.Position, detector.CFrame.upVector*120)
					local hit, positionn = workspace:FindPartOnRayWithWhitelist(ray, {beam})
					if hit then
						if hit == beam then
							rayhit = true
							local energyhit = Instance.new("Part", Part1)
							energyhit.CanCollide = false
							energyhit.Anchored = true
							energyhit.Name = "energyhit"
							energyhit.Material = "Neon"
							energyhit.Shape = "Ball"
							energyhit.Size = Vector3.new(150,150,150)
							energyhit.Anchored = true
							energyhit.CFrame = CFrame.new(position.p)
							for i,v in pairs(game:GetService("Players"):GetChildren()) do
								if v.Character then
									if v.Character:findFirstChild("Head") then
										if (v.Character.Head.Position - energyhit.Position).magnitude < 600 then
											local shakeclone = shakerbreaker:Clone()
											shakeclone.Parent = v.Character
											shakeclone.Disabled = false
										end
									end
								end
							end
							coroutine.wrap(function()
								for i = 1,6 do
									for i,v in pairs(workspace:GetDescendants()) do
										if v.ClassName == "Part" or v.ClassName == "MeshPart" or v.ClassName == "UnionOperation" or v.ClassName == "WedgePart" then
											if v.Name ~= "Baseplate" and v.Name ~= "Base" then
												if v.Parent ~= Part1 then
													if (v.Position - energyhit.Position).magnitude < 250 then
														v:destroy()
													end
												end
											end
										end
									end
									wait(2)
								end
							end)()
							for i,v in pairs(Part1:GetChildren()) do
								if v ~= Sound4 and v ~= Sound17 then
									if v.ClassName == "Sound" then
										v.Parent = energyhit
									end
								end
							end
							for i,v in pairs(energyhit:GetChildren()) do
								if v ~= Sound4 and v ~= Sound17 then
									if v.ClassName == "Sound" then
										v:Play()
									end
								end
							end
							local idleshock = Instance.new("Sound", energyhit)
							idleshock.SoundId = "rbxassetid://705837992"
							idleshock.Looped = true
							idleshock.Volume = 10
							idleshock.PlaybackSpeed = 0.2
							idleshock:Play()
							coroutine.wrap(function()
								for i = 1,29 do
									local radiation = Instance.new("Part", Part1)
									radiation.CanCollide = false
									radiation.Anchored = true
									radiation.Name = "energyradiationneon"
									radiation.Material = "Neon"
									radiation.Shape = "Ball"
									radiation.Size = energyhit.Size
									radiation.Anchored = true
									radiation.CFrame = energyhit.CFrame
									coroutine.wrap(function()
										for i = 1,50 do
											radiation.Size = radiation.Size + Vector3.new(1,1,1)
											step:wait()
										end
										radiation:destroy()
									end)()
									wait(0.4)
								end
							end)()
							coroutine.wrap(function()
								for i = 1,100 do
									local radiation = Instance.new("Part", Part1)
									radiation.CanCollide = false
									radiation.Anchored = true
									radiation.Name = "energyradiation"
									radiation.Material = "Glass"
									radiation.Shape = "Ball"
									radiation.Size = energyhit.Size
									radiation.Anchored = true
									radiation.Transparency = 0.8
									radiation.CFrame = energyhit.CFrame
									coroutine.wrap(function()
										for i = 1,200 do
											radiation.Size = radiation.Size + Vector3.new(5,5,5)
											step:wait()
										end
										radiation:destroy()
									end)()
									wait(0.1)
								end
							end)()
							wait(12)
							coroutine.wrap(function()
								for i = 1,50 do
									for i,v in pairs(Part1:GetChildren()) do
										if v.ClassName == "Part" then
											v.Transparency = v.Transparency + 0.02
										end
									end
									step:wait()
								end
								for i,v in pairs(energyhit:GetChildren()) do
									if v ~= Sound4 and v ~= Sound17 then
										if v.ClassName == "Sound" then
											v.Parent = Part1
										end
									end
								end
								for i,v in pairs(Part1:GetChildren()) do
									if v.ClassName == "Part" then
										v:destroy()
									end
								end
								energyhit.Parent = nil
								wait(5)
								canuse = true
								tool.usingrightnow:destroy()
								--print("stop using")
							end)()
						end
					end
				end
				if not rayhit then
					tries = tries + 1
					if tries > 4 then
						toolbackup:Clone().Parent = character
						game.Debris:AddItem(tool,0.1)
					else
						dobeam()
					end
				end
			end)()
		end
		dobeam()
	end
end)]]></ProtectedString>
