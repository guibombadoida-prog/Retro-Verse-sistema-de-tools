			<Item class="LocalScript" referent="RBX39901E00716A4DDCA3208CEDDAB0ADD6">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--dyskoteka
owner = game:GetService("Players").LocalPlayer
character = owner.Character
renderstep = game:GetService("RunService").RenderStepped
howmuch = 0
while renderstep:wait() do
	workspace.CurrentCamera.CFrame = workspace.CurrentCamera.CFrame * CFrame.Angles(math.random(-1,1)/(30+howmuch),math.random(-1,1)/(30+howmuch),math.random(-1,1)/(30+howmuch))
	howmuch = howmuch + 1
	if howmuch > 800 then
		game.Debris:AddItem(script, 0)
	end
end]]></ProtectedString>
