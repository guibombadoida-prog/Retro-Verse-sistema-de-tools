		<Item class="Script" referent="RBX06343694AA694658A42390BEFBC23408">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScript_Salvador_V4.lua
-- Coloque DENTRO da Tool "Salvador"
-- SUBSTITUI: ServerScript_Salvador_V3.lua
-- REMOVER: ServerScript_Salvador_V3.lua
--
-- CORREÇÕES V4:
--   [ADD] Sistema de animação CFrame via 3 Welds (RightArm, Head, HRP→Torso)
--         IDÊNTICO ao padrão do Escudo Bloqueador V5 e Bumerangue V5.
--         IDLE: mesma pose base dos escudos (corpo virado ~10°, escudo à frente).
--         ACTIVE: braço estendido para cima ~130°, cabeça para cima, corpo inclinado.
--   [ADD] RightGrip C0 configurado (mesmo valor dos outros escudos).
--   [ADD] CleanupAnimationWelds() com ordem correta (threads→welds).
--   [FIX] Sons: agora usa 1 único som "Sacrificio" (dentro do Handle, 4 segundos).
--   [KEEP] Anti-recursão, NPC, task.wait, .Parent = nil.
--
-- REUTILIZA:
--   Sistema de animação CFrame/Weld → Origem: ServerScript_EscudoBloqueador_V5
--   Sistema Anti-Friendly Fire → Origem: ServerScript_EscudoBloqueador_V5

--[[
═══════════════════════════════════════════════════════════════
                    LISTA DE CUSTOMIZAÇÃO
═══════════════════════════════════════════════════════════════
--]]

local CONFIG = {
	-- ========== TRANSFERÊNCIA DE DANO ==========
	Duration       = 7,
	Cooldown       = 10,
	MaxDistance     = 50,

	-- ========== MINI ESCUDO (clone do Handle) ==========
	ShieldScale       = 0.6,
	ShieldFloatHeight = 3,
	ShieldRotSpeed    = 3,

	-- ========== EFEITOS VISUAIS ==========
	BeamColor     = Color3.fromRGB(255, 0, 0),
	ShieldColor   = Color3.fromRGB(255, 50, 50),
	ParticleRate  = 15,
	FlashOnDamage = true,

	-- ========== ANIMAÇÃO ==========
	AnimationLerpSpeed = 0.15,

	-- ========== NPC ==========
	NPCDetectRange  = 40,
	NPCCooldownTime = 12,
}

--[[
═══════════════════════════════════════════════════════════════
  POSES CFRAME — SALVADOR (R6)

  3 Welds: RightArm (Torso→Right Arm), Head (Torso→Head),
           HRP (HumanoidRootPart→Torso)
  Loop: RunService.Stepped com :lerp() entre IDLE e ACTIVE

  IDLE — mesma pose base de todos os escudos:
    Corpo virado ~10° para o lado, escudo à frente.
    (valores exatos copiados do Bloqueador V5 / Bumerangue V5)

  ACTIVE — pose de sacrifício:
    Braço levantado ~130° oferecendo escudo ao aliado.
    Cabeça olhando para cima ~15°.
    Corpo inclinado para frente ~5°.
═══════════════════════════════════════════════════════════════
--]]

local POSE_IDLE_ARM = CFrame.new(
	1.40557981, 0.499999762, -0.579227924,
	0.98480767, 0.173648134, 3.55271368e-15,
	-4.39884928e-08, 2.49471157e-07, -0.999999821,
	-0.173648134, 0.98480767, 2.5331974e-07
)
local POSE_IDLE_HEAD = CFrame.new(
	0, 1.49999976, 0,
	0.173648208, 0, -0.98480767,
	0, 0.999999881, 0,
	0.98480767, 0, 0.173648208
)
local POSE_IDLE_HRP = CFrame.new(
	0, 0, 0,
	0.173648134, 0, 0.98480773,
	0, 0.99999994, 0,
	-0.98480773, 0, 0.173648134
)

local POSE_ACTIVE_ARM = CFrame.new(1.3, 0.8, -0.3)
	* CFrame.Angles(math.rad(130), 0, math.rad(-15))
local POSE_ACTIVE_HEAD = CFrame.new(0, 1.5, 0)
	* CFrame.Angles(math.rad(-15), 0, 0)
local POSE_ACTIVE_HRP = CFrame.new(0, 0, 0)
	* CFrame.Angles(math.rad(5), 0, 0)

--[[
═══════════════════════════════════════════════════════════════
                    CÓDIGO PRINCIPAL
═══════════════════════════════════════════════════════════════
--]]

local Services = {
	Players      = game:GetService("Players"),
	RunService   = game:GetService("RunService"),
	TweenService = game:GetService("TweenService"),
}

local Tool   = script.Parent
local Handle = Tool:WaitForChild("Handle")

-- 1 único som: "Sacrificio" (4 segundos, dentro do Handle)
local sacrificioSound = Handle:WaitForChild("Sacrificio", 10)

local owner, character, humanoid, rootpart
local equipped       = false
local onCooldown     = false
local abilityActive  = false

local ActiveEffects = {
	Parts            = {},
	Sounds           = {},
	Connections      = {},
	Welds            = {},
	AnimationThreads = {},
}
local CleanupConnections = {}

local RemoteEvent = Tool:FindFirstChild("RemoteEvent")
if not RemoteEvent then
	RemoteEvent        = Instance.new("RemoteEvent")
	RemoteEvent.Name   = "RemoteEvent"
	RemoteEvent.Parent = Tool
end

-- ========== SISTEMA ANTI-FRIENDLY FIRE ==========
local function IsAlly(char1, char2)
	if not char1 or not char2 then return false end
	if char1 == char2 then return true end
	local p1 = Services.Players:GetPlayerFromCharacter(char1)
	local p2 = Services.Players:GetPlayerFromCharacter(char2)
	if p1 and p2 then
		if not p1.Neutral and not p2.Neutral then
			return p1.Team == p2.Team
		end
	end
	local cf1 = char1:FindFirstChild("ControlFollow")
	local cf2 = char2:FindFirstChild("ControlFollow")
	if cf1 and cf2 then
		return cf1.Owner.Value == cf2.Owner.Value
	end
	return false
end

-- ========== LIMPEZA (threads PRIMEIRO, welds DEPOIS) ==========
local function CleanupAnimationWelds()
	for _, th in pairs(ActiveEffects.AnimationThreads) do
		if th then task.cancel(th) end
	end
	ActiveEffects.AnimationThreads = {}
	for _, weld in pairs(ActiveEffects.Welds) do
		if weld and weld.Parent then weld.Parent = nil end
	end
	ActiveEffects.Welds = {}
end

local function CleanupAllEffects()
	CleanupAnimationWelds()
	for _, p in pairs(ActiveEffects.Parts) do
		if p and p.Parent then p.Parent = nil end
	end
	ActiveEffects.Parts = {}
	for _, s in pairs(ActiveEffects.Sounds) do
		if s and s.Parent then s:Stop(); s.Parent = nil end
	end
	ActiveEffects.Sounds = {}
	for _, c in pairs(ActiveEffects.Connections) do
		if c then c:Disconnect() end
	end
	ActiveEffects.Connections = {}
	abilityActive = false
end

-- ========== ATIVAR SALVADOR ==========
local function ActivateSalvar(targetCharacter)
	local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	local targetRoot     = targetCharacter:FindFirstChild("HumanoidRootPart")
	local targetHead     = targetCharacter:FindFirstChild("Head")
	if not targetHumanoid or not targetRoot or not targetHead then return end
	if targetHumanoid.Health <= 0 then return end
	if not rootpart or not humanoid then return end
	if not IsAlly(character, targetCharacter) then return end
	if (targetRoot.Position - rootpart.Position).Magnitude > CONFIG.MaxDistance then return end

	abilityActive = true

	if sacrificioSound then sacrificioSound:Play() end

	-- Beam
	local att0 = Instance.new("Attachment")
	att0.Parent = rootpart
	table.insert(ActiveEffects.Parts, att0)
	local att1 = Instance.new("Attachment")
	att1.Parent = targetRoot
	table.insert(ActiveEffects.Parts, att1)
	local beam       = Instance.new("Beam")
	beam.Attachment0 = att0
	beam.Attachment1 = att1
	beam.Color       = ColorSequence.new(CONFIG.BeamColor)
	beam.Width0      = 0.5
	beam.Width1      = 0.5
	beam.FaceCamera  = true
	beam.Texture     = "rbxasset://textures/particles/smoke_main.dds"
	beam.Parent      = rootpart
	table.insert(ActiveEffects.Parts, beam)

	-- Mini escudo flutuante
	local miniShield = Handle:Clone()
	miniShield.Name  = "SalvadorShield"
	miniShield.CanCollide   = false
	miniShield.CanTouch     = false
	miniShield.Anchored     = true
	miniShield.Material     = Enum.Material.Neon
	miniShield.Color        = CONFIG.ShieldColor
	miniShield.Transparency = 0.3
	miniShield.Size         = Handle.Size * CONFIG.ShieldScale
	miniShield.Parent       = workspace
	table.insert(ActiveEffects.Parts, miniShield)
	for _, child in pairs(miniShield:GetChildren()) do
		if child:IsA("Sound") or child:IsA("Script") or child:IsA("LocalScript") then
			child.Parent = nil
		end
	end
	local particles    = Instance.new("ParticleEmitter")
	particles.Texture  = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Rate     = CONFIG.ParticleRate
	particles.Lifetime = NumberRange.new(1)
	particles.Speed    = NumberRange.new(2)
	particles.Color    = ColorSequence.new(CONFIG.BeamColor)
	particles.Size     = NumberSequence.new(0.3)
	particles.Parent   = miniShield
	local light      = Instance.new("PointLight")
	light.Brightness = 1
	light.Color      = CONFIG.BeamColor
	light.Range      = 8
	light.Parent     = miniShield

	-- Glow no usuário
	local userGlow         = Instance.new("Part")
	userGlow.Name          = "SalvarGlow"
	userGlow.Shape         = Enum.PartType.Ball
	userGlow.Size          = Vector3.new(3, 3, 3)
	userGlow.Material      = Enum.Material.Neon
	userGlow.Color         = CONFIG.BeamColor
	userGlow.Transparency  = 0.5
	userGlow.CanCollide    = false
	userGlow.CanTouch      = false
	userGlow.Anchored      = true
	userGlow.Parent        = workspace
	table.insert(ActiveEffects.Parts, userGlow)

	-- Transferência de dano
	local isTransferring = false
	local damageConn
	damageConn = targetHumanoid.HealthChanged:Connect(function(newHealth)
		if isTransferring then return end
		if not humanoid or humanoid.Health <= 0 then
			if damageConn then damageConn:Disconnect() end
			return
		end
		local oldHealth   = targetHumanoid.Health
		local damageTaken = oldHealth - newHealth
		if damageTaken > 0 then
			isTransferring = true
			targetHumanoid.Health = oldHealth
			humanoid:TakeDamage(damageTaken)
			if CONFIG.FlashOnDamage and userGlow and userGlow.Parent then
				Services.TweenService:Create(userGlow,
					TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{Transparency = 0.2}):Play()
				task.delay(0.15, function()
					if userGlow and userGlow.Parent then
						Services.TweenService:Create(userGlow,
							TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
							{Transparency = 0.5}):Play()
					end
				end)
			end
			task.wait()
			isTransferring = false
		end
	end)
	table.insert(ActiveEffects.Connections, damageConn)

	-- Seguimento do mini escudo
	local followThread = task.spawn(function()
		local rotation = 0
		while miniShield and miniShield.Parent and rootpart and rootpart.Parent and targetHead and targetHead.Parent do
			local floatPos = targetHead.Position + Vector3.new(0, CONFIG.ShieldFloatHeight, 0)
			miniShield.CFrame = CFrame.new(floatPos) * CFrame.Angles(0, math.rad(rotation), 0)
			rotation = rotation + CONFIG.ShieldRotSpeed
			if rotation >= 360 then rotation = 0 end
			if userGlow and userGlow.Parent then
				userGlow.CFrame = rootpart.CFrame
			end
			if (targetRoot.Position - rootpart.Position).Magnitude > CONFIG.MaxDistance then break end
			Services.RunService.Heartbeat:Wait()
		end
		if damageConn then damageConn:Disconnect() end
		if beam and beam.Parent then beam.Parent = nil end
		if miniShield and miniShield.Parent then miniShield.Parent = nil end
		if userGlow and userGlow.Parent then userGlow.Parent = nil end
		if att0 and att0.Parent then att0.Parent = nil end
		if att1 and att1.Parent then att1.Parent = nil end
		abilityActive = false
	end)

	-- Timer
	task.delay(CONFIG.Duration, function()
		abilityActive = false
		if damageConn then damageConn:Disconnect() end
		if sacrificioSound then sacrificioSound:Stop() end
		if miniShield and miniShield.Parent then
			Services.TweenService:Create(miniShield,
				TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Transparency = 1}):Play()
			task.delay(0.5, function()
				if miniShield and miniShield.Parent then miniShield.Parent = nil end
			end)
		end
		if beam and beam.Parent then beam.Parent = nil end
		if userGlow and userGlow.Parent then userGlow.Parent = nil end
		if att0 and att0.Parent then att0.Parent = nil end
		if att1 and att1.Parent then att1.Parent = nil end
	end)
end

-- ========== REMOTEEVENT ==========
RemoteEvent.OnServerEvent:Connect(function(player, action, targetModel)
	if player ~= owner or not equipped then return end
	if action == "protect" then
		if onCooldown then return end
		if not targetModel or not targetModel:FindFirstChildOfClass("Humanoid") then return end
		onCooldown = true
		ActivateSalvar(targetModel)
		task.wait(CONFIG.Cooldown)
		onCooldown = false
	end
end)

-- ========== NPC ==========
local NPCCooldown = false
task.spawn(function()
	while task.wait(1) do
		if equipped and not owner and not NPCCooldown then
			if rootpart and rootpart.Parent then
				local bestAlly, lowestHP = nil, 1
				for _, model in pairs(workspace:GetChildren()) do
					if model:IsA("Model") and model ~= character then
						local ah = model:FindFirstChildOfClass("Humanoid")
						local ar = model:FindFirstChild("HumanoidRootPart")
						if ah and ar and ah.Health > 0 and IsAlly(character, model) then
							local d = (ar.Position - rootpart.Position).Magnitude
							local hp = ah.Health / ah.MaxHealth
							if d < CONFIG.NPCDetectRange and hp < lowestHP then
								bestAlly = model; lowestHP = hp
							end
						end
					end
				end
				if bestAlly and lowestHP < 0.7 then
					NPCCooldown = true
					ActivateSalvar(bestAlly)
					task.wait(CONFIG.NPCCooldownTime)
					NPCCooldown = false
				end
			end
		end
	end
end)

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped  = true
	owner     = Services.Players:GetPlayerFromCharacter(Tool.Parent)
	character = Tool.Parent
	humanoid  = character:FindFirstChildOfClass("Humanoid")
	rootpart  = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootpart then return end
	onCooldown = false; abilityActive = false
	CleanupAllEffects()

	-- RightGrip C0 (padrão de todos os escudos)
	local rightArm = character:FindFirstChild("Right Arm")
	if rightArm then
		local rg = rightArm:FindFirstChild("RightGrip")
		if rg then
			rg.C0 = CFrame.new(
				0.409522653, -0.000911712646, 0.516324997,
				-0.0116359973, -0.0435790196, -0.998981893,
				0.999929667,  0.00166221452, -0.0117195444,
				0.0021712482, -0.999047935,   0.0435565971)
		end
	end

	-- 3 Welds de animação (padrão dos escudos)
	local torso = character:FindFirstChild("Torso")
	if torso and rightArm then
		local rightarmWeld = Instance.new("Weld")
		rightarmWeld.Part0 = torso; rightarmWeld.Part1 = rightArm
		rightarmWeld.C0 = CFrame.new(1.5, 0, 0)
		rightarmWeld.Name = "RightArmWeldsalvador"
		rightarmWeld.Parent = torso
		table.insert(ActiveEffects.Welds, rightarmWeld)

		local headPart = character:FindFirstChild("Head")
		if headPart then
			local headWeld = Instance.new("Weld")
			headWeld.Part0 = torso; headWeld.Part1 = headPart
			headWeld.C0 = CFrame.new(0, 1.5, 0)
			headWeld.Name = "HeadWeldsalvador"
			headWeld.Parent = torso
			table.insert(ActiveEffects.Welds, headWeld)

			local hrpWeld = Instance.new("Weld")
			hrpWeld.Part0 = rootpart; hrpWeld.Part1 = torso
			hrpWeld.C0 = CFrame.new()
			hrpWeld.Name = "HRPWeldsalvador"
			hrpWeld.Parent = rootpart
			table.insert(ActiveEffects.Welds, hrpWeld)

			-- Loop de animação (RunService.Stepped — conforme regras CFrame)
			local animThread = task.spawn(function()
				while equipped do
					Services.RunService.Stepped:Wait()
					if not rightarmWeld or not rightarmWeld.Parent then break end
					if abilityActive then
						rightarmWeld.C0 = rightarmWeld.C0:lerp(POSE_ACTIVE_ARM, CONFIG.AnimationLerpSpeed)
						headWeld.C0     = headWeld.C0:lerp(POSE_ACTIVE_HEAD, CONFIG.AnimationLerpSpeed)
						hrpWeld.C0      = hrpWeld.C0:lerp(POSE_ACTIVE_HRP, CONFIG.AnimationLerpSpeed)
					else
						rightarmWeld.C0 = rightarmWeld.C0:lerp(POSE_IDLE_ARM, CONFIG.AnimationLerpSpeed)
						headWeld.C0     = headWeld.C0:lerp(POSE_IDLE_HEAD, CONFIG.AnimationLerpSpeed)
						hrpWeld.C0      = hrpWeld.C0:lerp(POSE_IDLE_HRP, CONFIG.AnimationLerpSpeed)
					end
				end
			end)
			table.insert(ActiveEffects.AnimationThreads, animThread)
		end
	end

	if humanoid then
		CleanupConnections.Died = humanoid.Died:Connect(function() CleanupAllEffects() end)
	end
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped = false; onCooldown = false; abilityActive = false
	if sacrificioSound then sacrificioSound:Stop() end
	CleanupAllEffects()
	for _, conn in pairs(CleanupConnections) do if conn then conn:Disconnect() end end
	CleanupConnections = {}
end)

Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		if sacrificioSound then sacrificioSound:Stop() end
		CleanupAllEffects()
		for _, conn in pairs(CleanupConnections) do if conn then conn:Disconnect() end end
		CleanupConnections = {}
	end
end)]]></ProtectedString>
