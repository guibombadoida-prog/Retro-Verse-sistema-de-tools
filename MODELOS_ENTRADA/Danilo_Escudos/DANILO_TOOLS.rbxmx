			<Properties>
				<ProtectedString name="Source"><![CDATA[-- LocalScript_EscudoBumerangue_V4.lua
-- Coloque DENTRO da Tool "Escudo Bumerangue"
-- SUBSTITUI: LocalScript_Escudo_Bumerangue_V3.lua
-- REMOVER: LocalScript_Escudo_Bumerangue_V3.lua
--
-- CORREÇÕES V4:
--   [FIX] wait() → task.wait() em todo o script.
--   [FIX] coroutine.wrap → task.spawn.
--   [FIX] GUI :Destroy() → .Parent = nil (PROIBIDO).
--   [FIX] Configurações obrigatórias adicionadas.

local Tool        = script.Parent
local Player      = game.Players.LocalPlayer
local Mouse       = Player:GetMouse()
local RemoteEvent = Tool:WaitForChild("RemoteEvent")

-- Configurações obrigatórias
Tool.CanBeDropped   = false
Tool.RequiresHandle = true

-- Variáveis de controle
local equipped      = false
local isHolding     = false
local holdStartTime = 0
local lastClickTime = 0
local clickCount    = 0

-- Conexões
local mouseDownConn
local mouseUpConn

-- Configurações
local DOUBLE_CLICK_TIME = 0.3
local CHARGE_TIME       = 2

-- ========== GUI DE FEEDBACK ==========
local function CreateFeedbackGUI()
	local old = Player.PlayerGui:FindFirstChild("BoomerangFeedback")
	if old then old.Parent = nil end

	local screenGui        = Instance.new("ScreenGui")
	screenGui.Name         = "BoomerangFeedback"
	screenGui.ResetOnSpawn = false
	screenGui.Parent       = Player.PlayerGui

	local chargeFrame              = Instance.new("Frame")
	chargeFrame.Name               = "ChargeBar"
	chargeFrame.Size               = UDim2.new(0.15, 0, 0.02, 0)
	chargeFrame.Position           = UDim2.new(0.425, 0, 0.55, 0)
	chargeFrame.BackgroundColor3   = Color3.new(0.2, 0.2, 0.2)
	chargeFrame.BorderSizePixel    = 2
	chargeFrame.Visible            = false
	chargeFrame.Parent             = screenGui

	local chargeFill            = Instance.new("Frame")
	chargeFill.Name             = "Fill"
	chargeFill.Size             = UDim2.new(0, 0, 1, 0)
	chargeFill.BackgroundColor3 = Color3.new(1, 0.5, 0)
	chargeFill.BorderSizePixel  = 0
	chargeFill.Parent           = chargeFrame

	local modeText                  = Instance.new("TextLabel")
	modeText.Name                   = "ModeText"
	modeText.Size                   = UDim2.new(0.2, 0, 0.05, 0)
	modeText.Position               = UDim2.new(0.4, 0, 0.52, 0)
	modeText.BackgroundTransparency = 1
	modeText.Text                   = ""
	modeText.TextColor3             = Color3.new(1, 1, 1)
	modeText.TextScaled             = true
	modeText.Font                   = Enum.Font.GothamBold
	modeText.TextStrokeTransparency = 0
	modeText.Visible                = false
	modeText.Parent                 = screenGui

	return screenGui
end

-- ========== ATUALIZAR BARRA ==========
local function UpdateChargeBar(progress)
	local gui = Player.PlayerGui:FindFirstChild("BoomerangFeedback")
	if not gui then return end

	local bar = gui:FindFirstChild("ChargeBar")
	if not bar then return end

	bar.Visible = true
	local fill = bar:FindFirstChild("Fill")
	if fill then
		fill.Size = UDim2.new(progress, 0, 1, 0)
		if progress < 0.5 then
			fill.BackgroundColor3 = Color3.new(1, 1, 0)
		elseif progress < 1 then
			fill.BackgroundColor3 = Color3.new(1, 0.5, 0)
		else
			fill.BackgroundColor3 = Color3.new(1, 0, 0)
		end
	end
end

-- ========== MOSTRAR TEXTO ==========
local function ShowModeText(text, color)
	local gui = Player.PlayerGui:FindFirstChild("BoomerangFeedback")
	if not gui then return end

	local label = gui:FindFirstChild("ModeText")
	if label then
		label.Text       = text
		label.TextColor3 = color
		label.Visible    = true

		task.spawn(function()
			task.wait(1)
			if label and label.Parent then
				label.Visible = false
			end
		end)
	end
end

-- ========== ESCONDER BARRA ==========
local function HideChargeBar()
	local gui = Player.PlayerGui:FindFirstChild("BoomerangFeedback")
	if not gui then return end
	local bar = gui:FindFirstChild("ChargeBar")
	if bar then bar.Visible = false end
end

-- ========== DETECTAR CLIQUE DUPLO ==========
local function ProcessClick()
	local now = tick()

	if now - lastClickTime < DOUBLE_CLICK_TIME then
		clickCount = clickCount + 1
	else
		clickCount = 1
	end
	lastClickTime = now

	if clickCount >= 2 then
		RemoteEvent:FireServer("throwMulti", Mouse.Hit.Position)
		ShowModeText("MULTI-LANCAMENTO!", Color3.new(0, 1, 1))
		clickCount = 0
		return true
	end

	return false
end

-- ========== MOUSE DOWN ==========
local function OnMouseDown()
	if not equipped then return end

	isHolding     = true
	holdStartTime = tick()

	task.spawn(function()
		while isHolding and equipped do
			local elapsed  = tick() - holdStartTime
			local progress = math.min(elapsed / CHARGE_TIME, 1)
			UpdateChargeBar(progress)
			task.wait(0.03)
		end
		HideChargeBar()
	end)
end

-- ========== MOUSE UP ==========
local function OnMouseUp()
	if not equipped or not isHolding then return end

	local holdDuration = tick() - holdStartTime
	isHolding = false
	HideChargeBar()

	if holdDuration < 0.2 then
		if not ProcessClick() then
			task.wait(DOUBLE_CLICK_TIME)
			if clickCount == 1 then
				RemoteEvent:FireServer("throw", Mouse.Hit.Position)
				ShowModeText("LANCAMENTO NORMAL", Color3.new(0, 0.7, 1))
				clickCount = 0
			end
		end
	else
		if holdDuration >= CHARGE_TIME then
			RemoteEvent:FireServer("throwCharged", Mouse.Hit.Position)
			ShowModeText("LANCAMENTO CARREGADO!", Color3.new(1, 0.5, 0))
		else
			RemoteEvent:FireServer("throw", Mouse.Hit.Position)
			ShowModeText("LANCAMENTO NORMAL", Color3.new(0, 0.7, 1))
		end
		clickCount = 0
	end
end

-- ========== LIMPEZA ==========
local function CleanupConnections()
	if mouseDownConn then mouseDownConn:Disconnect(); mouseDownConn = nil end
	if mouseUpConn then mouseUpConn:Disconnect(); mouseUpConn = nil end
end

local function CleanupGUI()
	local gui = Player.PlayerGui:FindFirstChild("BoomerangFeedback")
	if gui then gui.Parent = nil end
end

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped   = true
	clickCount = 0
	isHolding  = false

	CreateFeedbackGUI()
	mouseDownConn = Mouse.Button1Down:Connect(OnMouseDown)
	mouseUpConn   = Mouse.Button1Up:Connect(OnMouseUp)
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped   = false
	isHolding  = false
	clickCount = 0
	CleanupConnections()
	CleanupGUI()
end)

-- ========== LIMPEZA AO REMOVER TOOL ==========
Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		CleanupConnections()
		CleanupGUI()
	end
end)]]></ProtectedString>
