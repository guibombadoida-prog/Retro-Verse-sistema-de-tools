			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScript_EscudoBloqueador_V5.lua
-- Coloque DENTRO da Tool "Escudo Bloqueador"
-- SUBSTITUI: ServerScript_Escudo_Bloqueador_V4.lua
-- REMOVER: ServerScript_Escudo_Bloqueador_V4.lua
--
-- CORREÇÕES V5:
--   [FIX] HealthChanged recursão infinita: modificar Health dentro do callback
--         causava re-trigger. Adicionado flag isProcessingDamage para evitar.
--   [FIX] workspace:GetDescendants() substituído por workspace:GetChildren()
--         em loops frequentes (CPU intensivo).
--   [FIX] wait() → task.wait() em todo o script.
--   [FIX] coroutine.wrap → task.spawn.
--   [FIX] debris:AddItem em BodyVelocity → task.delay + .Parent = nil.
--   [ADD] Sistema de NPC completo para uso por NPCs.
--   [ADD] Timeout no WaitForChild com fallback.
--   [KEEP] Sistema de animação via Welds (V4 fix mantido).
--   [KEEP] Som sequencial cíclico (sem math.random — PROIBIDO).
--   [KEEP] .Parent = nil em vez de :Destroy() (PROIBIDO).

--[[
═══════════════════════════════════════════════════════════════
                    LISTA DE CUSTOMIZAÇÃO
═══════════════════════════════════════════════════════════════
--]]

local CONFIG = {
	-- ========== BLOQUEIO PASSIVO ==========
	PlayerDamageReduction    = 0.25,   -- 25% redução de dano ao portador
	EnemyDamageReflection    = 0.15,   -- 15% reflexão de dano ao atacante
	AllyDefenseBonus         = 0.15,   -- 15% redução para aliados próximos
	AllyHealPerBlock         = 3,      -- Cura fixa por bloqueio em aliados
	AllyDefenseRange         = 10,     -- Alcance da defesa aliada

	-- ========== PROTEÇÃO ATIVA (Habilidade Extra - Botão Q) ==========
	ProtectionRange            = 15,
	ProtectionCooldown         = 8,
	ProtectionDamageReflection = 0.52,
	ProtectionKnockbackPower   = 90,
	TeleportStage1Duration     = 0.3,
	TeleportStage2Duration     = 0.5,
	PunchAnimationDuration     = 0.8,

	-- ========== EFEITOS VISUAIS ==========
	BlockEffectColor        = Color3.new(0, 0.7, 1),
	ReflectEffectColor      = Color3.new(1, 0, 0),
	ProtectionEffectColor   = Color3.new(0, 1, 0),
	PunchEffectColor        = Color3.new(1, 0.5, 0),
	BlockEffectSize         = 5,
	BlockEffectTransparency = 0.7,

	-- ========== SONS ==========
	BlockSoundPitch      = 1.0,
	ReflectSoundPitch    = 1.3,
	ProtectionSoundPitch = 0.8,
	PunchSoundPitch      = 1.5,

	-- ========== ANIMAÇÃO ==========
	AnimationLerpSpeed   = 0.2,

	-- ========== NPC ==========
	NPCDetectRange = 50,
	NPCCooldownTime = 8,
}

--[[
═══════════════════════════════════════════════════════════════
                    CÓDIGO PRINCIPAL
═══════════════════════════════════════════════════════════════
--]]

-- ========== SERVIÇOS ==========
local Services = {
	Players    = game:GetService("Players"),
	RunService = game:GetService("RunService"),
	TweenService = game:GetService("TweenService"),
}

-- ========== VARIÁVEIS GLOBAIS ==========
local Tool   = script.Parent
local Handle = Tool:WaitForChild("Handle")

local equipsound  = Handle:WaitForChild("equip", 10)
local blocksounds = {
	Handle:WaitForChild("block", 10),
	Handle:WaitForChild("block2", 10),
	Handle:WaitForChild("block3", 10),
	Handle:WaitForChild("block4", 10),
}

local owner, character, charhum, rootpart
local equipped         = false
local protectionActive = false
local protectionCooldown = false
local isProcessingDamage = false  -- [FIX V5] Flag anti-recursão

-- [KEEP V4] Índice sequencial de som (sem math.random — PROIBIDO)
local soundIndex = 1

-- ========== TABELAS DE EFEITOS ATIVOS ==========
local ActiveEffects = {
	Parts            = {},
	Sounds           = {},
	Connections      = {},
	Welds            = {},
	AnimationThreads = {},
}
local CleanupConnections = {}
local protectedAllies = {}

-- ========== REMOTEEVENT ==========
local remoteEvent = Tool:FindFirstChild("RemoteEvent")
if not remoteEvent then
	remoteEvent        = Instance.new("RemoteEvent")
	remoteEvent.Name   = "RemoteEvent"
	remoteEvent.Parent = Tool
end

-- ========== SISTEMA ANTI-FRIENDLY FIRE ==========
local function IsAlly(char1, char2)
	if not char1 or not char2 then return false end
	if char1 == char2 then return true end

	local p1 = Services.Players:GetPlayerFromCharacter(char1)
	local p2 = Services.Players:GetPlayerFromCharacter(char2)

	if p1 and p2 then
		if not p1.Neutral and not p2.Neutral then
			return p1.Team == p2.Team
		end
	end

	-- NPC ally check
	local cf1 = char1:FindFirstChild("ControlFollow")
	local cf2 = char2:FindFirstChild("ControlFollow")
	if cf1 and cf2 then
		return cf1.Owner.Value == cf2.Owner.Value
	end

	return false
end

-- ========== SOM SEQUENCIAL ==========
local function PlayBlockSound()
	local snd = blocksounds[soundIndex]
	if snd and snd.Parent then
		snd.Pitch = CONFIG.BlockSoundPitch
		snd:Play()
	end
	soundIndex = (soundIndex % #blocksounds) + 1
end

-- ========== SISTEMA DE LIMPEZA ==========
local function CleanupAnimationWelds()
	-- 1. Cancelar threads PRIMEIRO
	for _, th in pairs(ActiveEffects.AnimationThreads) do
		if th then task.cancel(th) end
	end
	ActiveEffects.AnimationThreads = {}

	-- 2. Remover Welds DEPOIS (Motor6D assume controle)
	for _, weld in pairs(ActiveEffects.Welds) do
		if weld and weld.Parent then weld.Parent = nil end
	end
	ActiveEffects.Welds = {}
end

local function CleanupAllEffects()
	CleanupAnimationWelds()

	for _, p in pairs(ActiveEffects.Parts) do
		if p and p.Parent then p.Parent = nil end
	end
	ActiveEffects.Parts = {}

	for _, s in pairs(ActiveEffects.Sounds) do
		if s and s.Parent then s:Stop(); s.Parent = nil end
	end
	ActiveEffects.Sounds = {}

	for _, c in pairs(ActiveEffects.Connections) do
		if c then c:Disconnect() end
	end
	ActiveEffects.Connections = {}

	protectionActive = false
	protectedAllies  = {}
	isProcessingDamage = false
end

-- ========== EFEITO VISUAL DE BLOQUEIO ==========
local function CreateBlockEffect(position, effectColor)
	local fx        = Instance.new("Part")
	fx.Name         = "BlockEffect"
	fx.Size         = Vector3.new(CONFIG.BlockEffectSize, CONFIG.BlockEffectSize, 0.5)
	fx.Material     = Enum.Material.Neon
	fx.Color        = effectColor
	fx.Transparency = CONFIG.BlockEffectTransparency
	fx.CanCollide   = false
	fx.CanTouch     = false
	fx.Anchored     = true
	fx.CFrame       = CFrame.new(position) * CFrame.new(0, 0, -2)
	fx.Parent       = workspace
	table.insert(ActiveEffects.Parts, fx)

	task.spawn(function()
		for i = 0, 10 do
			if not fx or not fx.Parent then break end
			fx.Transparency = CONFIG.BlockEffectTransparency + (i * 0.03)
			fx.Size = fx.Size + Vector3.new(0.5, 0.5, 0)
			task.wait(0.03)
		end
		if fx and fx.Parent then fx.Parent = nil end
	end)
end

-- ========== EFEITO VISUAL DE REFLEXÃO ==========
local function CreateReflectionEffect(position, direction)
	local fx        = Instance.new("Part")
	fx.Name         = "ReflectEffect"
	fx.Size         = Vector3.new(2, 2, 4)
	fx.Material     = Enum.Material.Neon
	fx.Color        = CONFIG.ReflectEffectColor
	fx.Transparency = 0.5
	fx.CanCollide   = false
	fx.CanTouch     = false
	fx.Anchored     = true
	fx.CFrame       = CFrame.new(position, position + direction)
	fx.Parent       = workspace
	table.insert(ActiveEffects.Parts, fx)

	local particles     = Instance.new("ParticleEmitter")
	particles.Texture   = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Rate      = 50
	particles.Lifetime  = NumberRange.new(0.5)
	particles.Speed     = NumberRange.new(10)
	particles.Color     = ColorSequence.new(CONFIG.ReflectEffectColor)
	particles.Size      = NumberSequence.new(0.5)
	particles.Parent    = fx
	particles:Emit(20)

	task.spawn(function()
		for i = 0, 10 do
			if not fx or not fx.Parent then break end
			fx.Transparency = 0.5 + (i * 0.05)
			fx.Size = fx.Size + Vector3.new(0.3, 0.3, 0.6)
			task.wait(0.03)
		end
		if fx and fx.Parent then fx.Parent = nil end
	end)
end

-- ========== EFEITO ESFERA EXPANSIVA ==========
local function CreateSphereEffect(pos, color, startSize, growRate, duration)
	local fx        = Instance.new("Part")
	fx.Name         = "SphereEffect"
	fx.Size         = Vector3.new(startSize, startSize, startSize)
	fx.Material     = Enum.Material.Neon
	fx.Color        = color
	fx.Transparency = 0.3
	fx.CanCollide   = false
	fx.CanTouch     = false
	fx.Anchored     = true
	fx.Shape        = Enum.PartType.Ball
	fx.CFrame       = CFrame.new(pos)
	fx.Parent       = workspace
	table.insert(ActiveEffects.Parts, fx)

	task.spawn(function()
		local steps = math.floor(duration / 0.03)
		for i = 0, steps do
			if not fx or not fx.Parent then break end
			local t = i / steps
			fx.Transparency = 0.3 + (t * 0.7)
			fx.Size = fx.Size + Vector3.new(growRate, growRate, growRate)
			task.wait(0.03)
		end
		if fx and fx.Parent then fx.Parent = nil end
	end)
end

-- ========== ENCONTRAR ATACANTE MAIS PRÓXIMO ==========
-- [FIX V5] Usa workspace:GetChildren() em vez de GetDescendants()
local function FindNearestAttacker()
	local closestDist = 10
	local attacker    = nil

	for _, v in pairs(workspace:GetChildren()) do
		if v:IsA("Model") and v ~= character then
			local head = v:FindFirstChild("Head")
			if head then
				local dist = (head.Position - Handle.Position).Magnitude
				if dist < closestDist and not IsAlly(character, v) then
					local hum = v:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						closestDist = dist
						attacker    = v
					end
				end
			end
		end
	end

	return attacker
end

-- ========== DEFESA DE ALIADOS PRÓXIMOS ==========
local function ApplyAllyDefense()
	if not rootpart then return end

	for _, v in pairs(workspace:GetChildren()) do
		if v:IsA("Model") and v ~= character then
			local allyHum  = v:FindFirstChildOfClass("Humanoid")
			local allyRoot = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")

			if allyHum and allyRoot and allyHum.Health > 0 then
				local dist = (allyRoot.Position - rootpart.Position).Magnitude

				if dist <= CONFIG.AllyDefenseRange and IsAlly(character, v) and not v:FindFirstChild("ShieldDefenseActive") then
					local tag    = Instance.new("BoolValue")
					tag.Name     = "ShieldDefenseActive"
					tag.Parent   = v
					table.insert(ActiveEffects.Parts, tag)

					local lastHP = allyHum.Health
					local allyProcessing = false

					local conn = allyHum.HealthChanged:Connect(function(hp)
						if allyProcessing then return end
						if hp < lastHP then
							allyProcessing = true

							local damage        = lastHP - hp
							local reducedDamage  = damage * CONFIG.AllyDefenseBonus
							allyHum.Health       = math.min(allyHum.MaxHealth, hp + reducedDamage)
							allyHum.Health       = math.min(allyHum.MaxHealth, allyHum.Health + CONFIG.AllyHealPerBlock)

							CreateSphereEffect(allyRoot.Position, CONFIG.BlockEffectColor, 3, 0.3, 0.5)

							task.wait()
							allyProcessing = false
						end
						lastHP = allyHum.Health
					end)
					table.insert(ActiveEffects.Connections, conn)
				end
			end
		end
	end
end

-- ========== PROTEÇÃO ATIVA (HABILIDADE EXTRA) ==========
local function ActivateAllyProtection(ally, attacker, damageAmount)
	if protectionCooldown then return end
	protectionCooldown = true
	protectionActive   = true

	local activateSound = blocksounds[1]:Clone()
	activateSound.Parent = rootpart
	activateSound.Pitch  = CONFIG.ProtectionSoundPitch
	activateSound:Play()
	table.insert(ActiveEffects.Sounds, activateSound)

	local allyRoot = ally:FindFirstChild("HumanoidRootPart") or ally:FindFirstChild("Torso")
	if not allyRoot then
		protectionCooldown = false
		protectionActive   = false
		return
	end

	-- Efeito de saída
	CreateSphereEffect(rootpart.Position, CONFIG.ProtectionEffectColor, 4, 0.5, 0.3)

	-- Teleportar para o aliado
	rootpart.CFrame = allyRoot.CFrame * CFrame.new(0, 0, -3)

	-- Efeito de chegada
	CreateSphereEffect(rootpart.Position, CONFIG.ProtectionEffectColor, 1, 0.8, 0.3)

	task.wait(CONFIG.TeleportStage1Duration)

	-- Teleportar para o atacante
	local attackerRoot = attacker:FindFirstChild("HumanoidRootPart") or attacker:FindFirstChild("Torso")
	if not attackerRoot then
		protectionCooldown = false
		protectionActive   = false
		return
	end

	CreateSphereEffect(rootpart.Position, CONFIG.PunchEffectColor, 4, 0.5, 0.3)

	rootpart.CFrame = attackerRoot.CFrame * CFrame.new(0, 0, -3)
	rootpart.CFrame = CFrame.new(
		rootpart.Position,
		Vector3.new(attackerRoot.Position.X, rootpart.Position.Y, attackerRoot.Position.Z)
	)

	task.wait(CONFIG.TeleportStage2Duration)

	-- Soco no atacante
	local punchSound = blocksounds[3]:Clone()
	punchSound.Parent = attackerRoot
	punchSound.Pitch  = CONFIG.PunchSoundPitch
	punchSound:Play()
	table.insert(ActiveEffects.Sounds, punchSound)

	CreateSphereEffect(attackerRoot.Position, CONFIG.PunchEffectColor, 5, 0.8, 0.3)

	local attackerHum = attacker:FindFirstChildOfClass("Humanoid")
	if attackerHum then
		local reflectedDamage = damageAmount * CONFIG.ProtectionDamageReflection
		attackerHum:TakeDamage(reflectedDamage)

		-- Knockback
		local bv        = Instance.new("BodyVelocity")
		bv.MaxForce     = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity     = rootpart.CFrame.LookVector * CONFIG.ProtectionKnockbackPower
		bv.Parent       = attackerRoot
		task.delay(0.3, function()
			if bv and bv.Parent then bv.Parent = nil end
		end)
	end

	task.wait(CONFIG.PunchAnimationDuration)
	protectionActive = false

	task.wait(CONFIG.ProtectionCooldown)
	protectionCooldown = false
end

-- ========== MONITORAR ATAQUES EM ALIADOS ==========
local function MonitorAllyAttacks()
	for _, ally in pairs(workspace:GetChildren()) do
		if ally:IsA("Model") and ally ~= character and IsAlly(character, ally) then
			local allyHum  = ally:FindFirstChildOfClass("Humanoid")
			local allyRoot = ally:FindFirstChild("HumanoidRootPart") or ally:FindFirstChild("Torso")

			if allyHum and allyRoot and allyHum.Health > 0 then
				local dist = (allyRoot.Position - rootpart.Position).Magnitude

				if dist <= CONFIG.ProtectionRange and not protectedAllies[ally] then
					protectedAllies[ally] = true
					local lastHP = allyHum.Health

					local conn = allyHum.HealthChanged:Connect(function(hp)
						if hp < lastHP and protectionActive then
							local damageAmount = lastHP - hp
							allyHum.Health     = lastHP

							local attackerFound = FindNearestAttacker()
							if attackerFound then
								ActivateAllyProtection(ally, attackerFound, damageAmount)
							end
						end
						lastHP = allyHum.Health
					end)
					table.insert(ActiveEffects.Connections, conn)
				end
			end
		end
	end
end

-- ========== SISTEMA DE BLOQUEIO PRINCIPAL ==========
local function SetupBlockSystem()
	local thechar = character
	local lasthp  = charhum.Health

	local conn = charhum.HealthChanged:Connect(function(hp)
		if character ~= thechar or not equipped then return end
		if isProcessingDamage then return end  -- [FIX V5] Anti-recursão

		if hp < lasthp then
			isProcessingDamage = true

			local damageAmount  = lasthp - hp
			local reducedDamage = damageAmount * CONFIG.PlayerDamageReduction
			charhum.Health      = math.min(charhum.MaxHealth, hp + reducedDamage)

			PlayBlockSound()

			local nearestAttacker = FindNearestAttacker()
			if nearestAttacker then
				-- Virar para o atacante
				local atkHead = nearestAttacker:FindFirstChild("Head")
				if atkHead then
					rootpart.CFrame = CFrame.new(
						rootpart.Position,
						Vector3.new(atkHead.Position.X, rootpart.Position.Y, atkHead.Position.Z)
					)
				end

				CreateBlockEffect(Handle.Position, CONFIG.BlockEffectColor)

				-- Reflexão de dano
				local atkHum = nearestAttacker:FindFirstChildOfClass("Humanoid")
				if atkHum then
					local reflectDamage = damageAmount * CONFIG.EnemyDamageReflection
					atkHum:TakeDamage(reflectDamage)

					local atkRoot = nearestAttacker:FindFirstChild("HumanoidRootPart") or nearestAttacker:FindFirstChild("Head")
					if atkRoot then
						CreateReflectionEffect(
							atkRoot.Position,
							(atkRoot.Position - Handle.Position).Unit
						)
					end

					local reflectSound = blocksounds[4]:Clone()
					reflectSound.Parent = atkRoot or Handle
					reflectSound.Pitch  = CONFIG.ReflectSoundPitch
					reflectSound:Play()
					table.insert(ActiveEffects.Sounds, reflectSound)
				end

				-- Recuo leve
				local bv        = Instance.new("BodyVelocity")
				bv.MaxForce     = Vector3.new(math.huge, 0, math.huge)
				bv.Velocity     = rootpart.CFrame.LookVector * -4
				bv.Parent       = rootpart
				task.delay(0.15, function()
					if bv and bv.Parent then bv.Parent = nil end
				end)
			end

			ApplyAllyDefense()

			task.wait()
			isProcessingDamage = false
		end

		lasthp = charhum.Health
	end)
	table.insert(ActiveEffects.Connections, conn)
end

-- ========== REMOTEEVENT HANDLER ==========
remoteEvent.OnServerEvent:Connect(function(player, action)
	if player ~= owner or not equipped then return end

	if action == "toggleProtection" then
		if not protectionCooldown then
			protectionActive = not protectionActive
			if protectionActive then
				MonitorAllyAttacks()
			else
				protectedAllies = {}
			end
		end
	end
end)

-- ========== SISTEMA DE NPC ==========
local NPCCooldown = false

task.spawn(function()
	while task.wait(1) do
		if equipped and not owner and not NPCCooldown then
			if rootpart and rootpart.Parent then
				-- NPC: ativar proteção aliada automaticamente
				local nearestAlly = nil
				local shortestDist = CONFIG.NPCDetectRange

				for _, model in pairs(workspace:GetChildren()) do
					if model:IsA("Model") and model ~= character then
						local allyHum  = model:FindFirstChildOfClass("Humanoid")
						local allyRoot = model:FindFirstChild("HumanoidRootPart")
						if allyHum and allyRoot and allyHum.Health > 0 and IsAlly(character, model) then
							local dist = (allyRoot.Position - rootpart.Position).Magnitude
							if dist < shortestDist then
								nearestAlly = model
								shortestDist = dist
							end
						end
					end
				end

				if nearestAlly then
					NPCCooldown = true
					protectionActive = true
					MonitorAllyAttacks()
					task.wait(CONFIG.NPCCooldownTime)
					protectionActive = false
					NPCCooldown = false
				end
			end
		end
	end
end)

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped = true
	owner    = Services.Players:GetPlayerFromCharacter(Tool.Parent)
	character = Tool.Parent
	charhum   = character:FindFirstChildOfClass("Humanoid")
	rootpart  = character:FindFirstChild("HumanoidRootPart")

	if not charhum or not rootpart then return end

	if equipsound then equipsound:Play() end
	CleanupAllEffects()

	-- Configurar RightGrip
	local rightArm = character:FindFirstChild("Right Arm")
	if rightArm then
		local rg = rightArm:FindFirstChild("RightGrip")
		if rg then
			rg.C0 = CFrame.new(
				0.409522653, -0.000911712646, 0.516324997,
				-0.0116359973, -0.0435790196, -0.998981893,
				0.999929667,  0.00166221452, -0.0117195444,
				0.0021712482, -0.999047935,   0.0435565971
			)
		end
	end

	-- Criar Welds de animação
	local torso = character:FindFirstChild("Torso")
	if torso and rightArm then
		local rightarmWeld = Instance.new("Weld")
		rightarmWeld.Part0 = torso
		rightarmWeld.Part1 = rightArm
		rightarmWeld.C0    = CFrame.new(1.5, 0, 0)
		rightarmWeld.Name  = "RightArmWeldshield"
		rightarmWeld.Parent = torso
		table.insert(ActiveEffects.Welds, rightarmWeld)

		local headPart = character:FindFirstChild("Head")
		if headPart then
			local headWeld = Instance.new("Weld")
			headWeld.Part0 = torso
			headWeld.Part1 = headPart
			headWeld.C0    = CFrame.new(0, 1.5, 0)
			headWeld.Name  = "HeadWeldshield"
			headWeld.Parent = torso
			table.insert(ActiveEffects.Welds, headWeld)

			local hrpWeld = Instance.new("Weld")
			hrpWeld.Part0 = rootpart
			hrpWeld.Part1 = torso
			hrpWeld.Name  = "HumanoidRootPartWeldshield"
			hrpWeld.Parent = rootpart
			table.insert(ActiveEffects.Welds, hrpWeld)

			-- Thread de animação
			local animThread = task.spawn(function()
				while equipped do
					Services.RunService.Stepped:Wait()
					if not rightarmWeld or not rightarmWeld.Parent then break end

					if protectionActive then
						rightarmWeld.C0 = rightarmWeld.C0:lerp(
							CFrame.new(1.5, 0.5, -0.3) * CFrame.Angles(math.rad(45), 0, math.rad(10)),
							CONFIG.AnimationLerpSpeed
						)
						headWeld.C0 = headWeld.C0:lerp(CFrame.new(0, 1.5, 0), CONFIG.AnimationLerpSpeed)
						hrpWeld.C0  = hrpWeld.C0:lerp(CFrame.new(), CONFIG.AnimationLerpSpeed)
					else
						rightarmWeld.C0 = rightarmWeld.C0:lerp(
							CFrame.new(1.40557981, 0.499999762, -0.579227924, 0.98480767, 0.173648134, 3.55271368e-15, -4.39884928e-08, 2.49471157e-07, -0.999999821, -0.173648134, 0.98480767, 2.5331974e-07),
							CONFIG.AnimationLerpSpeed
						)
						headWeld.C0 = headWeld.C0:lerp(
							CFrame.new(0, 1.49999976, 0, 0.173648208, 0, -0.98480767, 0, 0.999999881, 0, 0.98480767, 0, 0.173648208),
							CONFIG.AnimationLerpSpeed
						)
						hrpWeld.C0 = hrpWeld.C0:lerp(
							CFrame.new(0, 0, 0, 0.173648134, 0, 0.98480773, 0, 0.99999994, 0, -0.98480773, 0, 0.173648134),
							CONFIG.AnimationLerpSpeed
						)
					end
				end
			end)
			table.insert(ActiveEffects.AnimationThreads, animThread)
		end
	end

	-- Sistema de bloqueio
	SetupBlockSystem()

	-- Conexão de morte
	if charhum then
		CleanupConnections.Died = charhum.Died:Connect(function()
			CleanupAllEffects()
		end)
	end
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped         = false
	protectionActive = false
	protectionCooldown = false
	isProcessingDamage = false

	CleanupAllEffects()

	for _, conn in pairs(CleanupConnections) do
		if conn then conn:Disconnect() end
	end
	CleanupConnections = {}
end)

-- ========== LIMPEZA AO REMOVER TOOL ==========
Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		CleanupAllEffects()
		for _, conn in pairs(CleanupConnections) do
			if conn then conn:Disconnect() end
		end
		CleanupConnections = {}
	end
end)]]></ProtectedString>
