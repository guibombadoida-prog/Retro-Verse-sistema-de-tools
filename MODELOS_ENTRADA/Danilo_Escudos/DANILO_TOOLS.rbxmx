			</Properties>
		</Item>
		<Item class="Script" referent="RBXBC048A2BC65941968A0CCA8352DCC4ED">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScript_Protecao_V2.lua
-- Coloque DENTRO da Tool "Proteção"
-- SUBSTITUI: ServerScript_Protecao_V1.lua
-- REMOVER: ServerScript_Protecao_V1.lua
--
-- CORREÇÕES V2:
--   [ADD] Sistema de animação CFrame via 3 Welds (RightArm, Head, HRP→Torso)
--         IDÊNTICO ao padrão do Escudo Bloqueador V5 e Bumerangue V5.
--         IDLE: mesma pose base dos escudos (corpo virado ~10°, escudo à frente).
--         ACTIVE: braço estendido à frente ~70° em guarda defensiva,
--                 corpo levemente abaixado, cabeça olhando reto.
--   [ADD] RightGrip C0 configurado (mesmo valor dos outros escudos).
--   [ADD] CleanupAnimationWelds() com ordem correta (threads→welds).
--   [FIX] Sons: agora usa 1 único som "Protecao" (dentro do Handle, 4 segundos).
--   [KEEP] Órbita, reflexão de projéteis, NPC, task.wait, .Parent = nil.
--
-- REUTILIZA:
--   Sistema de animação CFrame/Weld → Origem: ServerScript_EscudoBloqueador_V5
--   Sistema Anti-Friendly Fire → Origem: ServerScript_EscudoBloqueador_V5

--[[
═══════════════════════════════════════════════════════════════
                    LISTA DE CUSTOMIZAÇÃO
═══════════════════════════════════════════════════════════════
--]]

local CONFIG = {
	-- ========== HABILIDADE ==========
	Duration       = 4,
	Cooldown       = 7,

	-- ========== ESCUDO ORBITANTE ==========
	OrbitRadius    = 4,
	OrbitSpeed     = 8,
	ShieldScale    = 0.7,
	ShieldHeight   = 1,

	-- ========== REFLEXÃO ==========
	ReflectRadius  = 8,
	ReflectForce   = 100,
	ReflectDamage  = 5,

	-- ========== EFEITOS VISUAIS ==========
	ShieldColor    = Color3.fromRGB(0, 150, 255),
	ReflectColor   = Color3.fromRGB(255, 100, 0),
	ParticleRate   = 20,

	-- ========== ANIMAÇÃO ==========
	AnimationLerpSpeed = 0.15,

	-- ========== NPC ==========
	NPCDetectRange  = 30,
	NPCCooldownTime = 10,
}

--[[
═══════════════════════════════════════════════════════════════
  POSES CFRAME — PROTEÇÃO (R6)

  3 Welds: RightArm (Torso→Right Arm), Head (Torso→Head),
           HRP (HumanoidRootPart→Torso)
  Loop: RunService.Stepped com :lerp() entre IDLE e ACTIVE

  IDLE — mesma pose base de todos os escudos:
    Corpo virado ~10°, escudo à frente.

  ACTIVE — guarda defensiva:
    Braço estendido à frente ~70° com escudo como barreira.
    Corpo levemente abaixado ~5° (postura defensiva).
    Cabeça olhando para frente.
═══════════════════════════════════════════════════════════════
--]]

local POSE_IDLE_ARM = CFrame.new(
	1.40557981, 0.499999762, -0.579227924,
	0.98480767, 0.173648134, 3.55271368e-15,
	-4.39884928e-08, 2.49471157e-07, -0.999999821,
	-0.173648134, 0.98480767, 2.5331974e-07
)
local POSE_IDLE_HEAD = CFrame.new(
	0, 1.49999976, 0,
	0.173648208, 0, -0.98480767,
	0, 0.999999881, 0,
	0.98480767, 0, 0.173648208
)
local POSE_IDLE_HRP = CFrame.new(
	0, 0, 0,
	0.173648134, 0, 0.98480773,
	0, 0.99999994, 0,
	-0.98480773, 0, 0.173648134
)

-- ACTIVE: guarda defensiva — escudo estendido à frente como barreira
local POSE_ACTIVE_ARM = CFrame.new(1.5, 0.5, -0.8)
	* CFrame.Angles(math.rad(70), 0, math.rad(-20))
local POSE_ACTIVE_HEAD = CFrame.new(0, 1.5, 0)
local POSE_ACTIVE_HRP = CFrame.new(0, -0.1, 0)
	* CFrame.Angles(math.rad(-5), 0, 0)

--[[
═══════════════════════════════════════════════════════════════
                    CÓDIGO PRINCIPAL
═══════════════════════════════════════════════════════════════
--]]

local Services = {
	Players      = game:GetService("Players"),
	RunService   = game:GetService("RunService"),
	TweenService = game:GetService("TweenService"),
}

local Tool   = script.Parent
local Handle = Tool:WaitForChild("Handle")

-- 1 único som: "Protecao" (4 segundos, dentro do Handle)
local protecaoSound = Handle:WaitForChild("Protecao", 10)

local owner, character, humanoid, rootpart
local equipped     = false
local onCooldown   = false
local abilityActive = false

local ActiveEffects = {
	Parts            = {},
	Sounds           = {},
	Connections      = {},
	Welds            = {},
	AnimationThreads = {},
}
local CleanupConnections = {}

local RemoteEvent = Tool:FindFirstChild("RemoteEvent")
if not RemoteEvent then
	RemoteEvent        = Instance.new("RemoteEvent")
	RemoteEvent.Name   = "RemoteEvent"
	RemoteEvent.Parent = Tool
end

-- ========== ANTI-FRIENDLY FIRE ==========
local function IsAlly(char1, char2)
	if not char1 or not char2 then return false end
	if char1 == char2 then return true end
	local p1 = Services.Players:GetPlayerFromCharacter(char1)
	local p2 = Services.Players:GetPlayerFromCharacter(char2)
	if p1 and p2 then
		if not p1.Neutral and not p2.Neutral then return p1.Team == p2.Team end
	end
	local cf1 = char1:FindFirstChild("ControlFollow")
	local cf2 = char2:FindFirstChild("ControlFollow")
	if cf1 and cf2 then return cf1.Owner.Value == cf2.Owner.Value end
	return false
end

-- ========== LIMPEZA (threads PRIMEIRO, welds DEPOIS) ==========
local function CleanupAnimationWelds()
	for _, th in pairs(ActiveEffects.AnimationThreads) do
		if th then task.cancel(th) end
	end
	ActiveEffects.AnimationThreads = {}
	for _, weld in pairs(ActiveEffects.Welds) do
		if weld and weld.Parent then weld.Parent = nil end
	end
	ActiveEffects.Welds = {}
end

local function CleanupAllEffects()
	CleanupAnimationWelds()
	for _, p in pairs(ActiveEffects.Parts) do
		if p and p.Parent then p.Parent = nil end
	end
	ActiveEffects.Parts = {}
	for _, s in pairs(ActiveEffects.Sounds) do
		if s and s.Parent then s:Stop(); s.Parent = nil end
	end
	ActiveEffects.Sounds = {}
	for _, c in pairs(ActiveEffects.Connections) do
		if c then c:Disconnect() end
	end
	ActiveEffects.Connections = {}
	abilityActive = false
end

-- ========== ENCONTRAR INIMIGO MAIS PRÓXIMO ==========
local function FindNearestEnemy()
	local nearest, dist = nil, CONFIG.ReflectRadius * 2
	for _, model in pairs(workspace:GetChildren()) do
		if model:IsA("Model") and model ~= character then
			local hum  = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 and not IsAlly(character, model) then
				local d = (root.Position - rootpart.Position).Magnitude
				if d < dist then nearest = model; dist = d end
			end
		end
	end
	return nearest
end

-- ========== ENCONTRAR PROJÉTEIS INIMIGOS ==========
local function FindEnemyProjectiles()
	local projectiles = {}
	for _, obj in pairs(workspace:GetChildren()) do
		if obj:IsA("BasePart") and not obj.Anchored and not obj:IsA("Terrain") then
			local isCharPart = obj.Parent and obj.Parent:FindFirstChildOfClass("Humanoid")
			if not isCharPart and rootpart then
				local dist = (obj.Position - rootpart.Position).Magnitude
				if dist < CONFIG.ReflectRadius then
					local vel = obj.AssemblyLinearVelocity or obj.Velocity
					if vel and vel.Magnitude > 5 then
						local toPlayer = (rootpart.Position - obj.Position).Unit
						local dot = toPlayer:Dot(vel.Unit)
						if dot > 0.3 then
							table.insert(projectiles, obj)
						end
					end
				end
			end
		end
	end
	return projectiles
end

-- ========== ATIVAR PROTEÇÃO ==========
local function ActivateProtecao()
	if not rootpart or not humanoid or humanoid.Health <= 0 then return end

	abilityActive = true

	-- Som (4 segundos)
	if protecaoSound then protecaoSound:Play() end

	-- Clone escudo orbitante
	local shield = Handle:Clone()
	shield.Name  = "ProtecaoShield"
	shield.CanCollide   = false
	shield.CanTouch     = false
	shield.Anchored     = true
	shield.Material     = Enum.Material.ForceField
	shield.Color        = CONFIG.ShieldColor
	shield.Transparency = 0.2
	shield.Size         = Handle.Size * CONFIG.ShieldScale
	shield.Parent       = workspace
	table.insert(ActiveEffects.Parts, shield)
	for _, child in pairs(shield:GetChildren()) do
		if child:IsA("Sound") or child:IsA("Script") or child:IsA("LocalScript") then
			child.Parent = nil
		end
	end

	-- Partículas
	local particles    = Instance.new("ParticleEmitter")
	particles.Texture  = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Rate     = CONFIG.ParticleRate
	particles.Lifetime = NumberRange.new(0.5)
	particles.Speed    = NumberRange.new(3)
	particles.Color    = ColorSequence.new(CONFIG.ShieldColor)
	particles.Size     = NumberSequence.new(0.3)
	particles.Parent   = shield

	-- Luz
	local light      = Instance.new("PointLight")
	light.Brightness = 1.5
	light.Color      = CONFIG.ShieldColor
	light.Range      = 10
	light.Parent     = shield

	-- ========== LOOP: ÓRBITA + REFLEXÃO ==========
	local reflectDebounce = {}

	local orbitThread = task.spawn(function()
		local startTime = tick()
		local angle = 0

		while abilityActive and shield and shield.Parent and rootpart and rootpart.Parent do
			if tick() - startTime >= CONFIG.Duration then break end

			local dt = Services.RunService.Stepped:Wait()
			angle = angle + CONFIG.OrbitSpeed * dt
			if not shield or not shield.Parent then break end

			local basePos     = rootpart.Position + Vector3.new(0, CONFIG.ShieldHeight, 0)
			local projectiles = FindEnemyProjectiles()
			local enemy       = FindNearestEnemy()

			if #projectiles > 0 then
				-- Mover escudo na frente do projétil mais próximo
				local closestProj = projectiles[1]
				local closestDist = (closestProj.Position - rootpart.Position).Magnitude
				for _, proj in pairs(projectiles) do
					local d = (proj.Position - rootpart.Position).Magnitude
					if d < closestDist then closestProj = proj; closestDist = d end
				end

				local dirToProj = (closestProj.Position - rootpart.Position).Unit
				shield.CFrame = CFrame.new(basePos + dirToProj * CONFIG.OrbitRadius, closestProj.Position)

				-- Refletir
				if closestDist < CONFIG.OrbitRadius + 2 and not reflectDebounce[closestProj] then
					reflectDebounce[closestProj] = true
					if enemy then
						local er = enemy:FindFirstChild("HumanoidRootPart")
						if er then
							closestProj.AssemblyLinearVelocity = (er.Position - shield.Position).Unit * CONFIG.ReflectForce
						end
					else
						closestProj.AssemblyLinearVelocity = -(closestProj.AssemblyLinearVelocity or closestProj.Velocity)
					end
					-- Flash
					local fx = Instance.new("Part")
					fx.Size = Vector3.new(2, 2, 2); fx.Material = Enum.Material.Neon
					fx.Color = CONFIG.ReflectColor; fx.Transparency = 0.3
					fx.CanCollide = false; fx.CanTouch = false; fx.Anchored = true
					fx.Shape = Enum.PartType.Ball; fx.CFrame = shield.CFrame
					fx.Parent = workspace
					table.insert(ActiveEffects.Parts, fx)
					task.spawn(function()
						for i = 0, 10 do
							if not fx or not fx.Parent then break end
							fx.Transparency = 0.3 + (i * 0.07)
							fx.Size = fx.Size + Vector3.new(0.3, 0.3, 0.3)
							task.wait(0.03)
						end
						if fx and fx.Parent then fx.Parent = nil end
					end)
				end

			elseif enemy then
				local er = enemy:FindFirstChild("HumanoidRootPart")
				if er then
					local dirToEnemy = (er.Position - rootpart.Position).Unit
					local orbitPos = basePos + Vector3.new(math.cos(angle) * CONFIG.OrbitRadius, 0, math.sin(angle) * CONFIG.OrbitRadius)
					local frontPos = basePos + dirToEnemy * CONFIG.OrbitRadius
					local finalPos = frontPos * 0.7 + orbitPos * 0.3
					shield.CFrame = CFrame.new(finalPos, er.Position)
				end
			else
				local orbitPos = basePos + Vector3.new(math.cos(angle) * CONFIG.OrbitRadius, 0, math.sin(angle) * CONFIG.OrbitRadius)
				shield.CFrame = CFrame.new(orbitPos) * CFrame.Angles(0, -angle, 0)
			end

			-- Dano por contato
			for _, model in pairs(workspace:GetChildren()) do
				if model:IsA("Model") and model ~= character then
					local hum  = model:FindFirstChildOfClass("Humanoid")
					local root = model:FindFirstChild("HumanoidRootPart")
					if hum and root and hum.Health > 0 and not IsAlly(character, model) then
						if (root.Position - shield.Position).Magnitude < 3 and not reflectDebounce[model] then
							reflectDebounce[model] = true
							hum:TakeDamage(CONFIG.ReflectDamage)
							task.delay(1, function() reflectDebounce[model] = nil end)
						end
					end
				end
			end
		end

		abilityActive = false
		if protecaoSound then protecaoSound:Stop() end

		if shield and shield.Parent then
			Services.TweenService:Create(shield,
				TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Transparency = 1}):Play()
			task.delay(0.5, function()
				if shield and shield.Parent then shield.Parent = nil end
			end)
		end
	end)
	table.insert(ActiveEffects.AnimationThreads, orbitThread)
end

-- ========== REMOTEEVENT ==========
RemoteEvent.OnServerEvent:Connect(function(player, action)
	if player ~= owner or not equipped then return end
	if action == "activate" then
		if onCooldown then return end
		onCooldown = true
		ActivateProtecao()
		task.wait(CONFIG.Cooldown)
		onCooldown = false
	end
end)

-- ========== NPC ==========
local NPCCooldown = false
task.spawn(function()
	while task.wait(1) do
		if equipped and not owner and not NPCCooldown then
			if rootpart and rootpart.Parent then
				local enemy = FindNearestEnemy()
				if enemy then
					local er = enemy:FindFirstChild("HumanoidRootPart")
					if er and (er.Position - rootpart.Position).Magnitude < CONFIG.NPCDetectRange then
						NPCCooldown = true
						ActivateProtecao()
						task.wait(CONFIG.NPCCooldownTime)
						NPCCooldown = false
					end
				end
			end
		end
	end
end)

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped  = true
	owner     = Services.Players:GetPlayerFromCharacter(Tool.Parent)
	character = Tool.Parent
	humanoid  = character:FindFirstChildOfClass("Humanoid")
	rootpart  = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootpart then return end
	onCooldown = false; abilityActive = false
	CleanupAllEffects()

	-- RightGrip C0 (padrão de todos os escudos)
	local rightArm = character:FindFirstChild("Right Arm")
	if rightArm then
		local rg = rightArm:FindFirstChild("RightGrip")
		if rg then
			rg.C0 = CFrame.new(
				0.409522653, -0.000911712646, 0.516324997,
				-0.0116359973, -0.0435790196, -0.998981893,
				0.999929667,  0.00166221452, -0.0117195444,
				0.0021712482, -0.999047935,   0.0435565971)
		end
	end

	-- 3 Welds de animação (padrão dos escudos)
	local torso = character:FindFirstChild("Torso")
	if torso and rightArm then
		local rightarmWeld = Instance.new("Weld")
		rightarmWeld.Part0 = torso; rightarmWeld.Part1 = rightArm
		rightarmWeld.C0 = CFrame.new(1.5, 0, 0)
		rightarmWeld.Name = "RightArmWeldprotecao"
		rightarmWeld.Parent = torso
		table.insert(ActiveEffects.Welds, rightarmWeld)

		local headPart = character:FindFirstChild("Head")
		if headPart then
			local headWeld = Instance.new("Weld")
			headWeld.Part0 = torso; headWeld.Part1 = headPart
			headWeld.C0 = CFrame.new(0, 1.5, 0)
			headWeld.Name = "HeadWeldprotecao"
			headWeld.Parent = torso
			table.insert(ActiveEffects.Welds, headWeld)

			local hrpWeld = Instance.new("Weld")
			hrpWeld.Part0 = rootpart; hrpWeld.Part1 = torso
			hrpWeld.C0 = CFrame.new()
			hrpWeld.Name = "HRPWeldprotecao"
			hrpWeld.Parent = rootpart
			table.insert(ActiveEffects.Welds, hrpWeld)

			-- Loop de animação (RunService.Stepped)
			local animThread = task.spawn(function()
				while equipped do
					Services.RunService.Stepped:Wait()
					if not rightarmWeld or not rightarmWeld.Parent then break end
					if abilityActive then
						rightarmWeld.C0 = rightarmWeld.C0:lerp(POSE_ACTIVE_ARM, CONFIG.AnimationLerpSpeed)
						headWeld.C0     = headWeld.C0:lerp(POSE_ACTIVE_HEAD, CONFIG.AnimationLerpSpeed)
						hrpWeld.C0      = hrpWeld.C0:lerp(POSE_ACTIVE_HRP, CONFIG.AnimationLerpSpeed)
					else
						rightarmWeld.C0 = rightarmWeld.C0:lerp(POSE_IDLE_ARM, CONFIG.AnimationLerpSpeed)
						headWeld.C0     = headWeld.C0:lerp(POSE_IDLE_HEAD, CONFIG.AnimationLerpSpeed)
						hrpWeld.C0      = hrpWeld.C0:lerp(POSE_IDLE_HRP, CONFIG.AnimationLerpSpeed)
					end
				end
			end)
			table.insert(ActiveEffects.AnimationThreads, animThread)
		end
	end

	if humanoid then
		CleanupConnections.Died = humanoid.Died:Connect(function() CleanupAllEffects() end)
	end
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped = false; onCooldown = false; abilityActive = false
	if protecaoSound then protecaoSound:Stop() end
	CleanupAllEffects()
	for _, conn in pairs(CleanupConnections) do if conn then conn:Disconnect() end end
	CleanupConnections = {}
end)

Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		if protecaoSound then protecaoSound:Stop() end
		CleanupAllEffects()
		for _, conn in pairs(CleanupConnections) do if conn then conn:Disconnect() end end
		CleanupConnections = {}
	end
end)]]></ProtectedString>
