				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX4EEE989FD139444EBA163CB2BCD8C2DE">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScript_EscudoSkate_V2.lua
-- Coloque DENTRO da Tool "Escudo Skate"
-- SUBSTITUI: ServerScript_EscudoSkate_V1.lua
-- REMOVER: ServerScript_EscudoSkate_V1.lua
--
-- CORREÇÕES V2:
--   [ADD] Sistema de animação CFrame via 3 Welds (RightArm, Head, HRP→Torso)
--         IDÊNTICO ao padrão do Escudo Bloqueador V5 e Bumerangue V5.
--         IDLE: mesma pose base dos escudos (corpo virado ~10°, escudo à frente).
--         ACTIVE: pose de skating — braço para trás, corpo inclinado à frente ~15°,
--                 cabeça olhando para frente/baixo.
--   [ADD] RightGrip C0 configurado (mesmo valor dos outros escudos).
--   [ADD] CleanupAnimationWelds() com ordem correta (threads→welds).
--   [KEEP] Escudo no pé, +35 speed, 10 dano + empurrão, NPC.
--
-- REUTILIZA:
--   Sistema de animação CFrame/Weld → Origem: ServerScript_EscudoBloqueador_V5
--   Sistema Anti-Friendly Fire → Origem: ServerScript_EscudoBloqueador_V5
--   Regras de CFrame para R6 → Origem: Regras_instrucoes_de_Cframe_de_tool.txt

--[[
═══════════════════════════════════════════════════════════════
                    LISTA DE CUSTOMIZAÇÃO
═══════════════════════════════════════════════════════════════
--]]

local CONFIG = {
	-- ========== HABILIDADE ==========
	Duration        = 5,
	Cooldown        = 8,
	SpeedBonus      = 35,

	-- ========== DANO E EMPURRÃO ==========
	ContactDamage   = 10,
	KnockbackPower  = 60,
	HitRadius       = 4,
	HitCooldown     = 0.5,

	-- ========== ESCUDO NO PÉ ==========
	ShieldScale     = 0.5,
	FootOffset      = CFrame.new(0, -0.5, 0) * CFrame.Angles(math.rad(90), 0, 0),

	-- ========== EFEITOS VISUAIS ==========
	ShieldColor     = Color3.fromRGB(0, 200, 255),
	TrailColor      = Color3.fromRGB(100, 200, 255),
	HitColor        = Color3.fromRGB(255, 150, 0),
	ParticleRate    = 25,

	-- ========== ANIMAÇÃO ==========
	AnimationLerpSpeed = 0.15,

	-- ========== NPC ==========
	NPCDetectRange  = 30,
	NPCCooldownTime = 10,
}

--[[
═══════════════════════════════════════════════════════════════
  POSES CFRAME — ESCUDO SKATE (R6)

  3 Welds: RightArm (Torso→Right Arm), Head (Torso→Head),
           HRP (HumanoidRootPart→Torso)
  Loop: RunService.Stepped com :lerp() entre IDLE e ACTIVE

  IDLE — mesma pose base de todos os escudos:
    Corpo virado ~10°, escudo à frente.

  ACTIVE — pose de skating/velocidade:
    Braço direito para trás ~-30° (equilibrando na corrida).
    Corpo inclinado para frente ~15° (aerodinâmico).
    Cabeça olhando para frente/baixo ~10°.
═══════════════════════════════════════════════════════════════
--]]

local POSE_IDLE_ARM = CFrame.new(
	1.40557981, 0.499999762, -0.579227924,
	0.98480767, 0.173648134, 3.55271368e-15,
	-4.39884928e-08, 2.49471157e-07, -0.999999821,
	-0.173648134, 0.98480767, 2.5331974e-07
)
local POSE_IDLE_HEAD = CFrame.new(
	0, 1.49999976, 0,
	0.173648208, 0, -0.98480767,
	0, 0.999999881, 0,
	0.98480767, 0, 0.173648208
)
local POSE_IDLE_HRP = CFrame.new(
	0, 0, 0,
	0.173648134, 0, 0.98480773,
	0, 0.99999994, 0,
	-0.98480773, 0, 0.173648134
)

-- ACTIVE: pose de skating — braço para trás, corpo inclinado à frente
local POSE_ACTIVE_ARM = CFrame.new(1.5, 0.3, 0.3)
	* CFrame.Angles(math.rad(-30), 0, math.rad(15))
local POSE_ACTIVE_HEAD = CFrame.new(0, 1.5, 0)
	* CFrame.Angles(math.rad(10), 0, 0)
local POSE_ACTIVE_HRP = CFrame.new(0, 0, 0)
	* CFrame.Angles(math.rad(15), 0, 0)

--[[
═══════════════════════════════════════════════════════════════
                    CÓDIGO PRINCIPAL
═══════════════════════════════════════════════════════════════
--]]

local Services = {
	Players      = game:GetService("Players"),
	RunService   = game:GetService("RunService"),
	TweenService = game:GetService("TweenService"),
}

local Tool   = script.Parent
local Handle = Tool:WaitForChild("Handle")

local owner, character, humanoid, rootpart
local equipped      = false
local onCooldown    = false
local skateActive   = false

local ActiveEffects = {
	Parts            = {},
	Sounds           = {},
	Connections      = {},
	Welds            = {},
	AnimationThreads = {},
}
local CleanupConnections = {}

local RemoteEvent = Tool:FindFirstChild("RemoteEvent")
if not RemoteEvent then
	RemoteEvent        = Instance.new("RemoteEvent")
	RemoteEvent.Name   = "RemoteEvent"
	RemoteEvent.Parent = Tool
end

-- ========== ANTI-FRIENDLY FIRE ==========
local function IsAlly(char1, char2)
	if not char1 or not char2 then return false end
	if char1 == char2 then return true end
	local p1 = Services.Players:GetPlayerFromCharacter(char1)
	local p2 = Services.Players:GetPlayerFromCharacter(char2)
	if p1 and p2 then
		if not p1.Neutral and not p2.Neutral then return p1.Team == p2.Team end
	end
	local cf1 = char1:FindFirstChild("ControlFollow")
	local cf2 = char2:FindFirstChild("ControlFollow")
	if cf1 and cf2 then return cf1.Owner.Value == cf2.Owner.Value end
	return false
end

-- ========== LIMPEZA (threads PRIMEIRO, welds DEPOIS) ==========
local function CleanupAnimationWelds()
	for _, th in pairs(ActiveEffects.AnimationThreads) do
		if th then task.cancel(th) end
	end
	ActiveEffects.AnimationThreads = {}
	for _, weld in pairs(ActiveEffects.Welds) do
		if weld and weld.Parent then weld.Parent = nil end
	end
	ActiveEffects.Welds = {}
end

local function CleanupAllEffects()
	-- Restaurar velocidade se ativo
	if humanoid and humanoid.Parent and skateActive then
		humanoid.WalkSpeed = humanoid.WalkSpeed - CONFIG.SpeedBonus
	end
	skateActive = false

	CleanupAnimationWelds()
	for _, p in pairs(ActiveEffects.Parts) do
		if p and p.Parent then p.Parent = nil end
	end
	ActiveEffects.Parts = {}
	for _, s in pairs(ActiveEffects.Sounds) do
		if s and s.Parent then s:Stop(); s.Parent = nil end
	end
	ActiveEffects.Sounds = {}
	for _, c in pairs(ActiveEffects.Connections) do
		if c then c:Disconnect() end
	end
	ActiveEffects.Connections = {}
end

-- ========== ATIVAR ESCUDO SKATE ==========
local function ActivateSkate()
	if not rootpart or not humanoid or humanoid.Health <= 0 then return end

	local rightLeg = character:FindFirstChild("Right Leg")
	if not rightLeg then return end

	skateActive = true

	-- Clone escudo para o pé
	local skateShield = Handle:Clone()
	skateShield.Name  = "SkateShield"
	skateShield.CanCollide   = false
	skateShield.CanTouch     = false
	skateShield.Anchored     = false
	skateShield.Material     = Enum.Material.Neon
	skateShield.Color        = CONFIG.ShieldColor
	skateShield.Transparency = 0.1
	skateShield.Size         = Handle.Size * CONFIG.ShieldScale
	skateShield.Parent       = workspace
	table.insert(ActiveEffects.Parts, skateShield)
	for _, child in pairs(skateShield:GetChildren()) do
		if child:IsA("Sound") or child:IsA("Script") or child:IsA("LocalScript") then
			child.Parent = nil
		end
	end

	-- Soldar ao pé
	local weld   = Instance.new("Weld")
	weld.Part0   = rightLeg
	weld.Part1   = skateShield
	weld.C0      = CONFIG.FootOffset
	weld.Name    = "SkateWeld"
	weld.Parent  = rightLeg
	table.insert(ActiveEffects.Parts, weld)

	-- Trail
	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, 0.5, 0)
	att1.Parent = skateShield
	local att2 = Instance.new("Attachment")
	att2.Position = Vector3.new(0, -0.5, 0)
	att2.Parent = skateShield
	local trail = Instance.new("Trail")
	trail.Attachment0 = att1; trail.Attachment1 = att2
	trail.Lifetime = 0.3; trail.FaceCamera = true
	trail.Color = ColorSequence.new(CONFIG.TrailColor)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = skateShield

	-- Partículas
	local particles = Instance.new("ParticleEmitter")
	particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Rate = CONFIG.ParticleRate
	particles.Lifetime = NumberRange.new(0.3)
	particles.Speed = NumberRange.new(5)
	particles.Color = ColorSequence.new(CONFIG.ShieldColor)
	particles.Size = NumberSequence.new(0.3)
	particles.SpreadAngle = Vector2.new(20, 20)
	particles.Parent = skateShield

	-- Luz
	local light = Instance.new("PointLight")
	light.Brightness = 1; light.Color = CONFIG.ShieldColor
	light.Range = 8; light.Parent = skateShield

	-- Velocidade
	local originalSpeed = humanoid.WalkSpeed
	humanoid.WalkSpeed  = humanoid.WalkSpeed + CONFIG.SpeedBonus

	-- Loop de contato
	local hitDebounce = {}

	local contactThread = task.spawn(function()
		local startTime = tick()

		while skateActive and rootpart and rootpart.Parent and humanoid and humanoid.Health > 0 do
			if tick() - startTime >= CONFIG.Duration then break end

			local velocity = rootpart.AssemblyLinearVelocity or rootpart.Velocity
			local isMoving = velocity and velocity.Magnitude > 5

			if isMoving then
				for _, model in pairs(workspace:GetChildren()) do
					if model:IsA("Model") and model ~= character and not hitDebounce[model] then
						local hum  = model:FindFirstChildOfClass("Humanoid")
						local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
						if hum and root and hum.Health > 0 and not IsAlly(character, model) then
							if (root.Position - rootpart.Position).Magnitude < CONFIG.HitRadius then
								hitDebounce[model] = true
								hum:TakeDamage(CONFIG.ContactDamage)

								local pushDir = velocity.Unit
								local bv = Instance.new("BodyVelocity")
								bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
								bv.Velocity = pushDir * CONFIG.KnockbackPower + Vector3.new(0, 20, 0)
								bv.Parent = root
								task.delay(0.3, function()
									if bv and bv.Parent then bv.Parent = nil end
								end)

								-- Efeito
								local hitFx = Instance.new("Part")
								hitFx.Size = Vector3.new(3, 3, 3)
								hitFx.Material = Enum.Material.Neon
								hitFx.Color = CONFIG.HitColor
								hitFx.Transparency = 0.3
								hitFx.CanCollide = false; hitFx.CanTouch = false
								hitFx.Anchored = true; hitFx.Shape = Enum.PartType.Ball
								hitFx.CFrame = root.CFrame
								hitFx.Parent = workspace
								table.insert(ActiveEffects.Parts, hitFx)
								task.spawn(function()
									for i = 0, 10 do
										if not hitFx or not hitFx.Parent then break end
										hitFx.Transparency = 0.3 + (i * 0.07)
										hitFx.Size = hitFx.Size + Vector3.new(0.3, 0.3, 0.3)
										task.wait(0.03)
									end
									if hitFx and hitFx.Parent then hitFx.Parent = nil end
								end)

								task.delay(CONFIG.HitCooldown, function()
									hitDebounce[model] = nil
								end)
							end
						end
					end
				end
			end

			Services.RunService.Heartbeat:Wait()
		end

		-- Fim
		skateActive = false
		if humanoid and humanoid.Parent then
			humanoid.WalkSpeed = originalSpeed
		end
		if skateShield and skateShield.Parent then
			if weld and weld.Parent then weld.Parent = nil end
			skateShield.Anchored = true
			if rightLeg and rightLeg.Parent then
				skateShield.CFrame = rightLeg.CFrame * CONFIG.FootOffset
			end
			Services.TweenService:Create(skateShield,
				TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Transparency = 1}):Play()
			task.delay(0.5, function()
				if skateShield and skateShield.Parent then skateShield.Parent = nil end
			end)
		end
	end)
	table.insert(ActiveEffects.AnimationThreads, contactThread)
end

-- ========== REMOTEEVENT ==========
RemoteEvent.OnServerEvent:Connect(function(player, action)
	if player ~= owner or not equipped then return end
	if action == "activate" then
		if onCooldown or skateActive then return end
		onCooldown = true
		ActivateSkate()
		task.wait(CONFIG.Cooldown)
		onCooldown = false
	end
end)

-- ========== NPC ==========
local NPCCooldown = false
task.spawn(function()
	while task.wait(1) do
		if equipped and not owner and not NPCCooldown and not skateActive then
			if rootpart and rootpart.Parent then
				local nearest, dist = nil, CONFIG.NPCDetectRange
				for _, model in pairs(workspace:GetChildren()) do
					if model:IsA("Model") and model ~= character then
						local hum  = model:FindFirstChildOfClass("Humanoid")
						local root = model:FindFirstChild("HumanoidRootPart")
						if hum and root and hum.Health > 0 and not IsAlly(character, model) then
							local d = (root.Position - rootpart.Position).Magnitude
							if d < dist then nearest = model; dist = d end
						end
					end
				end
				if nearest then
					NPCCooldown = true
					ActivateSkate()
					task.wait(CONFIG.NPCCooldownTime)
					NPCCooldown = false
				end
			end
		end
	end
end)

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped  = true
	owner     = Services.Players:GetPlayerFromCharacter(Tool.Parent)
	character = Tool.Parent
	humanoid  = character:FindFirstChildOfClass("Humanoid")
	rootpart  = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootpart then return end
	onCooldown = false; skateActive = false
	CleanupAllEffects()

	-- RightGrip C0 (padrão de todos os escudos)
	local rightArm = character:FindFirstChild("Right Arm")
	if rightArm then
		local rg = rightArm:FindFirstChild("RightGrip")
		if rg then
			rg.C0 = CFrame.new(
				0.409522653, -0.000911712646, 0.516324997,
				-0.0116359973, -0.0435790196, -0.998981893,
				0.999929667,  0.00166221452, -0.0117195444,
				0.0021712482, -0.999047935,   0.0435565971)
		end
	end

	-- 3 Welds de animação (padrão dos escudos)
	local torso = character:FindFirstChild("Torso")
	if torso and rightArm then
		local rightarmWeld = Instance.new("Weld")
		rightarmWeld.Part0 = torso; rightarmWeld.Part1 = rightArm
		rightarmWeld.C0 = CFrame.new(1.5, 0, 0)
		rightarmWeld.Name = "RightArmWeldskate"
		rightarmWeld.Parent = torso
		table.insert(ActiveEffects.Welds, rightarmWeld)

		local headPart = character:FindFirstChild("Head")
		if headPart then
			local headWeld = Instance.new("Weld")
			headWeld.Part0 = torso; headWeld.Part1 = headPart
			headWeld.C0 = CFrame.new(0, 1.5, 0)
			headWeld.Name = "HeadWeldskate"
			headWeld.Parent = torso
			table.insert(ActiveEffects.Welds, headWeld)

			local hrpWeld = Instance.new("Weld")
			hrpWeld.Part0 = rootpart; hrpWeld.Part1 = torso
			hrpWeld.C0 = CFrame.new()
			hrpWeld.Name = "HRPWeldskate"
			hrpWeld.Parent = rootpart
			table.insert(ActiveEffects.Welds, hrpWeld)

			-- Loop de animação (RunService.Stepped)
			local animThread = task.spawn(function()
				while equipped do
					Services.RunService.Stepped:Wait()
					if not rightarmWeld or not rightarmWeld.Parent then break end
					if skateActive then
						rightarmWeld.C0 = rightarmWeld.C0:lerp(POSE_ACTIVE_ARM, CONFIG.AnimationLerpSpeed)
						headWeld.C0     = headWeld.C0:lerp(POSE_ACTIVE_HEAD, CONFIG.AnimationLerpSpeed)
						hrpWeld.C0      = hrpWeld.C0:lerp(POSE_ACTIVE_HRP, CONFIG.AnimationLerpSpeed)
					else
						rightarmWeld.C0 = rightarmWeld.C0:lerp(POSE_IDLE_ARM, CONFIG.AnimationLerpSpeed)
						headWeld.C0     = headWeld.C0:lerp(POSE_IDLE_HEAD, CONFIG.AnimationLerpSpeed)
						hrpWeld.C0      = hrpWeld.C0:lerp(POSE_IDLE_HRP, CONFIG.AnimationLerpSpeed)
					end
				end
			end)
			table.insert(ActiveEffects.AnimationThreads, animThread)
		end
	end

	if humanoid then
		CleanupConnections.Died = humanoid.Died:Connect(function() CleanupAllEffects() end)
	end
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped = false; onCooldown = false
	CleanupAllEffects()
	for _, conn in pairs(CleanupConnections) do if conn then conn:Disconnect() end end
	CleanupConnections = {}
end)

Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		CleanupAllEffects()
		for _, conn in pairs(CleanupConnections) do if conn then conn:Disconnect() end end
		CleanupConnections = {}
	end
end)]]></ProtectedString>
