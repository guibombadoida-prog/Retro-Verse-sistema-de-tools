				<ProtectedString name="Source"><![CDATA[-- LocalScript_Salvador_V3.lua
-- Coloque DENTRO da Tool "Salvador"
-- SUBSTITUI: LocalScript_Salvador_V2.lua
-- REMOVER: LocalScript_Salvador_V2.lua
--
-- MUDANÇAS V3:
--   [REMOVE] Botão E (Aura Protetora) removido — agora é a Tool "Proteção".
--   [REMOVE] Botão Q removido — habilidade primária usa click/toque direto.
--   [REMOVE] GUI de feedback complexa removida (era GUI completa - PROIBIDO).
--   [CHANGE] Ativação por click direto no aliado (Tool.Activated → mouse target).
--   [FIX]    wait() → task.wait().
--
-- Sem botões: Tool tem apenas 1 habilidade (primária) = click/toque direto.

local Tool        = script.Parent
local RemoteEvent = Tool:WaitForChild("RemoteEvent")

-- Serviços
local Players = game:GetService("Players")

-- Configurações obrigatórias
Tool.CanBeDropped   = false
Tool.RequiresHandle = true

local Player = Players.LocalPlayer
local Mouse  = Player:GetMouse()

-- ========== ATIVAÇÃO POR CLICK ==========
Tool.Activated:Connect(function()
	local target = Mouse.Target
	if not target then return end

	local model = target:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then
		RemoteEvent:FireServer("protect", model)
	end
end)]]></ProtectedString>
