		<Item class="LocalScript" referent="RBXA476AD7E539B4E349F691F81FC2632A6">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- LocalScript_Protecao_V1.lua
-- Coloque DENTRO da Tool "Proteção"
-- NOVO SCRIPT
--
-- Sem botões: Tool tem apenas 1 habilidade (primária) = click/toque direto.

local Tool        = script.Parent
local RemoteEvent = Tool:WaitForChild("RemoteEvent")

-- Configurações obrigatórias
Tool.CanBeDropped   = false
Tool.RequiresHandle = true

-- ========== ATIVAÇÃO POR CLICK ==========
Tool.Activated:Connect(function()
	RemoteEvent:FireServer("activate")
end)]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{0EC769FF-0AB5-4161-8EAE-1D71BBD10AF7}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">LocalScript</string>
