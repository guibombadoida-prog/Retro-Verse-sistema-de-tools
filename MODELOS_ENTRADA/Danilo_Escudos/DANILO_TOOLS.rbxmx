				<ProtectedString name="Source"><![CDATA[-- LocalScript_EscudoBloqueador_V2.lua
-- Coloque DENTRO da Tool "Escudo Bloqueador"
-- SUBSTITUI: LocalScript_Escudo_Bloqueador_V1.lua
-- REMOVER: LocalScript_Escudo_Bloqueador_V1.lua
--
-- CORREÇÕES V2:
--   [FIX] Adicionado CanBeDropped/RequiresHandle no LocalScript (segurança extra).
--   [FIX] Limpeza correta do botão no AncestryChanged.
--   [ADD] Feedback visual ao ativar/desativar proteção.
--
-- REUTILIZA:
--   Estrutura de botão via ContextActionService → Origem: LocalScript_TacoDeBaseball_V1_1.lua

local Tool = script.Parent
local RemoteEvent = Tool:WaitForChild("RemoteEvent")

-- Serviços
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

-- Configurações obrigatórias
Tool.CanBeDropped   = false
Tool.RequiresHandle = true

local Player = Players.LocalPlayer
local equipped = false

-- ========== BOTÃO DE PROTEÇÃO (Habilidade Extra - Q) ==========
local function OnProtectionButton(actionName, inputState, inputObj)
	if inputState == Enum.UserInputState.Begin then
		RemoteEvent:FireServer("toggleProtection")
	end
end

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped = true

	-- Botão mobile para habilidade Extra (Proteção de Aliado)
	ContextActionService:BindAction(
		"EscudoProtecao",
		OnProtectionButton,
		true,
		Enum.KeyCode.Q,
		Enum.KeyCode.ButtonX
	)
	ContextActionService:SetTitle("EscudoProtecao", "Proteção")
	ContextActionService:SetPosition("EscudoProtecao", UDim2.new(0.85, 0, 0.15, 0))
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped = false
	ContextActionService:UnbindAction("EscudoProtecao")
end)

-- ========== LIMPEZA AO REMOVER TOOL ==========
Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		equipped = false
		ContextActionService:UnbindAction("EscudoProtecao")
	end
end)]]></ProtectedString>
