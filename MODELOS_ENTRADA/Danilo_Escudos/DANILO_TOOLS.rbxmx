			<Properties>
				<ProtectedString name="Source"><![CDATA[-- ServerScript_EscudoBumerangue_V5.lua
-- Coloque DENTRO da Tool "Escudo Bumerangue"
-- SUBSTITUI: ServerScript_Escudo_Bumerangue_V4.lua
-- REMOVER: ServerScript_Escudo_Bumerangue_V4.lua
--
-- REFEITO DO ZERO (V5):
--   [FIX] :connect() → :Connect() em todo o script.
--   [FIX] wait() → task.wait() em todo o script.
--   [FIX] coroutine.wrap → task.spawn em todo o script.
--   [FIX] workspace:GetDescendants() → workspace:GetChildren() em loops.
--   [FIX] WaitForChild com timeout em sons.
--   [FIX] .Parent = nil em vez de :Destroy() (PROIBIDO).
--   [FIX] debris:AddItem → task.delay + .Parent = nil.
--   [FIX] Welds limpas corretamente (threads cancelados PRIMEIRO).
--   [ADD] Sistema de NPC completo.
--   [ADD] Flag anti-recursão onde necessário.
--   [KEEP] Sem math.random — PROIBIDO (som sequencial).

--[[
═══════════════════════════════════════════════════════════════
                    LISTA DE CUSTOMIZAÇÃO
═══════════════════════════════════════════════════════════════
--]]

local CONFIG = {
	-- ========== LANÇAMENTO NORMAL ==========
	NormalDamage    = 18,
	NormalSpeed     = 80,
	NormalDistance   = 50,
	NormalCooldown  = 1,
	NormalKnockback = 15,

	-- ========== LANÇAMENTO CARREGADO ==========
	ChargedDamage    = 32,
	ChargedSpeed     = 100,
	ChargedDistance   = 80,
	ChargedCooldown  = 2,
	ChargedKnockback = 25,

	-- ========== MULTI-LANÇAMENTO ==========
	MultiCount    = 3,
	MultiDamage   = 14,
	MultiSpeed    = 90,
	MultiSpread   = 15,
	MultiCooldown = 3,

	-- ========== SISTEMA DE COMBO ==========
	ComboTimeWindow    = 3,
	ComboDamageBonus   = 0.10,
	MaxComboMultiplier = 2.0,

	-- ========== EFEITOS VISUAIS ==========
	TrailLifetime     = 0.5,
	TrailColor        = Color3.new(0, 0.7, 1),
	ChargedTrailColor = Color3.new(1, 0.5, 0),
	ParticleRate      = 20,
	ExplosionSize     = 8,
	ExplosionDuration = 1,

	-- ========== SONS ==========
	ThrowSoundPitch   = 1.5,
	HitSoundPitch     = 2.0,
	ReturnSoundPitch  = 1.0,
	ChargedSoundPitch = 0.8,

	-- ========== ANIMAÇÃO ==========
	AnimationLerpSpeed = 0.2,

	-- ========== NPC ==========
	NPCDetectRange  = 50,
	NPCCooldownTime = 3,

	-- ========== DETECÇÃO ==========
	HitRadius = 5,
}

--[[
═══════════════════════════════════════════════════════════════
                    CÓDIGO PRINCIPAL
═══════════════════════════════════════════════════════════════
--]]

-- ========== SERVIÇOS ==========
local Services = {
	Players      = game:GetService("Players"),
	RunService   = game:GetService("RunService"),
	TweenService = game:GetService("TweenService"),
}

-- ========== VARIÁVEIS GLOBAIS ==========
local Tool   = script.Parent
local Handle = Tool:WaitForChild("Handle")

local equipsound  = Handle:WaitForChild("equip", 10)
local blocksounds = {
	Handle:WaitForChild("block", 10),
	Handle:WaitForChild("block2", 10),
	Handle:WaitForChild("block3", 10),
	Handle:WaitForChild("block4", 10),
}

local owner, character, charhum, rootpart
local equipped = false

-- Cooldowns
local normalCooldown  = false
local chargedCooldown = false
local multiCooldown   = false

-- Combo
local currentCombo = 0
local lastHitTime  = 0

-- Som sequencial (PROIBIDO math.random)
local soundIndex = 1

-- ========== TABELAS DE EFEITOS ATIVOS ==========
local ActiveBoomerangs = {}
local ActiveEffects = {
	Parts            = {},
	Sounds           = {},
	Connections      = {},
	Trails           = {},
	Welds            = {},
	AnimationThreads = {},
}
local CleanupConnections = {}

-- Referências de Welds (escopo módulo para limpeza segura)
local weldRightArm = nil
local weldHead     = nil
local weldRootPart = nil

-- ========== REMOTEEVENT ==========
local remoteEvent = Tool:FindFirstChild("RemoteEvent")
if not remoteEvent then
	remoteEvent        = Instance.new("RemoteEvent")
	remoteEvent.Name   = "RemoteEvent"
	remoteEvent.Parent = Tool
end

-- ========== SISTEMA ANTI-FRIENDLY FIRE ==========
local function IsAlly(char1, char2)
	if not char1 or not char2 then return false end
	if char1 == char2 then return true end

	local p1 = Services.Players:GetPlayerFromCharacter(char1)
	local p2 = Services.Players:GetPlayerFromCharacter(char2)

	if p1 and p2 then
		if not p1.Neutral and not p2.Neutral then
			return p1.Team == p2.Team
		end
	end

	local cf1 = char1:FindFirstChild("ControlFollow")
	local cf2 = char2:FindFirstChild("ControlFollow")
	if cf1 and cf2 then
		return cf1.Owner.Value == cf2.Owner.Value
	end

	return false
end

-- ========== SOM SEQUENCIAL ==========
local function PlaySound(index, parent, pitch)
	local snd = blocksounds[index]
	if not snd then return end
	local clone = snd:Clone()
	clone.Parent = parent
	clone.Pitch  = pitch or 1
	clone:Play()
	table.insert(ActiveEffects.Sounds, clone)
	task.delay(2, function()
		if clone and clone.Parent then clone:Stop(); clone.Parent = nil end
	end)
end

-- ========== SISTEMA DE LIMPEZA ==========
local function CleanupAnimationWelds()
	for _, th in pairs(ActiveEffects.AnimationThreads) do
		if th then task.cancel(th) end
	end
	ActiveEffects.AnimationThreads = {}

	if weldRightArm and weldRightArm.Parent then weldRightArm.Parent = nil end
	weldRightArm = nil
	if weldHead and weldHead.Parent then weldHead.Parent = nil end
	weldHead = nil
	if weldRootPart and weldRootPart.Parent then weldRootPart.Parent = nil end
	weldRootPart = nil
end

local function CleanupAllEffects()
	CleanupAnimationWelds()

	for _, b in pairs(ActiveBoomerangs) do
		if b and b.Parent then b.Parent = nil end
	end
	ActiveBoomerangs = {}

	for _, p in pairs(ActiveEffects.Parts) do
		if p and p.Parent then p.Parent = nil end
	end
	ActiveEffects.Parts = {}

	for _, s in pairs(ActiveEffects.Sounds) do
		if s and s.Parent then s:Stop(); s.Parent = nil end
	end
	ActiveEffects.Sounds = {}

	for _, c in pairs(ActiveEffects.Connections) do
		if c then c:Disconnect() end
	end
	ActiveEffects.Connections = {}

	for _, t in pairs(ActiveEffects.Trails) do
		if t and t.Parent then t.Enabled = false end
	end
	ActiveEffects.Trails = {}

	currentCombo = 0

	-- Restaurar Handle
	if Handle and Handle.Parent then
		Handle.Transparency = 0
	end
end

-- ========== SISTEMA DE COMBO ==========
local function UpdateCombo()
	local now = tick()
	if now - lastHitTime > CONFIG.ComboTimeWindow then
		currentCombo = 0
	end
	currentCombo = currentCombo + 1
	lastHitTime  = now

	return math.min(1 + (currentCombo * CONFIG.ComboDamageBonus), CONFIG.MaxComboMultiplier)
end

-- ========== EFEITO DE HIT ==========
local function CreateHitEffect(position, isCombo)
	local fx      = Instance.new("Part")
	fx.Name       = "HitEffect"
	fx.Size       = Vector3.new(3, 3, 3)
	fx.Material   = Enum.Material.Neon
	fx.BrickColor = isCombo and BrickColor.new("New Yeller") or BrickColor.new("Electric blue")
	fx.CanCollide = false
	fx.CanTouch   = false
	fx.Anchored   = true
	fx.Shape      = Enum.PartType.Ball
	fx.CFrame     = CFrame.new(position)
	fx.Parent     = workspace
	table.insert(ActiveEffects.Parts, fx)

	task.spawn(function()
		for i = 0, 10 do
			if not fx or not fx.Parent then break end
			fx.Transparency = i * 0.1
			fx.Size = fx.Size + Vector3.new(0.5, 0.5, 0.5)
			task.wait(0.03)
		end
		if fx and fx.Parent then fx.Parent = nil end
	end)
end

-- ========== EXPLOSÃO DE RETORNO ==========
local function CreateReturnExplosion(position)
	local fx      = Instance.new("Part")
	fx.Name       = "ReturnExplosion"
	fx.Size       = Vector3.new(CONFIG.ExplosionSize, CONFIG.ExplosionSize, CONFIG.ExplosionSize)
	fx.Material   = Enum.Material.Neon
	fx.Color      = CONFIG.TrailColor
	fx.Transparency = 0.5
	fx.CanCollide = false
	fx.CanTouch   = false
	fx.Anchored   = true
	fx.Shape      = Enum.PartType.Ball
	fx.CFrame     = CFrame.new(position)
	fx.Parent     = workspace
	table.insert(ActiveEffects.Parts, fx)

	local particles     = Instance.new("ParticleEmitter")
	particles.Texture   = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Rate      = 100
	particles.Lifetime  = NumberRange.new(1)
	particles.Speed     = NumberRange.new(10)
	particles.Color     = ColorSequence.new(CONFIG.TrailColor)
	particles.Size      = NumberSequence.new(1)
	particles.Parent    = fx
	particles:Emit(30)

	Services.TweenService:Create(
		fx,
		TweenInfo.new(CONFIG.ExplosionDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			Size = Vector3.new(CONFIG.ExplosionSize * 2, CONFIG.ExplosionSize * 2, CONFIG.ExplosionSize * 2),
			Transparency = 1
		}
	):Play()

	task.delay(CONFIG.ExplosionDuration + 0.5, function()
		if fx and fx.Parent then fx.Parent = nil end
	end)
end

-- ========== CRIAR TRAIL ==========
local function CreateTrail(part, color)
	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, 1, 0)
	att1.Parent   = part

	local att2 = Instance.new("Attachment")
	att2.Position = Vector3.new(0, -1, 0)
	att2.Parent   = part

	local trail        = Instance.new("Trail")
	trail.Attachment0  = att1
	trail.Attachment1  = att2
	trail.Lifetime     = CONFIG.TrailLifetime
	trail.FaceCamera   = true
	trail.Color        = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = part
	table.insert(ActiveEffects.Trails, trail)
end

-- ========== CHECK HIT ==========
local function CheckHit(boomerang, damage, knockback, hitTargets, phase)
	for _, v in pairs(workspace:GetChildren()) do
		if v:IsA("Model") and v ~= character and not hitTargets[v] then
			local hum   = v:FindFirstChildOfClass("Humanoid")
			local torso = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")

			if hum and torso and hum.Health > 0 then
				if (torso.Position - boomerang.Position).Magnitude < CONFIG.HitRadius then
					if not IsAlly(character, v) then
						local comboMult   = UpdateCombo()
						local finalDamage = damage * comboMult

						hum:TakeDamage(finalDamage)
						hitTargets[v] = true

						-- Som sequencial
						PlaySound(soundIndex, torso, CONFIG.HitSoundPitch)
						soundIndex = (soundIndex % #blocksounds) + 1

						CreateHitEffect(torso.Position, currentCombo >= 3)

						-- Knockback
						local knockVel     = Instance.new("BodyVelocity")
						knockVel.MaxForce  = Vector3.new(math.huge, 0, math.huge)
						knockVel.Velocity  = (torso.Position - boomerang.Position).Unit * knockback
						knockVel.Parent    = torso
						task.delay(0.2, function()
							if knockVel and knockVel.Parent then knockVel.Parent = nil end
						end)

						-- Na ida, permite re-hit após 0.5s
						if phase == "going" then
							task.delay(0.5, function()
								hitTargets[v] = nil
							end)
						end
					end
				end
			end
		end
	end
end

-- ========== FUNÇÃO PRINCIPAL DE LANÇAMENTO ==========
local function ThrowBoomerang(targetPosition, mode)
	local damage, speed, distance, knockback, trailColor

	if mode == "normal" then
		damage     = CONFIG.NormalDamage
		speed      = CONFIG.NormalSpeed
		distance   = CONFIG.NormalDistance
		knockback  = CONFIG.NormalKnockback
		trailColor = CONFIG.TrailColor
	elseif mode == "charged" then
		damage     = CONFIG.ChargedDamage
		speed      = CONFIG.ChargedSpeed
		distance   = CONFIG.ChargedDistance
		knockback  = CONFIG.ChargedKnockback
		trailColor = CONFIG.ChargedTrailColor
	elseif mode == "multi" then
		damage     = CONFIG.MultiDamage
		speed      = CONFIG.MultiSpeed
		distance   = CONFIG.NormalDistance
		knockback  = CONFIG.NormalKnockback
		trailColor = CONFIG.TrailColor
	end

	-- Esconder Handle original
	Handle.Transparency = 1

	-- Criar clone do boomerang
	local boomerang = Handle:Clone()
	boomerang.Name  = "BoomerangShield"
	boomerang.Transparency = 0
	boomerang.CanCollide   = false
	boomerang.CanTouch     = false
	boomerang.CFrame       = Handle.CFrame
	boomerang.Parent       = workspace
	table.insert(ActiveBoomerangs, boomerang)

	-- Remover sons do clone
	for _, child in pairs(boomerang:GetChildren()) do
		if child:IsA("Sound") then child.Parent = nil end
	end

	-- Som de lançamento
	PlaySound(1, boomerang, mode == "charged" and CONFIG.ChargedSoundPitch or CONFIG.ThrowSoundPitch)

	-- Trail
	CreateTrail(boomerang, trailColor)

	-- Partículas
	local particles      = Instance.new("ParticleEmitter")
	particles.Texture    = "rbxassetid://1084969997"
	particles.Color      = ColorSequence.new(trailColor)
	particles.Size       = NumberSequence.new(0.5)
	particles.Lifetime   = NumberRange.new(0.5)
	particles.Rate       = CONFIG.ParticleRate
	particles.Speed      = NumberRange.new(3)
	particles.SpreadAngle = Vector2.new(30, 30)
	particles.Parent     = boomerang

	-- Física
	local bodyVel     = Instance.new("BodyVelocity")
	bodyVel.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
	bodyVel.Parent    = boomerang

	local bodyAngVel            = Instance.new("BodyAngularVelocity")
	bodyAngVel.AngularVelocity  = Vector3.new(0, 20, 0)
	bodyAngVel.MaxTorque        = Vector3.new(0, math.huge, 0)
	bodyAngVel.Parent           = boomerang

	local direction     = (targetPosition - boomerang.Position).Unit
	local startPosition = boomerang.Position
	local hitTargets    = {}

	-- Lançamento assíncrono
	task.spawn(function()
		-- FASE 1: Ida
		local traveled = 0
		while traveled < distance and boomerang and boomerang.Parent do
			bodyVel.Velocity = direction * speed
			CheckHit(boomerang, damage, knockback, hitTargets, "going")
			traveled = (boomerang.Position - startPosition).Magnitude
			task.wait(0.03)
		end

		-- Som de retorno
		PlaySound(3, boomerang, CONFIG.ReturnSoundPitch)

		-- FASE 2: Volta
		while boomerang and boomerang.Parent and Handle and Handle.Parent do
			local returnDir = (Handle.Position - boomerang.Position).Unit
			bodyVel.Velocity = returnDir * (speed * 0.75)
			CheckHit(boomerang, damage, knockback, hitTargets, "returning")

			if (boomerang.Position - Handle.Position).Magnitude < 3 then
				break
			end
			task.wait(0.03)
		end

		-- Limpeza
		if boomerang and boomerang.Parent then
			CreateReturnExplosion(boomerang.Position)
			boomerang.Parent = nil
		end

		if Handle and Handle.Parent then
			Handle.Transparency = 0
		end
	end)
end

-- ========== MULTI-LANÇAMENTO ==========
local function ThrowMultiBoomerang(targetPosition)
	local centerDir = (targetPosition - Handle.Position).Unit

	for i = 1, CONFIG.MultiCount do
		local angleOffset = (i - (CONFIG.MultiCount + 1) / 2) * CONFIG.MultiSpread
		local radians     = math.rad(angleOffset)
		local rotatedDir  = CFrame.new(Vector3.new(), centerDir) * CFrame.Angles(0, radians, 0)
		local newTarget   = Handle.Position + (rotatedDir.LookVector * CONFIG.NormalDistance)

		task.wait(0.1)
		ThrowBoomerang(newTarget, "multi")
	end
end

-- ========== REMOTEEVENT HANDLER ==========
remoteEvent.OnServerEvent:Connect(function(player, action, mouseHit)
	if player ~= owner or not equipped then return end

	if action == "throw" and not normalCooldown then
		normalCooldown = true
		ThrowBoomerang(mouseHit, "normal")
		task.wait(CONFIG.NormalCooldown)
		normalCooldown = false

	elseif action == "throwCharged" and not chargedCooldown then
		chargedCooldown = true
		ThrowBoomerang(mouseHit, "charged")
		task.wait(CONFIG.ChargedCooldown)
		chargedCooldown = false

	elseif action == "throwMulti" and not multiCooldown then
		multiCooldown = true
		ThrowMultiBoomerang(mouseHit)
		task.wait(CONFIG.MultiCooldown)
		multiCooldown = false
	end
end)

-- ========== SISTEMA DE NPC ==========
local NPCCooldown = false

local function FindNearestEnemy(pos)
	local nearest = nil
	local dist    = CONFIG.NPCDetectRange

	for _, model in pairs(workspace:GetChildren()) do
		if model:IsA("Model") and model ~= character then
			local hum  = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 and not IsAlly(character, model) then
				local d = (root.Position - pos).Magnitude
				if d < dist then
					nearest = model
					dist    = d
				end
			end
		end
	end

	return nearest
end

task.spawn(function()
	while task.wait(1) do
		if equipped and not owner and not NPCCooldown then
			if rootpart and rootpart.Parent then
				local enemy = FindNearestEnemy(rootpart.Position)
				if enemy then
					local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
					if enemyRoot then
						NPCCooldown = true
						ThrowBoomerang(enemyRoot.Position, "normal")
						task.wait(CONFIG.NPCCooldownTime)
						NPCCooldown = false
					end
				end
			end
		end
	end
end)

-- ========== EQUIPAR ==========
Tool.Equipped:Connect(function()
	equipped  = true
	owner     = Services.Players:GetPlayerFromCharacter(Tool.Parent)
	character = Tool.Parent
	charhum   = character:FindFirstChildOfClass("Humanoid")
	rootpart  = character:FindFirstChild("HumanoidRootPart")

	if not charhum or not rootpart then return end

	if equipsound then equipsound:Play() end

	-- Resetar
	normalCooldown  = false
	chargedCooldown = false
	multiCooldown   = false
	currentCombo    = 0

	-- RightGrip CFrame
	local rightArm = character:FindFirstChild("Right Arm")
	if rightArm then
		local rg = rightArm:FindFirstChild("RightGrip")
		if rg then
			rg.C0 = CFrame.new(
				0.409522653, -0.000911712646, 0.516324997,
				-0.0116359973, -0.0435790196, -0.998981893,
				0.999929667, 0.00166221452, -0.0117195444,
				0.0021712482, -0.999047935, 0.0435565971
			)
		end
	end

	-- Criar Welds de animação
	local torso = character:FindFirstChild("Torso")
	if torso and rightArm then
		weldRightArm       = Instance.new("Weld")
		weldRightArm.Part0 = torso
		weldRightArm.Part1 = rightArm
		weldRightArm.C0    = CFrame.new(1.5, 0, 0)
		weldRightArm.Name  = "RightArmWeldshield"
		weldRightArm.Parent = torso

		local headPart = character:FindFirstChild("Head")
		if headPart then
			weldHead       = Instance.new("Weld")
			weldHead.Part0 = torso
			weldHead.Part1 = headPart
			weldHead.C0    = CFrame.new(0, 1.5, 0)
			weldHead.Name  = "HeadWeldshield"
			weldHead.Parent = torso

			weldRootPart       = Instance.new("Weld")
			weldRootPart.Part0 = rootpart
			weldRootPart.Part1 = torso
			weldRootPart.Name  = "HumanoidRootPartWeldshield"
			weldRootPart.Parent = rootpart

			-- Thread de animação
			local animThread = task.spawn(function()
				while equipped do
					Services.RunService.Stepped:Wait()
					if not weldRightArm or not weldRightArm.Parent then break end

					if normalCooldown or chargedCooldown or multiCooldown then
						weldRightArm.C0 = weldRightArm.C0:lerp(
							CFrame.new(1.5, 0.5, -0.5) * CFrame.Angles(math.rad(90), 0, 0), 0.3)
						weldHead.C0 = weldHead.C0:lerp(
							CFrame.new(0, 1.5, 0), 0.3)
						weldRootPart.C0 = weldRootPart.C0:lerp(
							CFrame.new(), 0.3)
					else
						weldRightArm.C0 = weldRightArm.C0:lerp(
							CFrame.new(1.40557981, 0.499999762, -0.579227924, 0.98480767, 0.173648134, 3.55271368e-15, -4.39884928e-08, 2.49471157e-07, -0.999999821, -0.173648134, 0.98480767, 2.5331974e-07),
							CONFIG.AnimationLerpSpeed)
						weldHead.C0 = weldHead.C0:lerp(
							CFrame.new(0, 1.49999976, 0, 0.173648208, 0, -0.98480767, 0, 0.999999881, 0, 0.98480767, 0, 0.173648208),
							CONFIG.AnimationLerpSpeed)
						weldRootPart.C0 = weldRootPart.C0:lerp(
							CFrame.new(0, 0, 0, 0.173648134, 0, 0.98480773, 0, 0.99999994, 0, -0.98480773, 0, 0.173648134),
							CONFIG.AnimationLerpSpeed)
					end
				end
			end)
			table.insert(ActiveEffects.AnimationThreads, animThread)
		end
	end

	-- Conexão de morte
	if charhum then
		CleanupConnections.Died = charhum.Died:Connect(function()
			CleanupAllEffects()
		end)
	end
end)

-- ========== DESEQUIPAR ==========
Tool.Unequipped:Connect(function()
	equipped        = false
	normalCooldown  = false
	chargedCooldown = false
	multiCooldown   = false

	CleanupAllEffects()

	for _, conn in pairs(CleanupConnections) do
		if conn then conn:Disconnect() end
	end
	CleanupConnections = {}
end)

-- ========== LIMPEZA AO REMOVER TOOL ==========
Tool.AncestryChanged:Connect(function()
	if not Tool.Parent then
		CleanupAllEffects()
		for _, conn in pairs(CleanupConnections) do
			if conn then conn:Disconnect() end
		end
		CleanupConnections = {}
	end
end)]]></ProtectedString>
