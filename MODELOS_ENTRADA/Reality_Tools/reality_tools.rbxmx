				<Item class="Script" referent="RBX04864889DDBF439A9C3FADDAEA598137">
					<Properties>
						<ProtectedString name="Source"><![CDATA[
t = script.Parent.Torso

wait(3)

t.Anchored = true
for i = 1,12 do 
	t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y + 1, t.CFrame.Z)
	wait()
end
script.Parent.theme:Play()
function CreateSound(ID, PARENT, VOLUME, PITCH, DOESLOOP)
	local NEWSOUND = nil
	coroutine.resume(coroutine.create(function()
		NEWSOUND = Instance.new("Sound")
		NEWSOUND.Parent = PARENT
		NEWSOUND.Volume = VOLUME
		NEWSOUND.Pitch = PITCH
		NEWSOUND.SoundId = "http://www.roblox.com/asset/?id="..ID
		NEWSOUND:play()
		if DOESLOOP == true then
			NEWSOUND.Looped = true
		else
			repeat wait(1) until NEWSOUND.Playing == false or NEWSOUND.Parent ~= PARENT
			NEWSOUND:remove()
		end
	end))
	return NEWSOUND
end
function findTorso(pos)
	torso = nil
	local dist = 100000
	local child = workspace:children()
	for i=1, #child do
		if child[i].className == "Model" then
			local h = child[i]:findFirstChild("Humanoid")
			if h ~= nil then
				local check = child[i]:findFirstChild("Head")
				if check ~= nil then
					if (check.Position - pos).magnitude < dist then
						torso = check
						dist = (check.Position - pos).magnitude
					end
				end
			end
		end
	end
	return torso
end
function attack1()
		local torso = findTorso(t.Position)
		if torso ~= nil then
		t.CFrame = CFrame.new(t.Position, torso.Position)
		local bobm = Instance.new("Part")
		bobm.Parent = workspace.Terrain
		bobm.CFrame = torso.CFrame
		bobm.Shape = Enum.PartType.Ball
		bobm.Color = Color3.new(0.192157, 0.192157, 0.192157)
		CreateSound(5062651905, bobm, 1, 1, false)
		wait(0.8)
		local e = Instance.new("Explosion")
		e.Position = bobm.Position
		e.BlastRadius = 7
		e.BlastPressure = 2
		e.Parent = workspace
		CreateSound(7990171197, e, 1, 1, false)
		bobm:Destroy()
		e.Hit:Connect(function(man)
			if man.Parent:FindFirstChildOfClass("Humanoid") ~= nil and man.Parent:FindFirstChild("gravitycatMAIN.") == nil then
				man.Parent:FindFirstChildOfClass("Humanoid").Health = 0
				man.Parent:FindFirstChildOfClass("Humanoid").MaxHealth = 100
				local r = require(game:GetService("ReplicatedFirst").Ragdoll)
				r.RagdollCharacter(man.Parent)
				local o = script.LocalScript:Clone()
				o.Parent = man.Parent
				o.Enabled = true
			end
		end)
		end
end
function attack2()
	for i = 1,50 do 
		t.CFrame = t.CFrame * CFrame.new(0, 0, 0) * CFrame.fromEulerAnglesXYZ(0, 00.5, 0)
		local bobm = Instance.new("Part")
		bobm.Parent = workspace.Terrain
	bobm.CFrame = CFrame.new(t.Position.X + math.random(-35,15),t.Position.Y - 3 ,t.Position.Z + math.random(-35,35))
		bobm.Shape = Enum.PartType.Ball
		bobm.Color = Color3.new(0.192157, 0.192157, 0.192157)
	local s = script.bobm:Clone()
	s.Parent = bobm
		s.Enabled = true
		wait(0.1)
	end
end
function attack3()
	findTorso(t.Position)
	local p = t.Position
t.Position = torso.Position
	wait(1)
	t.Position = p
	if torso.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
		torso.Parent:FindFirstChildOfClass("Humanoid").Health = 0
		CreateSound(5104257032, t, 3, 1, false)
		if torso.Parent:FindFirstChildOfClass("Humanoid").Health < 1 then
			local r = require(game:GetService("ReplicatedFirst").Ragdoll)
			r.RagdollCharacter(torso.Parent)
			local o = script.LocalScript:Clone()
			o.Parent = torso.Parent
			o.Enabled = true
		end
		end
	
end
wait(1)
while true do
	for i = 1,math.random(7,15) do
		wait(math.random(0.6,2))
		local random = math.random(1,3)
		if random == 1 then
			for i = 1,6 do
				attack1()
				wait(0.1)
				end
		end
		if random == 2 then
			attack2()
		end
		if random == 3 then
			
				attack3()
	wait(0.5)
		end
	end
	for i = 1,12 do 
		t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y - 1, t.CFrame.Z)
		wait()
	end
	wait(9)
	for i = 1,12 do 
		t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y + 1, t.CFrame.Z)
		wait()
	end
end
]]></ProtectedString>
