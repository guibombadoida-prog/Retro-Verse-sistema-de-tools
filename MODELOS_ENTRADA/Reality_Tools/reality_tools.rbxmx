		<Item class="Script" referent="RBX8C52735AF5D2413299477EB88BBB829A">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--By Rufus14
local players = game:GetService("Players")
local tool = script.Parent
local handle = tool.Handle
local light = handle.SpotLight
local owner
local character
local charhum
--
local catchmagnitude = 32
local catchangle = -0.5
local frozentime = 4

local equiptick = os.clock()
local lightbrightness = light.Brightness
local using = false
local freezeparts = false --incase you also want to freeze parts
local soundtable = {}
local sounddata = { --id, vol
	["equip1"] = {"9113672388", 0.5},
	["equip2"] = {"9113672349", 0.5},
	["prepare1"] = {"9113675530", 1},
	["takephoto"] = {"9125423670", 3},
	["charge"] = {"6832473701", 1},
	["release"] = {"9113690849", 0.15},
}
local peopletable = {}

local addhumtopeople = function(humanoid)
	pcall(function()
		if humanoid.Parent:WaitForChild("Head") then
			peopletable[humanoid] = humanoid.Parent.Head
			humanoid.Died:Connect(function()
				peopletable[humanoid] = nil
			end)
		end
	end)
end

local playsound = function(name, parent, speed, timepos)
	if soundtable[name] then
		local thesound = soundtable[name]
		thesound.PlaybackSpeed = speed
		thesound.TimePosition = timepos or 0
		thesound.Parent = parent
		thesound.Parent = nil
	end
end

local checkifinradius = function(part)
	local diff = (handle.Position - part.Position)
	local unit = diff.Unit
	local dot = handle.CFrame.LookVector:Dot(unit)
	return dot, diff.Magnitude
end

for i,v in pairs(workspace:GetDescendants()) do
	if v.ClassName == "Humanoid" and v.Health > 0 then
		addhumtopeople(v)
	end
end

workspace.DescendantAdded:Connect(function(WHAT)
	if WHAT.ClassName == "Humanoid" then
		addhumtopeople(WHAT)
	end
end)

for i,v in pairs(sounddata) do
	local thesound = Instance.new("Sound")
	thesound.SoundId = "rbxassetid://"..v[1]
	thesound.Volume = v[2]
	thesound.RollOffMinDistance = 1
	thesound.RollOffMode = Enum.RollOffMode.LinearSquare
	thesound.PlayOnRemove = true
	soundtable[i] = thesound
end

tool.Equipped:Connect(function()
	equiptick = os.clock()
	owner = players:GetPlayerFromCharacter(tool.Parent)
	character = owner.Character
	charhum = character:FindFirstChildOfClass("Humanoid")
	local backuptick = equiptick
	tool.Grip = CFrame.new(0.7,-0.3,0.25)
	playsound("equip"..math.random(1,2), handle, 1+math.random(-20,20)/100)
	while equiptick == backuptick and tool.Parent:FindFirstChildOfClass("Humanoid") do
		for i,v in pairs(peopletable) do
			if not i:IsDescendantOf(workspace) then
				peopletable[i] = nil
			end
		end
		task.wait(2)
	end
end)
tool.Activated:Connect(function()
	if using or os.clock() < (equiptick + 0.3) then return end
	using = true
	local frozenpeople = {}
	task.spawn(function()
		light.Enabled = true
		light.Brightness = lightbrightness
		for i = 0,1, 0.125 do
			light.Brightness = lightbrightness - (lightbrightness*i)
			task.wait()
		end
		light.Enabled = false
	end)
	for i,v in pairs(peopletable) do
		if v:IsDescendantOf(workspace) and v.Parent ~= tool.Parent then
			local dot, mag = checkifinradius(v)
			if dot < catchangle and mag < catchmagnitude then
				local alllimbs = {}
				for q,w in pairs(v.Parent:GetChildren()) do
					if w:IsA("BasePart") and not w.Anchored then
						w.Anchored = true
						table.insert(alllimbs,w)
					end
				end
				if #alllimbs > 0 then
					frozenpeople[i] = v
				end
				task.spawn(function()
					task.wait(frozentime)
					for q,w in pairs(alllimbs) do
						w.Anchored = false
						alllimbs[q] = nil --clear the table incase
					end
				end)
			end
		end
	end
	if freezeparts then
		local frozenparts = {}
		for i,v in pairs(workspace:GetDescendants()) do --im so sorry
			if v:IsA("BasePart") and not v.Anchored and not v:IsDescendantOf(character) then
				local dot, mag = checkifinradius(v)
				if dot < catchangle and mag < catchmagnitude then
					table.insert(frozenparts, v)
					v.Anchored = true
				end
			end
		end
		task.spawn(function()
			task.wait(frozentime)
			for i,v in pairs(frozenparts) do
				v.Anchored = false
				frozenparts[i] = nil
			end
		end)
	end
	task.spawn(function()
		task.wait(frozentime-3.1)
		for i,v in pairs(frozenpeople) do
			if v:IsDescendantOf(workspace) then
				playsound("release", v, 1)
			end
		end
	end)
	playsound("takephoto", handle, 1+math.random(-20,20)/100, 0.2)
	task.wait(0.21)
	playsound("charge", handle, 1+math.random(-20,20)/100)
	task.wait(2)
	playsound("prepare1", handle, 1+math.random(-20,20)/120)
	using = false
end)]]></ProtectedString>
