		<Item class="Script" referent="RBX945EECBFE39840ACB0ED2010FBB66F85">
			<Properties>
				<ProtectedString name="Source"><![CDATA[script.Slime.Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage.Slime:Clone()
	AI.Parent = game.Workspace
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
end)
]]></ProtectedString>
