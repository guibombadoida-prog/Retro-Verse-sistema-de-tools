			<Item class="Script" referent="RBXD72CC89F460F472299E20C4272601859">
				<Properties>
					<ProtectedString name="Source"><![CDATA[

local FlingAmount = 20 	--sky
local sound = true			--well i mean its defau; so..
local sit = true			--If it makes the player sit.
local e = false				--Do not change.
local explode = true		--This one just kills you
local banish_table = {}

function write(textbox,text)
	for i = 1,#text,1 do
		textbox.Text = string.sub(text,1,i)
		script.Parent.e.Pitch = math.random(0.95,1.5)
		script.Parent.e:Play()
		wait(0.005)
	end
	wait(1)
	textbox.Text = " "
end
function hit(Touch) 
	local blender = Touch.Parent:FindFirstChild("Head") 
	if not (blender == nil) then
		if e == false and Touch.Parent.Name ~= "ded" then
			
		
			
		
			e = true
			local bv = Instance.new("BodyVelocity")
			bv.P = 12500
			bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
			bv.Velocity = blender.CFrame.lookVector*-math.huge
			bv.Parent = blender
			if sit == true then
				local scream = script.Parent.Sound:Clone()
				scream.Parent = Touch.Parent.Head
				scream:Play()
				Touch.Parent:FindFirstChild("Humanoid").Sit = true
			
				
			end
			if sound == true then
				local s = script.Parent.slaps
				local random = math.random(8,12)/10
				s.PlaybackSpeed = 1
				s:Play()
				script.Parent.Sound:Play()
			end
			wait(.0)
			bv:Destroy()
			wait(.02)

			e = false
			wait(0)
			Touch.Parent.Archivable = true
			local clone = Touch.Parent:Clone()
			clone.Name = "ded"
			clone.Parent = workspace
			clone:BreakJoints()
			clone.Head.Position = Touch.Position
			game.Debris:AddItem(clone,12)
			table.insert(banish_table, Touch.Parent)
			local random_txt = math.random(1,10)
			if random_txt == 1 then
				write(script.Parent.BillboardGui.TextBox, "bro just got banished")
			end
			if random_txt == 2 then
				write(script.Parent.BillboardGui.TextBox, "i will send you to nether")
			end
			if random_txt == 3 then
				write(script.Parent.BillboardGui.TextBox, "no more fortnite")
			end
			if random_txt == 4 then
				write(script.Parent.BillboardGui.TextBox, "died of death")
			end
			if random_txt == 5 then
				write(script.Parent.BillboardGui.TextBox, "sent you to the gulag")
			end
			if random_txt == 6 then
				write(script.Parent.BillboardGui.TextBox, "you forgor")
			end
			if random_txt == 7 then
				write(script.Parent.BillboardGui.TextBox, "360 noscoped")
			end
			if random_txt == 8 then
				write(script.Parent.BillboardGui.TextBox, "tf2 random crit moment")
			end
			if random_txt == 9 then
				write(script.Parent.BillboardGui.TextBox, "go commit not exist")
			end
			if random_txt == 10 then
				write(script.Parent.BillboardGui.TextBox, "you are not alive")
			end
			if explode == true then
			end
wait(1)


		end
	end 
end

script.Parent.Touched:connect(hit)
while true do
	for i,v in pairs(banish_table) do
		v:Destroy()
		if workspace:FindFirstChild(v.Name) ~= nil then

			workspace:FindFirstChild(v.Name):Destroy()
		end
		if workspace.Terrain:FindFirstChild(v.Name) ~= nil then
			workspace.Terrain:FindFirstChild(v.Name):Destroy()
		end
	end
	wait()
end]]></ProtectedString>
