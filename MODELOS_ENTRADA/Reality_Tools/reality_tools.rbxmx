		<Item class="Script" referent="RBX3AC5665AF0214C1CAE8CD9B327AB8C31">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--By Rufus14
tool = script.Parent
handle = tool.Handle
players = game:GetService("Players")
runservice = game:GetService("RunService")
character = nil
owner = nil
equipped = false
anim = "idle"
----------
handle.ChildRemoved:connect(function(WHAT)
	if WHAT.ClassName == "Sound" then
		local backupyeaah = Instance.new("Sound", handle)
		backupyeaah.SoundId = WHAT.SoundId
		backupyeaah.Name = WHAT.Name
		backupyeaah.Volume = WHAT.Volume
		backupyeaah.TimePosition = WHAT.TimePosition
		backupyeaah.Playing = WHAT.Playing
	end
end)
----------
tool.Activated:connect(function()
	handle.thud:Play()
	handle.thud.TimePosition = 0.3
	local model = Instance.new("Model", workspace)
	model.Name = "ban"
	local humfake = Instance.new("Humanoid", model)
	humfake.MaxHealth = 0
	humfake.Health = 0
	local beam = Instance.new("FlagStand", model)
	beam.Size = Vector3.new(0.5,0.5,2)
	beam.BrickColor = BrickColor.Red()
	beam.Name = "Head"
	beam.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0,1.5,-5)
	beam.Material = "Neon"
	Instance.new("SpecialMesh", beam).MeshType = "Sphere"
	beam.Touched:connect(function(WHAT)
		local h = WHAT.Parent:findFirstChildOfClass("Humanoid")
		if h then
			if h.Parent == character then return end
			for i,v in pairs(h.Parent:GetDescendants()) do
				v:destroy()
			end
			local soundbrick = Instance.new("FlagStand", tool)
			soundbrick.Anchored = true
			soundbrick.CanCollide = false
			soundbrick.Transparency = 1
			soundbrick.Size = Vector3.new(0.1,0.1,0.1)
			soundbrick.CFrame = beam.CFrame
			local s = Instance.new("Sound", soundbrick)
			s.SoundId = "rbxassetid://1392276089"
			s.Volume = 5
			s:Play()
			game.Debris:AddItem(soundbrick, 3)
			beam:destroy()
		end
	end)
	local velocity = Instance.new("BodyVelocity", beam)
	velocity.MaxForce = Vector3.new(math.huge,0,math.huge)
	velocity.Velocity = beam.CFrame.lookVector * 200
	game.Debris:AddItem(model, 5)
	game.Debris:AddItem(velocity, 1)
	for i = 1,3 do
		local effect = Instance.new("FlagStand", tool)
		effect.Size = Vector3.new(0.5,0.5,0.5)
		effect.Anchored = true
		effect.CanCollide = false
		effect.BrickColor = BrickColor.Red()
		effect.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0,1.5,-7)
		effect.Material = "Neon"
		coroutine.wrap(function()
			local xrandom = math.random(-1,1)
			local yrandom = math.random(-1,1)
			local zrandom = math.random(-1,1)
			for i = 1,10 do
				effect.CFrame = effect.CFrame * CFrame.fromEulerAnglesYXZ(xrandom/3, yrandom/3, zrandom/3)
				effect.Transparency = effect.Transparency + 0.1
				effect.Size = effect.Size + Vector3.new(0.1,0.1,0.1)
				runservice.Stepped:wait()
			end
		end)()
	end
end)
----------
tool.Equipped:connect(function()
	equipped = true
	owner = players:GetPlayerFromCharacter(tool.Parent)
	character = owner.Character
	handle.theme:Play()
	local rightgrip = character["Right Arm"]:WaitForChild("RightGrip")
	rightgrip.C0 = CFrame.new(-0.00291109085, -0.808973312, -0.217943192, 0.999945521, -0.00986599829, -0.00341791473, -0.00352935679, -0.011299599, -0.999929965, 0.00982669368, 0.999887645, -0.0113338623)
	local shadepart = Instance.new("Part", character)
	shadepart.Name = "badass shades for badass individuals"
	shadepart.Size = Vector3.new(1,1,1)
	shadepart.CanCollide = false
	shadepart:BreakJoints()
	local shademesh = Instance.new("SpecialMesh", shadepart)
	shademesh.MeshId = "rbxassetid://4074491872"
	shademesh.TextureId = "http://www.roblox.com/asset/?id=4074505370"
	local shadeweld = Instance.new("Weld", character)
	shadeweld.Part0 = character.Head
	shadeweld.Part1 = shadepart
	shadeweld.C0 = CFrame.new(0.000405788422, 0.250156403, -0.24974823, 0.999999762, -4.92639032e-08, 3.32781528e-05, 4.92662267e-08, 0.999999344, -7.06257595e-08, -3.32781383e-05, 7.06274292e-08, 1)
	local rightarm = Instance.new("Weld", character.Torso)
	rightarm.Part0 = character.Torso
	rightarm.Part1 = character["Right Arm"]
	rightarm.C0 = CFrame.new(1.5,0,0)
	rightarm.Name = "RightArmWeld"
	local head = Instance.new("Weld", character.Torso)
	head.Part0 = character.Torso
	head.Part1 = character.Head
	head.C0 = CFrame.new(0,1.5,0)
	head.Name = "HeadWeld"
	local humanoidrootpart = Instance.new("Weld", character.HumanoidRootPart)
	humanoidrootpart.Part0 = character.HumanoidRootPart
	humanoidrootpart.Part1 = character.Torso
	humanoidrootpart.Name = "HumanoidRootPartWeld"
	coroutine.wrap(function()
		while equipped and runservice.Stepped:wait() do
			if anim == "idle" then
				head.C0 = head.C0:lerp(CFrame.new(0, 1.5, 0, -4.37113883e-08, 0, -1, 0, 0.99999994, 0, 1, 0, -4.37113883e-08),0.2)
				rightarm.C0 = rightarm.C0:lerp(CFrame.new(2, 0.5, 0, -4.37113883e-08, -0.99999994, 0, -4.37113847e-08, 1.91068525e-15, -0.999999881, 1, -4.37113918e-08, -4.37113847e-08),0.2)
				rightgrip.C0 = rightgrip.C0:lerp(CFrame.new(-0.00291109085, -0.808973312, -0.217943192, 0.999945521, -0.00986599829, -0.00341791473, -0.00352935679, -0.011299599, -0.999929965, 0.00982669368, 0.999887645, -0.0113338623),0.2)
				humanoidrootpart.C0 = humanoidrootpart.C0:lerp(CFrame.new(0, 0, 0, 1.19248806e-08, 0, 1, 0, 1, 0, -1, 0, 1.19248806e-08),0.3)
			end
		end
		head:destroy()
		rightarm:destroy()
		humanoidrootpart:destroy()
	end)()
end)
tool.Unequipped:connect(function()
	equipped = false
	handle.theme:Stop()
	if character:findFirstChild("badass shades for badass individuals") then
		character["badass shades for badass individuals"]:destroy()
	end
end)]]></ProtectedString>
