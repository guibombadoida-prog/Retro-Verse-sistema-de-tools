		<Item class="Script" referent="RBXB3CB49DBA4E94FAF91B03EF0A5357EBA">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local plr = script.Parent.Parent.Parent
local tool = script.Parent
script.Car.Parent = game.ReplicatedStorage
local isply = workspace:WaitForChild(plr.Name)
local car = game.ReplicatedStorage.Car
if isply ~= nil then
	local isplayer = isply:FindFirstChild("Humanoid")
	if isplayer ~= nil then
		local pos = isply:WaitForChild("Torso").Position
		local folder = Instance.new("Folder")
		folder.Name = "Car"
		folder.Parent = isply

		tool.Activated:Connect(function()

				local clone = car:Clone()
				clone:SetPrimaryPartCFrame(CFrame.new(isply.Torso.Position +  Vector3.new(10,0,0)))
			clone.Parent = workspace
	
			
		end)
	end
end]]></ProtectedString>
