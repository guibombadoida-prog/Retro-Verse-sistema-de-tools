				<Item class="Script" referent="RBX9F43BDEC27924A069D025EDE34E6CAC8">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local human = script.Parent.Humanoid

while wait() do
	for _, child in pairs(workspace:GetChildren()) do
		if child:IsA('Model') and child:FindFirstChild('Humanoid') and (script.Parent.HumanoidRootPart.Position - child.HumanoidRootPart.Position).magnitude < 25 then
			human:MoveTo(child.HumanoidRootPart.Position)
			
			
			script.Parent.Torso.Touched:connect(function()
				human.Jump =true
			end)
		end
	end
	
end
]]></ProtectedString>
