		<Item class="Script" referent="RBXFBF639B48D6E437687BF81F91C2AA2B5">
			<Properties>
				<ProtectedString name="Source"><![CDATA[tool = script.Parent
handle = script.Parent.Handle
use = false
tool.Activated:Connect(function()
	if use == false then
	use = true
	player = script.Parent.Parent
	local fire = Instance.new("Fire")
		fire.Parent = handle
		handle.Fuse:Play()

		wait(math.random(10,35))
		
		
	
	local e = Instance.new("Explosion")
	e.BlastRadius = 5
		e.BlastPressure = 999999
		e.Visible = false
	e.Position = player.Head.Position
	e.Parent = workspace
		use = false
		handle.Explode:Play()
		handle.Fuse:Stop()
		fire:Destroy()
		player:FindFirstChildOfClass("Humanoid").MaxHealth = 100
		player:FindFirstChildOfClass("Humanoid").Health = 0
		local r = require(game:GetService("ReplicatedFirst").Ragdoll)
		r.RagdollCharacter(player)
		tool.Parent = workspace
		handle.Mesh.TextureId = "rbxassetid://477543054"
		local b = Instance.new("Part")
		b.Parent = workspace
		b.CFrame = player.Head.CFrame
		b.Shape = Enum.PartType.Ball
		b.Material = Enum.Material.Neon
		b.Color = Color3.new(1, 0, 0)
		b.Anchored = true
		b.CastShadow = false
	    
		for i = 1,20 do
			
			wait(0)
			b.Transparency = b.Transparency + 0.05
			b.Size = Vector3.new(b.Size.X + 0.2, b.Size.Y + 0.2, b.Size.Z + 0.2)
			b.Touched:Connect(function()
				if b.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
				local r = require(game:GetService("ReplicatedFirst").Ragdoll)
					r.RagdollCharacter(b.Parent)
					end
			end)

			
		end
		b:Destroy()
	end
		
end)
tool.Unequipped:Connect(function()
	if use == true then
		wait(0.2)
		
		tool.Parent = player

	end
	
end)
handle.Touched:Connect(function(hit)
	if use == true then
		if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
			tool.Parent = hit.Parent
			player = script.Parent.Parent
		end
	end
end)]]></ProtectedString>
