			</Properties>
			<Item class="ModuleScript" referent="RBX1D4732461E384B87965744E30747AC4A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Converter = {}

local KeydownEvent = Instance.new("BindableEvent")
local KeyupEvent = Instance.new("BindableEvent")
local Player = nil

script.GetPlayer.OnServerEvent:Connect(function(player)
	Player = player
end)

function Converter:GetPlayer()
	return Player
end

while not Player do
	game:GetService("RunService").Heartbeat:Wait()
end

function Converter:GetTextboxText(Textbox)
	return script.GetTextboxCode:InvokeClient(Player, Textbox)	
end

function Converter:GUIWireButton(Button)
	script.GetButton1Down:FireClient(Player, Button)
		local FalseRemote = Instance.new("BindableEvent")
		
	script.GetButton1Down.OnServerEvent:Connect(function(_, GetB)
		if GetB == Button then
			FalseRemote:Fire()
		end
	end)

	return FalseRemote.Event	
end

function Converter:GUIWireFocusLost(Button)
	script.GetFocusLost:FireClient(Player, Button)
	local FalseRemote = Instance.new("BindableEvent")

	script.GetFocusLost.OnServerEvent:Connect(function(Playerrrrr,GetB)
		if GetB == Button then
			FalseRemote:Fire()
		end
	end)

	return FalseRemote.Event
end

script.KeyDown.OnServerEvent:Connect(function(Player,Key)
	KeydownEvent:Fire(Key)
end)

script.KeyUp.OnServerEvent:Connect(function(Player,Key)
	KeydownEvent:Fire(Key)
end)


Converter.Hit = script.GetHit:InvokeClient(Player)
Converter.hit = script.GetHit:InvokeClient(Player)
Converter.Target = script.GetTarget:InvokeClient(Player)
Converter.Origin = script.GetOrigin:InvokeClient(Player)
Converter.X =  script.GetX:InvokeClient(Player)
Converter.Y =  script.GetY:InvokeClient(Player)


Converter.RenderStepped = script.RenderStep.OnServerEvent
Converter.KeyUp = KeyupEvent.Event
Converter.KeyDown = KeydownEvent.Event
Converter.Button1Down = script.Button1Down.OnServerEvent
Converter.Button1Up = script.Button1Up.OnServerEvent
Converter.Button2Down = script.Button2Down.OnServerEvent
Converter.Button2Up = script.Button2Up.OnServerEvent


script.RenderStep.OnServerEvent:Connect(function()
	Converter.Hit = script.GetHit:InvokeClient(Player)
	Converter.hit = script.GetHit:InvokeClient(Player)
	Converter.Target = script.GetTarget:InvokeClient(Player)
	Converter.Origin = script.GetOrigin:InvokeClient(Player)
	Converter.X =  script.GetX:InvokeClient(Player)
	Converter.Y =  script.GetY:InvokeClient(Player)
end)

return Converter
]]></ProtectedString>
