						<Properties>
							<ProtectedString name="Source"><![CDATA[local fonts = Enum.Font:GetEnumItems()
while wait() do
	local t = ""
	for _,v in pairs(string.split("the j")) do
		local m = math.random(0,1)
		if m==1 then
			t=t..string.upper(v)
		else
			t=t..v
		end
	end
	script.Parent.Text = t
	script.Parent.Font = fonts[math.random(1,#fonts)]
end]]></ProtectedString>
