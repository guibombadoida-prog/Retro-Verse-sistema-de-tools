			<Properties>
				<ProtectedString name="Source"><![CDATA[script.Parent.Handle.Touched:Connect(function(hit)
	if hit.Parent:FindFirstChildOfClass("Humanoid") then
		local player = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
		player.Character = hit.Parent
		script.Parent:Destroy()
	end
end)]]></ProtectedString>
