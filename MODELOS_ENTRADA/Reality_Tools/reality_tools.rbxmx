			<Properties>
				<ProtectedString name="Source"><![CDATA[script["angri dumme"].Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage["angri dumme"]:Clone()
	AI.Parent = game.Workspace
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
end)
]]></ProtectedString>
