		<Item class="Script" referent="RBXBEF6169F5B71476B8FEBB5E51FC5473D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[
function Activated()
	animator = require(script.Parent:WaitForChild("CFAv3"))

	animation = animator.new(script.Parent.Parent, script.Parent["california gurls"])
	animation:play()
	script.Parent.music:Play()
	wait(4.6)
	script.Parent.music:Stop()
	script.Parent.Parent.Archivable = true
	local clone = script.Parent.Parent:Clone()
	clone.Parent = workspace
	
	local me = script.Parent.Parent
