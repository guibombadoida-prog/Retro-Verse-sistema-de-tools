		<Item class="Script" referent="RBXC0E140BD51844CB59C4075B967D9CE22">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local human = tool.Parent.Parent.Character.Humanoid
script.Parent.Equipped:Connect(function(hit)
	human.WalkSpeed = 60
	script.Parent.Handle.speed:Play()
	script.Script.Parent = human.Parent.Torso
	human.Parent.Torso.Script.Enabled = true
end)
script.Parent.Unequipped:Connect(function(hit)
	
	human.WalkSpeed = 17
	script.Parent.Handle.speed:Stop()
	human.Parent.Torso.Script.Enabled = false
	human.Parent.Torso.Script.Parent = script

end)

]]></ProtectedString>
