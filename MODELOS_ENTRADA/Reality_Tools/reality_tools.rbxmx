						<ProtectedString name="Source"><![CDATA[
for i,v in pairs(script.Parent:GetDescendants()) do
	script.Sound:Play()
	script.Parent:BreakJoints()
	local fire = Instance.new("ParticleEmitter")
	fire.Parent = v
	
	
	if v:IsA("BasePart") then
		
		v.CanCollide = true
        
		v.Anchored = true
		v.Material = "Neon"
		
		
		local goals = {Transparency = 1;CFrame = v.CFrame*CFrame.new(math.random(-10,40),math.random(-40,10),math.random(-10,40),math.random(-90,90),math.random(-10,50),math.random(-10,90),math.random(-200,200));Color = Color3.new(1, 1, 1);Size = Vector3.new(2,2,2);Velocity = Vector3.new(math.random()-.5,math.random()-.5,math.random()-.5)*290 }


	game:GetService("TweenService"):Create(v,TweenInfo.new(3),goals):Play()
	
	end
	end
]]></ProtectedString>
