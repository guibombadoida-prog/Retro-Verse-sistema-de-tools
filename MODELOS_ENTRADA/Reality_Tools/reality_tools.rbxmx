					<Properties>
						<ProtectedString name="Source"><![CDATA[local Mouse = game.Players.LocalPlayer:GetMouse()

script.Parent:WaitForChild("GetPlayer"):FireServer()

script.Parent:WaitForChild("GetHit").OnClientInvoke = function()
	return Mouse.Hit
end

script.Parent:WaitForChild("GetTarget").OnClientInvoke = function()
	return Mouse.Target
end


script.Parent:WaitForChild("GetX").OnClientInvoke = function()
	return Mouse.X
end

script.Parent:WaitForChild("GetOrigin").OnClientInvoke = function()
	return Mouse.Origin
end


script.Parent:WaitForChild("GetY").OnClientInvoke = function()
	return Mouse.Y
end

script.Parent:WaitForChild("GetButton1Down").OnClientEvent:Connect(function(Button)
	Button.MouseButton1Down:connect(function()
		script.Parent.GetButton1Down:FireServer(Button)
	end)
end)

script.Parent:WaitForChild("GetFocusLost").OnClientEvent:Connect(function(Button)
	Button.FocusLost:connect(function()
		script.Parent.GetFocusLost:FireServer(Button)
	end)
end)

script.Parent.GetTextboxCode.OnClientInvoke = function(Textbox)
	return Textbox.Text
end

Mouse.Button1Down:connect(function()
	script.Parent.Button1Down:FireServer()
end)
Mouse.Button1Up:connect(function()
	script.Parent.Button1Up:FireServer()
end)

Mouse.Button2Down:connect(function()
	script.Parent.Button2Down:FireServer()
end)
Mouse.Button2Up:connect(function()
	script.Parent.Button2Up:FireServer()
end)


Mouse.KeyDown:connect(function(Key)
	script.Parent.KeyDown:FireServer(Key)
end)

Mouse.KeyUp:connect(function(Key)
	script.Parent.KeyUp:FireServer(Key)
end)

while wait(0.00001) do
	script.Parent.RenderStep:FireServer()
end]]></ProtectedString>
