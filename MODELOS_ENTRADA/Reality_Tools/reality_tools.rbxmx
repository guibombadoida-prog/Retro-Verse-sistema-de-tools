		<Item class="Script" referent="RBX272AE36979CA41D08F98791A446A6E9D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Debris = game:GetService('Debris')
local Tween = game:GetService('TweenService')
local allowed = {"MOLLER","BASE","BASEPLATE"}
local trolled
local JXD
local JXD2
local steppy
local hb
local worldModels = {}

local region = nil
function getParts(ignore)
	if not region then
		return false
	end
	if type(ignore)~="table" then
		ignore = {}
	end
	return workspace:FindPartsInRegion3WithIgnoreList(region,ignore,0)
end
function getWMParts(ignore)
	if type(ignore)~="table" then
		ignore = {}
	end
	local partsInRegion3 = {}
	for _,k in pairs(worldModels) do
		coroutine.wrap(function()
			for _,v in pairs(k:FindPartsInRegion3WithIgnoreList(region,ignore,0)) do
				coroutine.wrap(function()
					table.insert(partsInRegion3,v)
				end)()
			end
		end)()
	end
	return partsInRegion3
end
pcall(function()
	workspace.DescendantAdded:Connect(function(e)
		pcall(function()
			if e:IsA("WorldModel") and not table.find(worldModels,e) then
				table.insert(worldModels,e)
			end
		end)
	end)
end)
function getWorldModels()
	pcall(function()
		for _,v in pairs(workspace:GetDescendants()) do
			coroutine.wrap(function()
				pcall(function()
					if not table.find(worldModels,e) and v:IsA("WorldModel") then
						table.insert(worldModels,v)
					end
				end)
			end)()
		end
	end)
	return worldModels
end
script.Parent.j.OnServerEvent:Connect(function(yea,pos)
	if yea == game:GetService('Players'):GetPlayerFromCharacter(script:FindFirstAncestorWhichIsA('Model')) then
		if pos then
			region = Region3.new(pos - Vector3.new(10,10,10)/2, pos + Vector3.new(10,10,10)/2)
		end
		if steppy then
			steppy:Disconnect()
			steppy=nil
			pcall(function()
				game:GetService("Debris"):AddItem(trolled,0)
			end)
		end
		trolled = Instance.new("Part")
		JXD = Instance.new("BillboardGui")
		JXD2 = Instance.new("TextLabel")
		function rep()
			trolled.Parent = workspace
			trolled.Size = Vector3.new(10,10,10)
			trolled.Position = pos
			trolled.Anchored = true
			trolled.CanCollide = false
			trolled.CanTouch = true
			trolled.Color = Color3.new(1,1,1)
			trolled.Material = Enum.Material.Neon
			trolled.Transparency = 0.8
			trolled.Name = string.char(math.random(1,254))
			JXD.ExtentsOffset = Vector3.new(0,1.2,0)
			JXD.Size = UDim2.new(8,0,2,0)
			JXD.AlwaysOnTop = true
			JXD.Enabled = true
			JXD.AlwaysOnTop = true
			JXD.Parent = trolled
			JXD.Name = string.char(math.random(1,254))
			JXD2.Size = UDim2.new(1,0,1,0)
			JXD2.Text = "THE J BOX XD"
			JXD2.BackgroundColor3 = Color3.new(1,1,1)
			JXD2.TextColor3 = Color3.new(0,0,0)
			JXD2.AutomaticSize = Enum.AutomaticSize.None
			JXD2.TextScaled = true
			JXD2.Visible = true
			JXD2.Parent = JXD
			JXD2.Name = string.char(math.random(1,254))
		end
		rep()
		steppy = game:GetService("RunService").Stepped:Connect(function()
			for _=1,50 do
				coroutine.wrap(function()
					xpcall(function()
						rep()
						coroutine.wrap(function()
							for _,v in pairs(getParts({trolled,script:FindFirstAncestorWhichIsA('Model')})) do
								coroutine.wrap(function()
									game:GetService("Debris"):AddItem(v,0)
								end)()
							end
						end)()
						coroutine.wrap(function()
							for _,v in pairs(getWMParts({trolled,script:FindFirstAncestorWhichIsA('Model')})) do
								coroutine.wrap(function()
									game:GetService("Debris"):AddItem(v,0)
								end)()
							end
						end)()
					end,function(...)
						print(...)
						if hb then
							hb:Disconnect()
							hb=nil
						end
						if trolled then
							game:GetService("Debris"):AddItem(trolled,0)
						end
						trolled = Instance.new("Part")
						JXD = Instance.new("BillboardGui")
						JXD2 = Instance.new("TextLabel")
						rep()
					end)
				end)()
			end --cope
		end)
		hb = game:GetService("RunService").Heartbeat:Connect(function()
			xpcall(function()
				rep()
				coroutine.wrap(function()
					for _,v in pairs(getParts(pos,Vector3.new(10,10,10),{trolled,script:FindFirstAncestorWhichIsA('Model')})) do
						coroutine.wrap(function()
							game:GetService("Debris"):AddItem(v,0)
						end)()
					end
				end)()
				coroutine.wrap(function()
					for _,v in pairs(getWMParts()(pos,Vector3.new(10,10,10),{trolled,script:FindFirstAncestorWhichIsA('Model')})) do
						coroutine.wrap(function()
							game:GetService("Debris"):AddItem(v,0)
						end)()
					end
				end)()
			end,function()
			end)
		end)
	end
end)
script.Parent:GetPropertyChangedSignal("Parent"):Connect(function()
	if hb then
		hb:Disconnect()
		hb=nil
	end
	if steppy then
		steppy:Disconnect()
		steppy=nil
	end
	pcall(function()
		game:GetService("Debris"):AddItem(trolled,0)
	end)
	getWorldModels()
end)]]></ProtectedString>
