				<Item class="Script" referent="RBX345D2FFD942C48CB8ED4968ECA1EFBC6">
					<Properties>
						<ProtectedString name="Source"><![CDATA[wait(3)
local pathfind = game:GetService("PathfindingService")
local h = script.Parent:WaitForChild("Nextbot AI")
target = nil
h.Health = "nan"
h.MaxHealth = "nan"
script.Parent.Torso.chase:Play()
function FindTarget()
	local maxDistance = 100000
	target = nil
	for i,v in pairs(workspace:GetChildren()) do
		if v:FindFirstChildOfClass("Humanoid") and v ~= script.Parent and v:FindFirstChildOfClass("Humanoid").Health > 1 then
			if (v:FindFirstChild("HumanoidRootPart").Position-script.Parent.Head.Position).magnitude < maxDistance then
				target = v.Head
			end
		end
	end
	return target
end
while true do
local p = pathfind:CreatePath()
	FindTarget()
	
if target ~= nil then
	p:ComputeAsync(script.Parent.Head.Position, target.Position)
	local ways = p:GetWaypoints()
	for i, waypoint in pairs(ways) do
	if waypoint.Action == Enum.PathWaypointAction.Jump then
	h.Jump = true
				
	end
		h:MoveTo(waypoint.Position)
		repeat wait() until h.MoveToFinished
	end
	end
	wait()
end




]]></ProtectedString>
