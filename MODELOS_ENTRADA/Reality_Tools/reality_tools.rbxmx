			<Properties>
				<ProtectedString name="Source"><![CDATA[script["Cannibal Soldier"].Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage["Cannibal Soldier"]:Clone()
	AI.Parent = game.Workspace.Terrain
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
end)
]]></ProtectedString>
