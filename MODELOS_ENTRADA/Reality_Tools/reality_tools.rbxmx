		<Item class="Script" referent="RBX5DEFB05A5C854657B2E489037A5A10FD">
			<Properties>
				<ProtectedString name="Source"><![CDATA[script.dumme.Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage.dumme:Clone()
	AI.Parent = game.Workspace
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
end)
]]></ProtectedString>
