		<Item class="Script" referent="RBXFCA41912E805491FA0908F734C584A70">
			<Properties>
				<ProtectedString name="Source"><![CDATA[script.Zombie.Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage.Zombie:Clone()
	AI.Parent = game.Workspace
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
end)
]]></ProtectedString>
