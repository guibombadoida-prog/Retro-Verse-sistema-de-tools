				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX04DC3AF8567F46EEB19A3512F4BFF88B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local pewsound
local cn,euler,rad,random,c3,v3,clamp,sin,cos = CFrame.new,CFrame.fromEulerAnglesYXZ,math.rad,math.random,Color3.fromRGB,Vector3.new,math.clamp,math.sin,math.cos
debris = game:GetService("Debris")
function pew(start,pos,whitelistedParts)
	for i = 1, 5 do
		local hitpos = pos
		local length = clamp((start-hitpos).Magnitude,0,2048)
		local s = Instance.new("Part")
		s.Parent = Instance.new("WorldModel",workspace)
		s.Anchored = true
		s.CanCollide = false
		s.Size = v3(0.5,0.5,length)
		s.Material = Enum.Material.Neon
		s.Position = start
		s.CFrame = cn(start,hitpos)
		s.CFrame = s.CFrame * cn(0,0,-length/2)
		game:GetService("TweenService"):Create(s,TweenInfo.new(0.2,Enum.EasingStyle.Linear,Enum.EasingDirection.In),{Size=v3(0,0,length),Transparency=1}):Play()
		debris:AddItem(s,0.2)
		local hiteffectidk = Instance.new("Part")
		hiteffectidk.Parent = Instance.new("WorldModel",workspace)
		hiteffectidk.Anchored = true
		hiteffectidk.CanCollide = false
		hiteffectidk.Material = Enum.Material.Neon
		hiteffectidk.Size = v3(1.5,1.5,1.5)
		hiteffectidk.CFrame = cn(hitpos) * euler(rad(random(0,360)),rad(random(0,360)),rad(random(0,360)))

		game:GetService("TweenService"):Create(hiteffectidk,TweenInfo.new(0.2,Enum.EasingStyle.Linear,Enum.EasingDirection.In),{Transparency=1,Orientation=v3(random(0,360),random(0,360),random(0,360)),Size=v3()}):Play()
		debris:AddItem(hiteffectidk,0.2)
		pcall(function()
			if pewsound.Parent == script.Parent.gun then
				debris:AddItem(pewsound,0)
			end
		end)
		pewsound = Instance.new("Sound")
		pewsound.SoundId = "rbxassetid://3723700663"
		pewsound.Playing = true
		pewsound.Volume = 3
		pewsound.Parent = script.Parent.gun
		pcall(function()
			debris:AddItem(pewsound,2)
		end)
	end

end

script.Parent.dummy.OnServerEvent:Connect(function(a,b,c)
	if a == game:GetService('Players'):GetPlayerFromCharacter(script:FindFirstAncestorWhichIsA('Model')) then
		pew(script.Parent.bstart.Position,c)
		local shot = Instance.new("Part")
		shot.Parent = Instance.new("WorldModel",workspace)
		shot.Anchored = true
		shot.CanCollide = false
		shot.Transparency = 1
		shot.Shape = Enum.PartType.Ball
		shot.Size = Vector3.new(b*2,b*2,b*2)
		shot.Position = c
		shot.Touched:Connect(function() end)
		game:GetService("Debris"):AddItem(shot,0.2)
		for i, p in next, shot:GetTouchingParts() do
			if game:GetService("Players"):GetPlayerFromCharacter(p:FindFirstAncestorWhichIsA("Model"))~=a then
				spawn(function()
					pcall(function()
						local hum = p.Parent:FindFirstChildOfClass("Humanoid") or p.Parent.Parent:FindFirstChildOfClass("Humanoid")
						if p.Size.X > 50 or p.Size.Y > 50 or p.Size.Z > 50 or (not hum and not p.CanCollide) then return end
						if hum then hum.Parent:BreakJoints()
							for o, b in next, hum.Parent:GetDescendants() do
								if b:IsA("BasePart") then
									game:GetService("Debris"):AddItem(b,0.15)
								end
							end
						end
						game:GetService("Debris"):AddItem(p,0.15)
					end)
				end)
			end
		end
	end
end)
script.Parent:GetPropertyChangedSignal("Parent"):Connect(function()
	if script.Parent.Parent:IsA("Model") then
		script.Parent.gun.Sound.Playing = true
	else
		script.Parent.gun.Sound.Playing = false
	end
end)]]></ProtectedString>
