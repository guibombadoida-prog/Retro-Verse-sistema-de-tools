		<Item class="Script" referent="RBX355AB5D036EE441DB0E262FE02E228F3">
			<Properties>
				<ProtectedString name="Source"><![CDATA[Tool = script.Parent
Handle = Tool.Handle
Head = script.FHead
Head.Parent = game.ServerStorage
swing = false
Tool.Activated:Connect(function()
	
	local humanoid = Tool.Parent:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")
	local Animation = Instance.new("Animation")
	Animation.AnimationId = "rbxassetid://28090109"
	local AnimationTrack = animator:LoadAnimation(Animation)
	AnimationTrack:Play()
	Handle.Sound:Play()
	swing = true
	wait(1)
	swing = false
	AnimationTrack:Stop()
end)
Handle.Touched:Connect(function(Hit)
	if swing == true then
		if Hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
			Handle.Hit:Play()
			if Hit.Name == "Head" then
				local r = require(game:GetService("ReplicatedFirst").Ragdoll)
				r.RagdollCharacter(Hit.Parent)	
			Hit.Parent:FindFirstChildOfClass("Humanoid").Health = 0
			local FakeHead = Head:Clone()
			FakeHead.Parent = Hit.Parent
				FakeHead.CFrame = Hit.CFrame
				FakeHead.Anchored = false
			if Hit.Parent:FindFirstChild("Torso") ~= nil then
					Hit.Parent:FindFirstChild("Torso").Neck.Part1 = FakeHead
					Handle.Ow:Play()
				Hit:Destroy()
			end
		end
		Hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(30)
		end
		end
end)]]></ProtectedString>
