						<string name="ScriptGuid">{0E4FAC15-FC8C-4683-83B5-96FE88FE01F2}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
						<bool name="DefinesCapabilities">true</bool>
						<string name="Name">Talk</string>
						<int64 name="SourceAssetId">4813035422</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX3FBA58830D53425F934195828374D2ED">
					<Properties>
						<ProtectedString name="Source"><![CDATA[wait(4)
local larm = script.Parent:FindFirstChild("HumanoidRootPart")
local rarm = script.Parent:FindFirstChild("HumanoidRootPart")
function findZombie(pos)
	local torso = nil
	local dist = 100000
	local child = workspace:children()
	for i=1, #child do
		if child[i].className == "Model" then
			local h = child[i]:findFirstChild("Humanoid")
			if h ~= nil and h.Health > 0  then
				local check = child[i]:findFirstChild("Head") 
				if check ~= nil and child[i]:FindFirstChild("Zombie AI") ~= nil or child[i]:FindFirstChild("Zombie") ~= nil or child[i]:FindFirstChild("Script") ~= nil or child[i]:FindFirstChild("ZombieScript") ~= nil then
					if (check.Position - pos).magnitude < dist then
						torso = check
						dist = (check.Position - pos).magnitude
					end
				end
			end
		end
	end
	return torso
end

game:GetService("RunService").Stepped:Connect(function()
	wait(1)
	local torso = findZombie(script.Parent.Torso.Position)
	if torso ~= nil and torso.Parent:FindFirstChildOfClass("Humanoid").Health > 0 then
		if math.random(1,4) == 1 then
			chat("Watch out!")
			wait(1)
		end
		if math.random(1,4) == 2 then
			chat("Incoming!")
			wait(1)
		end
		if math.random(1,4) == 3 then
			chat("We've got hostiles.")
			wait(1)
		end
		if math.random(1,4) == 4 then
			chat("Enemy spotted.")
			wait(1)
		end
		script.Parent.Humanoid:MoveTo(torso.Position)
		
		 torso.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(30) 
			script.Parent.Torso.Sound:Play() 
			
			local t = script.Parent:FindFirstChild("Torso")
			armw = t:FindFirstChild("Right Shoulder")
			local oldpos = armw.C1
                t.Parent:FindFirstChildOfClass("Humanoid"):Move(math.random(-90,90))
			for i = 1,5 do
				armw.C1 = armw.C1 * CFrame.Angles(-0.1,-0.1,-0.1)
				wait()
			end
			for i = 1,5 do
				armw.C1 = armw.C1 * CFrame.Angles(0.1,0.1,0.1)
				wait()
			end
			armw.C1 = oldpos

			armw.C1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, -0, -1, 0, 0) 
		
	
		
	end
end)
function chat(thing)
	game:GetService("Chat"):Chat(script.Parent.Head, thing, Enum.ChatColor.White)
end
function findNearestTorso(pos)
	local list = game.Workspace:children()
	local torso = nil
	local dist = 10000
	local temp = nil
	local human = nil
	local temp2 = nil
	for x = 1, #list do
		temp2 = list[x]
		if (temp2.className == "Model") and (temp2 ~= script.Parent) then
			temp = temp2:findFirstChild("Head")
			human = temp2:findFirstChild("Humanoid")
			if (temp ~= nil) and (human ~= nil) and (human.Health > 0) then
				if (temp.Position - pos).magnitude < dist then
					torso = temp
					dist = (temp.Position - pos).magnitude
				end
			end
		end
	end
	return torso
end




while true do
	wait(math.random(1,5))
	if math.random(1,2) == 1 then
	local target = findNearestTorso(script.Parent.HumanoidRootPart.Position)
	if target ~= nil then
		script.Parent.Humanoid:MoveTo(target.Position, target)
	end
	end
	if math.random(1,2) == 2 then
		script.Parent.Humanoid:MoveTo(Vector3.new(larm.Position.X + math.random(-50,50), larm.Position.Y + math.random(-50,50),larm.Position.Z + math.random(-50,50)))
	end
end
script.Parent.Torso.Touched:Connect(function(hit)
	if hit.Parent:FindFirstChild("Zombie AI") ~= nil or hit.Parent:FindFirstChild("Zombie") ~= nil or hit.Parent:FindFirstChild("Script") ~= nil and hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
		local t = script.Parent:FindFirstChild("Torso")
		armw = t:FindFirstChild("Right Shoulder")
		local oldpos = armw.C1

		for i = 1,5 do
			armw.C1 = armw.C1 * CFrame.Angles(0.1,0.1,0.1)
			wait()
		end
		hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(80)
		script.Parent.Torso.Smack:Play()
		for i = 1,5 do
			armw.C1 = armw.C1 * CFrame.Angles(-0.1,-0.1,-0.1)
			wait()
		end
		armw.C1 = oldpos

		armw.C1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, -0, -1, 0, 0) 
	end
end)]]></ProtectedString>
