		<Item class="LocalScript" referent="RBX0F3152464BC24F21AA1191631E4F136F">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool=script.Parent
local handle=tool:WaitForChild("Handle")
local mouse=game.Players.LocalPlayer:GetMouse()
local canslap=false
local cd=false
local abilitycd=false
local abilitycooldown=1
local equipped=false
local ContextActionService = game:GetService("ContextActionService")
local abilityactivategui=tool:WaitForChild("AbilityActivateButton")
abilityactivategui:WaitForChild("Button").MouseButton1Down:Connect(function()
	if cd==false then
		cd=true
		local multiplier=2.25
		local char=game.Players.LocalPlayer.Character
		char:FindFirstChildOfClass("Humanoid"):LoadAnimation(tool:WaitForChild("Swing")):Play()
		tool:WaitForChild("Event"):FireServer()
		canslap=true
		wait(tool:WaitForChild("Speed").Value/multiplier)
		canslap=false
		wait(tool:WaitForChild("Speed").Value-tool:WaitForChild("Speed").Value/multiplier)
		cd=false
	end
end)
tool.Equipped:Connect(function()
	equipped=true
	abilityactivategui.Parent=game.Players.LocalPlayer:WaitForChild("PlayerGui")
end)
tool.Unequipped:Connect(function()
	equipped=false
	abilityactivategui.Parent=tool
end)
tool.Activated:Connect(function()
	if cd==false then
		cd=true
		local multiplier=2.25
		local char=game.Players.LocalPlayer.Character
		char:FindFirstChildOfClass("Humanoid"):LoadAnimation(tool:WaitForChild("Swing")):Play()
		tool:WaitForChild("Event"):FireServer()
		canslap=true
		wait(tool:WaitForChild("Speed").Value/multiplier)
		canslap=false
		wait(tool:WaitForChild("Speed").Value-tool:WaitForChild("Speed").Value/multiplier)
		cd=false
	end
end)

local function handleAction(actionName, inputState, _inputObject)
	if actionName == "Slap" and inputState == Enum.UserInputState.Begin then
		if cd==false then
			cd=true
			local multiplier=2.25
			local char=game.Players.LocalPlayer.Character
			char:FindFirstChildOfClass("Humanoid"):LoadAnimation(tool:WaitForChild("Swing")):Play()
			tool:WaitForChild("Event"):FireServer()
			canslap=true
			wait(tool:WaitForChild("Speed").Value/multiplier)
			canslap=false
			wait(tool:WaitForChild("Speed").Value-tool:WaitForChild("Speed").Value/multiplier)
			cd=false
		end
	end
end

ContextActionService:BindAction("Slap", handleAction, true, Enum.KeyCode.E)

local auto = false

abilityactivategui:WaitForChild("Auto").MouseButton1Down:Connect(function()
	if auto == false then 
		abilityactivategui:WaitForChild("Auto").BackgroundColor3 = Color3.fromRGB(89, 255, 0)
	else
		print(auto)
		abilityactivategui:WaitForChild("Auto").BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
	auto = not auto
	tool:WaitForChild("Auto"):FireServer(auto)
end)]]></ProtectedString>
