					<Item class="Script" referent="RBXFBFAA91B65EE4E368552827EDD8807D7">
						<Properties>
							<ProtectedString name="Source"><![CDATA[script.Parent.Touched:Connect(function(hit)
	if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
		local r = require(game:GetService("ReplicatedFirst").Ragdoll)
		r.RagdollCharacter(hit.Parent)
		local blood = script.BloodSplat:Clone()
		blood.Parent = hit.Parent
		blood.Enabled = true
		hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(4000)
		script.Parent.Sound:Play()
	end
end)
]]></ProtectedString>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
