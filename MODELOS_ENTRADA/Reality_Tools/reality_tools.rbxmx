		<Item class="Script" referent="RBX38DCD5C140434A9F9BD123BEF22F1EF2">
			<Properties>
				<ProtectedString name="Source"><![CDATA[function Kill(foe)
	foe:BreakJoints()

	local sound = Instance.new("Sound",foe)
	sound.SoundId = "rbxassetid://62339698"
	sound.Volume = 4
	sound.PlaybackSpeed = .3
	sound.Playing = true
	game.Debris:AddItem(sound,5)

	for i,v in pairs(foe:GetDescendants()) do
		if v:IsA("BasePart") then
			local particle = Instance.new("Smoke", v)
			particle.Color = Color3.new(1,0,0)
			particle.Size = 0.2
			particle.RiseVelocity = 0
			particle.Opacity = 0.3
			v.Material = Enum.Material.Neon
			v.Color = Color3.fromRGB(255, 0, 4)
			v.Velocity = Vector3.new(0,-90,0)
			v.Anchored = false
			v.Parent = workspace.Terrain
			v.Name = ":skull:"
			local info = TweenInfo.new(2)
			local goal = {}
			goal.Transparency = 1
			goal.CFrame = CFrame.new(v.CFrame.X + math.random(-5,5),v.CFrame.Y + math.random(-5,5), v.CFrame.Z + math.random(-5,5))
			local t = game.TweenService:Create(v,info,goal)
			t:Play()

			local bp = Instance.new("BodyVelocity",v)
			bp.MaxForce = Vector3.new(0,math.huge,0)

			t.Completed:Connect(function()
				local sound = Instance.new("Sound",foe)
				sound.SoundId = "rbxassetid://1192402877"
				sound.Volume = 0.5
				sound.PlaybackSpeed = .8
				sound.Playing = true
				game.Debris:AddItem(sound,5)

				local ball = Instance.new("Part",foe)
				ball.Size = Vector3.new(0.3,0.3,0.3)
				ball.Shape = Enum.PartType.Ball
				ball.CFrame = v.CFrame
				ball.Material = Enum.Material.Neon
				ball.Color = Color3.fromRGB(255, 0, 4)
				ball.Anchored = true
				ball.CanCollide = false
				ball.Massless = true
				game.Debris:AddItem(ball,5)

				local info2 = TweenInfo.new(3)
				local goal2 = {}
				goal2.Size = Vector3.new(4,4,4)
				goal2.Transparency = 1
				local t2 = game.TweenService:Create(ball,info2,goal2)
				t2:Play()
				v:Destroy()
			end)
		elseif v:IsA("Clothing") then
			v:Destroy()
		elseif v:IsA("Decal") then
			v:Destroy()
		elseif v:IsA("Accessory") then
			v:Destroy()
		elseif v:IsA("ParticleEmitter") then
			v:Destroy()
		end
	end
end
local Tool = script.Parent


local COOL_DOWN = 20

local LastStrike = 0

local OnMouseClickEvent = Instance.new("RemoteEvent")
OnMouseClickEvent.Name = "OnMouseClick"
OnMouseClickEvent.OnServerEvent:connect(function(player, location)
	local boom = Instance.new("Part")
	boom.Parent = workspace
	boom.Shape = Enum.PartType.Ball
	boom.Position = location
	boom.Color = Color3.new(1, 0, 0.0156863)
	boom.Material = Enum.Material.Neon
	boom.Anchored = true
	for i = 1,30 do
		boom.Size = Vector3.new(boom.Size.X + 1.5, boom.Size.Y + 1.5, boom.Size.Z + 1.5)
		boom.Transparency = boom.Transparency + 0.05
		wait()
		boom.Touched:Connect(function(hit)
			if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
				Kill(hit.Parent)
			end
		end)
	end
	boom:Destroy()
end)
OnMouseClickEvent.Parent = Tool]]></ProtectedString>
