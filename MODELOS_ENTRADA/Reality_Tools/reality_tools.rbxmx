		<Item class="Script" referent="RBXC920623A06FA4D8FAB55C19848C8EC15">
			<Properties>
				<ProtectedString name="Source"><![CDATA[swing = false

script.Parent.Activated:Connect(function()
	if swing == false then
	swing = true
	
	script.Parent.Handle.Swing:Play()
	script.Parent.Handle.Touched:Connect(function(hit)
		if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil and swing == true then
			swing = false
			
			script.Parent.Handle.Sound:Play()
			hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(30)
		end
	end)
	wait(0.5)
		swing = false
		end
	end)
	
]]></ProtectedString>
