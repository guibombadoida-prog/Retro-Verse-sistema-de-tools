			<Properties>
				<ProtectedString name="Source"><![CDATA[local mouse = game:GetService("Players").LocalPlayer:GetMouse()
script.Parent.Activated:Connect(function()
	local data = {
		[1]=mouse.hit.p,
		[2]=mouse.target
	}
	script.Parent.Moller:FireServer(unpack(data))
end)]]></ProtectedString>
