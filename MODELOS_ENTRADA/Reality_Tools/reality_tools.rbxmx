					<ProtectedString name="Source"><![CDATA[--Made by Luckymaxer

Players = game:GetService("Players")
Debris = game:GetService("Debris")

_G.RbxUtility = require(script.RbxUtility)
RbxUtility = _G.RbxUtility
Create = RbxUtility.Create

ContentsFolder = script:WaitForChild("Contents")

Contents = {}
for i, v in pairs(ContentsFolder:GetChildren()) do
	local Object = v:Clone()
	if v:IsA("ModuleScript") then
		Contents[v.Name] = {Object = v, Module = require(v)}
	else
		Contents[v.Name] = Object
	end
end

Contents = {}
for i, v in pairs(ContentsFolder:GetChildren()) do
	local SubAssets = {}
	for ii, vv in pairs(v:GetChildren()) do
		local ObjectTable = vv:Clone()
		if vv:IsA("ModuleScript") then
			ObjectTable = {Object = ObjectTable, Module = require(vv)}
		end
		SubAssets[vv.Name] = ObjectTable
	end
	Contents[v.Name] = SubAssets
end

BaseUrl = "http://www.roblox.com/asset/?id="

Rate = (1 / 60)

BasePart = Create("Part"){
	Shape = Enum.PartType.Block,
	Material = Enum.Material.Plastic,
	TopSurface = Enum.SurfaceType.Smooth,
	BottomSurface = Enum.SurfaceType.Smooth,
	FormFactor = Enum.FormFactor.Custom,
	Size = Vector3.new(0.2, 0.2, 0.2),
	CanCollide = true,
	Locked = true,
	Anchored = false,
}

function GetData(Table)
	local Player = Table.Player
	local Tool = Table.Tool
	
	local function SharpenKnife()
		for i, v in pairs(Contents.Scripts) do
			for ii, vv in pairs(Tool:GetChildren()) do
				if vv:IsA("BaseScript") and vv.Name == v.Name then
					vv:Destroy()
				end
			end
		end
		for i, v in pairs(Contents.Scripts) do
			local NewScript = v:Clone()
			NewScript.Disabled = false
			NewScript.Parent = Tool
		end
		local Handle = Tool:FindFirstChild("Handle")
		if Handle then
			for i, v in pairs(Handle:GetChildren()) do
				if v:IsA("Sound") then
					v:Destroy()
				end
			end
			for i, v in pairs(Contents.Sounds) do
				local NewSound = v:Clone()
				NewSound.Parent = Handle
			end
		end
	end
	
	return {
		SharpenKnife = SharpenKnife,
	}
end

return {
	GetData = GetData,
}]]></ProtectedString>
