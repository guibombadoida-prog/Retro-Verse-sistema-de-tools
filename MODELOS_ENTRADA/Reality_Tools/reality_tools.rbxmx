			<Item class="Script" referent="RBXAD5369BAD29E4BF2AEB02233CFA39600">
				<Properties>
					<ProtectedString name="Source"><![CDATA[script.Parent.Archivable = true
clone = script.Parent:Clone()
script.Parent.Archivable = false
script.LocalScript.Enabled = true
for i,v in pairs(clone:GetDescendants()) do
	if v:IsA("Script") then
		v.Enabled = false
	end
end
clone.Parent = game.ReplicatedStorage
script.Parent.Humanoid.MaxHealth = math.huge
script.Parent.Humanoid.Health = math.huge
script.Parent.Humanoid.Died:Connect(function()
	local c = clone:Clone()
	c.Humanoid.MaxHealth = math.huge
	c.Humanoid.Health = math.huge
	c:MakeJoints()
	c.Parent = workspace
	c.Head.CFrame = script.Parent.Head.CFrame
	local plr = game.Players:FindFirstChild(script.Parent.Name)
	plr.Character = c
	local old = script.Parent
	script.Parent = c
	old.Archivable = true
	clone:Destroy()
	for i,v in pairs(c:GetDescendants()) do
		if v:IsA("Script") then
			v.Enabled = true
		end
	end
	old:Destroy()
end)
]]></ProtectedString>
