		<Item class="Script" referent="RBX87F3853B1A4E4EB9ADD1CEF15190D4FB">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--By Rufus14
players = game:GetService("Players")
runservice = game:GetService("RunService")
tool = script.Parent
handle = tool.Handle
hurt = handle.hurt1
uuhh = handle.uuhh
slash = handle.slash
unsteath = handle.unsteath
print([[Rufus14's 32k sword of ebin
----------------------------
Sharpness enchantment.level.32767
Unbreaking enchantment.level.32767
Knockback X
Fire Aspect enchantment.level.32767
Looting X
Sweeping Edge III
Curse of Vanishing
Mending

When in main hand:
	1.6 Attack Speed
	81917.5 Attack Damage]])


equipped = false
canattack = true
swinging = false

local owner
local character

tool.Equipped:connect(function()
	equipped = true
	if owner ~= nil then
		if owner ~= players:GetPlayerFromCharacter(tool.Parent) then --curse of vanishing
			tool:destroy()
		end
	end
	owner = players:GetPlayerFromCharacter(tool.Parent)
	character = owner.Character
	unsteath:Play()
end)
tool.Unequipped:connect(function()
	equipped = false
	if character.Torso:findFirstChild("RightArmWeld32k") then
		character.Torso.RightArmWeld32k:destroy()
	end
end)

tool.Activated:connect(function()
	if not canattack then
		return
	end
	swinging = true
	slash:Play()
	canattack = false
	coroutine.wrap(function()
		local rightarm = Instance.new("Weld", character.Torso)
		rightarm.Part0 = character.Torso
		rightarm.Part1 = character["Right Arm"]
		rightarm.C0 = CFrame.new(1.5,0.5,-0.5) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0)
		rightarm.Name = "RightArmWeld32k"
		for i = 0,1 , 0.1 do
			rightarm.C0 = rightarm.C0:lerp(CFrame.new(1.5,0,0), i) 
			runservice.Stepped:wait()
		end
		wait(0.25)
		swinging = false
		for i = 0,1 , 0.06 do
			rightarm.C0 = rightarm.C0:lerp(CFrame.new(1.5,0.5,-0.5) * CFrame.fromEulerAnglesXYZ(math.pi/2,0,0), i) 
			runservice.Stepped:wait()
		end
		rightarm:destroy()
	end)()
	wait(1.6)
	canattack = true
end)

handle.Touched:connect(function(WHAT)
	if swinging then
		local damaged = WHAT.Parent:findFirstChild("32k'd")
		local humsomeone = WHAT.Parent:findFirstChildOfClass("Humanoid")
		if not damaged then
			local dmgd = Instance.new("BoolValue", WHAT.Parent)
			dmgd.Name = "32k'd"
			game.Debris:AddItem(dmgd, 0.5)
			--looting
			for i,v in pairs(humsomeone.Parent:GetChildren()) do
				if v.ClassName == "Tool" then
					v.Archivable = true
					for i = 1,10 do
						local theclone = v:Clone()
						theclone.Parent = workspace
						if theclone:findFirstChildOfClass("Part") then
							theclone:findFirstChildOfClass("Part").CanCollide = true
							theclone:findFirstChildOfClass("Part").CFrame = theclone:findFirstChildOfClass("Part").CFrame * CFrame.new(math.random(-2,2)/2,math.random(-2,2)/2,math.random(-2,2)/2)
						end
					end
				end
			end
			local attackedplr = players:GetPlayerFromCharacter(humsomeone.Parent)
			if attackedplr ~= nil then
				for i,v in pairs(attackedplr:findFirstChildOfClass("Backpack"):GetChildren()) do
					if v.ClassName == "Tool" then
						v.Archivable = true
						for i = 1,10 do
							local theclone = v:Clone()
							theclone.Parent = workspace
							if theclone:findFirstChildOfClass("Part") then
								theclone:findFirstChildOfClass("Part").CanCollide = true
								theclone:findFirstChildOfClass("Part").CFrame = WHAT.CFrame * CFrame.new(math.random(-2,2)/2,math.random(-2,2)/2,math.random(-2,2)/2)
							end
						end
					end
				end
			end
			--knockback X
			for i,v in pairs(WHAT.Parent:GetChildren()) do
				if v.ClassName == "Part" or v.ClassName == "MeshPart" then
					local velocity = Instance.new("BodyVelocity", v)
					velocity.Velocity = Vector3.new(0,15,0) + character.Head.CFrame.lookVector * 60
					velocity.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
					game.Debris:AddItem(velocity, 0.2)
				end
			end
			--damage
			hurt.PlaybackSpeed = 1+(math.random(-10,10)/60)
			hurt:Play()
			--[[uuhh.PlaybackSpeed = 1+(math.random(-10,10)/60)
			uuhh:Play()--]]
			humsomeone.Health = humsomeone.Health - 81917.5
			--fire aspect
			for i,v in pairs(WHAT.Parent:GetChildren()) do
				if v.ClassName == "Part" or v.ClassName == "MeshPart" then
					local fire = Instance.new("Fire", v)
					game.Debris:AddItem(fire, 4)
				end
			end
			coroutine.wrap(function()
				local hurtclone = hurt:Clone()
				hurtclone.Parent = WHAT
				for i = 1,4 do
					wait(1)
					humsomeone.Health = humsomeone.Health - 327667.5
					if humsomeone.Health > 0 then
						hurtclone:Play()
					end
				end
			end)()
			--sweeping edge III
			humsomeone.Health = humsomeone.Health - (1 + 81917.5 * (3/(3+1)))
		end
	end
end)]]></ProtectedString>
