					<Item class="Script" referent="RBX91CF8309AAE44D75BC0C0F01E9E2296A">
						<Properties>
							<ProtectedString name="Source"><![CDATA[
script.Parent.Touched:Connect(function(hit)
	if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil and hit.Parent:FindFirstChild("what?") == nil then
		hit.Parent.Head.Anchored = true
		wait(1)
		script.yikes:Play()
		for i = 1,10 do
			hit.Parent.Head.CFrame = CFrame.new(hit.Parent.Head.CFrame.X, hit.Parent.Head.CFrame.Y - 1, hit.Parent.Head.CFrame.Z)
			wait()
		end
		for i, v in pairs(hit.Parent:GetDescendants()) do
			if v:IsA("BodyColors") then
				v:Destroy()
			end
			if v:IsA("Accessory") then
				v:Destroy()
			end
			if v:IsA("Shirt") then
				v:Destroy()
			end
			if v:IsA("Pants") then
				v:Destroy()
			end
			
			
		end
		
		local tag = Instance.new("StringValue")
		tag.Name = "what?"
		tag.Parent = hit.Parent
		script["Body Colors"]:Clone().Parent = hit.Parent
	
		wait(2)
		for i = 1,13 do
			hit.Parent.Head.CFrame = CFrame.new(hit.Parent.Head.CFrame.X, hit.Parent.Head.CFrame.Y + 1, hit.Parent.Head.CFrame.Z)
			wait(0.05)
		end
		hit.Parent.Head.Anchored = false
	end
end)]]></ProtectedString>
