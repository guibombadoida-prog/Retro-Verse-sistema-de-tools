					<Item class="Script" referent="RBXEC4A03964C1A4D39B69707AC16A3BBC0">
						<Properties>
							<ProtectedString name="Source"><![CDATA[
Tool = script.Parent
Handle = Tool.Handle

function animate(id,length)
	local animation = script:WaitForChild('Animation')
	animation.AnimationId = "rbxassetid://"..id
	local humanoid = Tool.Parent:WaitForChild('Humanoid')
	local anim = humanoid:LoadAnimation(animation)
	anim:Play()
	wait(length)
	anim:Stop()
end
function crit(man)
	local critgui = script.crit:Clone()
	critgui.Parent = man:FindFirstChild("Head")
	man:FindFirstChild("Head").Velocity = Vector3.new(10,20,10)
	critgui.Enabled = true
	local boom = critgui.sound
	boom.Parent = man:FindFirstChild("Head")
	boom:Play()
	man:FindFirstChildOfClass("Humanoid"):TakeDamage(math.random(10,30))
	if man:FindFirstChildOfClass("Humanoid").Health == 0 then
		local r = require(game:GetService("ReplicatedFirst").Ragdoll)
		r.RagdollCharacter(man)
	end
	for i = 1,20 do
		critgui.ImageLabel.ImageTransparency = critgui.ImageLabel.ImageTransparency + 0.05
		wait()
	end
	critgui:Destroy()
end
	Mags = 12
local OnMouseClickEvent = Instance.new("RemoteEvent")
OnMouseClickEvent.Name = "OnMouseClick"
OnMouseClickEvent.OnServerEvent:connect(function(player, location)
	Tool.Enabled = false
	if Mags > 1 then
		Mags = Mags - 1
	else
		Handle.Reload:Play()
		Tool.Enabled = false
		animate(97885754,1)
		wait(1)
		Mags = 12
Tool.Enabled = true
	end
	local dir = (location - Tool.Handle.Position).Unit * 50
	local ray = workspace:Raycast(Tool.Handle.Position, dir)
	if ray then
		local hit = ray.Instance
		if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil and hit.Parent ~= Tool.Parent then 
			hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(15)
			if hit.Parent:FindFirstChildOfClass("Humanoid").Health == 0 then
				local r = require(game:GetService("ReplicatedFirst").Ragdoll)
				r.RagdollCharacter(hit.Parent)
			end
			local randomcrit = math.random(1,5)
			if randomcrit < 3 then
				crit(hit.Parent)
			end
		end		
	local function bullet ()
		local bullet = Instance.new("Part")
		local p = Tool.Handle.Position + dir/2
		bullet.Size = Vector3.new(0.5,0.5,dir.magnitude)
		bullet.Anchored = true
		bullet.Transparency = 0
		bullet.CFrame = CFrame.new(p, Tool.Handle.Position)
		bullet.Parent = workspace
		bullet.CanCollide = false
		bullet.Color = Color3.new(0.266667, 1, 0)
		bullet.Material = Enum.Material.Neon

		
		Handle.Flash.Enabled = false
		Handle.Light.Enabled = false
		for i = 1,5 do
			bullet.Size = Vector3.new(bullet.Size.X - 0.1, bullet.Size.Y - 0.1, bullet.Size.Z - 0.1)
			
			bullet.Transparency = bullet.Transparency + 0.2
			wait()
			bullet.Touched:Connect(function(hit)
				if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil and hit.Parent ~= Tool.Parent then 
					hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(15)
					if hit.Parent:FindFirstChildOfClass("Humanoid").Health == 0 then
						local r = require(game:GetService("ReplicatedFirst").Ragdoll)
						r.RagdollCharacter(hit.Parent)
					end
					bullet:Destroy()
					local randomcrit = math.random(1,5)
					if randomcrit < 3 then
						crit(hit.Parent)
					end
				end		
			end)
		end
		bullet:Destroy()
	end
	bullet()
	
		Handle.Fire:Play()
		Handle.Flash.Enabled = true
		Handle.Light.Enabled = true
		wait(0.1)
		Handle.Flash.Enabled = false
		Handle.Light.Enabled = false
		
		local t = Tool.Parent:FindFirstChild("Torso")
		armw = t:FindFirstChild("Right Shoulder")
		local oldpos = armw.C1
	
		for i = 1,5 do
			armw.C1 = armw.C1 * CFrame.Angles(-0.1,-0.1,-0.1)
			wait()
		end
		for i = 1,5 do
			armw.C1 = armw.C1 * CFrame.Angles(0.1,0.1,0.1)
			wait()
		end
		armw.C1 = oldpos
		
	end
	
	armw.C1 = CFrame.new(-0.5, 0.5, 0, 0, 0, 1, 0, 1, -0, -1, 0, 0)
	Tool.Enabled = true
	
end)
OnMouseClickEvent.Parent = Tool]]></ProtectedString>
