			<Item class="Script" referent="RBXA77A02CD232F4167BC469B68984FACA6">
				<Properties>
					<ProtectedString name="Source"><![CDATA[script.Parent.Touched:Connect(function(touch)
	if touch.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
		
		touch.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(400)
		touch.Material = "CorrodedMetal"
		touch:BreakJoints()
		touch.Anchored = true
		for i = 1, 20 do
			touch.Transparency = touch.Transparency + 0.05
			touch.CFrame = CFrame.new(touch.CFrame.X, touch.CFrame.Y + 0.5, touch.CFrame.Z)
			wait(0.05)
		end
		touch:Destroy()
	end
end)
]]></ProtectedString>
					<bool name="Disabled">true</bool>
