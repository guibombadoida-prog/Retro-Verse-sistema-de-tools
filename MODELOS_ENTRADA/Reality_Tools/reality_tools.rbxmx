			</Properties>
			<Item class="Sound" referent="RBXE44FEFE96E964E9B9C65C21613F981AF">
				<Properties>
					<bool name="AcousticSimulationEnabled">true</bool>
					<NumberRange name="LoopRegion">0 60000 </NumberRange>
