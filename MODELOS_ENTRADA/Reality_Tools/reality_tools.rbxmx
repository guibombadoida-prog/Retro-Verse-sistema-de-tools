	L_68_:WaitForChild("Neck").Part1 = L_69_
	L_68_:WaitForChild("Neck").C1 = L_68_:WaitForChild("Neck").C1
	L_68_:WaitForChild("Neck").C0 = L_68_:WaitForChild("Neck").C0
	
	L_18_:Destroy()
	L_17_:Destroy()
