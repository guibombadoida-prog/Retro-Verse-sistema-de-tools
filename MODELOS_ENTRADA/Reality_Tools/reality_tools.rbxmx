				<Properties>
					<ProtectedString name="Source"><![CDATA[script.Parent.Head.Anchored = true
for i = 1,10 do
	wait(0)
	script.Parent.Head.CFrame = CFrame.new(script.Parent.Head.CFrame.X, script.Parent.Head.CFrame.Y + 0.5, script.Parent.Head.CFrame.Z)
end

wait(1)
script.boom:Play()
script.Parent:BreakJoints()
script.Parent:FindFirstChildOfClass("Humanoid").Health = 0

for i,v in pairs(script.Parent:GetDescendants()) do
	if v:IsA("Shirt") then
		v:Destroy()
	end
	if v:IsA("Pants") then
		v:Destroy()
	end
	if v:IsA("Script") then
		if v.Name ~= "epicfunnydeatheffect" then
			v:Destroy()
		end
	end
	if v:IsA("BasePart") then
		v.CanCollide = false
		v.Anchored = true
		local goals = {Transparency = 1;CFrame = v.CFrame*CFrame.new(math.random(-5,5),math.random(1,3),math.random(-5,5),math.random(-15,5),math.random(-4,4),math.random(-8,8),math.random(-9,9));Color = Color3.new(1, 0.976471, 0.980392) }


	game:GetService("TweenService"):Create(v,TweenInfo.new(3),goals):Play()
	
	end
	end
]]></ProtectedString>
