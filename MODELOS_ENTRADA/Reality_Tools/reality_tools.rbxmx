					<Item class="Script" referent="RBX4DBFB8CD961A477A9516C3D411A3C5F2">
						<Properties>
							<ProtectedString name="Source"><![CDATA[script.Parent.Touched:Connect(function(hit)
	if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil and hit.Transparency ~= 1 then
		hit.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(30)
	
		script.Parent.eat:Play()

		for i = 1,math.random(10,15) do
			local hedd = Instance.new("Part", workspace)
			hedd.Size = Vector3.new(0.25,0.25,0.25)
			hedd.CFrame = hit.CFrame * CFrame.new(math.random(-10,10)/20,math.random(-10,10)/20,math.random(-10,10)/20)

			if math.random(1,3) == 1 then
				hedd.BrickColor = hit.BrickColor
				hedd.Material = hit.Material
			else
				hedd.BrickColor = BrickColor.new("Maroon")
				hedd.Material = "Granite"
			end
		end
		hit:Destroy()
		wait(1)
	end
end)
]]></ProtectedString>
