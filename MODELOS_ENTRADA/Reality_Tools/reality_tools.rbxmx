		<Item class="Script" referent="RBX113BA410BF184AD0B05DFA99C15991B0">
			<Properties>
				<ProtectedString name="Source"><![CDATA[script["Gravity Cat Not Amused"].Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage["Gravity Cat Not Amused"]:Clone()
	AI.Parent = game.Workspace.Terrain
	AI["gravitycatMAIN."].Enabled = true
	AI.Script.Enabled = true
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
	script.Parent:Destroy()
end)
]]></ProtectedString>
