		<Item class="Script" referent="RBX63E34F7031C64E05AA9BD90BAF9B3C08">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent

local animationsR6 = script.Parent.Animation.R6

local animationsR15 = script.Parent.Animation.R15

local MainAnimation = animationsR6.Main
local IdleAnimation = animationsR6.Idle

local mainAnim = nil
local idleAnim = nil

local character = nil

local boost = {}

local handle = script.Parent.Handle

local theCharacterOther = nil

local blastSmoke = script.BlastSmoke

local collidePart = {}
local massPart = {}

function Got(touched)
	if touched.Parent.ClassName == "Model" or touched.Parent.ClassName == "Accessory" and handle:FindFirstChildOfClass("Weld") == nil then
		theCharacterOther = touched.Parent
		if touched.Parent.ClassName == "Accessory" then
			theCharacterOther = touched.Parent.Parent
		end
		if theCharacterOther:FindFirstChildOfClass("Humanoid") ~= nil and theCharacterOther:FindFirstChild("HumanoidRootPart") ~= nil then
			theCharacterOther:FindFirstChildOfClass("Humanoid").PlatformStand = true
			local partOrModel = Instance.new("Weld", handle)
			partOrModel.Part0 = theCharacterOther.HumanoidRootPart
			partOrModel.Part1 = handle
			local babies = theCharacterOther:GetDescendants()
			for x = 1, #babies do
				if babies[x]:IsA("BasePart") ~= nil then
			
				end
			end
		end
	end

end

local thing = nil

function MainAttack()
	if handle:FindFirstChildOfClass("Weld") ~= nil then
		mainAnim:Play()
		handle:FindFirstChildOfClass("Weld"):Destroy()
		
		if #collidePart ~= 0 then
			for x = 1, #collidePart do
				collidePart[x].CanCollide = true
			end
			collidePart = {}
		end
		if #massPart ~= 0 then
			for x = 1, #massPart do
				massPart[x].Massless = false
			end
			massPart = {}
		end
		
		local function getRidOfWelds()
			if handle:FindFirstChildOfClass("Weld") ~= nil then
				handle:FindFirstChildOfClass("Weld"):Destroy()
				getRidOfWelds()
			end
		end
		
		getRidOfWelds()
		
		if theCharacterOther ~= nil then
			local throwVelocity = CFrame.new(character.HumanoidRootPart.Position - Vector3.new(0, 1, 0), character.HumanoidRootPart.CFrame.LookVector * 5 + character.HumanoidRootPart.Position).LookVector * 1500
			local boost = Instance.new("BodyVelocity", theCharacterOther.HumanoidRootPart)
			boost.Velocity = throwVelocity
			
			local smoke = blastSmoke:Clone()
			smoke.Enabled = true
			smoke.Parent = theCharacterOther.HumanoidRootPart
			
			wait(.2)
			
			theCharacterOther:FindFirstChildOfClass("Humanoid"):Destroy()
			theCharacterOther:BreakJoints()
			handle.ee:Play()
			handle.e:Play()
			boost:Destroy()
			smoke.Enabled = false
			wait(3)
			blastSmoke:Destroy()
		
		end
	elseif character:FindFirstChild("TouchPart") == nil then
		mainAnim:Play()
		if character.Humanoid.RigType == Enum.HumanoidRigType.R15 then
			thing = character.RightHand:Clone()
			local weld = Instance.new("Weld", thing)
			weld.Part0 = thing
			weld.Part1 = character.RightHand
		else
			thing = character["Right Arm"]:Clone()
			local weld = Instance.new("Weld", thing)
			weld.Part0 = thing
			weld.Part1 = character["Right Arm"]
		end
		thing.Massless = true
		thing.CanCollide = false
		thing.Name = "TouchPart"
		thing.Parent = character
		thing.Transparency = 1
		
		thing.Touched:Connect(Got)
		wait(.4)
		thing:Destroy()
		thing = nil
	end
end

script.Parent.Activated:Connect(MainAttack)

script.Parent.Equipped:Connect(function()
	character = script.Parent.Parent
	if character.Humanoid.RigType == Enum.HumanoidRigType.R15 then
		MainAnimation = animationsR15.Main
		IdleAnimation = animationsR15.Idle
	end
	mainAnim = character.Humanoid:LoadAnimation(MainAnimation)
	idleAnim = character.Humanoid:LoadAnimation(IdleAnimation)
	idleAnim:Play()
end)

script.Parent.Unequipped:Connect(function() idleAnim:Stop() end)]]></ProtectedString>
