		<Item class="Script" referent="RBXFA6624B3771B48669329AF7EBB3212E9">
			<Properties>
				<ProtectedString name="Source"><![CDATA[script["Skeleton"].Parent = game.ServerStorage

script.Parent.Activated:Connect(function()
	
	local AI = game.ServerStorage["Skeleton"]:Clone()
	AI.Parent = game.Workspace.Terrain
	AI["skeleMAIN."].Enabled = true
	AI.Script.Enabled = true
	AI:MoveTo(script.Parent.Handle.Position + Vector3.new(math.random(-12.5,12.5),nil,math.random(-12.5,12.5)))
	AI:MakeJoints()
	script.Parent:Destroy()
end)
]]></ProtectedString>
