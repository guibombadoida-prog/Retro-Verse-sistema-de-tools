		<Item class="Script" referent="RBXBAA80CEC7AB4425F95F39B4E0127000D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool=script.Parent
local handle=tool:WaitForChild("Handle")
local canslap=false
local auto = false
tool.HitBox.Touched:Connect(function(part)
	if canslap==true or auto==true then
		if part.Parent:FindFirstChildOfClass("Humanoid") then
			local char = part.Parent
			local velocity=char:WaitForChild("HumanoidRootPart").CFrame.LookVector*tool:WaitForChild("Power").Value
			local flingvelocity=velocity*5
			local spinvelocity=velocity*0.5
			local multipliervelocity=tool:WaitForChild("Power").Value*3
			char:FindFirstChildOfClass("Humanoid").PlatformStand=true
			local bv=Instance.new("BodyVelocity")
			bv.Parent=char:WaitForChild("HumanoidRootPart")
			bv.MaxForce=Vector3.new(1e8,1e8,1e8)
			bv.Velocity=flingvelocity+Vector3.new(0,multipliervelocity,0)
			local bav=Instance.new("BodyAngularVelocity")
			bav.Parent=char:WaitForChild("HumanoidRootPart")
			bav.AngularVelocity=flingvelocity+Vector3.new(0,multipliervelocity,0)
			script.Parent.Handle.MeshPart.hit.Enabled = true
			wait(0.1)
			script.Parent.Handle.MeshPart.hit.Enabled = false
			local sound=Instance.new("Sound")
			sound.Parent=char:WaitForChild("HumanoidRootPart")
			sound.Volume=3
			sound.SoundId="rbxassetid://5814804751"
			sound:Play()
			wait(tool:WaitForChild("FlightSpeed").Value)
			bv:Destroy()
			bav:Destroy()
			char:FindFirstChildOfClass("Humanoid").PlatformStand=false
			sound:Destroy()
			local r = require(game:GetService("ReplicatedFirst").Ragdoll)
			r.RagdollCharacter(part.Parent)
			wait(5)
			r.UnRagdollCharacter(part.Parent)
			char:FindFirstChildOfClass("Humanoid"):TakeDamage(1)
		end
	end
end)

tool:WaitForChild("Event").OnServerEvent:Connect(function()
	print("hi")
	if canslap == false then 
		canslap=true
		wait(1.5)
		canslap = false
	end
end)

tool:WaitForChild("Auto").OnServerEvent:Connect(function(player,val)
	auto = val
	print(auto)
end)]]></ProtectedString>
