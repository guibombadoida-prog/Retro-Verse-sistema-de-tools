		<Item class="Script" referent="RBXE4508662436A497399001EE6F6BCB5D3">
			<Properties>
				<ProtectedString name="Source"><![CDATA[
humanoid = script.Parent.Parent.Parent.Character:WaitForChild('Humanoid')

tool = script.Parent
handle = script.Parent.Handle
uses = 1
cooldown = 20

print("Dummy's soda script activated")
function equip()
	handle.Equip:Play()
end
function unequip()
	handle.Unequip:Play()
end
function use()
	
	handle.Use:Play()
	uses = uses - 1
	local save = humanoid.Parent.Torso["Right Shoulder"].C1
	humanoid.Parent.Torso["Right Shoulder"].C1 = CFrame.Angles(-0.7, 0.7, 0)
	
tool.ManualActivationOnly = true
	wait(2)
	if uses < 1 then
		handle.Parent = workspace
		game.Debris:AddItem(handle, 30)
		handle.Drop:Play()
		handle.CanCollide = true
		tool.Name = "Bonk Cola (Empty)"
	end
	humanoid.MaxHealth = 999999999999999999999999999999999999999999999999999999999999999999999999999999999
	humanoid.Health = 999999999999999999999999999999999999999999999999999999999999999999999999999999999
	local sparkles = Instance.new("Sparkles")
	sparkles.Parent = humanoid.Parent.Torso
	humanoid.WalkSpeed = 35
	humanoid.Parent.Torso["Right Shoulder"].C1 = save
	wait(cooldown)
	tool.ManualActivationOnly = false
	humanoid.WalkSpeed = 16
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	sparkles:Destroy()
end

























tool.Activated:Connect(use)
tool.Unequipped:Connect(unequip)
tool.Equipped:Connect(equip)
]]></ProtectedString>
