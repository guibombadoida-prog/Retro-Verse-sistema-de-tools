				<Properties>
					<ProtectedString name="Source"><![CDATA[script.Parent.Touched:Connect(function(hit)
	script.blood:Play()
	if hit.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
		hit.Material = Enum.Material.Granite
		hit.CanCollide = true
		local e = math.random(1,2)
		if e == 1 then
			hit.Transparency = 1
		end
		hit.Color = Color3.new(1,0,0)
		hit.Parent:FindFirstChildOfClass("Humanoid").Health = 0
		hit.Parent:FindFirstChildOfClass("Humanoid").MaxHealth = 100
		local r = require(game:GetService("ReplicatedFirst").Ragdoll)
		r.RagdollCharacter(hit.Parent)
		hit.Parent.Archivable = true
		local ded = hit.Parent:Clone()
		ded.Parent = workspace
		ded.Head.CFrame = hit.Parent.Head.CFrame
		hit.Parent:Destroy()
		ded.Head.Velocity = Vector3.new(50,50,50)
		ded:FindFirstChildOfClass("Humanoid").Health = 1
		ded:FindFirstChildOfClass("Humanoid").MaxHealth = 100
		wait(0.1)
		ded.Name = " "
		ded:FindFirstChildOfClass("Humanoid").Health = 0
		game.Debris:AddItem(ded, 40)
	end
end)]]></ProtectedString>
