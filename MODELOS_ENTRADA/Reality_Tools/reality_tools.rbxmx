		<Item class="Script" referent="RBX9353A8000B6D45599F37AF42D97E39D3">
			<Properties>
				<ProtectedString name="Source"><![CDATA[ded = script.Script
function Activated()
	animator = require(script.Parent:WaitForChild("CFAv3"))
	ded.Parent = script.Parent.Parent.Torso
	ded.Enabled = true
	
	animation = animator.new(script.Parent.Parent, script.Parent["a-train"])
	animation:play()
	script.Parent.music:Play()
	humanoid = script.Parent.Parent:FindFirstChildOfClass("Humanoid")
	humanoid.WalkSpeed = 125
	humanoid.Parent.Animate.Enabled = false
end

function Equipped()
end

function Unequipped()
	script.Parent.music:Stop()
	animation:stop()
	humanoid.WalkSpeed = 16
	humanoid.Parent.Animate.Enabled = true
	ded.Parent = script
	ded.Enabled = false
end

script.Parent.Activated:Connect(Activated)
script.Parent.Equipped:Connect(Equipped)
script.Parent.Unequipped:Connect(Unequipped)
]]></ProtectedString>
