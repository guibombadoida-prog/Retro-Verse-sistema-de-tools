					<Properties>
						<ProtectedString name="Source"><![CDATA[
t = script.Parent.Torso

wait(3)

t.Anchored = true
for i = 1,12 do 
	t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y + 1, t.CFrame.Z)
	wait()
end
script.Parent.theme:Play()
function CreateSound(ID, PARENT, VOLUME, PITCH, DOESLOOP)
	local NEWSOUND = nil
	coroutine.resume(coroutine.create(function()
		NEWSOUND = Instance.new("Sound")
		NEWSOUND.Parent = PARENT
		NEWSOUND.Volume = VOLUME
		NEWSOUND.Pitch = PITCH
		NEWSOUND.SoundId = "http://www.roblox.com/asset/?id="..ID
		NEWSOUND:play()
		if DOESLOOP == true then
			NEWSOUND.Looped = true
		else
			repeat wait(1) until NEWSOUND.Playing == false or NEWSOUND.Parent ~= PARENT
			NEWSOUND:remove()
		end
	end))
	return NEWSOUND
end
function findTorso(pos)
	torso = nil
	local dist = 100000
	local child = workspace:children()
	for i=1, #child do
		if child[i].className == "Model" then
			local h = child[i]:findFirstChild("Humanoid")
			if h ~= nil then
				local check = child[i]:findFirstChild("Head")
				if check ~= nil then
					if (check.Position - pos).magnitude < dist then
						torso = check
						dist = (check.Position - pos).magnitude
					end
				end
			end
		end
	end
	return torso
end
function attack1()
	for i = 1,12 do 
		t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y + 1, t.CFrame.Z)
		wait()
	end
		local torso = findTorso(t.Position)
		if torso ~= nil then
		t.CFrame = CFrame.new(t.Position, torso.Position)
		local direction = t.CFrame.Rotation
		local spawnPos = t.CFrame
		local bobm = Instance.new("Part")
		bobm.Parent = workspace.Terrain
		bobm.CFrame = spawnPos
		bobm.Shape = Enum.PartType.Ball
		bobm.Material = Enum.Material.DiamondPlate
		bobm.Color = Color3.new(1, 0, 0.0156863)
		CreateSound(9073674876, t, 8, 1, false)
		Instance.new("BodyForce", bobm).Force = Vector3.new(0, workspace.Gravity*bobm:GetMass(), 0)
		local TS = game:GetService("TweenService")
		local Ti = TweenInfo.new(0.1)
local e = Instance.new("Fire")
		TS:Create(bobm, Ti, {Position = torso.Position}):Play()
wait(0.1)
		game.Debris:AddItem(bobm, 10)
	e.Parent = bobm
		
		bobm.Touched:Connect(function(man)
			local e = Instance.new("Explosion")
			e.Position = bobm.Position
			e.BlastRadius = 7
			e.BlastPressure = 2
			e.Parent = workspace

			CreateSound(6787514780, e, 1, 1, false)
			bobm:Destroy()
			if man.Parent:FindFirstChildOfClass("Humanoid") ~= nil and man.Parent:FindFirstChild("gravitycatMAIN.") == nil or man.Parent:FindFirstChild("skeleMAIN.") == nil then
				man.Parent:FindFirstChildOfClass("Humanoid").Health = 0
				man.Parent:FindFirstChildOfClass("Humanoid").MaxHealth = 100
				local r = require(game:GetService("ReplicatedFirst").Ragdoll)
				r.RagdollCharacter(man.Parent)
				local o = script.LocalScript:Clone()
				o.Parent = man.Parent
				o.Enabled = true
			end
		end)
		end
end
function attack3()
	local torso = findTorso(t.Position)
	if torso ~= nil then
		t.CFrame = CFrame.new(t.Position, torso.Position)
		end
	local TS = game:GetService("TweenService")
	local Ti = TweenInfo.new(0.5)

	TS:Create(t, Ti, {Position = torso.Position}):Play()
	wait(0.5)
local hit = false
	t.Touched:Connect(function(man)
		if hit == false then
		CreateSound(8397011109, torso, 2, 1, false)
		if torso.Parent:FindFirstChildOfClass("Humanoid") ~= nil then
			torso.Parent:FindFirstChildOfClass("Humanoid"):TakeDamage(15)
			local r = require(game:GetService("ReplicatedFirst").Ragdoll)
			r.RagdollCharacter(man.Parent)
			wait(0.5)
			task.wait(2)
			r.UnRagdollCharacter(man.Parent)
		if torso.Parent:FindFirstChildOfClass("Humanoid") ~= nil and torso.Parent:FindFirstChild("gravitycatMAIN.") == nil then
			torso.Parent:FindFirstChildOfClass("Humanoid").Health = 0
			torso.Parent:FindFirstChildOfClass("Humanoid").MaxHealth = 100
			local r = require(game:GetService("ReplicatedFirst").Ragdoll)
			r.RagdollCharacter(torso.Parent)
			local o = script.LocalScript:Clone()
			o.Parent = torso.Parent
				o.Enabled = true
				local hit = true
	end			
	end
		end
		end)
	end

wait(1)
while true do
	
		wait(math.random(0.6,2))
		local random = math.random(1,2)
		if random == 1 then
			for i = 1,6 do
				attack1()
				wait(0.1)
				end
		end
		
		if random == 2 then
			
				attack3()
	end
	wait(0.8)
	end

]]></ProtectedString>
