			<OptionalCoordinateFrame name="WorldPivotData">
				<CFrame>
					<X>433.064331</X>
					<Y>-342814560</Y>
					<Z>-5329241.5</Z>
					<R00>1.09988304e-21</R00>
					<R01>-3.40660159e-21</R01>
					<R02>-1</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>3.40660159e-21</R12>
					<R20>1</R20>
					<R21>0</R21>
					<R22>-1.09988304e-21</R22>
				</CFrame>
			</OptionalCoordinateFrame>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">Exploding Cola</string>
			<int64 name="SourceAssetId">12370374310</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
		<Item class="Script" referent="RBXE75D0C990EA2468D9D570F69666EFBDC">
			<Properties>
				<ProtectedString name="Source"><![CDATA[
humanoid = script.Parent.Parent.Parent.Character:WaitForChild('Humanoid')

tool = script.Parent
handle = script.Parent.Handle
uses = 1
cooldown = 20
timer = 0

print("Dummy's soda script activated")
function equip()
	handle.Equip:Play()
end
function unequip()
	handle.Unequip:Play()
end
function use()
	
	handle.Use:Play()
	uses = uses - 1
	local save = humanoid.Parent.Torso["Right Shoulder"].C1
	humanoid.Parent.Torso["Right Shoulder"].C1 = CFrame.Angles(-0.7, 0.7, 0)
	
tool.ManualActivationOnly = true
	wait(2)
	if uses < 1 then
		handle.Parent = workspace
		
		handle.Drop:Play()
		handle.CanCollide = true
		tool.Name = "(Exploded)"
	end

	
	humanoid.Parent.Torso["Right Shoulder"].C1 = save
	wait(0.5)
	script.Parent = handle
	handle.CastShadow = false
	
	humanoid:TakeDamage(95)
	handle.Decal:Destroy()
	handle.Decal1:Destroy()
	handle.Decal2:Destroy()
	handle.Explosion:Play()
	handle.Anchored = true
	handle.Material = "Neon"
	handle.kill.Enabled = true
	handle.Name = "Explosion"
	handle.CanCollide = false
	for i = 1, 50 do
		handle.Transparency = handle.Transparency + 0.02
		handle.Size = Vector3.new(handle.Size.X + 1, handle.Size.Y + 1, handle.Size.Z + 1)
		
		wait(0.05)
	end
	handle:Destroy()
	wait(timer)
	wait(cooldown)
	tool.ManualActivationOnly = false

	
end

























tool.Activated:Connect(use)
tool.Unequipped:Connect(unequip)
tool.Equipped:Connect(equip)
]]></ProtectedString>
