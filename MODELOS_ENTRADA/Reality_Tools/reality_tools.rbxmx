				<Item class="Script" referent="RBX9C56D89204C349249A97B007A332209B">
					<Properties>
						<ProtectedString name="Source"><![CDATA[
wait()
local r = require(game:GetService("ReplicatedFirst").Ragdoll)
r.RagdollCharacter(script.Parent)
script.scream:Play()
script.ow:Play()
script.Parent.Head.Transparency = 1
script.Parent.Humanoid.Health = 0
script.Parent.Archivable = true
script.Parent.Head.face.Transparency = 1
local clone = script.Parent:Clone()
clone.death:Destroy()
clone.Parent = workspace
clone:BreakJoints()
clone.Head.CFrame = script.Parent.Head.CFrame
local de = script.Parent
script.Parent = workspace
de:Destroy()

clone.Humanoid.Health = 20
clone.Humanoid.MaxHealth = 100
wait(0)
clone.Humanoid.Health = 0
clone.Head.Velocity = Vector3.new(70,70,70)
for i = 1,math.random(25,30) do
	local hedd = Instance.new("Part", workspace)
	hedd.Size = Vector3.new(0.25,0.25,0.25)
	hedd.CFrame = clone.Head.CFrame * CFrame.new(math.random(-10,10)/20,math.random(-10,10)/20,math.random(-10,10)/20)

	if math.random(1,3) == 1 then
		hedd.BrickColor = clone.Head.BrickColor
		hedd.Material = clone.Head.Material
	else
		hedd.BrickColor = BrickColor.new("Maroon")
		hedd.Material = "Granite"
	end
end]]></ProtectedString>
