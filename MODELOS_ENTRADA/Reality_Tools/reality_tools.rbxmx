		<Item class="Script" referent="RBX1C0CFF825E424C20B9D20E4DFACB8741">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local audios = {
	6881833667,
	7103147161
}
local Debris = game:GetService('Debris')
local Tween = game:GetService('TweenService')

-- the deleting the mouse target was user's fault
local allowedNames = {"Baseplate","Base","Moller","MOLLER"}
function line (from: Vector3, to: Vector3, color: Color3)
end
function animate(v,p)
	if v:IsA("BasePart") then 
		local fbp = v:Clone()
		fbp.Parent = workspace
		fbp.Name = string.char(math.random(1,254))
		fbp.Color = Color3.fromRGB(103, 91, 72)
		fbp.Material = Enum.Material.SmoothPlastic
		fbp.Anchored = true
		fbp.CanCollide = false
		game:GetService("Debris"):AddItem(fbp,1)
		coroutine.wrap(function()
			Tween:Create(fbp,TweenInfo.new(1),{
				Position = p,
				Orientation = Vector3.new(math.random(-360,360),math.random(-360,360),math.random(-360,360)),
				Transparency = 1,
			}):Play()
		end)()
		game:GetService("Debris"):AddItem(v,0)
	end
end
function animatedKil(p)
	pcall(function()
		if p.Parent ~= workspace and p.Parent ~= workspace.Terrain then
			local hc = false
			pcall(function()
				local parente = p:FindFirstAncestorWhichIsA("Folder") or p:FindFirstAncestorWhichIsA("Model") or p:FindFirstAncestorWhichIsA("Configuration") or p:FindFirstAncestorWhichIsA("Script") or p:FindFirstAncestorWhichIsA("ModuleScript") or p:FindFirstAncestorWhichIsA("ViewportFrame") or p:FindFirstAncestorWhichIsA("Tool")
				if parente~=workspace and parente~=workspace.Terrain then
					local vectors = {}

					local minX, maxX, minY, maxY, minZ, maxZ = math.huge, -math.huge,math.huge, -math.huge,math.huge, -math.huge
					pcall(function()
						for _,v in pairs(parente:GetDescendants()) do
							if v:IsA("BasePart") then
								v = v.Position
								if (v.X < minX) then minX = v.X end
								if (v.X > maxX) then maxX = v.X end
								if (v.Y < minY) then minY = v.Y end
								if (v.Y > maxY) then maxY = v.Y end
								if (v.Z < minZ) then minZ = v.Z end
								if (v.Z > maxZ) then maxZ = v.Z end
							end
						end
					end)
					local minVector = Vector3.new(minX, minY, minZ)
					local maxVector = Vector3.new(maxX, maxY, maxZ)

					local center = minVector:Lerp(maxVector, 0.5)

					for _,v in pairs(parente:GetDescendants()) do
						pcall(function()
							if v:IsA("BasePart") then
								hc = true
								animate(v,center)
							end
						end)
					end
				else
					animate(p,p.Position)
				end
			end)
		else
			animate(p,p.Position)
		end
	end)
end
script.Parent.Moller.OnServerEvent:Connect(function(yea,pos,targ)
	local barkie = Instance.new("Sound")
	barkie.Parent = script.Parent.Handle
	barkie.SoundId = "rbxassetid://"..audios[math.random(1,#audios)]
	barkie.PlayOnRemove = true
	barkie.Volume = 1
	barkie:Destroy()
	if yea == game:GetService('Players'):GetPlayerFromCharacter(script:FindFirstAncestorWhichIsA('Model')) then
		pcall(function()
			if pos then
				line(script.Parent.Handle.Position, pos, Color3.fromRGB(103, 91, 72))
			end
			if targ then
				pcall(function()
					if not table.find(allowedNames,targ.Name) then
						animatedKil(targ)
					end
				end)
			end
		end)
	end
end)]]></ProtectedString>
