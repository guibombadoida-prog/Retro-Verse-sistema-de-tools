				<Item class="Script" referent="RBX0FF64CCE55044A93955AA920FDF25967">
					<Properties>
						<ProtectedString name="Source"><![CDATA[name = "Humanoid"

robo = script.Parent:clone()

while true do
	wait(20)
	if script.Parent.Humanoid.Health <= 0 then
		robot=robo:clone()
		robot.Parent=script.Parent.Parent
		robot:makeJoints()
		script.Parent:remove()
	end
end
		


]]></ProtectedString>
