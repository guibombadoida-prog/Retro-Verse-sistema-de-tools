			<Item class="Script" referent="RBX9E2A88591A294D98A294C706C4C90C14">
				<Properties>
					<ProtectedString name="Source"><![CDATA[
local FlingAmount = 100 --Make it high, to go to the sky...
local sound = true			--If the block plays a YEET noise or not.
local sit = true			--If it makes the player sit.
local e = false				--Do not change.
local explode = false		--Change to true, I dare you. :D



function hit(Touch) 
	local blender = Touch.Parent:FindFirstChild("Head") 
	if not (blender == nil) then
		if e == false then
		e = true
		local bv = Instance.new("BodyVelocity")
		bv.P = 1250
		bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
		bv.Velocity = blender.CFrame.lookVector*-FlingAmount
		bv.Parent = blender
		if sit == true then
				Touch.Parent:FindFirstChild("Humanoid").Sit = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
				local rag = script.RagdollSCript:Clone()
				rag.Parent = Touch.Parent
				rag.Enabled = true
		end
		if sound == true then
			local s = script.PunchSound:Clone()
			local random = math.random(10,10)/10
			s.Parent = blender
			s.PlaybackSpeed = random
			s:Play()
		end
		wait(.05)
		bv:Destroy()
		wait(.2)
	
	e = false
		wait(1)
		if explode == true then
			local ex = Instance.new("Explosion")
			ex.ExplosionType = Enum.ExplosionType.NoCraters
			ex.BlastPressure = 100000
			ex.BlastRadius = 2
			ex.Visible = true					
			ex.DestroyJointRadiusPercent = 0
			ex.Position = blender.Position
			ex.Parent = blender
			Touch.Parent:FindFirstChild("Humanoid").Health = 0 
		end



		end
	end 
end

script.Parent.Touched:connect(hit)]]></ProtectedString>
