			L_61_forvar2.Anchored = true
			
			if L_61_forvar2.Name ~= "Grip" and L_61_forvar2.Name ~= "Bolt" and L_61_forvar2.Name ~= 'Lid' then
				Weld(L_61_forvar2, L_1_:WaitForChild("Grip"))
