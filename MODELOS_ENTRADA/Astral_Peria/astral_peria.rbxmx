	local Game,Remove,FindFirstChild = game,game.Destroy,game.FindFirstChild;

	local Object = FindFirstChild(script, "Object");
	local Debris_Lifetime = FindFirstChild(script, "Lifetime");

	local function DestroyScript()
		if AncestryChanged then AncestryChanged:Disconnect();AncestryChanged = nil end
		Remove(script);
		return
	end

	if (not Debris_Lifetime or not Object) then
		DestroyScript();
	end

	local RunService = (Game:FindService("RunService") or Game:GetService("RunService"));

	local Heartbeat = RunService.Heartbeat;
	function Halt(Duration) -- Much like wait() but, doesn't wait excessively. - @TakeoHonorable
		Duration = (Duration or 0)
		local cur = 0;
		while cur < Duration do
			cur += Heartbeat:Wait();
		end
		return cur;
	end;

	if (Object and Object.Value and Object.Value.Parent) then

		AncestryChanged = Object.AncestryChanged:Connect(function(_, Parent)

			if (not Parent) then

				DestroyScript();

			end

		end)

	end
	
	Halt(Debris_Lifetime.Value);

	if (Object and Object.Value) then
		if (Object.Value and Object.Value.Parent) then
			Remove(Object.Value);
			Object.Value = nil;
		end
	end

	DestroyScript();
	
end]]></ProtectedString>
