local Grips = {
	Normal = Tool:FindFirstChild("CFrames"):WaitForChild("NormalGrip").Value,
	Lunging = Tool:FindFirstChild("CFrames"):WaitForChild("LungeGrip").Value
}
Tool.Grip = Grips.Normal

function RayCast(Pos, Dir, Max, IgnoreList)
	return game:GetService("Workspace"):FindPartOnRayWithIgnoreList(Ray.new(Pos, Dir.unit * (Max or 999.999)), IgnoreList) 
end

function IsInTable(Table,Value)
	for _,v in pairs(Table) do
		if v == Value then
			return true
		end
	end
	return false
end

local function Wait(para) -- bypasses the latency
	local Initial = tick()
	repeat
		Services.RunService.Heartbeat:Wait()
	until tick()-Initial >= para
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	Services.Debris:AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

function swordOut()
	local initTime = tick()
	local time = tick()
	local duration = .25
	local initGrip = Tool.Grip
	while (time - initTime) < duration do
		--local frames =5	for i = 1, frames do
		time = tick()
		Tool.Grip = initGrip * CFrame.Angles( (time - initTime)/duration * math.pi/2,0,0)
		SmoothWait()
	end

	--Tool.GripForward = Vector3.new(0,0,-1)
	--Tool.GripRight = Vector3.new(0,1,0)
	--Tool.GripUp = Vector3.new(1,0,0)
	Tool.Grip = Grips.Lunging
	SmoothWait(.25)
end

local function GetNearestTorso(MarkedPosition,TorsoPopulationTable)
	local ClosestDistance = math.huge
	local ClosestTorso
	for i=1,#TorsoPopulationTable do
		local distance = (TorsoPopulationTable[i].CFrame.p-MarkedPosition).magnitude
		if TorsoPopulationTable[i] and  distance < ClosestDistance then
			ClosestDistance = distance
			ClosestTorso = TorsoPopulationTable[i]
		end
	end
	--warn("The Closest Person is: "..ClosestTorso.Parent.Name)
	return ClosestTorso
end

local OrbI = Essentials.OrbCore
local OrbO = Essentials.OrbOutline

local CanTeleport = true

local CurrentTime,LastTime = tick(),tick()
function Activated()
	if not Tool.Enabled then return end
	Tool.Enabled = false
	CurrentTime = tick()
	if (CurrentTime-LastTime) <= 0.2 then
		for i,v in pairs(AttackAnims) do
			v:Stop()
		end
		--print("Lunge")
		Components.PeriTrail.Enabled = true
		--Components.PeriTrail2.Enabled = true
		AttackAnims.Fire:Play()
		Sounds.LungeSound:Play()
		swordOut()
		SmoothWait()
		for i = 1,2 do
			local HasExploded = false
			--[[if not workspace:FindFirstChild("AstralOrb") then
				AstralOrb = New("Model",workspace)
				AstralOrb.Name = "AstralOrb"
			end]]
			local Colors = {
				Color3.fromRGB(255, 255, 255),
				Color3.fromRGB(170, 0, 255),
				Color3.fromRGB(255, 128, 253),
				Color3.fromRGB(255, 119, 0),
				Color3.fromRGB(0, 136, 255),
				Color3.fromRGB(255, 255, 0),
				Color3.fromRGB(8, 0, 255),
				Color3.fromRGB(92, 255, 130),
				Color3.fromRGB(103, 255, 212)
			}
			local ChosenColor = Colors[math.random(1,#Colors)]
			SmoothWait(.15)
			local Inner = OrbI:Clone()
			Inner.Parent = workspace
			local Direction = Root.CFrame.lookVector
			local Pos = Character.HumanoidRootPart.CFrame
			Inner.CFrame = ((Pos + (Direction * (2))))
			Inner.Color = Color3.new(0,0,0)
			Inner.Size = VEC3(1.5,1.5,1.5) --//Hitbox
			Inner.Anchored = false
			Inner.CanTouch = true
			Inner.Name = "InnerOrb"
			local Shell = New("Part",Inner)
			Shell.CanCollide,Shell.CanTouch = false,false
			Shell.Position = Inner.Position
			Shell.Color,Shell.Shape,Shell.Material = Color3.new(0,0,0),Enum.PartType.Ball,Enum.Material.Neon
			Shell.Size,Shell.Massless,Shell.Name = VEC3(1.5, 1.5, 1.5),true,"Shell"
			ExoticDebris:AddItem(Inner,25)
			local Outer = OrbO:Clone()
			Outer.Parent = Inner
			Outer.Position = Inner.Position
			Outer.Color = ChosenColor
			Outer.Name = "Outline"
			Outer.Anchored = false
			Outer.CanTouch = false
			local FXPart = New("Part",workspace)
			FXPart.Position = Inner.Position
			FXPart.Anchored = true
			FXPart.Transparency = 1
			FXPart.Size = VEC3(0.1,0.1,0.1)
			FXPart.CanCollide,FXPart.CanTouch = false,false
			local Sparkles = script:WaitForChild("OrbSpawns"):Clone()
			Sparkles.Parent = FXPart
			Sparkles.Color = ColorSequence.new{
				ColorSequenceKeypoint.new(0,ChosenColor),
				ColorSequenceKeypoint.new(1,ChosenColor)
			}
			OrbFlux(Inner,0.4,0.5,ChosenColor,RNG(2,4),false,40,20)
			Sparkles:Emit(RNG(20,30))
			ExoticDebris:AddItem(FXPart,5)
			local OrbWeld = New("WeldConstraint")
			OrbWeld.Parent = Inner
			OrbWeld.Part0 = Inner
			OrbWeld.Part1 = Outer
			OrbWeld.Enabled = true
			local OrbWeld2 = New("WeldConstraint")
			OrbWeld2.Parent = Inner
			OrbWeld2.Part0 = Inner
			OrbWeld2.Part1 = Shell
			OrbWeld2.Enabled = true
			local OrbScript = Replicated.Singularities:Clone()
			OrbScript.Parent = Inner
			OrbScript.Character.Value = Character
			OrbScript.Player.Value = Player
			OrbScript.Tool.Value = Tool
			OrbScript.DirectSpeed.Value = Properties.Direct_Speed
			OrbScript.ExplodeSize.Value = Properties.Orb_Explode_Range
			OrbScript.Damage.Value = Properties.Orb_Explosion_Damage
			OrbScript.Time.Value = 20
			OrbScript.Disabled = false
			local OrbForce = New("BodyPosition")
			OrbForce.Parent = Inner
			OrbForce.MaxForce = VEC3(1,1,1)*math.huge
			OrbForce.D = RNG(1000,1700)
			OrbForce.Position = (Root.Position + (Root.CFrame.lookVector * (RNG(50,100))))
			OrbForce.Name = "OrbMobility"
			--[[local OrbForce2 = New("BodyPosition")
			OrbForce2.Parent = Outer
			OrbForce2.MaxForce = Vector3.new(1,1,1)*math.huge
			OrbForce2.D = OrbForce.D
			OrbForce2.Position = (OrbForce.Position)
			OrbForce2.Name = "OrbMobility"]]
			Sounds.Pulse:Play()
		end
		SmoothWait(.15)
		Components.PeriTrail.Enabled = false
		--Components.PeriTrail2.Enabled = false
		Tool.Grip = Grips.Normal
	else
		local SwingAnims = {AttackAnims.Slash,AttackAnims.SlashAnim,AttackAnims.RightSlash}
		local AttackAnim = SwingAnims[Seed:NextInteger(1,#SwingAnims)]
		spawn(function()
			if AttackAnim ~= AttackAnims.SlashAnim then
				Sounds.SlashSound:Play()
			else
				Sounds.SlashSound:Play()
				SmoothWait(.5)
				Sounds.SlashSound:Play()
			end	
		end)

		AttackAnim:Play()
		--SmoothWait(.4)
	end
	LastTime = CurrentTime
	Tool.Enabled = true
end

local Touch


function Equipped(Mouse)
	Character = Tool.Parent
	Root = Character:FindFirstChild("HumanoidRootPart")
	Player = Services.Players:GetPlayerFromCharacter(Character)
	Humanoid = Character:FindFirstChildOfClass("Humanoid")
	if not workspace:FindFirstChild("AstralOrb") then
		AstralOrb = New("Model",workspace)
		AstralOrb.Name = "AstralOrb"
	end
	AttackAnims = {
		Slash = Animations:WaitForChild(Humanoid.RigType.Name,10):WaitForChild("Slash",10),
		RightSlash = Animations:WaitForChild(Humanoid.RigType.Name,10):WaitForChild("RightSlash",10),
		SlashAnim = Animations:WaitForChild(Humanoid.RigType.Name,10):WaitForChild("SlashAnim",10),
		Fire = Animations:WaitForChild(Humanoid.RigType.Name,10):WaitForChild("Fire",10)
	}
	
	for i,v in pairs(AttackAnims) do
		AttackAnims[i] = Humanoid:LoadAnimation(v)
	end
	
	Touch = Handle.Touched:Connect(function(hit)
		Damage(hit,Properties.Base_Damage,false)
	end)
end

function Unequipped()
	if Touch then Touch:Disconnect();Touch = nil end
	for i,v in pairs(AttackAnims) do
		v:Stop()
	end
end

local HitHumanoids = {}
function Damage(hit,TotalDamage)
	if not hit or not hit.Parent then return end
	local Hum = hit.Parent:FindFirstChildOfClass("Humanoid")
	local ForceField = hit.Parent:FindFirstChildOfClass("ForceField")
	if not Hum or Hum.Health <=0 or Hum == Humanoid or ForceField then return end
	
	if IsTeamMate(Player,Services.Players:GetPlayerFromCharacter(Hum.Parent)) then return end
	
	spawn(function()
		UntagHumanoid(Hum)
		TagHumanoid(Hum,Player)
		HitHumanoids[#HitHumanoids+1]=Hum
		Hum:TakeDamage(TotalDamage)
		--SmoothWait(.5)
	end)
end

Tool.Activated:Connect(Activated)
Tool.Equipped:Connect(Equipped)
Tool.Unequipped:Connect(Unequipped)

--Specials go here
local DirectOrbs = true
local ExplodeOrbs = true
local SpacePulsar = true

function Explode()
	ExplodeOrbs = false
	--Tool.Enabled = false
	Events.Explode.Value = true

	spawn(function()
		SmoothWait(Properties.ExplodeCD)
		--Tool.Enabled = true
		ExplodeOrbs = true
	end)
	SmoothWait(1/10) --//Can't be a super small number otherwise it wont work
	Events.Explode.Value = false
end

function Direct()
	DirectOrbs = false
	--Tool.Enabled = false
	Events.DirectTo.Value = true
	
	spawn(function()
		SmoothWait(Properties.RedirectCD)
		--Tool.Enabled = true
		DirectOrbs = true
	end)
	SmoothWait(1/10) --//Can't be a super small number otherwise it wont work
	Events.DirectTo.Value = false
end

function NewAstralPulsar()
	if not SpacePulsar then return end
	SpacePulsar = false
	spawn(function()
		Components.PeriSparkle.Enabled = false
		SmoothWait(Properties.Space_Pulsar_CD)
		--Tool.Enabled = true
		SpacePulsar = true
		Components.PeriSparkle.Enabled = true
	end)
	--//We'll handle the spawning of the pulsar and most of the initial VFX here
	local Pulsar = Essentials.Pulsar:Clone()
	Pulsar.Parent,Pulsar.Position = workspace,Root.Position + VEC3(0,45,0)
	Pulsar.Transparency,Pulsar.Orientation,Pulsar.Size,Pulsar.Anchored = 0,VEC3(0,180,180),VEC3(4.275,22.082,5.978),true
	ExoticDebris:AddItem(Pulsar,Properties.Space_Pulsar_Duration + 10)
	local BoltProps = {
		1,--Main Bolt Size
		0.9, --Sub Bolt Size
		6, --Main Bolt Number
		8, --Sub Bolt Number
		Color3.new(0.541176, 0.588235, 1), --Main Particle Color
		Color3.new(0.533333, 0.376471, 1), --Sub Particle Color
		Color3.fromRGB(139, 141, 255), --Main Lighting Color 1
		Color3.fromRGB(139, 141, 255), --Main Lighting Color 2
		Color3.fromRGB(90, 78, 255), --Sub Lightning Color 1
		Color3.fromRGB(90, 78, 255), --Sub Lightning Color 2
	}
	YModule:FireAllClients("Cast_Effects","Hit","Strong",Pulsar.Position,
