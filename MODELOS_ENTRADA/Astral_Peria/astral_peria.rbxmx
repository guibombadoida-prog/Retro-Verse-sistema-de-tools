						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")

return function(Object,TweenTable,Params)
	
	if not Object then
		return
	end
	
	TweenTable = TweenTable or {}
	Params = Params or {}
	
	TweenTable[1] = TweenTable[1] or 0;
	TweenTable[2] = TweenTable[2] or Enum.EasingStyle.Linear;
	TweenTable[3] = TweenTable[3] or Enum.EasingDirection.Out;
	TweenTable[4] = TweenTable[4] or 0;
	TweenTable[5] = TweenTable[5] or false;
	TweenTable[6] = TweenTable[6] or 0;
	
	local Info = TweenInfo.new(
		TweenTable[1],
		TweenTable[2],
		TweenTable[3],
		TweenTable[4],
		TweenTable[5],
		TweenTable[6]
	)
	
	TweenService:Create(Object,Info,Params):Play()
	
end]]></ProtectedString>
						<string name="ScriptGuid">{BA6F383F-97AC-4656-A47F-3ABEE6B59B69}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Tween</string>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX5CBA2029FABF4C4DBC20A4B3AD1B35AE">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--// Astral Pulsar's Main server, coded by @Yukikuramudo

--[[

	Hi there! Yukikuramudo here. I jst want to point out that the only reason I'm doing this entirely outside
	of the main server for the sword is that when the user died, the pulsar would stop functioning entirely.
	
	(THAT IS A REFERENCE TO MY OLD ASTRAL FROM MAY 2024)
	
	I'm making this as a result just incase the user dies while the pulsar is running.
	
	See Line 99 for the main code.
	
	If Astral Pulsar is causing lag i recommend visiting line 221 and changing
	
	the "workspace:GetDescendants() to workspace:GetChildren()"
	
	keep in mind later on i will return to this to optimize EVERYTHING that needs fixing / vast improvement.

]]

local Pulsar = script.Parent

--// Core Functions
local Character = script.Character.Value
local Player = script.Player.Value

local Lasting_Time = script.Duration.Value
local Pillar_Damage = script.BeamDamage.Value
local Pillar_Explosion_Range = script.BeamRange.Value
local Surge_Damage = script.GammaSurgeDamage.Value
local Surge_Range = script.GammaSurgeRange.Value
local Pulsar_Range = script.PulsarRange.Value

local RNG, VEC3, NEW, Self = math.random, Vector3.new, Instance.new, script

local DT, Clone, FindFChild, FindFCoC = script.Destroy, script.Clone, script.FindFirstChild, script.FindFirstChildOfClass

local TweenModule = require(script:FindFirstChild("Tween"))

local RunService = game:GetService("RunService") or game:FindService("RunService")

local ExoticDebris = require(game:GetService("ReplicatedStorage"):FindFirstChild("ExoticDebris"))


local spawn, delay, wait = task.spawn, task.delay, task.wait

local Beaming = false
local Detecting = false
local Mobility = false
local Rotating = false

--[[local Sounds = {
	Pulsar_Radii = Self:FindFirstChild("Pulsar SFX"):WaitForChild("Ambient",10),
	Charging = Self:FindFirstChild("Pulsar SFX"):WaitForChild("Chargeup",10),
	Target_Damage = Self:FindFirstChild("Pulsar SFX"):WaitForChild("Damage",10),
	Laser_Release = Self:FindFirstChild("Pulsar SFX"):WaitForChild("Pulsar Beam",10),
	Laser_Collapse_Explosion = Self:FindFirstChild("Pulsar SFX"):WaitForChild("Pulsar Explosion",10),
}]]

--//End of core functions.
----------------------------------------

function SmoothWait(Number)
	Number = Number or 0
	repeat
		Number = Number - RunService.Heartbeat:Wait()
	until Number <= 0
end

local function random(min, max)
	return RNG()*(max-min) + min
end

Essentials = game.ServerStorage:FindFirstChild("AstralPulsarInstances") 
if script:FindFirstChild("AstralPulsarInstances") then
	Folder = script:WaitForChild("AstralPulsarInstances",10)
	Essentials = game.ServerStorage:FindFirstChild("AstralPulsarInstances") 
	if not Essentials then
		Essentials = Folder:Clone()
		Essentials.Parent = game.ServerStorage
	end
	Folder:Destroy()
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	game:GetService("Debris"):AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

local TargetPoint

local Pulsar_Instances = NEW("Folder",workspace)
ExoticDebris:AddItem(Pulsar_Instances,50)

local function Waver(Position,EndSize,Time,EndTransparency)
	local Wave = Clone(Essentials.Wave)
	Wave.Parent = Pulsar_Instances
	Wave.Position = Position or nil
	Wave.Transparency,Wave.Anchored,Wave.Orientation,Wave.Size = 0,true,VEC3(0,0,0),VEC3(1,0.15,1)
	local Wave2 = Clone(Wave)
	Wave2.Parent = Wave.Parent
	Wave2.Position = Position or nil
	Wave2.Color,Wave2.Size = Color3.fromRGB(81,0,255),VEC3(1.1,0.15,1.1)
	ExoticDebris:AddItem(Wave,Time)
	ExoticDebris:LockToInstance(Wave2,Wave)
	
	EndSize = EndSize or 10
	Time = Time or 1
	EndTransparency = EndTransparency or 1
	
	local WaveSize = VEC3(EndSize,0.15,EndSize) or VEC3(30,0.15,30)
	local WaveSize2 = VEC3(EndSize*1.2,0.15,EndSize*1.2) or VEC3(32,0.3,32)
	
	local TweenTable = {Time,Enum.EasingStyle.Exponential,Enum.EasingDirection.Out,0,false,0}
	TweenModule(Wave,TweenTable,{Size = WaveSize, Position = Pulsar.Position - VEC3(0,12.5,0), Transparency = EndTransparency})
	TweenModule(Wave2,TweenTable,{Size = WaveSize2,Position = Pulsar.Position - VEC3(0,12.5,0), Transparency = EndTransparency})
end

--// Allow the pulsar to detect enemies for here on out...
--// Allow the pulsar to damage enemies as well...

--// MAIN CODE \\--

local Charging = Clone(Self:FindFirstChild("Pulsar SFX"):WaitForChild("Chargeup",10))
Charging.Parent = Pulsar
Charging:Play()

SmoothWait(Charging.TimeLength - 1.2)

local Releaser = Clone(Self:FindFirstChild("Pulsar SFX"):WaitForChild("Pulsar Beam",10))
Releaser.Parent = Pulsar
Releaser:Play()

Beaming = true
Rotating = true
local Active = true

local MainLaser = Clone(Essentials.InnerBeam)
MainLaser.Parent,MainLaser.Position = Pulsar_Instances,Pulsar.Position - VEC3(0,26,0)
MainLaser.Transparency,MainLaser.Orientation,MainLaser.Anchored,MainLaser.Size = 0,VEC3(0,0,90),true,VEC3(28.95,2.6,2.6)

local LaserOutline = Clone(Essentials.OuterBeam)
LaserOutline.Parent,LaserOutline.Position = Pulsar_Instances,MainLaser.Position
LaserOutline.Transparency,LaserOutline.Orientation,LaserOutline.Anchored,LaserOutline.Size = 0,VEC3(0,90,0),true,VEC3(3.5,28.95,3.5)

local End = Clone(Essentials.Core)
End.Parent,End.Position,End.Transparency = Pulsar_Instances,Pulsar.Position - VEC3(0,45,0),0
End.Anchored,End.Size = true,VEC3(1,1,1)*9

local EndOutline = Clone(Essentials.End)
EndOutline.Parent,EndOutline.Position,EndOutline.Transparency = Pulsar_Instances,End.Position,0
EndOutline.Anchored,EndOutline.Size = true,VEC3(1,1,1)*10.5

local EnergyTop = Clone(Essentials:FindFirstChild("Energy Shock"))
EnergyTop.Parent,EnergyTop.Position,EnergyTop.Transparency = Pulsar_Instances,Pulsar.Position - VEC3(0,13.3,0),0
EnergyTop.Anchored,EnergyTop.Size,EnergyTop.Orientation = true,VEC3(6,3.8,6),VEC3(0,0,180)

local EnergyBottom = Clone(Essentials:FindFirstChild("Energy Shock"))
EnergyBottom.Parent,EnergyBottom.Position = Pulsar_Instances,End.Position + VEC3(0,5,0)
EnergyBottom.Orientation,EnergyBottom.Size,EnergyBottom.Anchored = VEC3(0,0,0),VEC3(10,17.5,10),true

local EnergyBottom2 = Clone(EnergyBottom)
EnergyBottom2.Parent,EnergyBottom2.Position = Pulsar_Instances,EnergyBottom.Position + VEC3(0,0.05,0)
EnergyBottom2.Color = Color3.fromRGB(255,255,255)

spawn(function()
	spawn(function()
		while Rotating do --//Astral Pulsar: Shockwave rotation
			local RotationTable = {0.01,Enum.EasingStyle.Linear,Enum.EasingDirection.Out,0,false,0}
			TweenModule(EnergyTop,RotationTable,{Orientation = EnergyTop.Orientation + VEC3(0,30,0)})
			TweenModule(EnergyBottom,RotationTable,{Orientation = EnergyBottom.Orientation + VEC3(0,30,0)})
			TweenModule(EnergyBottom2,RotationTable,{Orientation = EnergyBottom2.Orientation + VEC3(0,30,0)})
			SmoothWait(nil)
		end
	end)
	spawn(function()
		while Beaming do
			Waver(Pulsar.Position - VEC3(0,12.5,0),30,1,1)
			SmoothWait(1)
		end
	end)
end)
SmoothWait(1.4)

Mobility = true
Detecting = true

TargetPoint = Pulsar.Position - VEC3(0,45,0)

spawn(function()
	spawn(function()
		while Mobility do --//Astral Pulsar: Pulsar mobility
			--//I will use tweening for this
			local MomentumTable = {0.4,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false,0}
			TweenModule(Pulsar,MomentumTable,{Position = TargetPoint + VEC3(0,45,0)})
			
			MainLaser.Position = Pulsar.Position - VEC3(0,26,0)
			LaserOutline.Position = MainLaser.Position
			End.Position = Pulsar.Position - VEC3(0,45,0)
			EndOutline.Position = End.Position
			EnergyTop.Position = Pulsar.Position - VEC3(0,13.3,0)
			EnergyBottom.Position = End.Position + VEC3(0,5,0)
			EnergyBottom2.Position = EnergyBottom.Position + VEC3(0,0.05,0)
			
			SmoothWait(nil)
		end
	end)
	spawn(function()
		while Detecting do --//Astral Pulsar: Tracking enemies
			--//I don't know why the pulsar is restricted to detecting very specific enemies but will still detect others beyond just 2 entities.
			for i,v in pairs(game.Workspace:GetDescendants()) do 
				if v and v:FindFirstChildOfClass("Humanoid") and v ~= Character then
					local Humanoid = v:FindFirstChildOfClass("Humanoid")
					local Root = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("UpperTorso")
					local Enemy = v
					if Humanoid and Root and (Root.CFrame.p - Pulsar.CFrame.p).magnitude <= Pulsar_Range and Active and Humanoid.Health > 0 and not v:FindFirstChildOfClass("ForceField") then
						Active = false
						TargetPoint = Root.Position --//Change the current target to the detected enemy
						spawn(function()
							while Humanoid and Humanoid.Health > 0 and Root do
								TargetPoint = Root.Position
								SmoothWait(nil)
							end
						end)
						Humanoid.Died:Connect(function() --//If enemy dies then allow the pulsar to detect another user
							Active = true
						end)
					end
				end
			end
			SmoothWait(1/30)
		end
	end)
	spawn(function()
		while Beaming do
			local Surge = NEW("Explosion")
			Surge.Parent,Surge.Position,Surge.BlastRadius,Surge.BlastPressure = workspace,End.Position,Pillar_Explosion_Range,0
			Surge.DestroyJointRadiusPercent,Surge.Visible,Surge.ExplosionType = 0,false,Enum.ExplosionType.NoCraters --//do NOT set to true unless if you want high lag
			Surge.Hit:Connect(function(Hit)
				local EnemyHumanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
				local ERoot = Hit.Parent:FindFirstChild("HumanoidRootPart") or Hit.Parent:FindFirstChild("Torso") or Hit.Parent:FindFirstChild("UpperTorso")
				if EnemyHumanoid and ERoot and not Hit.Parent:FindFirstChild("GammaPulsarDet") and Hit.Parent ~= Character and not Hit.Parent:FindFirstChildOfClass("ForceField") then
					local Det = NEW("ObjectValue",Hit.Parent)
					Det.Name = "GammaPulsarDet"
					ExoticDebris:AddItem(Det,0.25)
					EnemyHumanoid:TakeDamage(Pillar_Damage)
					EnemyHumanoid:UnequipTools()
					UntagHumanoid(EnemyHumanoid)
					TagHumanoid(EnemyHumanoid, Player)
					local HitThing = Self:FindFirstChild("Impact"):Clone()
					HitThing.Parent = ERoot
					HitThing:Emit(1)
					ExoticDebris:AddItem(HitThing,HitThing.Lifetime.Max)
					local HitSound = Self:FindFirstChild("Pulsar SFX"):FindFirstChild("Damage"):Clone()
					HitSound.Parent = ERoot
					HitSound:Play()
					ExoticDebris:AddItem(HitSound,HitSound.TimeLength)
				end
			end)
			SmoothWait(1/30)
		end
	end)
end)

SmoothWait(Lasting_Time)

function GammaSurge() --//for when the gamma surge happens
	local CollapseTable = {0.4,Enum.EasingStyle.Sine,Enum.EasingDirection.In,0,false,0}
	TweenModule(MainLaser,CollapseTable,{Size = VEC3(0,MainLaser.Size.Y,MainLaser.Size.Z),Position = MainLaser.Position - VEC3(0,MainLaser.Size.X/2,0)})
	TweenModule(LaserOutline,CollapseTable,{Size = VEC3(LaserOutline.Size.X,0,LaserOutline.Size.Z),Position = LaserOutline.Position - VEC3(0,LaserOutline.Size.Y/2,0)})
	TweenModule(Pulsar,{0.6,Enum.EasingStyle.Sine,Enum.EasingDirection.In,0,false,0},{Transparency = 1})
	TweenModule(EnergyTop,{0.2,Enum.EasingStyle.Sine,Enum.EasingDirection.In,0,false,0},{Transparency = 1})
	delay(0.4,function()
		MainLaser:Destroy()
		LaserOutline:Destroy()
		EnergyBottom:Destroy()
		EnergyBottom2:Destroy()
		local BoomTable = {0.6,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false,0}
		local FadeTable = {1,Enum.EasingStyle.Sine,Enum.EasingDirection.In,0,false,0}
		TweenModule(End,BoomTable,{Size = VEC3(1,1,1)*60})
		TweenModule(EndOutline,BoomTable,{Size = VEC3(1,1,1)*69})
		local Wave = Clone(Essentials.Shockwave)
		Wave.Parent,Wave.Position = workspace,End.Position
		Wave.Transparency,Wave.Orientation,Wave.Size,Wave.Anchored = 0,VEC3(0,0,0),VEC3(2,1,2),true
		ExoticDebris:AddItem(Wave,5)
		local OuterWave = Clone(Wave)
		OuterWave.Parent,OuterWave.Color = workspace,Color3.fromRGB(255,255,255)
		ExoticDebris:AddItem(OuterWave,5)
		TweenModule(Wave,BoomTable,{Size = VEC3(113,27,113)})
		TweenModule(OuterWave,BoomTable,{Size = VEC3(105,27,105)})
		delay(0.5,function()
			TweenModule(End,FadeTable,{Transparency = 1})
			TweenModule(EndOutline,FadeTable,{Transparency = 1})
		end)
		delay(1.3,function()
			TweenModule(Wave,FadeTable,{Transparency = 1})
			TweenModule(OuterWave,FadeTable,{Transparency = 1})
		end)
		delay(5,function()
			End:Destroy()
			EndOutline:Destroy()
		end)
		local ExplosionSound = Clone(Self:FindFirstChild("Pulsar SFX"):FindFirstChild("Pulsar Explosion"))
		ExplosionSound.Parent = End
		ExplosionSound:Play()
		local Surge = NEW("Explosion")
		Surge.Parent,Surge.Position,Surge.BlastRadius,Surge.BlastPressure = workspace,End.Position,Surge_Range,0
		Surge.DestroyJointRadiusPercent,Surge.Visible,Surge.ExplosionType = 0,false,Enum.ExplosionType.NoCraters
		Surge.Hit:Connect(function(hit)
			local EHumanoid = hit.Parent:FindFirstChildOfClass("Humanoid")
			local ERoot = hit.Parent:FindFirstChild("HumanoidRootPart") or hit.Parent:FindFirstChild("Torso") or hit.Parent:FindFirstChild("UpperTorso")
			if EHumanoid and ERoot and hit.Parent ~= Character and not hit.Parent:FindFirstChildOfClass("ForceField") and not hit.Parent:FindFirstChild("GammaShockDet") then
				local Tag = NEW("ObjectValue",hit.Parent)
				Tag.Name = "GammaShockDet"
				ExoticDebris:AddItem(Tag,0.1)
				EHumanoid:TakeDamage(Surge_Damage)
				EHumanoid.Sit = true
				if not hit.Parent:FindFirstChild("Confusion_Debuff") then
					local Confuse = Clone(Self:FindFirstChild("Confusion_Debuff"))
					Confuse.Parent = hit.Parent
					Confuse.Duration.Value = 6
					Confuse.Disabled = false
				end
				local delta = ERoot.Position - (Surge.Position + VEC3(0,-10,0))
				local bv = NEW("BodyVelocity")
				bv.maxForce = VEC3(1e9, 1e9, 1e9)
				bv.velocity = delta.unit * 80
				bv.Parent = ERoot
				ExoticDebris:AddItem(bv, 0.1)
				local Spin = NEW("BodyAngularVelocity",ERoot)
				Spin.P = 10000
				Spin.MaxTorque = VEC3(1,1,1)*math.huge
				Spin.AngularVelocity = VEC3(0,RNG(20,40),0)
				ExoticDebris:AddItem(Spin,0.1)
			end
		end)
		
	end)
end

Beaming,Rotating,Mobility,Detecting = false,false,false,false
GammaSurge()

--// We will make the laser beam here

]]></ProtectedString>
