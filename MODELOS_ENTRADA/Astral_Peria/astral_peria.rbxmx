					<Properties>
						<ProtectedString name="Source"><![CDATA[--// Singularities script for Astral Periastron made by @Yukikuramudo

local Outline = script.Parent.Outline
local Singu = script.Parent
local Shell = script.Parent.Shell

local Character = script.Character.Value
local Player = script.Player.Value
local Tool = script.Tool.Value
local Time = script.Time.Value
local RNG = math.random
local TweenModule = require(script:FindFirstChild("Tween"))
local ExoticDebris = require(game:GetService("ReplicatedStorage"):FindFirstChild("ExoticDebris"))
local VEC3 = Vector3.new
local New = Instance.new
local OrbSpeed = script.DirectSpeed.Value
local ExplosionDamage = script.Damage.Value
local TS = (game:FindService("TweenService") or game:GetService("TweenService"))
local ExplosionSize = script.ExplodeSize.Value

local spawn, delay, wait = task.spawn, task.delay, task.wait

local Services = {
	RunService = game:GetService("RunService") or game:FindService("RunService"),
}

function SmoothWait(Number)
	Number = Number or 0
	repeat
		Number = Number - Services.RunService.Heartbeat:Wait()
	until Number <= 0
end

local function random(min, max)
	-- roblox's math.random doesnt support decimals which is dumb so we have to do this
	return math.random()*(max-min) + min
end

Essentials = game.ServerStorage:FindFirstChild("AstralExplosionStuff") 
if script:FindFirstChild("AstralExplosionStuff") then
	Folder = script:WaitForChild("AstralExplosionStuff",10)
	Essentials = game.ServerStorage:FindFirstChild("AstralExplosionStuff") 
	if not Essentials then
		Essentials = Folder:Clone()
		Essentials.Parent = game.ServerStorage
	end
	Folder:Destroy()
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	game:GetService("Debris"):AddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end

function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

local HasBeenHit = false
local HasBeenDirected = false
local HasExploded = false

local function ExplodeVFX()
	local TweenTable = {1,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false,0}
	local InneriteParams = {Size = VEC3(1,1,1)*12.5}
	local OutlineParams = {Size = VEC3(1,1,1)*14}
	local RingParams = {Size = VEC3(24,2.5,24),Rotation = VEC3(0,RNG(-1000,1000),0)}

	local StarExplosion = Essentials:FindFirstChild("Inner"):Clone()
	StarExplosion.Parent = workspace
	StarExplosion.Position = Singu.Position
	StarExplosion.Transparency = 0.1
	StarExplosion.Size = VEC3(1,1,1)*0.5
	StarExplosion.Orientation = VEC3(RNG(-360,360),RNG(-360,360),RNG(-360,360))
	local StarOutline = Essentials:FindFirstChild("Outline"):Clone()
	StarOutline.Parent = workspace
	StarOutline.Position = StarExplosion.Position
	StarOutline.Size = VEC3(1,1,1)*0.6
	StarOutline.Transparency = 0.4
	StarOutline.Orientation = StarExplosion.Orientation
	local Ring = Essentials:FindFirstChild("Ring"):Clone()
	Ring.Parent = workspace
	Ring.Position = StarExplosion.Position
	Ring.Size = VEC3(2,0.1,2)*0.8
	Ring.Transparency = 0
	Ring.Orientation = VEC3(0,VEC3(0,RNG(-360,360)),0)
	ExoticDebris:AddItem(StarExplosion,5)
	ExoticDebris:LockToInstance(StarOutline,StarExplosion)
	ExoticDebris:LockToInstance(Ring,StarExplosion)

	local ExplosionSound = script:FindFirstChild("Explosion"):Clone()
	ExplosionSound.Parent = StarExplosion
	ExplosionSound:Play()
	ExoticDebris:AddItem(ExplosionSound,ExplosionSound.TimeLength)

	spawn(function()
		local FadeProps = {Transparency = 1}
		TweenModule(StarExplosion,TweenTable,InneriteParams)
		TweenModule(StarOutline,TweenTable,OutlineParams)
		TweenModule(Ring,TweenTable,RingParams)
		delay(1,function() --//Delay and then make the parts fade out
			local FadeTweenTable = {1,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false,0}
			TweenModule(StarExplosion,FadeTweenTable,FadeProps)
			TweenModule(StarOutline,FadeTweenTable,FadeProps)
			delay(1,function() --//Destroy the part
				StarExplosion:Destroy()
				StarOutline:Destroy()
			end)
		end)
		delay(1,function() --//Delay and then make the parts fade out
			local FadeTweenTable = {0.6,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,false,0}
			TweenModule(Ring,FadeTweenTable,FadeProps)
			delay(1,function() --//Destroy the part
				Ring:Destroy()
			end)
		end)
	end)

	Singu.Transparency = 1
	Outline.Transparency = 1
	Shell.Transparency = 1
	for i,v in pairs (Singu:GetChildren()) do
		if v and v:IsA("Trail") then
			v:Destroy()
		elseif v and v:IsA("ParticleEmitter") then
			v.Enabled = false
		end
	end
	delay(4,function()
		Singu:Destroy()
		Outline:Destroy()
		Shell:Destroy()
	end)
end

delay(Time,function() --//Causes the orbs to explode individually after a set period of time.
	if not HasExploded and not HasBeenDirected then
		HasExploded = true
		ExplodeVFX()
		local PatchyBoom = New("Explosion")
		PatchyBoom.Parent,PatchyBoom.Position = workspace,Singu.Position
		PatchyBoom.BlastRadius,PatchyBoom.BlastPressure = ExplosionSize,nil
		PatchyBoom.ExplosionType,PatchyBoom.DestroyJointRadiusPercent,PatchyBoom.Visible = Enum.ExplosionType.NoCraters,0,false
		PatchyBoom.Hit:Connect(function(Hit)
			local Humanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
			local Root = Hit.Parent:FindFirstChild("HumanoidRootPart") or Hit.Parent:FindFirstChild("Torso") or Hit.Parent:FindFirstChild("UpperTorso")
			if Humanoid and Root and not Hit.Parent:FindFirstChildOfClass("ForceField") and Hit.Parent ~= Character and not Hit.Parent:FindFirstChild("OrbExplosionTag") then
				Humanoid:TakeDamage(ExplosionDamage)
				UntagHumanoid(Humanoid)
				TagHumanoid(Humanoid, Player)
				Humanoid.Sit = true
				local Tag = New("ObjectValue",Hit.Parent)
				Tag.Name = "OrbExplosionTag"
				ExoticDebris:AddItem(Tag,0.01)
				local Force = New("BodyVelocity",Root)
				Force.MaxForce = VEC3(1,1,1)*math.huge
				Force.Velocity = Root.Position - (script.Parent.Position + VEC3(0,-10,0)).Unit * 20
				ExoticDebris:AddItem(Force,0.01)
				if not Hit.Parent:FindFirstChild("Confusion_Debuff") then
					local Confusion = script:FindFirstChild("Confusion_Debuff"):Clone()
					Confusion.Parent = Hit.Parent
					Confusion.Duration.Value = 4
					Confusion.Disabled = false
				end
			end
		end)
	end
end)

