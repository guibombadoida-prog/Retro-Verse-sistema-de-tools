					<Properties>
						<ProtectedString name="Source"><![CDATA[local Character = script.Character.Value
local Player = script.Player.Value

function DebrisAddItem(Thing,Time)
	local Script = script.FakeDebrisService:Clone()
	Script.Parent = Thing
	Script.TimeToDelete.Value = Time
	Script.ThingToDestroy.Value = Thing
	Script.Disabled = false
end

function TagHumanoid(humanoid, player)
	local Creator_Tag = Instance.new("ObjectValue")
	Creator_Tag.Name = "creator"
	Creator_Tag.Value = player
	DebrisAddItem(Creator_Tag, 2)
	Creator_Tag.Parent = humanoid
end


function UntagHumanoid(humanoid)
	for i, v in pairs(humanoid:GetChildren()) do
		if v:IsA("ObjectValue") and v.Name == "creator" then
			v:Destroy()
		end
	end
end

function IsTeamMate(Player1, Player2)
	return (Player1 and Player2 and not Player1.Neutral and not Player2.Neutral and Player1.TeamColor == Player2.TeamColor)
end

script.Parent.Hit:Connect(function(Hit)
	local Humanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
	local Root = Hit.Parent:FindFirstChild("HumanoidRootPart") or Hit.Parent:FindFirstChild("Torso")
	if Humanoid and Root and Hit.Parent ~= Character and not Hit.Parent:FindFirstChild("SupernovaDetection") then
		local HasBeenHit = Instance.new("ObjectValue",Hit.Parent)
		HasBeenHit.Name = "SupernovaDetection"
		DebrisAddItem(HasBeenHit,0.2)
		UntagHumanoid(Humanoid)
		TagHumanoid(Humanoid,Player)
		if IsTeamMate(Player,game:GetService("Players"):GetPlayerFromCharacter(Humanoid.Parent)) then return end
		local Confusion = script.Confusion_Debuff:Clone()
		Confusion.Parent = Hit.Parent
		Confusion.Disabled = false
		Humanoid:TakeDamage(25)
		Humanoid.Sit = true
		if Root and Root:FindFirstChild("Attraction") then
			Root.Attraction:Destroy()
		end
		if Root and Root:FindFirstChild("Magnet") then
			Root.Magnet:Destroy()
		end
		if Hit and Hit:FindFirstChild("Attraction") then
			Hit.Attraction:Destroy()
		end
		if Hit and Hit:FindFirstChild("Magnet") then
			Hit.Magnet:Destroy()
		end
		local delta = Root.Position - (script.Parent.Position + Vector3.new(0,-10,0) )
		local bv = Instance.new("BodyVelocity")
		bv.maxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.velocity = delta.unit * 10
		bv.Parent = Root
		DebrisAddItem(bv, 0.1)
	end
end)]]></ProtectedString>
