							<Item class="Script" referent="RBXF152B040776F4FB6998415EB69B78A12">
								<Properties>
									<ProtectedString name="Source"><![CDATA[--//BEHOLD, THE ANTI-TWEENSERVICE PULSATE SCRIPT! (For if you wanted to use weldConstraints with parts using tweenservice)
--//Scripted by Yukikuramudo
local Par = script.Parent

local Configs = {
	PulsateSizeMin = -3, --The smallest amount to be added onto the part's size
	PulsateSizeMax = 3, --The largest amount to be added onto the part's size
	HaltTime = 0.02, --How long the pulse will stop for until goining to the second pulse
	TotalPulses = 60, --Total times the object will pulsate
	PulseDelay = 0.02 --Time until the part should pulsate again

	--//Feel free to add more here! (Do scripting though)
}

function SmoothWait(Number)
	Number = Number or 0
	repeat
		Number = Number - game:GetService("RunService").Heartbeat:Wait()
	until Number <= 0
end

local RNG = math.random

while script.Enabled do
	for i = 1,Configs.TotalPulses do
		local ChosenValue = RNG(Configs.PulsateSizeMin,Configs.PulsateSizeMax)
		Par.Size = Par.Size + Vector3.new(ChosenValue,ChosenValue,ChosenValue) --//First Pulse
		SmoothWait(Configs.HaltTime)
		Par.Size = Par.Size - Vector3.new(ChosenValue,ChosenValue,ChosenValue) --//Second Pulse
		SmoothWait(Configs.PulseDelay)
	end
end
]]></ProtectedString>
									<bool name="Disabled">true</bool>
									<Content name="LinkedSource"><null></null></Content>
									<token name="RunContext">0</token>
									<string name="ScriptGuid">{7C794850-FDF4-4FE9-A83E-BC1AB417D3CF}</string>
									<BinaryString name="AttributesSerialize"></BinaryString>
									<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
									<bool name="DefinesCapabilities">false</bool>
									<string name="Name">Pulsate</string>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								</Properties>
							</Item>
							<Item class="Script" referent="RBX475A8AE034E441C59635BE1448F9EBFD">
								<Properties>
									<ProtectedString name="Source"><![CDATA[local part = script.Parent

local TweenService = game:GetService("TweenService")

local Info = TweenInfo.new(
	2, -- Time
	Enum.EasingStyle.Quart, -- EasingStyle
	Enum.EasingDirection.Out, -- EasingDirection
	0, -- RepeatCount (when less than zero the tween will loop indefinitely)
	false, -- Reverses (tween will reverse once reaching its goal)
	0 -- DelayTime
)

local Properties = {
	Size = Vector3.new(0.6,0.6,0.6),
	Transparency = 1
}

local transparencyDelay = 1 -- Delay in seconds
local transparencyTweeen = TweenService:Create(part, Info, Properties)

-- Apply the size tween immediately
local sizeTweeen = TweenService:Create(part, Info, {Size = Vector3.new(0.6,0.6,0.6)})
sizeTweeen:Play()

-- Delay before applying transparency tween
wait(transparencyDelay)
transparencyTweeen:Play()

wait(2.2)
part:Destroy()
]]></ProtectedString>
