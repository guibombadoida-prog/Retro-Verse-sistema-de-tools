	ParticleFolder = script:WaitForChild("Particles",10)
}

local Events = {
	Starified = Tool:WaitForChild("Events").Starified,
	Explode = Tool:WaitForChild("Events").Explode,
	DirectTo = Tool:WaitForChild("Events").Direct,
	--Moving = Tool:WaitForChild("Events").InTween
}

local ExoticDebris = require(script.ExoticDebris)
local YModule = require(125275839196878)
--local TweenModule = require(Replicated:FindFirstChild("Tween"))
--local TModule = require(Services.ReplicatedStorage:FindFirstChild("TakeosVFXSystem"))

local RNG, VEC3, New = math.random,  Vector3.new, Instance.new

function SmoothWait(Number)
	Number = Number or 0
	repeat
		Number = Number - Services.RunService.Heartbeat:Wait()
	until Number <= 0
end

Components.PeriSparkle.Enabled = true
Components.PeriTrail.Enabled = false
PointLight.Enabled = true

local Player,Character,Humanoid,Root,Torso

local AstralOrb

function ShakeOld(Part,Intensity,Time)
	for i,v in pairs(game.Players:GetChildren())do
		if (v.Character.Head.Position-Part.Position).magnitude<=200 then
			local shakeS=Replicated.ShakeScriptOld:clone()
			shakeS.Parent=v.PlayerGui
			local val=Intensity-((v.Character.Head.Position-Part.Position).magnitude/25)
			if val<=0 then
				val=0
			end
			shakeS.pwr.Value=val
			shakeS.Disabled=false
			Services.TweenService:create(shakeS.pwr,TweenInfo.new(Time),{Value=0}):play()
			game.Debris:AddItem(shakeS,1)
		end
	end
end

function Shake(Part,Intensity,Time,Range)
	for i,v in pairs(game.Players:GetChildren())do
		if (v.Character.Head.Position-Part.Position).magnitude<=Range then
			local shakeS=Replicated.ShakeScript:clone()
			shakeS.Parent=v.PlayerGui
			local val=Intensity-((v.Character.Head.Position-Part.Position).magnitude/25)
			if val<=0 then
				val=0
			end
			shakeS.Duration.Value = Time
			shakeS.Range.Value = Range
			shakeS.Strength.Value = val
			shakeS.Disabled = false
			--Services.TweenService:create(shakeS.pwr,TweenInfo.new(Time),{Value=0}):play()
			--ExoticDebris:AddItem(shakeS,Time+1)
		end
	end
end

Gear_Manager = require(6645113937)

function OrbFlux(Position,Duration,Size,Color,Number,Gather,MaxDistance,MinDistance)
	local VFX = script:FindFirstChild("Power"):Clone() or script:WaitForChild("Power"):Clone()
	VFX.Position.Value = Position or Root
	VFX.Duration.Value = Duration or 1.2
	VFX.Size.Value = Size or 1
	VFX.Color.Value = Color or Color3.fromRGB(255, 255, 255)
	VFX.Number.Value = Number or 4
	VFX.Gather.Value = Gather or false
	VFX.Radius_Max.Value = MaxDistance or 230
	VFX.Radius_Min.Value = MinDistance or 180
	VFX.Enabled = true
	Gear_Manager.CastLocalScripts(nil,VFX,Duration + 2.75,false)
	--Exoticdebris.AddItem(nil,VFX,Duration + 1.75)
end

local Properties = {
	Base_Damage = 27,
	
	--// Re-Direct \\--
	Redirect_CD = 1,
	Direct_Speed = 100,
	--// Explode \\--
