				<Item class="LocalScript" referent="RBX973AC930E4114D77A28AC5EB4F540831">
					<Properties>
						<ProtectedString name="Source"><![CDATA[local cam=workspace.CurrentCamera
local cf=cam.CFrame
local power=script.pwr

while true do
game:GetService("RunService").RenderStepped:wait()
cam.CFrame=cam.CFrame:lerp(cam.CFrame*CFrame.Angles(math.random(-power.Value,power.Value)/360,math.random(-power.Value,power.Value)/360,math.random(-power.Value,power.Value)/360),.1)
--[[spawn(function()
wait()
cam.CFrame=cf
end)]]
end]]></ProtectedString>
						<bool name="Disabled">true</bool>
