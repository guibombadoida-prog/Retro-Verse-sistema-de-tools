							</Item>
							<Item class="Script" referent="RBX2A02358E71C4447292880E07A5EB74F0">
								<Properties>
									<ProtectedString name="Source"><![CDATA[--//BEHOLD, THE ANTI-TWEENSERVICE PULSATE SCRIPT! (For if you wanted to use weldConstraints with parts using tweenservice)
--//Scripted by Yukikuramudo
local Par = script.Parent

local Configs = {
	PulsateSizeMin = -3, --The smallest amount to be added onto the part's size
	PulsateSizeMax = 3, --The largest amount to be added onto the part's size
	HaltTime = 0.02, --How long the pulse will stop for until goining to the second pulse
	TotalPulses = 60, --Total times the object will pulsate
	PulseDelay = 0.02 --Time until the part should pulsate again

	--//Feel free to add more here! (Do scripting though)
}

function SmoothWait(Number)
	Number = Number or 0
	repeat
		Number = Number - game:GetService("RunService").Heartbeat:Wait()
	until Number <= 0
end

local RNG = math.random

while script.Enabled do
	for i = 1,Configs.TotalPulses do
		local ChosenValue = RNG(Configs.PulsateSizeMin,Configs.PulsateSizeMax)
		Par.Size = Par.Size + Vector3.new(ChosenValue,ChosenValue,ChosenValue) --//First Pulse
		SmoothWait(Configs.HaltTime)
		Par.Size = Par.Size - Vector3.new(ChosenValue,ChosenValue,ChosenValue) --//Second Pulse
		SmoothWait(Configs.PulseDelay)
	end
end
]]></ProtectedString>
