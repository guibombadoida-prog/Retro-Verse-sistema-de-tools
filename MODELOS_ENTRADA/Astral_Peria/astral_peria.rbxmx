	--// Explode and Re-Direct \\--
	Orb_Explode_Range = 20,
	Orb_Explosion_Damage = 25,
	
	--// Astral / Omega Pulsar \\--
	Space_Pulsar_CD = 60,
	Pulsar_Hurts_User = true,
	Space_Pulsar_Duration = 30,
	Space_Pulsar_Range = 200,
	Space_Pulsar_Damage = 15,
	Pulsar_Radii_Range = 10,
	
	Gamma_Surge_Damage = 34,
	Gamma_Surge_Range = 60,
}

local CanDirect = true
