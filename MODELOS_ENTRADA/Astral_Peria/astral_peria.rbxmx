								<ProtectedString name="Source"><![CDATA[local Instant,Pairs,Type,IsA,GetChildren,Clone,Destroy,FindFirstChild,FindFirstChildOfClass = Instance.new,pairs,type,script.IsA,script.GetChildren,script.Clone,script.Destroy,script.FindFirstChild,script.FindFirstChildOfClass;

local inf,Vec3,RNG = math.huge,Vector3.new,math.random;

local Pcall = pcall;

--//

local RunService = (game:FindService("RunService") or game:GetService("RunService"));

--//

function Create(ty)
	return function(data)
		local obj = Instant(ty)
		for k, v in Pairs(data) do
			if Type(k) == "number" then
				v.Parent = obj
			else
				obj[k] = v
			end
		end
		return obj
	end
end

local Heartbeat = RunService.Heartbeat;
function Halt(Duration) -- Much like wait() but, doesn't wait excessively. - @TakeoHonorable
	--// Arguments: (Duration[Number])

	Duration = (Duration or 0)
	local cur = 0;
	while cur < Duration do
		cur += Heartbeat:Wait();
	end
	return cur;

end

--//

local Player = (FindFirstChild(script, "Player") or script:WaitForChild("Player")).Value;

local Ref = (FindFirstChild(script, "Ref") or script:WaitForChild("Ref")).Value;

if (not Player or not Ref) then Destroy(script); return end

local Main = nil;

local AncestryChanged = nil;

function CleanUp()
	
	Halt(5);
	
	if Main then
		Destroy(Main);
		Main = nil;
	end
	
	Destroy(script);
	
	return
	
end

local PlayerGui = FindFirstChildOfClass(Player, "PlayerGui");

if PlayerGui then
	
	Main = Create("ScreenGui"){
		Name = "Invert_Controls";
		ResetOnSpawn = false;
		Parent = PlayerGui;
	};
	
	local Invert_Controls = Clone(script.Invert_Controls);
	Invert_Controls.Parent = Main;
	
	Create("ObjectValue"){
		Name = "Ref";
		Value = Ref;
		Parent = Invert_Controls;
	};
	
	Invert_Controls.Disabled = false;
	
end

if (Ref and Ref.Parent) then
	
	AncestryChanged = Ref.AncestryChanged:Connect(function(_,parent)
		
		if (not parent) then
			
			if AncestryChanged then AncestryChanged:Disconnect(); AncestryChanged = nil; end
			
			CleanUp();
			
		end
		
	end)
	
else
	
	CleanUp();
	
end]]></ProtectedString>
