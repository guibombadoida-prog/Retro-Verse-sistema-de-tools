							<ProtectedString name="Source"><![CDATA[
local TweenService = game:FindService("TweenService") or game:GetService("TweenService")

return function(Object,TweenTable,Params)
	
	if not Object then
		return
	end
	
	TweenTable = TweenTable or {}
	Params = Params or {}
	
	TweenTable[1] = TweenTable[1] or 0;
	TweenTable[2] = TweenTable[2] or Enum.EasingStyle.Linear;
	TweenTable[3] = TweenTable[3] or Enum.EasingDirection.Out;
	TweenTable[4] = TweenTable[4] or 0;
	TweenTable[5] = TweenTable[5] or false;
	TweenTable[6] = TweenTable[6] or 0;
	
	local Info = TweenInfo.new(
		TweenTable[1],
		TweenTable[2],
		TweenTable[3],
		TweenTable[4],
		TweenTable[5],
		TweenTable[6]
	)
	
	TweenService:Create(Object,Info,Params):Play()
	
end]]></ProtectedString>
