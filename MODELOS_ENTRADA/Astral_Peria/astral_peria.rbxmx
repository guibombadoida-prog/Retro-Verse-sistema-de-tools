			<Item class="ModuleScript" referent="RBX12DE00C683854727870E849A1EF29F7A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--// Cooler Debris Service

local SERVICES = {};

--//

local Game,Instant,Duplicate,Remove,FindFirstChild,WaitForChild,Typeof = game,Instance.new,game.Clone,game.Destroy,game.FindFirstChild,game.WaitForChild,typeof;

local RunService = (Game:FindService("RunService") or Game:GetService("RunService"))
local ServerScriptService = (Game:FindService("ServerScriptService") or Game:GetService("ServerScriptService"))

local Usage_Type = "Server"; --// Default

if RunService:IsClient() then
	Usage_Type = "Client"; --//
elseif RunService:IsServer() then
	Usage_Type = "Server"; --//
end

--//

local Debris_Script = (FindFirstChild(script,"Debris_Script_"..Usage_Type) or WaitForChild(script,"Debris_Script_"..Usage_Type));

function SERVICES:AddItem(Instance_Item, Lifetime)
	
	--// Better version of Debris:AddItem()
	
	if (Instance_Item and Typeof(Instance_Item) == "Instance") then
		
		if (Typeof(Lifetime) == "number") then
			
			if (Lifetime <= 0) then --// Lifetime is 0 or below --> Destroy Instantly
				
				Remove(Instance_Item);
				Instance_Item = nil;
				
			else
				
				local Clone_Debris_Script = Duplicate( Debris_Script ); --// Clone a script that destroys an instance.
				Clone_Debris_Script.Parent = ServerScriptService;

				--//
				
				local Object = Instant("ObjectValue");
				Object.Name = "Object";
				Object.Value = Instance_Item;
				Object.Parent = Clone_Debris_Script;

				local Lifespan = Instant("NumberValue");
				Lifespan.Name = "Lifetime";
				Lifespan.Value = Lifetime;
				Lifespan.Parent = Clone_Debris_Script;

				--//

				Clone_Debris_Script.Disabled = false;
			end
		end
	end
end

local Hook = (FindFirstChild(script,"Hook") or WaitForChild(script,"Hook"));

function SERVICES:Hook(Instance_Item1, Instance_Item2) --// Server only.
	
	--// Allowing instances to destroy the other if one of them is destroyed.
	
	if (Instance_Item1 and Instance_Item2) then
		
		if (Typeof(Instance_Item1) == "Instance" and Typeof(Instance_Item2) == "Instance") then
			
			local Hook_Duplicate = Duplicate(Hook);

			--//

			local Object1 = Instant("ObjectValue");
			Object1.Name = "Object1";
			Object1.Value = Instance_Item1;
			Object1.Parent = Hook_Duplicate;
			
			local Object2 = Instant("ObjectValue");
			Object2.Name = "Object2";
			Object2.Value = Instance_Item2;
			Object2.Parent = Hook_Duplicate;
			
			--//
			
			Hook_Duplicate.Parent = ServerScriptService;
			Hook_Duplicate.Disabled = false;
			
			
		end
		
	end
	
end

local Lock = (FindFirstChild(script,"Lock") or WaitForChild(script,"Lock"));

function SERVICES:LockToInstance(Instance_Item1, Instance_Item2)
	
	--// This will lock Instance_Item1 to Instance_Item2 - Meaning if Instance_Item2 is 'Destroyed' then Instance_Item1 will be 'Destroyed' too.
	
	if (Instance_Item1 and Instance_Item2) then

		if (Typeof(Instance_Item1) == "Instance" and Typeof(Instance_Item2) == "Instance") then

			local Lock_Duplicate = Duplicate(Lock);

			--//

			local Object1 = Instant("ObjectValue");
			Object1.Name = "Object1";
			Object1.Value = Instance_Item1;
			Object1.Parent = Lock_Duplicate;

			local Object2 = Instant("ObjectValue");
			Object2.Name = "Object2";
			Object2.Value = Instance_Item2;
			Object2.Parent = Lock_Duplicate;

			--//

			Lock_Duplicate.Parent = ServerScriptService;
			Lock_Duplicate.Disabled = false;


		end

	end
	
end

return SERVICES;
]]></ProtectedString>
					<string name="ScriptGuid">{52687e1e-bdc8-42ac-85d3-4ca7c613fea2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
					<bool name="DefinesCapabilities">true</bool>
					<string name="Name">ExoticDebris</string>
					<int64 name="SourceAssetId">6076058910</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
				<Item class="Script" referent="RBX79C5E5DF0424452AB636BD2FAC8919D3">
					<Properties>
						<ProtectedString name="Source"><![CDATA[do
	
	local Game,Remove,FindFirstChild = game,game.Destroy,game.FindFirstChild;

	--//

	local Object = FindFirstChild(script, "Object");
	local Debris_Lifetime = FindFirstChild(script, "Lifetime");

	--//

	local function DestroyScript()
		if AncestryChanged then AncestryChanged:Disconnect();AncestryChanged = nil end
		Remove(script);
		return
	end

	if (not Debris_Lifetime or not Object) then
		DestroyScript();
	end

	local RunService = (Game:FindService("RunService") or Game:GetService("RunService"));

	local Heartbeat = RunService.Heartbeat;
	function Halt(Duration) -- Much like wait() but, doesn't wait excessively. - @TakeoHonorable
		Duration = (Duration or 0)
		local cur = 0;
		while cur < Duration do
			cur += Heartbeat:Wait();
		end
		return cur;
	end;

	if (Object and Object.Value and Object.Value.Parent) then
		
