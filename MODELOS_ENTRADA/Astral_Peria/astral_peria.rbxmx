			PatchyBoom.ExplosionType,PatchyBoom.DestroyJointRadiusPercent,PatchyBoom.Visible = Enum.ExplosionType.NoCraters,0,false
			PatchyBoom.Hit:Connect(function(Hit)
				local Humanoid = Hit.Parent:FindFirstChildOfClass("Humanoid")
