			<Properties>
				<ProtectedString name="Source"><![CDATA[--// Scripted by Yukikuramudo 
--// Custom Periastrons: the Periastron of Astral Space


--[[

	Keep in mind that i'll be coming back to this and optimizing EVERYTHING.
	And for those of you who know about Catalog Gear Place, i'll be optimizing this thing
	AFTER i finish my Cosmic Scythe project, with 8 specials.

	This may take until Febuary until i can tamper with this again C:
	
	What i should change when i get the chance to change this:
	
	-Astral Pulsar's detection method as the for i, v in pairs method invokes lag
	to GearManager's Detect_Humanoids_Nearby method as that is smoother
	
	-Change all damage methods using explosions to using GearManager's Detect_Humanoids_Nearby
	method
	
	-Change all VFX to localscripts to prevent stress on the server therefore preventing lagging
	for weaker devices
	
	-Redo some portions of the script i guess? (likely since this is future me here, as i am now
	getting to where i have high potential in possibly joining the CGP dev team)

]]

function Create(ty)
	return function(data)
		local obj = Instance.new(ty)
		for k, v in pairs(data) do
			if type(k) == 'number' then
				v.Parent = obj
			else
				obj[k] = v
			end
		end
		return obj
	end
end

local function random(min, max)
	-- roblox's math.random doesnt support decimals which is dumb so we have to do this
	return math.random()*(max-min) + min
end

Essentials = game.ServerStorage:FindFirstChild("AstralPeriEssentials") 
if script:FindFirstChild("AstralPeriEssentials") then
	Folder = script:WaitForChild("AstralPeriEssentials",10)
	Essentials = game.ServerStorage:FindFirstChild("AstralPeriEssentials") 
	if not Essentials then
		Essentials = Folder:Clone()
		Essentials.Parent = game.ServerStorage
	end
	Folder:Destroy()
end

--//Why not?
Replicated = game.ReplicatedStorage:FindFirstChild("AstralReplicated")
if script:FindFirstChild("AstralReplicated") then
	Folder = script:WaitForChild("AstralReplicated",10)
	Replicated = game.ReplicatedStorage:FindFirstChild("AstralReplicated") 
	if not Replicated then
		Replicated = Folder:Clone()
		Replicated.Parent = game.ReplicatedStorage
	end
	Folder:Destroy()
end

