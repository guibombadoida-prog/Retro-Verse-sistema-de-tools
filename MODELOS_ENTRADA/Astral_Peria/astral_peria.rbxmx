					<Item class="Script" referent="RBXBEE95247B6354009855498787999F305">
						<Properties>
							<ProtectedString name="Source"><![CDATA[do
	
	--// Scripted by: @Konochimi
	--// This debuff will cause the inflicted target into walking in random direction.

	local Instant,Pairs,Type,IsA,GetChildren,Clone,Destroy,FindFirstChild,FindFirstChildOfClass = Instance.new,pairs,type,script.IsA,script.GetChildren,script.Clone,script.Destroy,script.FindFirstChild,script.FindFirstChildOfClass;

	local inf,Vec3,RNG = math.huge,Vector3.new,math.random;

	local Pcall = pcall;

	--//

	local RunService = (game:FindService("RunService") or game:GetService("RunService"));
	local Players = (game:FindService("Players") or game:GetService("Players"));
	local Exoticdebris = require(game:GetService("ReplicatedStorage"):FindFirstChild("ExoticDebris"));

	--//

	function Create(ty)
		return function(data)
			local obj = Instant(ty)
			for k, v in Pairs(data) do
				if Type(k) == "number" then
					v.Parent = obj
				else
					obj[k] = v
				end
			end
			return obj
		end
	end

	local Heartbeat = RunService.Heartbeat;
	local Stepped = RunService.Stepped;
	function Halt(Duration) -- Much like wait() but, doesn't wait excessively. - @TakeoHonorable
		--// Arguments: (Duration[Number])

		Duration = (Duration or 0)
		local cur = 0;
		while cur < Duration do
			cur += Heartbeat:Wait();
		end
		return cur;

	end

	local Character = script.Parent;

	local Humanoid = FindFirstChildOfClass(Character,"Humanoid");

	if (not Humanoid or Humanoid.Health <= 0) then Destroy(script); return end

	local Duration = (FindFirstChild(script,"Duration"));

	if not Duration then Destroy(script); return end

	local Player = Players:GetPlayerFromCharacter(Character);

	local Head = FindFirstChild(Character, "Head");
	local Confusion_Effect = nil;

	if Head then

		Confusion_Effect = Clone( script.Confuse );
		Confusion_Effect.Parent = Head;
		Confusion_Effect.Enabled = true;

	end

	local Confuse_Debounce = true;

	local Confusing = nil;

	local Move_Position = nil;

	if not Player then

		Confusing = Heartbeat:Connect(function(delta)

			if Humanoid and Humanoid.WalkToPoint ~= Vec3(0,0,0) then

				Humanoid:MoveTo(-Humanoid.WalkToPoint);

			end

		end)

	elseif Player then

		local Decimate = Clone(script.Decimate);

		Create("ObjectValue"){
			Name = "Player";
			Value = Player;
			Parent = Decimate;
		};

		Create("ObjectValue"){
			Name = "Ref";
			Value = script;
			Parent = Decimate;
		};

		Decimate.Parent = (game:FindService("ServerScriptService") or game:GetService("ServerScriptService"));
		Decimate.Disabled = false;

	end

	while ((Duration.Value) > 0 and Humanoid and Humanoid.Health > 0) do

		if (Duration.Value == inf) then
			Stepped:Wait();
		else
			Duration.Value -= .5;
			Halt(.5);
		end

	end

	if Confusing then
		Confusing:Disconnect();
		Confusing = nil;
	end

	if (Confusion_Effect and Confusion_Effect.Parent) then
		Confusion_Effect.Enabled = false;
		Exoticdebris:AddItem(Confusion_Effect,2);
	end

	Destroy(script);



	
end]]></ProtectedString>
