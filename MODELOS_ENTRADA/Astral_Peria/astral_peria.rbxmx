					Humanoid:TakeDamage(ExplosionDamage)
					Humanoid.Sit = true
					local Tag = New("ObjectValue",Hit.Parent)
					Tag.Name = "OrbExplosionTag"
					ExoticDebris:AddItem(Tag,0.01)
					local delta = Root.Position - (script.Parent.Position + VEC3(0,-10,0))
