								<Properties>
									<ProtectedString name="Source"><![CDATA[local part = script.Parent

local TweenService = game:GetService("TweenService")

local Info = TweenInfo.new(
	0.6, -- Time
	Enum.EasingStyle.Quart, -- EasingStyle
	Enum.EasingDirection.Out, -- EasingDirection
	0, -- RepeatCount (when less than zero the tween will loop indefinitely)
	false, -- Reverses (tween will reverse once reaching its goal)
	0 -- DelayTime
)

local Properties = {
	Size = Vector3.new(0.8,0.8,0.8),
	Transparency = 1
}

local transparencyDelay = 1 -- Delay in seconds
local transparencyTweeen = TweenService:Create(part, Info, Properties)

-- Apply the size tween immediately
local sizeTweeen = TweenService:Create(part, Info, {Size = Vector3.new(0.8,0.8,0.8)})
sizeTweeen:Play()

-- Delay before applying transparency tween
wait(transparencyDelay)
transparencyTweeen:Play()

wait(2.2)
part:Destroy()
]]></ProtectedString>
