								<Properties>
									<ProtectedString name="Source"><![CDATA[local Ref = script:WaitForChild("Ref").Value;

if (not Ref or not Ref.Parent) then return end

local Players = (game:FindService("Players") or game:GetService("Players"));

local Player = Players.LocalPlayer;
local PlayerScripts = Player:WaitForChild("PlayerScripts");
local PlayerModule = require(PlayerScripts:WaitForChild("PlayerModule"));

local Controller = PlayerModule:GetControls();

Controller.moveFunction = function(player, direction, relative) --// Inverts Controls
	Player.Move(player, -direction, relative);
end

if (not Ref or not Ref.Parent) then
	
	Controller.moveFunction = Player.Move;
	
else
	
	local AncestryChanged = nil;
	
	AncestryChanged = Ref.AncestryChanged:Connect(function(_,parent)
		
		if (not parent) then
			
			if AncestryChanged then AncestryChanged:Disconnect(); AncestryChanged = nil; end
			
			Controller.moveFunction = Player.Move;
			
		end
		
	end)
	
end



]]></ProtectedString>
