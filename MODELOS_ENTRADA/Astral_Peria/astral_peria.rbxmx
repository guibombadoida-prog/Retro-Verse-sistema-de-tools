						end
					end
				end)
			end
		end)
		--[[local TweenTable = {1,Enum.EasingStyle.Linear,Enum.EasingDirection.Out,0,false,0}
		local Goals = {Position = Endpoint.Position}
		TweenModule(Singu,TweenTable,Goals)
		TweenModule(Outline,TweenTable,Goals)
		delay(1,function()
			ExplodeVFX()
			local PatchyBoom = New("Explosion")
			PatchyBoom.Parent,PatchyBoom.Position = workspace,Singu.Position
