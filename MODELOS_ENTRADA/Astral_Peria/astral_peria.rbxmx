Remote.OnServerEvent:Connect(function(Client,Key)
	if not Player or not Client or Client ~= Player or not Key or not Tool.Enabled then return end
	if Key == Enum.KeyCode.Q and DirectOrbs == true and Tool.Enabled == true and Events.Starified.Value == false then
		Direct()
	elseif Key == Enum.KeyCode.E and ExplodeOrbs == true and Tool.Enabled == true and Events.Starified.Value == false then
		Explode()
	elseif Key == Enum.KeyCode.X and SpacePulsar == true and Events.Starified.Value == false then
		if Components.PeriSparkle.Enabled then
			NewAstralPulsar()
		end
	end
end)]]></ProtectedString>
