<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Folder" referent="RVPACK"><Properties><string name="Name">Pack</string></Properties><Item class="ModuleScript" referent="RBXDD62479EE0D2498691640ADECC9F7DAB">
