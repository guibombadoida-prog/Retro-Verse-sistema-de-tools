			<Properties>
				<ProtectedString name="Source">-- Humilhador - Script do Servidor

local Tool = script.Parent
local char
local enabled = true
local COOLDOWN = 2 -- Cooldown de 2 segundos entre usos
local MAX_USES_PER_MINUTE = 10 -- Máximo de 10 usos por minuto
local useTimes = {} -- Tabela para rastrear horários de uso

-- Função para limpar usos antigos (mais de 1 minuto)
local function cleanOldUses()
	local currentTime = tick()
	local newUseTimes = {}

	for _, useTime in ipairs(useTimes) do
		if currentTime - useTime &lt; 60 then
			table.insert(newUseTimes, useTime)
		end
	end

	useTimes = newUseTimes
end

Tool.Equipped:Connect(function()
	char = Tool.Parent
end)

function onLeftDown()
	-- Verificar se está habilitado
	if not enabled then
		return
	end

	-- Verificar se o personagem existe
	if not char or not char:FindFirstChild('Head') then
		return
	end

	-- Limpar usos antigos
	cleanOldUses()

	-- Verificar limite de usos por minuto
	if #useTimes &gt;= MAX_USES_PER_MINUTE then
		warn("Limite de usos atingido! Aguarde um momento.")
		return
	end

	-- Desabilitar temporariamente
	enabled = false

	-- Registrar uso atual
	table.insert(useTimes, tick())

	-- Criar som
	local boom = Instance.new("Sound")
	boom.SoundId = "rbxassetid://7995127481"
	boom.Volume = 3
	boom.PlayOnRemove = true
	boom.Parent = char:FindFirstChild('Head')
	boom:Destroy()

	-- Criar efeito visual
	local part = script.heheheha:Clone()
	part.Parent = char:FindFirstChild('Head')
	part.mainz.Disabled = false

	-- Limpar efeito após alguns segundos para evitar acúmulo
	game:GetService("Debris"):AddItem(part, 5)

	-- Reabilitar após cooldown
	wait(COOLDOWN)
	enabled = true
end

Tool.Activated:Connect(onLeftDown)

-- Limpar tabela quando tool é desequipada
Tool.Unequipped:Connect(function()
	useTimes = {}
	enabled = true
end)</ProtectedString>
