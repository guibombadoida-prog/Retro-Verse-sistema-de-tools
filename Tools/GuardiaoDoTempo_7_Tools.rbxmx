</Vector3><token name="EmissionDirection">1</token><token name="Orientation">0</token><bool name="LockedToPart">false</bool><bool name="Enabled">false</bool><float name="TimeScale">1.0</float></Properties></Item></Item><Item class="Part" referent="RBX34"><Properties><string name="Name">AURA</string><Vector3 name="size"><X>0.4</X><Y>0.4</Y><Z>0.4</Z></Vector3><CoordinateFrame name="CFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1.0</R00><R01>0.0</R01><R02>0.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>0.0</R20><R21>0.0</R21><R22>1.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4294967295</Color3uint8><token name="Material">272</token><token name="shape">1</token><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><bool name="Massless">true</bool><bool name="Locked">true</bool><float name="Transparency">1.0</float><float name="Reflectance">0.0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token></Properties><Item class="ParticleEmitter" referent="RBX35"><Properties><string name="Name">Aura</string><Content name="Texture"><url>rbxassetid://12156297119</url></Content><float name="Rate">2.0</float><NumberRange name="Lifetime">1.25 1.25 </NumberRange><NumberRange name="Speed">0.05 0.05 </NumberRange><NumberSequence name="Size">0 5 0 1 5 0 </NumberSequence><NumberSequence name="Transparency">0 0.35 0 1 1 0 </NumberSequence><ColorSequence name="Color">0 0.604 0.804 0.196 0 1 0.78 0.95 0.45 0 </ColorSequence><float name="LightEmission">1.0</float><float name="LightInfluence">1.0</float><float name="Brightness">1.0</float><NumberRange name="Rotation">0 0 </NumberRange><NumberRange name="RotSpeed">0 0 </NumberRange><float name="ZOffset">5.0</float><float name="Drag">0.0</float>