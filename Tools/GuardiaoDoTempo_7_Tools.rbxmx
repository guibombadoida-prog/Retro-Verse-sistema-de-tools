	{
		duracao = 0.15,
		easing = "quadInOut",
		absoluto = true,
		juntas = {
			["RootJoint"] = CFrame.new(-2.44929e-17, -0.05, 0.2, -0.819152, -0.573576, -3.16962e-17, 0.148453, -0.212012, 0.965926, -0.554032, 0.79124, 0.258819),
			["Neck"] = CFrame.new(0, 1, 0, -0.819152, 0.573576, 3.16962e-17, 0.148453, 0.212012, 0.965926, 0.554032, 0.79124, -0.258819),
			["Right Shoulder"] = CFrame.new(1.04685, 0.5, 0.611309, 5.54953e-17, 0.422618, 0.906308, 1, 5.54953e-17, -8.71102e-17, -8.71102e-17, 0.906308, -0.422618),
			["Left Shoulder"] = CFrame.new(-0.750761, 0.384865, 0.101218, -0.0348663, -0.999391, 0.00152229, 0.996956, -0.0348875, -0.0697299, 0.0697405, -0.000913562, 0.997565),
			["Right Hip"] = CFrame.new(1, -1.05, -0.01, -0.173648, -0.0343693, 0.984208, -0.254887, 0.966906, -0.0112058, -0.951251, -0.252808, -0.176662),
			["Left Hip"] = CFrame.new(-1, -0.85, -0.01, 0.642788, 0.0133693, -0.765928, 0.198267, 0.962875, 0.183198, 0.739942, -0.269616, 0.616274),
		},
	},
	{
		duracao = 0.08,
		easing = "backOut",
		absoluto = true,
		juntas = {
			["RootJoint"] = CFrame.new(7.9602e-17, -0.3, -0.65, -1, -6.12323e-17, 1.06058e-16, 7.4988e-33, 0.866025, 0.5, -1.22465e-16, 0.5, -0.866025),
			["Neck"] = CFrame.new(0, 1, 0, -1, -1.22465e-16, 0, 7.4988e-33, -6.12323e-17, 1, -1.22465e-16, 1, 6.12323e-17),
			["Right Shoulder"] = CFrame.new(1, 0.5, 0.4, 6.12323e-17, 0, 1, 0.906308, 0.422618, -5.54953e-17, -0.422618, 0.906308, 2.58779e-17),
			["Left Shoulder"] = CFrame.new(-0.750761, 0.384865, 0.101218, -0.0348663, -0.999391, 0.00152229, 0.996956, -0.0348875, -0.0697299, 0.0697405, -0.000913562, 0.997565),
			["Right Hip"] = CFrame.new(1, -1.05, -0.01, 6.12323e-17, 0, 1, 0.766044, 0.642788, -4.69067e-17, -0.642788, 0.766044, 3.93594e-17),
			["Left Hip"] = CFrame.new(-1, -1.05, -0.01, 6.12323e-17, 0, -1, -0.866025, 0.5, -5.30288e-17, 0.5, 0.866025, 3.06162e-17),
		},
	},
	{
		duracao = 0.08,
		easing = "cubicOut",
		absoluto = true,
		juntas = {
			["RootJoint"] = CFrame.new(3.79641e-17, -0.45, -0.31, -1, -6.12323e-17, 1.06058e-16, 7.4988e-33, 0.866025, 0.5, -1.22465e-16, 0.5, -0.866025),
			["Neck"] = CFrame.new(0, 1, 0, -1, -1.22465e-16, 0, 7.4988e-33, -6.12323e-17, 1, -1.22465e-16, 1, 6.12323e-17),
			["Right Shoulder"] = CFrame.new(0.867037, 0.554691, -0.882715, 5.91459e-17, 0.258819, 0.965926, 0.906308, 0.408218, -0.109382, -0.422618, 0.875426, -0.23457),
			["Left Shoulder"] = CFrame.new(-0.750761, 0.384865, 0.101218, -0.0348663, -0.999391, 0.00152229, 0.996956, -0.0348875, -0.0697299, 0.0697405, -0.000913562, 0.997565),
			["Right Hip"] = CFrame.new(1, -0.25, -0.4, 6.12323e-17, 0, 1, 0.766044, 0.642788, -4.69067e-17, -0.642788, 0.766044, 3.93594e-17),
			["Left Hip"] = CFrame.new(-1, -0.25, -0.4, 6.12323e-17, 0, -1, -0.866025, 0.5, -5.30288e-17, 0.5, 0.866025, 3.06162e-17),
		},
	},
	{
		duracao = 0.25,
		easing = "quadOut",
		absoluto = true,
		juntas = {
			["RootJoint"] = CFrame.new(3.79641e-17, -0.45, -0.31, -1, -6.12323e-17, 1.06058e-16, 7.4988e-33, 0.866025, 0.5, -1.22465e-16, 0.5, -0.866025),
			["Neck"] = CFrame.new(0, 1, 0, -1, -1.22465e-16, 0, 7.4988e-33, -6.12323e-17, 1, -1.22465e-16, 1, 6.12323e-17),
			["Right Shoulder"] = CFrame.new(0.940424, 0.621202, -0.740082, 5.01586e-17, 0.573576, 0.819152, 0.906308, 0.346189, -0.242404, -0.422618, 0.742404, -0.519837),
			["Left Shoulder"] = CFrame.new(-0.750761, 0.384865, 0.101218, -0.0348663, -0.999391, 0.00152229, 0.996956, -0.0348875, -0.0697299, 0.0697405, -0.000913562, 0.997565),
			["Right Hip"] = CFrame.new(1, -0.25, -0.4, 1, 0, 0, 0, 1, 0, 0, 0, 1),
			["Left Hip"] = CFrame.new(-1, -0.25, -0.4, 6.12323e-17, 0, -1, -0.866025, 0.5, -5.30288e-17, 0.5, 0.866025, 3.06162e-17),
		},
	},
}

function Poses.primaria()
	return PRIMARIA
end

return Poses
