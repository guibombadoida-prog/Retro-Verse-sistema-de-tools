t name="Drag">10.0</float><Vector3 name="Acceleration"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><token name="EmissionDirection">0</token><token name="Orientation">0</token><bool name="LockedToPart">false</bool><bool name="Enabled">false</bool><float name="TimeScale">1.0</float></Properties></Item></Item></Item></Item></roblox>