		{ t = 0.0667, style = "Sine", dir = "InOut", RightArm = CFrame.new(2.8181, -0.25087, -0.43137, -0.95308, 0.216, 0.21207, 0.25722, 0.20854, 0.94358, 0.15959, 0.95386, -0.25432), LeftArm = CFrame.new(-3.0259, -0.78205, -0.18307, -0.88296, -0.43467, -0.17729, -0.055037, -0.2792, 0.95865, -0.4662, 0.85622, 0.2226), Head = CFrame.new(0, 1.5, 0.018294, 0.98965, 0.097034, 0.10574, -0.10025, 0.99464, 0.025506, -0.1027, -0.035845, 0.99407), HRP = CFrame.new(-0.01389, 0.52796, -0.98219, 0.97396, -0.018577, -0.22595, 0.013682, 0.99964, -0.02321, 0.2263, 0.019514, 0.97386), RightLeg = CFrame.new(1.7043, -1.5405, 0.0053623, 0.55716, 0.8274, 0.070562, -0.82907, 0.55907, -0.0092117, -0.04707, -0.053368, 0.99746), LeftLeg = CFrame.new(-0.49822, -2.1668, -0.023122, 0.26977, 0.96019, -0.072449, -0.93287, 0.24196, -0.26686, -0.23871, 0.13958, 0.96101) },
