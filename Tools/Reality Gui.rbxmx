				<ProtectedString name="Source">
function Activated()
	animator = require(script.Parent:WaitForChild("CFAv3"))

	animation = animator.new(script.Parent.Parent, script.Parent["california gurls"])
	animation:play()
	script.Parent.music:Play()
end

function Equipped()
end

function Unequipped()
	script.Parent.music:Stop()
	animation:stop()
end

script.Parent.Activated:Connect(Activated)
script.Parent.Equipped:Connect(Equipped)
script.Parent.Unequipped:Connect(Unequipped)
