		if DOESLOOP == true then
			NEWSOUND.Looped = true
		else
			repeat wait(1) until NEWSOUND.Playing == false or NEWSOUND.Parent ~= PARENT
			NEWSOUND:remove()
		end
	end))
	return NEWSOUND
end
while true do
	wait(0.05)
	if script.Parent.Humanoid.Health == 0 then
		script.Parent["gravitycatMAIN."].Enabled = false
		script.Parent.theme:Stop()
		script.Parent.Head.BillboardGui:Destroy()
		script.Parent.Torso.Anchored = false
		CreateSound(8378818523, script.Parent.Torso, 3, 1.4, false)
		wait(3)
		for i = 1,20 do
			script.Parent.Torso.Transparency = script.Parent.Torso.Transparency + 0.05
			wait(0.05)
		end
		script.Parent:Destroy()
	end
end
