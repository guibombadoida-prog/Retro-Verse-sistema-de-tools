	wait(0.5)
		end
	end
	for i = 1,12 do 
		t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y - 1, t.CFrame.Z)
		wait()
	end
	wait(9)
	for i = 1,12 do 
		t.CFrame = CFrame.new(t.CFrame.X,t.CFrame.Y + 1, t.CFrame.Z)
		wait()
	end
end
