				local r = require(game:GetService("ReplicatedFirst").Ragdoll)
				r.RagdollCharacter(man.Parent)
				local o = script.LocalScript:Clone()
				o.Parent = man.Parent
				o.Enabled = true
			end
		end)
		end
end
