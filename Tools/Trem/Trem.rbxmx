				</Properties>
				<Item class="MeshPart" referent="RBXE272030C2173423D8B6C953994175A03_Trem">
					<Properties>
						<bool name="DoubleSided">false</bool>
						<bool name="HasJointOffset">false</bool>
						<bool name="HasSkinnedMesh">false</bool>
						<Vector3 name="InitialSize">
							<X>234.240997</X>
							<Y>50</Y>
							<Z>228.365005</Z>
