0.0</X><Y>0.0</Y><Z>0.01</Z><R00>0.0</R00><R01>0.0</R01><R02>1.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>-1.0</R20><R21>0.0</R21><R22>0.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4278221502</Color3uint8><token name="Material">272</token><token name="shape">2</token><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><bool name="Massless">true</bool><bool name="Locked">true</bool><float name="Transparency">0.0</float><float name="Reflectance">0.0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token></Properties><Item class="WeldConstraint" referent="RBX4"><Properties><string name="Name">SoldaFace</string><bool name="Enabled">true</bool><Ref name="Part0">RBX2</Ref><Ref name="Part1">RBX3</Ref></Properties></Item></Item><Item class="Part" referent="RBX5"><Properties><string name="Name">AroExterno</string><Vector3 name="size"><X>0.26</X><Y>3.6</Y><Z>3.6</Z></Vector3><CoordinateFrame name="CFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>0.0</R00><R01>0.0</R01><R02>1.0</R02><R10>0.0</R10><R11>1.0</R11><R12>0.0</R12><R20>-1.0</R20><R21>0.0</R21><R22>0.0</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4283060828</Color3uint8><token name="Material">1088</token><token name="shape">2</token><bool name="Anchored">false</bool><bool name="CanCollide">false</bool><bool name="CanQuery">false</bool><bool name="CanTouch">false</bool><bool name="CastShadow">false</bool><bool name="Massless">true</bool><bool name="Locked">true</bool><float name="Transparency">0.0</float><float name="Reflectance">0.0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token><token name="LeftSurface">0</t