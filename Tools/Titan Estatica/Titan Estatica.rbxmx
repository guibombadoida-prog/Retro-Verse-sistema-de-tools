	TweenService:Create(SlashPart,TweenInfo.new(Duration,Enum.EasingStyle.Linear),{Transparency = 1,Color = Color_B}):Play()

	Debris:AddItem(SlashPart,Duration + .8)

end]]></ProtectedString>
