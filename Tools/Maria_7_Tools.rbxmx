P.SEQUENCIAS = {

	-- conjuração · 1.20s · 4 passo(s)
	CURAR = {
		{ pose = "APONTA", time = 0.26, style = "Back", dir = "In", marca = "CARGA" },
		{ pose = "APONTA", time = 0.46, style = "Sine", dir = "InOut", tremor = 0.025, freq = 20, marca = "SEGURA" },
