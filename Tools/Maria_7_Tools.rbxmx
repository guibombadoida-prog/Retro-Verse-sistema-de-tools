	-- golpe pesado · 1.42s · 4 passo(s)
	CHUVA = {
		{ pose = "DUAS_MAOS", time = 0.32, style = "Back", dir = "In", marca = "CARGA" },
		{ pose = "DUAS_MAOS", time = 0.58, style = "Sine", dir = "InOut", tremor = 0.045, freq = 26, marca = "SEGURA" },
