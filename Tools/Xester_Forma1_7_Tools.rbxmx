P.SEQUENCIAS = {

	CARDNADO = {
		{ pose = "CARDNADO_2", time = 0.333, style = "Exponential", dir = "Out", marca = "CARGA" },
		{ pose = "CARDNADO_3", time = 0.150, style = "Exponential", dir = "Out" },
		{ pose = "CARDNADO_4", time = 0.150, style = "Exponential", dir = "Out", marca = "GOLPE" },
